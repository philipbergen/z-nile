@@ -0,0 +1,39 @@
+--!strict
+-- Every title's paid play (f0201): its name, the title its screens print, its two DataStores (live and test) and the
+-- ServerScriptService attributes that hold its two Developer Product ids. Every place installs Receipts with this whole
+-- list, so a receipt for any title is granted wherever it is processed. A new title is one entry here and two products.
+-- Pickman keeps f0145's names (its store, its test store and its two attributes).
+return table.freeze({
+	table.freeze({
+		name = "pickman",
+		title = "PICKMAN",
+		store = "PaidPlay",
+		testStore = "PaidPlayTest",
+		play = "PlayProductId",
+		revive = "ContinueProductId",
+	}),
+	table.freeze({
+		name = "snake",
+		title = "SNAKE",
+		store = "SnakePaidPlay",
+		testStore = "SnakePaidPlayTest",
+		play = "SnakePlayProductId",
+		revive = "SnakeReviveProductId",
+	}),
+	table.freeze({
+		name = "invaders",
+		title = "INVADERS",
+		store = "InvadersPaidPlay",
+		testStore = "InvadersPaidPlayTest",
+		play = "InvadersPlayProductId",
+		revive = "InvadersReviveProductId",
+	}),
+	table.freeze({
+		name = "asteroids",
+		title = "ASTEROIDS",
+		store = "AsteroidsPaidPlay",
+		testStore = "AsteroidsPaidPlayTest",
+		play = "AsteroidsPlayProductId",
+		revive = "AsteroidsReviveProductId",
+	}),
+})
diff --git a/arcade/src/server/Receipts.luau b/arcade/src/server/Receipts.luau
new file mode 100644
index 00000000..d36e8faa
--- /dev/null
+++ b/arcade/src/server/Receipts.luau
@@ -0,0 +1,154 @@
+--!strict
+-- Receipts (f0201): the purchases of every title, installed by every place (E4). ProcessReceipt grants a known
+-- product's receipt once into its own title's record, by user id, wherever Roblox processes it, and answers
+-- PurchaseGranted only after the write; an unknown product or a failed write answers NotProcessedYet. `ask` opens
+-- the purchase screen: Roblox's in live mode, the test purchase screen in test mode (which charges nothing), none in
+-- closed mode. A client only answers a test screen this server opened for it; it never names a product, a price or a
+-- receipt. Fresh grants and closed screens are handed to the place.
+local PaidPlay = require("@game/ReplicatedStorage/Arcade/Logic/PaidPlay")
+local Prices = require("@game/ReplicatedStorage/Arcade/Prices")
+local Wallet = require("./Wallet")
+
+local MarketplaceService = game:GetService("MarketplaceService")
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+export type Handlers = {
+	granted: ((player: any, name: string, kind: PaidPlay.Kind) -> ())?, -- a new grant for a player on this server
+	closed: ((player: any, name: string, kind: PaidPlay.Kind, bought: boolean) -> ())?, -- a purchase screen closed
+}
+
+local Receipts = {}
+
+Receipts.FOLDER = "ArcadePaidPlay" -- ReplicatedStorage folder made at start
+Receipts.REMOTE = "TestPurchase" -- its RemoteEvent: "open" to a client, "confirm" or "cancel" back
+
+type Pending = { name: string, kind: PaidPlay.Kind }
+
+local started = false
+local on: Handlers = {}
+local remote: any = nil
+local pending: { [any]: Pending } = {}
+
+local function present(userId: any): any
+	if type(userId) ~= "number" then
+		return nil
+	end
+	return Players:GetPlayerByUserId(userId)
+end
+
+local function granted(player: any, name: string, kind: PaidPlay.Kind)
+	local fn = on.granted
+	if fn ~= nil and player.Parent ~= nil then
+		task.spawn(fn, player, name, kind)
+	end
+end
+
+local function closed(player: any, name: string, kind: PaidPlay.Kind, bought: boolean)
+	local fn = on.closed
+	if fn ~= nil and player.Parent ~= nil then
+		task.spawn(fn, player, name, kind, bought)
+	end
+end
+
+local function process(info: any): any
+	local product = Wallet.config().products[info.ProductId]
+	local purchaseId = info.PurchaseId
+	if
+		product == nil
+		or type(purchaseId) ~= "string"
+		or purchaseId == ""
+		or type(info.PlayerId) ~= "number"
+	then
+		return Enum.ProductPurchaseDecision.NotProcessedYet
+	end
+	local written, fresh = Wallet.grant(info.PlayerId, product.name, product.kind, purchaseId)
+	if not written then
+		return Enum.ProductPurchaseDecision.NotProcessedYet
+	end
+	if fresh and Wallet.mode(product.name) ~= "test" then
+		local player = present(info.PlayerId)
+		if player ~= nil then
+			granted(player, product.name, product.kind)
+		end
+	end
+	return Enum.ProductPurchaseDecision.PurchaseGranted
+end
+
+local function answer(player: any, what: any)
+	local p = pending[player]
+	if p == nil or (what ~= "confirm" and what ~= "cancel") then
+		return
+	end
+	pending[player] = nil
+	if what == "cancel" then
+		closed(player, p.name, p.kind, false)
+		return
+	end
+	local written = Wallet.testGrant(player, p.name, p.kind)
+	closed(player, p.name, p.kind, written)
+	if written then
+		granted(player, p.name, p.kind)
+	end
+end
+
+-- Installs the purchases on this server, once: a second call does nothing and answers false.
+function Receipts.start(handlers: Handlers?): boolean
+	if started then
+		return false
+	end
+	started = true
+	on = handlers or {}
+	local config = Wallet.config()
+	local folder = ReplicatedStorage:FindFirstChild(Receipts.FOLDER)
+	if folder == nil then
+		folder = Instance.new("Folder")
+		folder.Name = Receipts.FOLDER
+		folder.Parent = ReplicatedStorage
+	end
+	remote = folder:FindFirstChild(Receipts.REMOTE)
+	if remote == nil then
+		remote = Instance.new("RemoteEvent")
+		remote.Name = Receipts.REMOTE
+		remote.Parent = folder
+	end
+	remote.OnServerEvent:Connect(answer)
+	MarketplaceService.ProcessReceipt = process
+	MarketplaceService.PromptProductPurchaseFinished:Connect(
+		function(userId: any, productId: any, bought: any)
+			local product = config.products[productId]
+			local player = present(userId)
+			if product ~= nil and player ~= nil then
+				closed(player, product.name, product.kind, bought == true)
+			end
+		end
+	)
+	Players.PlayerRemoving:Connect(function(player: any)
+		pending[player] = nil
+	end)
+	return true
+end
+
+-- Opens a purchase screen of a title's product for a player: Roblox's in live mode, the test screen in test mode
+-- (not while one is open for them), none in closed mode. Answers whether a screen opened.
+function Receipts.ask(player: any, name: string, kind: PaidPlay.Kind): boolean
+	if not started then
+		error("Receipts: start() first", 2)
+	end
+	local t = Wallet.config().titles[name]
+	if t == nil then
+		error(`Receipts: no title "{tostring(name)}" in the catalog`, 2)
+	end
+	if t.mode == "live" then
+		MarketplaceService:PromptProductPurchase(player, if kind == "play" then t.ids.play else t.ids.revive)
+		return true
+	end
+	if t.mode == "test" and pending[player] == nil then
+		pending[player] = { name = name, kind = kind }
+		remote:FireClient(player, "open", PaidPlay.testLines(t.entry.title, kind, Prices))
+		return true
+	end
+	return false
+end
+
+return Receipts
diff --git a/arcade/src/server/Wallet.luau b/arcade/src/server/Wallet.luau
new file mode 100644
index 00000000..719f8f80
--- /dev/null
+++ b/arcade/src/server/Wallet.luau
@@ -0,0 +1,397 @@
+--!strict
+-- Wallet (f0201): a player's paid-play records, one per title, through one UpdateAsync per decision; the portal's
+-- passes; this run's revives; and the guards that bound what one client can make this server spend. Server only
+-- (ServerStorage.Arcade): no client can read it. Every decision is PaidPlay's, taken inside the transform, and the
+-- transform's last call decides (UpdateAsync may call it again on a newer value). What a teleport carries is never read.
+local Catalog = require("./Catalog")
+local PaidPlay = require("@game/ReplicatedStorage/Arcade/Logic/PaidPlay")
+
+local DataStoreService = game:GetService("DataStoreService")
+local HttpService = game:GetService("HttpService")
+local MemoryStoreService = game:GetService("MemoryStoreService")
+local Players = game:GetService("Players")
+local ServerScriptService = game:GetService("ServerScriptService")
+
+local Wallet = {}
+
+Wallet.WAIT_SECONDS = 5 -- an arrival's claim or a read not back by then counts as failed
+Wallet.READ_SECONDS = 60 -- a read within this of the last record seen answers from it (every write here refreshes it)
+Wallet.USE_SECONDS = 6 -- at most one revive write per player and title in this span
+Wallet.PASS_SECONDS = 300 -- a portal pass lives this long
+Wallet.PASS_MAP = "PaidPlayPass" -- MemoryStore hash map of the passes, key "<name>/<user id>"
+Wallet.MODE_ATTRIBUTE = "PaidPlay" -- ServerScriptService attribute: "live" for live mode
+
+type Arrival = { verdict: PaidPlay.Verdict, start: PaidPlay.Start? }
+type Slot = {
+	seen: PaidPlay.Record?, -- the last record of this title this server saw for the player, in the mode's store
+	seenAt: number?,
+	reading: boolean,
+	using: boolean,
+	usedAt: number?,
+	arrival: Arrival?, -- this join's arrival, answered once
+	arriving: { thread }?, -- callers waiting for the arrival under way
+}
+
+local configured: PaidPlay.Config? = nil
+local slots: { [any]: { [string]: Slot } } = {}
+local tallies: { [string]: number } = {} -- "<name>/<user id>": revives used in this run
+local stores: { [string]: any } = {}
+local passMap: any = nil
+
+function Wallet.config(): PaidPlay.Config
+	local c = configured
+	if c == nil then
+		c = PaidPlay.configure(
+			Catalog,
+			ServerScriptService:GetAttribute(Wallet.MODE_ATTRIBUTE),
+			function(name: string): any
+				return ServerScriptService:GetAttribute(name)
+			end
+		)
+		configured = c
+	end
+	return c :: PaidPlay.Config
+end
+
+local function title(name: string): PaidPlay.Title
+	local t = Wallet.config().titles[name]
+	if t == nil then
+		error(`Wallet: no title "{tostring(name)}" in the catalog`, 2)
+	end
+	return t
+end
+
+function Wallet.mode(name: string): PaidPlay.Mode
+	return title(name).mode
+end
+
+local function keyOf(name: string, userId: number): string
+	return `{name}/{userId}`
+end
+
+local function slotOf(player: any, name: string): Slot
+	local byName = slots[player]
+	if byName == nil then
+		byName = {}
+		slots[player] = byName
+	end
+	local slot = byName[name]
+	if slot == nil then
+		slot = { reading = false, using = false }
+		byName[name] = slot
+	end
+	return slot
+end
+
+-- Slots are kept per Player object and dropped when the player leaves, so a result that comes back after a leave
+-- lands in a dropped slot, and a rejoin starts a fresh one.
+local function see(slot: Slot, r: PaidPlay.Record)
+	slot.seen = r
+	slot.seenAt = os.clock()
+end
+
+local function store(name: string): any
+	local s = stores[name]
+	if s == nil then
+		local ok, opened = pcall(function(): any
+			return DataStoreService:GetDataStore(name)
+		end)
+		if ok and opened ~= nil then
+			s = opened
+			stores[name] = s
+		end
+	end
+	return s
+end
+
+-- One UpdateAsync of a player's record: `fn` answers the new record (nil writes nothing) and a decision. Answers the
+-- final record and the decision of the transform's last call, or nil when the store failed.
+local function update(
+	storeName: string,
+	userId: number,
+	fn: (PaidPlay.Record) -> (PaidPlay.Record?, any)
+): (PaidPlay.Record?, any)
+	local s = store(storeName)
+	if s == nil then
+		return nil
+	end
+	local final: PaidPlay.Record? = nil
+	local decision: any = nil
+	local ok = pcall(function()
+		s:UpdateAsync(tostring(userId), function(raw: any): any
+			local r = PaidPlay.record(raw)
+			local n, d = fn(r)
+			final, decision = n or r, d
+			return n
+		end)
+	end)
+	if not ok then
+		return nil
+	end
+	return final, decision
+end
+
+-- Runs fn in its own thread and answers (true, its results), or (false) when it is not back within `seconds`.
+local function within(seconds: number, fn: () -> ...any): (boolean, ...any)
+	local me = coroutine.running()
+	local result: { any }? = nil
+	local waiting = false
+	local function settle(r: { any })
+		if result ~= nil then
+			return
+		end
+		result = r
+		if waiting then
+			task.spawn(me)
+		end
+	end
+	task.spawn(function()
+		settle(table.pack(true, fn()))
+	end)
+	if result == nil then
+		task.delay(seconds, function()
+			settle(table.pack(false))
+		end)
+	end
+	if result == nil then
+		waiting = true
+		coroutine.yield()
+	end
+	local r = result :: any
+	return table.unpack(r, 1, r.n)
+end
+
+-- A player's record of a title, from the mode's store. Answers nil and "busy" while a read for them is under way,
+-- or nil and "down" when the store failed or was not back within WAIT_SECONDS; a read within READ_SECONDS of the
+-- last record seen answers from it.
+function Wallet.read(player: any, name: string): (PaidPlay.Record?, string?)
+	local t = title(name)
+	local slot = slotOf(player, name)
+	if slot.reading then
+		return nil, "busy"
+	end
+	if slot.seen ~= nil and slot.seenAt ~= nil and os.clock() - slot.seenAt < Wallet.READ_SECONDS then
+		return slot.seen
+	end
+	slot.reading = true
+	local s = store(PaidPlay.store(t.entry, t.mode))
+	local back, ok, raw = within(Wallet.WAIT_SECONDS, function(): (boolean, any)
+		if s == nil then
+			slot.reading = false
+			return false, nil
+		end
+		local okRead, value = pcall(function(): any
+			return s:GetAsync(tostring(player.UserId))
+		end)
+		slot.reading = false
+		return okRead, value
+	end)
+	if not back or not ok then
+		return nil, "down"
+	end
+	local r = PaidPlay.record(raw)
+	see(slot, r)
+	return r
+end
+
+-- The portal's pass, for a player it let go on a failed read: the arrival then plays even with nothing to pay with.
+function Wallet.pass(player: any, name: string): boolean
+	title(name)
+	local ok = pcall(function()
+		if passMap == nil then
+			passMap = MemoryStoreService:GetHashMap(Wallet.PASS_MAP)
+		end
+		passMap:SetAsync(keyOf(name, player.UserId), true, Wallet.PASS_SECONDS)
+	end)
+	return ok
+end
+
+-- Takes the player's pass for a title: true when one was there, or when the map cannot be read (decided with the
+-- user, 2026-10-31: "Let all of them play").
+local function takePass(player: any, name: string): boolean
+	local key = keyOf(name, player.UserId)
+	local ok, value = pcall(function(): any
+		if passMap == nil then
+			passMap = MemoryStoreService:GetHashMap(Wallet.PASS_MAP)
+		end
+		return passMap:GetAsync(key)
+	end)
+	if not ok then
+		return true
+	end
+	if value == nil then
+		return false
+	end
+	pcall(function()
+		passMap:RemoveAsync(key)
+	end)
+	return true
+end
+
+-- The arrival in a title's place, once per join: the free start due, else a held play (PaidPlay.start, in one
+-- UpdateAsync); the portal's pass is taken whatever the start; a claim that failed or was not back within
+-- WAIT_SECONDS plays (a failure costs the player nothing). Answers "play" or "back" and the start (nil: failed).
+-- Begins this run's revive count. A second call during the first waits for it; a later one answers the same.
+function Wallet.arrive(player: any, name: string): (PaidPlay.Verdict, PaidPlay.Start?)
+	local t = title(name)
+	local slot = slotOf(player, name)
+	local done = slot.arrival
+	if done ~= nil then
+		return done.verdict, done.start
+	end
+	local waiting = slot.arriving
+	if waiting ~= nil then
+		table.insert(waiting, coroutine.running())
+		return coroutine.yield()
+	end
+	slot.arriving = {}
+	local userId = player.UserId
+	local now = os.time()
+	local back, final, start = within(Wallet.WAIT_SECONDS, function(): (PaidPlay.Record?, any)
+		return update(
+			PaidPlay.store(t.entry, t.mode),
+			userId,
+			function(r: PaidPlay.Record): (PaidPlay.Record?, any)
+				local s, n = PaidPlay.start(r, now)
+				return if s == "buy" then nil else n, s
+			end
+		)
+	end)
+	local passed = takePass(player, name)
+	local verdict: PaidPlay.Verdict = PaidPlay.arrive(start, passed) :: PaidPlay.Verdict
+	tallies[keyOf(name, userId)] = 0
+	if back and final ~= nil then
+		see(slot, final)
+	end
+	local answer: Arrival = { verdict = verdict, start = start }
+	slot.arrival = answer
+	local woken: { thread } = slot.arriving or {}
+	slot.arriving = nil
+	for _, thread in woken do
+		task.spawn(thread, verdict, start)
+	end
+	return verdict, start
+end
+
+-- Uses one held revive: true when used (this run's count goes up), false when none is held (known from the last
+-- record this server saw, then no write), nil when it cannot tell (a use under way, one within USE_SECONDS, or the
+-- store failed).
+function Wallet.useRevive(player: any, name: string): boolean?
+	local t = title(name)
+	local slot = slotOf(player, name)
+	if slot.using then
+		return nil
+	end
+	local seen = slot.seen
+	if seen ~= nil and seen.revives < 1 then
+		return false
+	end
+	if slot.usedAt ~= nil and os.clock() - slot.usedAt < Wallet.USE_SECONDS then
+		return nil
+	end
+	slot.using = true
+	slot.usedAt = os.clock()
+	local userId = player.UserId
+	local final, used = update(
+		PaidPlay.store(t.entry, t.mode),
+		userId,
+		function(r: PaidPlay.Record): (PaidPlay.Record?, any)
+			local u, n = PaidPlay.useRevive(r)
+			return if u then n else nil, u
+		end
+	)
+	slot.using = false
+	if final == nil then
+		return nil
+	end
+	see(slot, final)
+	if used then
+		local key = keyOf(name, userId)
+		tallies[key] = (tallies[key] or 0) + 1
+	end
+	return used == true
+end
+
+-- Gives a credit back (a revive used that could not be applied): its own credit, outside the receipts.
+function Wallet.refund(player: any, name: string, kind: PaidPlay.Kind): boolean
+	local t = title(name)
+	local slot = slotOf(player, name)
+	local final = update(
+		PaidPlay.store(t.entry, t.mode),
+		player.UserId,
+		function(r: PaidPlay.Record): (PaidPlay.Record?, any)
+			return PaidPlay.refund(r, kind), nil
+		end
+	)
+	if final == nil then
+		return false
+	end
+	see(slot, final)
+	return true
+end
+
+-- The revives this run of the player has used (PaidPlay's count for the boards): 0 at the arrival, one more for each
+-- revive used. Kept after the player leaves, until their next arrival on this server.
+function Wallet.revives(player: any, name: string): number
+	title(name)
+	return tallies[keyOf(name, player.UserId)] or 0
+end
+
+local function grantInto(
+	storeName: string,
+	userId: number,
+	kind: PaidPlay.Kind,
+	receiptId: string
+): (boolean, boolean, PaidPlay.Record?)
+	local final, fresh = update(storeName, userId, function(r: PaidPlay.Record): (PaidPlay.Record?, any)
+		local n, isNew = PaidPlay.grant(r, kind, receiptId)
+		return if isNew then n else nil, isNew
+	end)
+	if final == nil then
+		return false, false, nil
+	end
+	return true, fresh == true, final
+end
+
+local function seeGrant(userId: number, name: string, final: PaidPlay.Record?)
+	local player = Players:GetPlayerByUserId(userId)
+	if player ~= nil and final ~= nil then
+		see(slotOf(player, name), final)
+	end
+end
+
+-- A Roblox receipt's grant, by user id (the buyer need not be on this server): always into the title's live store,
+-- since real Robux were charged. Answers whether it was written, and whether it was new (not granted before).
+function Wallet.grant(
+	userId: number,
+	name: string,
+	kind: PaidPlay.Kind,
+	receiptId: string
+): (boolean, boolean)
+	local t = title(name)
+	local written, fresh, final = grantInto(t.entry.store, userId, kind, receiptId)
+	if written and t.mode ~= "test" then
+		seeGrant(userId, name, final)
+	end
+	return written, fresh
+end
+
+-- A test purchase's grant (test mode only): into the test store, under a fresh "test:" id. Answers whether written.
+function Wallet.testGrant(player: any, name: string, kind: PaidPlay.Kind): boolean
+	local t = title(name)
+	if t.mode ~= "test" then
+		return false
+	end
+	local receiptId = "test:" .. HttpService:GenerateGUID(false)
+	local written, _, final = grantInto(t.entry.testStore, player.UserId, kind, receiptId)
+	if written then
+		seeGrant(player.UserId, name, final)
+	end
+	return written
+end
+
+Players.PlayerRemoving:Connect(function(player: any)
+	slots[player] = nil
+end)
+
+return Wallet
diff --git a/arcade/src/shared/Logic/PaidPlay/init.luau b/arcade/src/shared/Logic/PaidPlay/init.luau
new file mode 100644
index 00000000..0f37f5d6
--- /dev/null
+++ b/arcade/src/shared/Logic/PaidPlay/init.luau
@@ -0,0 +1,242 @@
+--!strict
+-- PaidPlay (f0201): the cost model every arcade title shares. One free start per rolling hour per title and player,
+-- then a held play (bought for 1 R$), else a purchase; a revive (3 new lives) for 1 R$; a receipt granted once; test
+-- mode charges nothing. Pure: the clock, the catalog and the attribute reads come in as parameters, and nothing here
+-- mutates a record it is given.
+
+export type Mode = "live" | "test" | "closed"
+export type Kind = "play" | "revive"
+export type Start = "free" | "credit" | "buy"
+export type Verdict = "play" | "back"
+-- one player's record in one title, as stored (key: the user id)
+export type Record = { free: number?, plays: number, revives: number, receipts: { string } }
+export type Status = { free: boolean, nextFree: number?, plays: number, revives: number }
+-- a title's catalog entry: its name, the title its screens print, its two stores and the attribute names of its ids
+export type Entry = {
+	name: string,
+	title: string,
+	store: string,
+	testStore: string,
+	play: string,
+	revive: string,
+}
+export type Ids = { play: number?, revive: number? }
+export type Product = { name: string, kind: Kind }
+export type Title = { entry: Entry, mode: Mode, ids: Ids }
+export type Config = { titles: { [string]: Title }, products: { [number]: Product } }
+export type Prices = { struck: string, price: string, sale: string }
+
+local PaidPlay = {}
+
+PaidPlay.FREE_SECONDS = 3600 -- the free start's rolling hour
+PaidPlay.PRICE = 1 -- R$ a play and a revive; the products carry it
+PaidPlay.RECEIPTS_KEPT = 50 -- receipt ids remembered per record, for granting each once
+PaidPlay.LIVE = "live" -- the PaidPlay attribute's one live value
+PaidPlay.TEST_NOTE = "TEST PURCHASE: NOTHING IS CHARGED"
+PaidPlay.KIND_TEXT = table.freeze({ play = "1 GAME", revive = "REVIVE: 3 NEW LIVES" })
+PaidPlay.TEST_KEYS = table.freeze({
+	confirm = table.freeze({ "Return", "KeypadEnter", "ButtonA" }),
+	cancel = table.freeze({ "Backspace", "ButtonB" }),
+})
+
+local function whole(x: any): number?
+	if type(x) == "number" and x == x and x >= 0 and x < math.huge and x == math.floor(x) then
+		return x
+	end
+	return nil
+end
+
+local function id(x: any): number?
+	local n = whole(x)
+	if n and n > 0 then
+		return n
+	end
+	return nil
+end
+
+local function copy(r: Record): Record
+	return { free = r.free, plays = r.plays, revives = r.revives, receipts = table.clone(r.receipts) }
+end
+
+-- The mode of one title on a server: "live" only for exactly PaidPlay.LIVE with both ids; "live" with an id missing
+-- is "closed" (it sells nothing and grants nothing free); anything else is "test".
+function PaidPlay.mode(raw: any, ids: Ids): Mode
+	if raw ~= PaidPlay.LIVE then
+		return "test"
+	end
+	if ids.play and ids.revive then
+		return "live"
+	end
+	return "closed"
+end
+
+-- The store a mode keeps its records in: test mode's own, else the live one (closed included).
+function PaidPlay.store(entry: Entry, mode: Mode): string
+	if mode == "test" then
+		return entry.testStore
+	end
+	return entry.store
+end
+
+-- Every title's mode and ids, and the map from a product id to its title and kind. An id that two products share
+-- belongs to neither. `read` answers an attribute's value.
+function PaidPlay.configure(catalog: { Entry }, raw: any, read: (string) -> any): Config
+	local names: { [string]: boolean } = {}
+	local found: { { entry: Entry, ids: Ids } } = {}
+	local uses: { [number]: number } = {}
+	for _, entry in catalog do
+		assert(
+			type(entry.name) == "string" and string.match(entry.name, "^%l+$"),
+			"PaidPlay: a name is lowercase letters"
+		)
+		assert(not names[entry.name], `PaidPlay: {entry.name} twice in the catalog`)
+		names[entry.name] = true
+		local play, revive = id(read(entry.play)), id(read(entry.revive))
+		if play then
+			uses[play] = (uses[play] or 0) + 1
+		end
+		if revive then
+			uses[revive] = (uses[revive] or 0) + 1
+		end
+		local ids: Ids = { play = play, revive = revive }
+		table.insert(found, { entry = entry, ids = ids })
+	end
+	local config: Config = { titles = {}, products = {} }
+	for _, f in found do
+		local ids: Ids = {
+			play = if f.ids.play and uses[f.ids.play] == 1 then f.ids.play else nil,
+			revive = if f.ids.revive and uses[f.ids.revive] == 1 then f.ids.revive else nil,
+		}
+		config.titles[f.entry.name] = { entry = f.entry, mode = PaidPlay.mode(raw, ids), ids = ids }
+		if ids.play then
+			config.products[ids.play] = { name = f.entry.name, kind = "play" }
+		end
+		if ids.revive then
+			config.products[ids.revive] = { name = f.entry.name, kind = "revive" }
+		end
+	end
+	return config
+end
+
+-- A stored value read defensively: nil or broken fields are a new player's. A record written before revives were
+-- named (f0145's `continues`) keeps its count.
+function PaidPlay.record(raw: any): Record
+	local r: Record = { free = nil, plays = 0, revives = 0, receipts = {} }
+	if type(raw) ~= "table" then
+		return r
+	end
+	r.free = whole(raw.free)
+	r.plays = whole(raw.plays) or 0
+	r.revives = whole(raw.revives) or whole(raw.continues) or 0
+	if type(raw.receipts) == "table" then
+		for _, x in raw.receipts do
+			if type(x) == "string" and x ~= "" then
+				table.insert(r.receipts, x)
+			end
+		end
+	end
+	return r
+end
+
+-- A free start is due when none was taken yet, or the latest one is a full hour old. A clock behind the recorded
+-- start (another server's) waits; an instant that is not a whole number never grants one.
+function PaidPlay.freeDue(r: Record, now: number): boolean
+	if whole(now) == nil then
+		return false
+	end
+	return r.free == nil or now - r.free >= PaidPlay.FREE_SECONDS
+end
+
+function PaidPlay.status(r: Record, now: number): Status
+	local free = PaidPlay.freeDue(r, now)
+	return {
+		free = free,
+		nextFree = if free or r.free == nil then nil else r.free + PaidPlay.FREE_SECONDS,
+		plays = r.plays,
+		revives = r.revives,
+	}
+end
+
+-- The arrival's claim: a free start due first (recording now), else one held play, else "buy" (nothing changes).
+function PaidPlay.start(r: Record, now: number): (Start, Record)
+	if PaidPlay.freeDue(r, now) then
+		local n = copy(r)
+		n.free = now
+		return "free", n
+	end
+	if r.plays >= 1 then
+		local n = copy(r)
+		n.plays -= 1
+		return "credit", n
+	end
+	return "buy", r
+end
+
+local function add(r: Record, kind: Kind): Record
+	local n = copy(r)
+	if kind == "play" then
+		n.plays += 1
+	else
+		n.revives += 1
+	end
+	return n
+end
+
+-- A purchase granted once per receipt id: one credit of its kind, the id remembered (the oldest dropped past
+-- RECEIPTS_KEPT). An id already remembered, or no id, grants nothing: false.
+function PaidPlay.grant(r: Record, kind: Kind, receiptId: string): (Record, boolean)
+	if type(receiptId) ~= "string" or receiptId == "" or table.find(r.receipts, receiptId) then
+		return r, false
+	end
+	local n = add(r, kind)
+	table.insert(n.receipts, receiptId)
+	while #n.receipts > PaidPlay.RECEIPTS_KEPT do
+		table.remove(n.receipts, 1)
+	end
+	return n, true
+end
+
+-- A credit given back (a revive used that could not be applied): its own credit, outside the receipts.
+function PaidPlay.refund(r: Record, kind: Kind): Record
+	return add(r, kind)
+end
+
+-- One held revive used, once; with none held nothing changes.
+function PaidPlay.useRevive(r: Record): (boolean, Record)
+	if r.revives < 1 then
+		return false, r
+	end
+	local n = copy(r)
+	n.revives -= 1
+	return true, n
+end
+
+-- An arrival: a charged start, or a claim whose write failed (nil), plays; "buy" plays only with the portal's pass.
+function PaidPlay.arrive(start: Start?, passed: boolean): Verdict
+	if start == "buy" and not passed then
+		return "back"
+	end
+	return "play"
+end
+
+-- The test purchase screen's lines: what is bought, its price as the badge says it, and that nothing is charged.
+function PaidPlay.testLines(title: string, kind: Kind, prices: Prices): { string }
+	return {
+		`{title}: {PaidPlay.KIND_TEXT[kind]}`,
+		`{prices.struck} {prices.price} {prices.sale}`,
+		PaidPlay.TEST_NOTE,
+	}
+end
+
+-- The test screen's answer for a key or button name, nil for any other.
+function PaidPlay.testKey(name: string): ("confirm" | "cancel")?
+	if table.find(PaidPlay.TEST_KEYS.confirm, name) then
+		return "confirm"
+	end
+	if table.find(PaidPlay.TEST_KEYS.cancel, name) then
+		return "cancel"
+	end
+	return nil
+end
+
+return PaidPlay
