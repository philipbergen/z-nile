+--!strict
+-- PaidPlay's unit spec (f0201): the prototype's minimal one; the executor writes the full spec.
+local PaidPlay = require("@logic/PaidPlay")
+local t = require("@tests/lib/t")
+
+return t.spec("PaidPlay", function(it)
+	it("a first start is free", function()
+		local s = PaidPlay.start(PaidPlay.record(nil), 100)
+		t.expect(s).toBe("free")
+	end)
+end)
