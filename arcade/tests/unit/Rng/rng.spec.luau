--!strict
-- Rng unit specs: plain-data generator state, custom stream, and misuse refusals.
local Rng = require("@logic/Rng")
local t = require("@tests/lib/t")

return t.spec("Rng unit", function(it)
	it("creates a plain-data generator with deterministic draws", function()
		local a = Rng.new(42)
		local b = Rng.new(42)
		t.expect(type(a.state)).toBe("number")
		t.expect(type(a.multiplier)).toBe("number")
		t.expect(Rng.int(a, 100)).toBe(Rng.int(b, 100))
		t.expect(Rng.float(a)).toBe(Rng.float(b))
	end)

	it("draw shares the underlying generator state", function()
		local g = Rng.new(7)
		local d = Rng.draw(g)
		local first = d(10)
		local g2 = Rng.new(7)
		t.expect(first).toBe(Rng.int(g2, 10))
		t.expect(Rng.int(g, 10)).toBe(Rng.int(g2, 10))
	end)

	it("refuses invalid int bounds and invalid streams", function()
		local g = Rng.new(1)
		t.expect(function()
			Rng.int(g, 0)
		end).toThrow("Rng.int")
		t.expect(function()
			Rng.int(g, 2.5)
		end).toThrow("Rng.int")
		t.expect(function()
			Rng.new(1, { multiplier = 1, mix = 1, offset = 0 })
		end).toThrow("Rng.new")
	end)
end)
