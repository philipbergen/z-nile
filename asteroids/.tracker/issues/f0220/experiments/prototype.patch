index 00000000..9d2c3716
--- /dev/null
+++ b/asteroids/src/shared/Logic/Pilot/init.luau
@@ -0,0 +1,161 @@
+--!strict
+-- Pilot: one player's ship and its life on the field: on the field, away in hyperspace, or lost and waiting to
+-- come back; its protection, its shots, its lives and its score. The rules that are the same for every ship
+-- live here, so a run with one ship (Classic) or two steps each pilot through the same functions. A pilot is
+-- any table with these fields: a run that is itself a pilot passes itself.
+local Field = require("./Field")
+local Ship = require("./Ship")
+
+export type State = "alive" | "hyperspace" | "dead"
+export type Cause = "rock" | "saucer" | "saucershot" | "hyperspace"
+export type Shot = { x: number, y: number, vx: number, vy: number, life: number }
+export type Controls = { turn: number, thrust: boolean, fire: boolean, hyperspace: boolean }
+export type Config = {
+	field: Field.Field,
+	ship: Ship.Config,
+	lives: number,
+	extraLifeEvery: number,
+	shotLimit: number,
+	shotSpeed: number,
+	shotLife: number,
+	hyperspaceTicks: number,
+	hyperspaceOdds: number,
+	respawnTicks: number,
+	protectTicks: number,
+}
+export type Pilot = {
+	ship: Ship.Ship,
+	shipState: State,
+	timer: number, -- ticks left away in hyperspace, or before a lost ship may come back
+	protect: number, -- protected ticks left
+	shots: { Shot },
+	lives: number,
+	score: number,
+	nextExtra: number, -- the score that earns the next life
+}
+export type Event = { kind: string, lives: number?, cause: Cause?, x: number?, y: number? }
+export type Draw = (n: number) -> number -- a whole number in 1..n
+
+local Pilot = {}
+
+-- a pilot at (x, y), on the field at rest, with the run's lives and no score
+function Pilot.new(c: Config, x: number, y: number): Pilot
+	return {
+		ship = Ship.new(c.ship, x, y),
+		shipState = "alive",
+		timer = 0,
+		protect = 0,
+		shots = {},
+		lives = c.lives,
+		score = 0,
+		nextExtra = c.extraLifeEvery,
+	}
+end
+
+-- What an input asks for: a turn only of exactly 1 or -1, the rest only when exactly true. Anything else,
+-- or no table at all, asks for nothing.
+function Pilot.controls(input: any): Controls
+	if type(input) ~= "table" then
+		return { turn = 0, thrust = false, fire = false, hyperspace = false }
+	end
+	local turn = if input.turn == 1 then 1 elseif input.turn == -1 then -1 else 0
+	return {
+		turn = turn,
+		thrust = input.thrust == true,
+		fire = input.fire == true,
+		hyperspace = input.hyperspace == true,
+	}
+end
+
+-- on the field and not protected: what rocks, saucers and their shots can hit
+function Pilot.exposed(p: Pilot): boolean
+	return p.shipState == "alive" and p.protect == 0
+end
+
+-- Points won, and a life each time the score reaches another extraLifeEvery (after the event of the hit).
+function Pilot.award(p: Pilot, c: Config, points: number, emit: (Event) -> ())
+	p.score += points
+	while c.extraLifeEvery > 0 and p.score >= p.nextExtra do
+		p.lives += 1
+		p.nextExtra += c.extraLifeEvery
+		emit({ kind = "ExtraLife", lives = p.lives })
+	end
+end
+
+-- The ship is lost where it is: a life, and it waits at the field's centre, unseen, for its respawn. Its
+-- shots fly on. True when that was its last life (the run decides what that ends).
+function Pilot.lose(p: Pilot, c: Config, cause: Cause, emit: (Event) -> ()): boolean
+	p.lives -= 1
+	emit({ kind = "ShipDestroyed", cause = cause, lives = p.lives, x = p.ship.x, y = p.ship.y })
+	p.ship = Ship.new(c.ship, c.field.width / 2, c.field.height / 2)
+	p.shipState = "dead"
+	p.timer = c.respawnTicks
+	p.protect = 0
+	return p.lives <= 0
+end
+
+-- One tick of the ship's clocks, first in the tick. Protection runs down while the ship is not lost (on the
+-- field or away). Away, it comes back when its time is up, unless draw(hyperspaceOdds) is 1, which loses it
+-- there, protected or not. Lost, it waits out its time, then comes back at the centre, protected, on the
+-- first tick clear() says the centre is clear. True when the ship was lost on its last life.
+function Pilot.clock(p: Pilot, c: Config, draw: Draw, clear: () -> boolean, emit: (Event) -> ()): boolean
+	if p.shipState ~= "dead" and p.protect > 0 then
+		p.protect -= 1
+	end
+	if p.shipState == "hyperspace" then
+		p.timer -= 1
+		if p.timer <= 0 then
+			p.timer = 0
+			if draw(c.hyperspaceOdds) == 1 then
+				return Pilot.lose(p, c, "hyperspace", emit)
+			end
+			p.shipState = "alive"
+			emit({ kind = "HyperspaceEnd" })
+		end
+	elseif p.shipState == "dead" then
+		if p.timer > 0 then
+			p.timer -= 1
+		end
+		if p.timer == 0 and clear() then
+			p.ship = Ship.new(c.ship, c.field.width / 2, c.field.height / 2)
+			p.shipState = "alive"
+			p.protect = c.protectTicks
+			emit({ kind = "Respawn", lives = p.lives })
+		end
+	end
+	return false
+end
+
+-- One tick of the player's controls, only while the ship is on the field: a hyperspace jump (to a drawn spot,
+-- x then y, at rest, its heading kept) and nothing else, or the flight, then a fire with fewer than shotLimit
+-- shots out (from the nose, at shotSpeed plus the ship's own velocity).
+function Pilot.control(p: Pilot, c: Config, controls: Controls, draw: Draw, emit: (Event) -> ())
+	if p.shipState ~= "alive" then
+		return
+	end
+	local f = c.field
+	if controls.hyperspace then
+		local x = draw(f.width) - 1
+		local y = draw(f.height) - 1
+		p.ship.x, p.ship.y, p.ship.vx, p.ship.vy = x, y, 0, 0
+		p.shipState = "hyperspace"
+		p.timer = c.hyperspaceTicks
+		emit({ kind = "Hyperspace", x = x, y = y })
+		return
+	end
+	Ship.fly(p.ship, c.ship, f, controls.turn, controls.thrust)
+	if controls.fire and #p.shots < c.shotLimit then
+		local x, y = Ship.nose(p.ship, c.ship, f)
+		local ux, uy = Field.unit(p.ship.heading)
+		table.insert(p.shots, {
+			x = x,
+			y = y,
+			vx = ux * c.shotSpeed + p.ship.vx,
+			vy = uy * c.shotSpeed + p.ship.vy,
+			life = c.shotLife,
+		})
+		emit({ kind = "Fire" })
+	end
+end
+
+return Pilot
diff --git a/asteroids/src/shared/Logic/Rocks/init.luau b/asteroids/src/shared/Logic/Rocks/init.luau
new file mode 100644
index 00000000..a6bc53f2
--- /dev/null
+++ b/asteroids/src/shared/Logic/Rocks/init.luau
@@ -0,0 +1,64 @@
+--!strict
+-- Rocks: the three sizes, their points and speeds, and how a hit one splits. A rock drifts in a straight
+-- line and wraps; a large one splits into 2 medium, a medium into 2 small, and a small one is destroyed.
+local Field = require("./Field")
+
+export type SizeName = "large" | "medium" | "small"
+export type Size = {
+	radius: number,
+	points: number,
+	speedMin: number,
+	speedMax: number,
+	splitsInto: SizeName?,
+	pieces: number,
+}
+export type Rock = { id: number, size: SizeName, x: number, y: number, vx: number, vy: number }
+export type Draw = (n: number) -> number -- a whole number in 1..n
+
+local Rocks = {}
+
+Rocks.SIZES = table.freeze({
+	large = table.freeze(
+		{ radius = 40, points = 20, speedMin = 0.75, speedMax = 1.5, splitsInto = "medium", pieces = 2 } :: Size
+	),
+	medium = table.freeze(
+		{ radius = 20, points = 50, speedMin = 1, speedMax = 2.25, splitsInto = "small", pieces = 2 } :: Size
+	),
+	small = table.freeze(
+		{ radius = 10, points = 100, speedMin = 1.25, speedMax = 3, splitsInto = nil, pieces = 0 } :: Size
+	),
+})
+Rocks.SPEED_STEPS = 8
+
+-- the speed of a size's step (1..SPEED_STEPS), from its slowest to its fastest
+function Rocks.speed(size: SizeName, step: number): number
+	local s = Rocks.SIZES[size]
+	return s.speedMin + (s.speedMax - s.speedMin) * (step - 1) / (Rocks.SPEED_STEPS - 1)
+end
+
+-- a rock at (x, y) with a drawn heading, then a drawn speed step
+function Rocks.launch(id: number, size: SizeName, x: number, y: number, draw: Draw): Rock
+	local heading = draw(Field.HEADINGS) - 1
+	local speed = Rocks.speed(size, draw(Rocks.SPEED_STEPS))
+	local ux, uy = Field.unit(heading)
+	return { id = id, size = size, x = x, y = y, vx = ux * speed, vy = uy * speed }
+end
+
+-- the pieces a hit rock leaves, at its centre, numbered from firstId
+function Rocks.split(r: Rock, firstId: number, draw: Draw): { Rock }
+	local s = Rocks.SIZES[r.size]
+	local out = {}
+	local into = s.splitsInto
+	if into then
+		for i = 1, s.pieces do
+			table.insert(out, Rocks.launch(firstId + i - 1, into, r.x, r.y, draw))
+		end
+	end
+	return out
+end
+
+function Rocks.move(r: Rock, f: Field.Field)
+	r.x, r.y = Field.wrap(f, r.x + r.vx, r.y + r.vy)
+end
+
+return Rocks
diff --git a/asteroids/src/shared/Logic/Saucers/init.luau b/asteroids/src/shared/Logic/Saucers/init.luau
new file mode 100644
index 00000000..3fad26da
--- /dev/null
+++ b/asteroids/src/shared/Logic/Saucers/init.luau
@@ -0,0 +1,131 @@
+--!strict
+-- Saucers: the large saucer (200), which fires at random, and the small one (1,000), which aims at the ship,
+-- more closely as the score rises, and comes more often in later waves. A saucer crosses the field edge to
+-- edge, wrapping only up and down, and changes its course now and then.
+local Field = require("./Field")
+
+export type Kind = "large" | "small"
+export type KindConfig = { radius: number, points: number, speed: number, fireTicks: number, aimed: boolean }
+export type Config = {
+	large: KindConfig,
+	small: KindConfig,
+	firstWait: number, -- ticks without a saucer before one appears, in wave 1
+	waitStep: number, -- how much shorter the wait is each later wave
+	minWait: number,
+	smallEighths: { number }, -- by wave (the last entry for every wave after): the small saucer's share, in eighths
+	turnTicks: number, -- ticks between course changes
+	shotSpeed: number,
+	shotLife: number,
+	spread: { { score: number, spread: number } }, -- the small saucer's aim error, in headings, from a score up
+}
+export type Saucer = {
+	kind: Kind,
+	x: number,
+	y: number,
+	vx: number,
+	vy: number,
+	travelled: number,
+	fireElapsed: number,
+	turnElapsed: number,
+}
+export type Draw = (n: number) -> number -- a whole number in 1..n
+
+local Saucers = {}
+
+Saucers.CLASSIC = table.freeze({
+	large = table.freeze(
+		{ radius = 20, points = 200, speed = 2, fireTicks = 60, aimed = false } :: KindConfig
+	),
+	small = table.freeze(
+		{ radius = 10, points = 1000, speed = 3, fireTicks = 40, aimed = true } :: KindConfig
+	),
+	firstWait = 900,
+	waitStep = 120,
+	minWait = 360,
+	smallEighths = table.freeze({ 1, 2, 3, 4, 5, 6, 7 }),
+	turnTicks = 60,
+	shotSpeed = 6,
+	shotLife = 60,
+	spread = table.freeze({
+		table.freeze({ score = 0, spread = 16 }),
+		table.freeze({ score = 10000, spread = 8 }),
+		table.freeze({ score = 20000, spread = 4 }),
+		table.freeze({ score = 40000, spread = 0 }),
+	}),
+} :: Config)
+
+-- the ticks without a saucer before the next one appears, in this wave
+function Saucers.wait(c: Config, wave: number): number
+	return math.max(c.minWait, c.firstWait - c.waitStep * (wave - 1))
+end
+
+-- the small saucer's share of appearances in this wave, in eighths
+function Saucers.smallShare(c: Config, wave: number): number
+	return c.smallEighths[math.min(wave, #c.smallEighths)]
+end
+
+-- the small saucer's aim error at this score: the last row whose score the score has reached
+function Saucers.spread(c: Config, score: number): number
+	local s = c.spread[1].spread
+	for _, row in c.spread do
+		if score >= row.score then
+			s = row.spread
+		end
+	end
+	return s
+end
+
+-- A new saucer: its kind (small when draw(8) is at most the small share), its side (draw(2): 1 from the left
+-- edge heading right, 2 from the right heading left), then its height (draw(height) - 1). Both sides start on
+-- the x = 0 edge, which is also the field's right edge.
+function Saucers.appear(c: Config, f: Field.Field, wave: number, draw: Draw): Saucer
+	local kind: Kind = if draw(8) <= Saucers.smallShare(c, wave) then "small" else "large"
+	local dir = if draw(2) == 1 then 1 else -1
+	local y = draw(f.height) - 1
+	return {
+		kind = kind,
+		x = 0,
+		y = y,
+		vx = dir * c[kind].speed,
+		vy = 0,
+		travelled = 0,
+		fireElapsed = 0,
+		turnElapsed = 0,
+	}
+end
+
+-- One tick: a course change when due (draw(3): down, level or up at 45 degrees), then the move. True once it
+-- has crossed the whole width, when it leaves.
+function Saucers.move(s: Saucer, c: Config, f: Field.Field, draw: Draw): boolean
+	local speed = c[s.kind].speed
+	s.turnElapsed += 1
+	if s.turnElapsed >= c.turnTicks then
+		s.turnElapsed = 0
+		s.vy = (draw(3) - 2) * speed
+	end
+	s.x, s.y = Field.wrap(f, s.x + s.vx, s.y + s.vy)
+	s.travelled += math.abs(s.vx)
+	return s.travelled >= f.width
+end
+
+-- The heading of its next shot: a large saucer's is drawn (draw(256) - 1); a small one's points at the target
+-- across the wrap, off by a drawn error of up to the spread either way (draw(2 * spread + 1) - 1 - spread).
+function Saucers.aim(
+	s: Saucer,
+	c: Config,
+	f: Field.Field,
+	score: number,
+	tx: number,
+	ty: number,
+	draw: Draw
+): number
+	if not c[s.kind].aimed then
+		return draw(Field.HEADINGS) - 1
+	end
+	local dx, dy = Field.delta(f, s.x, s.y, tx, ty)
+	local spread = Saucers.spread(c, score)
+	local err = draw(2 * spread + 1) - 1 - spread
+	return (Field.heading(dx, dy) + err) % Field.HEADINGS
+end
+
+return Saucers
diff --git a/asteroids/src/shared/Logic/Ship/init.luau b/asteroids/src/shared/Logic/Ship/init.luau
new file mode 100644
index 00000000..b9cfd180
--- /dev/null
+++ b/asteroids/src/shared/Logic/Ship/init.luau
@@ -0,0 +1,57 @@
+--!strict
+-- Ship: one ship's flight on the field. It turns at a fixed rate and thrusts with inertia and slight drag,
+-- up to a top speed.
+local Field = require("./Field")
+
+export type Config = {
+	radius: number,
+	turnRate: number, -- headings a tick
+	thrust: number, -- units a tick, added each thrusting tick
+	drag: number, -- the share of the velocity lost each tick
+	maxSpeed: number, -- units a tick
+	startHeading: number,
+}
+export type Ship = { x: number, y: number, vx: number, vy: number, heading: number }
+
+local Ship = {}
+
+Ship.CLASSIC = table.freeze({
+	radius = 12,
+	turnRate = 3,
+	thrust = 0.1,
+	drag = 0.01,
+	maxSpeed = 6,
+	startHeading = 64,
+} :: Config)
+
+-- at rest at (x, y), pointing along the start heading
+function Ship.new(c: Config, x: number, y: number): Ship
+	return { x = x, y = y, vx = 0, vy = 0, heading = c.startHeading }
+end
+
+-- One tick: turn (1 to the left, -1 to the right), then thrust along the new heading, then drag, then the
+-- top speed, then move and wrap.
+function Ship.fly(s: Ship, c: Config, f: Field.Field, turn: number, thrust: boolean)
+	s.heading = (s.heading + turn * c.turnRate) % Field.HEADINGS
+	if thrust then
+		local ux, uy = Field.unit(s.heading)
+		s.vx += ux * c.thrust
+		s.vy += uy * c.thrust
+	end
+	s.vx *= 1 - c.drag
+	s.vy *= 1 - c.drag
+	local speed = math.sqrt(s.vx * s.vx + s.vy * s.vy)
+	if speed > c.maxSpeed then
+		s.vx = s.vx * c.maxSpeed / speed
+		s.vy = s.vy * c.maxSpeed / speed
+	end
+	s.x, s.y = Field.wrap(f, s.x + s.vx, s.y + s.vy)
+end
+
+-- the tip of the ship, where its shots start
+function Ship.nose(s: Ship, c: Config, f: Field.Field): (number, number)
+	local ux, uy = Field.unit(s.heading)
+	return Field.wrap(f, s.x + ux * c.radius, s.y + uy * c.radius)
+end
+
+return Ship
