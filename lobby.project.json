{
  "name": "pickman-lobby",
  "tree": {
    "$className": "DataModel",
    "Players": {
      "$properties": { "CharacterAutoLoads": false }
    },
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "Remotes": {
        "$className": "Folder",
        "StartGame": { "$className": "RemoteEvent" },
        "Status": { "$className": "RemoteEvent" }
      }
    },
    "ServerScriptService": {
      "$attributes": { "GamePlaceId": 0 },
      "Lobby": { "$path": "src/lobby/server" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Lobby": { "$path": "src/lobby/client" }
      }
    }
  }
}
