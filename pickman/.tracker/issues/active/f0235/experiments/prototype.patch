+-- f0235: while the drawn eye is above the wall tops, each power pellet still in the maze shows a beacon, a pillar of
+-- the pellets' light from the pellet up past the walls and the ghosts, so the player can plan a route to it. A beacon
+-- within `clear` tiles of the eye is not shown, so a hop down its corridor never flies through it.
+View.BEACON = table.freeze({ width = 3, top = 20, transparency = 0.3, clear = 1.5 })
+
+-- Where a pellet's beacon stands: on its tile's centre, from the pellet's centre (View.PELLET.height) up to
+-- View.BEACON.top, View.BEACON.width wide.
+function View.beacon(slot: Pellets.Slot): BeaconPart
+	local x, z = View.world(slot.x, slot.y)
+	local bottom, top = View.PELLET.height, View.BEACON.top
+	return { x = x, y = (bottom + top) / 2, z = z, width = View.BEACON.width, height = top - bottom }
+end
+
+-- Whether the eye drawn at height `eye` (world studs) is above the wall tops: a hop's middle (Hop.airborne's
+-- window, as the camera shows it), a long hop's, or any other raised eye (f0234's wait at a jump's top). False for
+-- no eye yet, or one that is not a finite number.
+function View.elevated(eye: number?): boolean
+	if type(eye) ~= "number" or eye ~= eye or math.abs(eye) == math.huge then
+		return false
+	end
+	return eye > SCALE.wallHeight
+end
+
+-- Which beacons show, keyed by slot index over every power slot of `slots`: a power pellet still present
+-- (`present`, Pellets.decode's list) while the eye is `elevated`, unless the eye's place `pose` (tile coordinates)
+-- is strictly within View.BEACON.clear tiles of it. A nil pose is near nothing. Other slots have no key.
+function View.beacons(
+	slots: { Pellets.Slot },
+	present: { boolean },
+	elevated: boolean,
+	pose: Pose?
+): { [number]: boolean }
+	local out: { [number]: boolean } = {}
+	local clear = View.BEACON.clear
+	for i, slot in slots do
+		if slot.kind == "power" then
+			local near = pose ~= nil and (pose.x - slot.x) ^ 2 + (pose.y - slot.y) ^ 2 < clear * clear
+			out[i] = elevated and present[i] == true and not near
+		end
+	end
+	return out
+end
+
 function View.action(keyName: string): Action?
 	return KEYS[keyName]
 end
