+
+	-- c0164 (R0056 code reviews 002 F2 and 003 F2): pins what Main hands these two calls, beside
+	-- tests/place/main-walls.spec.luau, which pins where they sit (decided with the user, 2026-11-01: "Keep both").
+	-- The rule: on every frame, in every phase, Main hands MazeView.edible and DangerHud.wallState the colour state that
+	-- frame's play gives (View.edible of it) and its overlay.flash, from the play alone, whatever else the frame
+	-- carries. So one script of play states, in an order the game produces (a ready before each life, lives only going
+	-- down, every PlayFrame field set, every pellet eaten on the level-clear frames), runs twice: on bare frames, and on
+	-- busy ones that also carry holes and marks, a ghost, shots, a shot, a hop, a pick and a boon, with the shot, the
+	-- hop, the pick, the boon, the ghost and the player changing from frame to frame (the holes and marks stay put)
+	-- (design reviews 001 F1 to 005 F1).
+	it(
+		"Main turns the walls and the radar green while the ghosts are edible, and blue again after, every frame",
+		function()
+			type Step = {
+				phase: any,
+				timer: number,
+				frightened: number,
+				lives: number,
+				level: number,
+				flash: boolean,
+			}
+			local function step(
+				phase: string,
+				timer: number,
+				frightened: number,
+				lives: number,
+				level: number
+			): Step
+				local flash = phase == "levelclear" and (timer // Flow.FLASH_TICKS) % 2 == 1
+				return {
+					phase = phase,
+					timer = timer,
+					frightened = frightened,
+					lives = lives,
+					level = level,
+					flash = flash,
+				}
+			end
+			local LIT_BEAT = Flow.FLASH_TICKS
+			local plays: { Step } = {
+				step("ready", 30, 0, 3, 1),
+				step("playing", 0, 0, 3, 1),
+				step("playing", 0, 6, 3, 1), -- edible
+				step("playing", 0, 6, 3, 1), -- nothing changes
+				step("playing", 0, 0, 3, 1), -- blue again
+				step("playing", 0, 0, 3, 1),
+				step("playing", 0, 1, 3, 1), -- the lowest edible tick: a cutoff above 0 fails it
+				step("playing", 0, 6, 3, 1),
+				step("levelclear", LIT_BEAT, 0, 3, 1), -- the last pellet eaten under power: flash lit, power zeroed
+				step("levelclear", 0, 0, 3, 1), -- the flash's dark beat
+				step("ready", 30, 0, 3, 2),
+				step("playing", 0, 6, 3, 2),
+				step("dying", 10, 0, 2, 2), -- caught under power once it ran out: Game.died zeroes the power
+				step("ready", 30, 0, 2, 2),
+				step("playing", 0, 1, 2, 2),
+				step("playing", 0, 0, 2, 2),
+				step("dying", 10, 0, 1, 2),
+				step("ready", 30, 0, 1, 2),
+				step("playing", 0, 6, 1, 2),
+				step("dying", 10, 0, 0, 2), -- the last life
+				step("gameover", 0, 0, 0, 2),
+			}
+			local function bare(k: number, st: Step): Session.Frame
+				local f = frame({}, {})
+				f.tick = k
+				f.play.phase, f.play.timer, f.play.frightened = st.phase, st.timer, st.frightened
+				f.play.lives, f.play.level, f.play.score = st.lives, st.level, k * 10
+				if st.phase == "levelclear" then
+					f.pellets = string.rep("A", #f.pellets) -- a level clears when the last pellet is eaten (review 005 F1)
+				end
+				return f
 			end
+			local HEADINGS: { Maze.Heading } = { "N", "E", "S", "W" }
+			local function busy(k: number, st: Step): Session.Frame
+				local f = bare(k, st)
+				f.walls = { opened = { at(2, 2) }, marked = { at(7, 2), at(25, 6) } }
+				f.tick = 1000 + 7 * k -- odd and even ticks
+				-- the player moves, turns and jumps (review 005 F1: a Main that froze the frame mid-jump passed)
+				local jumping = k % 2 == 0
+				f.player = {
+					x = 1 + k % 5,
+					y = 2,
+					heading = HEADINGS[k % 4 + 1],
+					moving = not jumping,
+					jumpTick = if jumping then f.tick - 1 else -1,
+				}
+				f.shots = k % 3
+				f.shot = { tick = f.tick - 1, heading = HEADINGS[k % 4 + 1], from = at(1, 1) }
+				f.hopped, f.hopTicks = f.tick - 2, Hop.LONG_TICKS
+				f.pick = { wall = at(7, 2), started = f.tick - 3, ticks = 40, fast = k % 2 == 0 }
+				f.boon = { tick = f.tick - 4, kind = if k % 2 == 0 then "jumps" else "pill" }
+				local look = if st.frightened > 0 then "frightened" else "normal"
+				f.ghosts = {
+					{
+						name = "blinky",
+						x = 5 + k % 3,
+						y = 5,
+						heading = "N",
+						look = look,
+						flash = false,
+						jumpTick = -1,
+					},
+				} :: any
+				return f
+			end
+			-- the busy frames carry every field the bare ones leave out (a named check, so the second pass is not a copy)
+			local b, p = busy(1, plays[1]) :: any, bare(1, plays[1]) :: any
+			for _, key in { "ghosts", "shot", "hopped", "pick", "boon" } do
+				t.expect(b[key] ~= nil and p[key] == nil).toBe(true)
+			end
+			t.expect(#b.walls.opened > #p.walls.opened).toBe(true)
+			for _, make in { bare, busy } do
+				local push, calls = mainWorld()
+				for k, st in plays do
+					t.expect((pcall(push, make(k, st)))).toBe(true)
+					local walls = calls["MazeView.edible"] or {}
+					local radar = calls["DangerHud.wallState"] or {}
+					t.expect(#walls).toBe(k) -- once a frame, not only when something changes
+					t.expect(#radar).toBe(k)
+					local w, r = walls[k], radar[k]
+					-- the model MazeView.build gave: the one Main also handed PelletView.build (design review 001 F3)
+					local builds = calls["PelletView.build"] or {}
+					t.expect(w[1] ~= nil and w[1] == (builds[#builds] or {})[2]).toBe(true)
+					t.expect(w[2]).toBe(st.frightened > 0)
+					t.expect(w.n).toBe(2)
+					t.expect(r[1]).toBe(st.flash)
+					t.expect(r[2]).toBe(st.frightened > 0)
+					t.expect(r.n).toBe(2)
+				end
+			end
 		end
 	)
 end)
