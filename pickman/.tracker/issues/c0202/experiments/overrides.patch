-local function enumProxy(): any
-	return setmetatable({}, {
-		__index = function(self: any, group: string): any
-			local g = setmetatable({}, {
-				__index = function(gs: any, item: string): any
-					local v = `{group}.{item}`
-					rawset(gs, item, v)
-					return v
-				end,
-			})
-			rawset(self, group, g)
-			return g
-		end,
