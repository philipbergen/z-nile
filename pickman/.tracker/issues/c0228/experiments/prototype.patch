+-- A key that changes exactly when the runs do (c0228): each run's bounds and whether it is marked, in order. Two
+-- calls of View.walls on equal mazes and marks give equal keys, so MazeView can tell walls it has drawn already.
+function View.runsKey(rects: { Rect }): string
+	local parts: { string } = {}
+	for _, r in rects do
+		table.insert(parts, `{r.x0},{r.y0},{r.x1},{r.y1},{if r.marked == true then 1 else 0}`)
+	end
+	return table.concat(parts, ";")
+end
+
