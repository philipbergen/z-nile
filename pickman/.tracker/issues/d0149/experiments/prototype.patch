+-- The touch controls in the safe rectangle. Each circle's diameter is CIRCLE_SHARE of the rectangle's smaller side,
+-- whole pixels, between CIRCLE_MIN and CIRCLE_MAX. The look circle's right edge is one margin in from the
+-- rectangle's, its bottom one margin above the power bar (where the corner radar's own bottom rule puts it); the
+-- steer circle's left edge is one margin in, its bottom one margin above the lives row. FIRE and PICK are squares of
+-- BUTTON_SHARE of the diameter (at least MIN_TARGET), bottom-aligned with the look circle: FIRE one margin left of
+-- it, PICK one margin left of FIRE, so the row reads PICK, FIRE, look.
 function Touch.buttons(box: Box): Buttons
+	local m = box.margin
+	local d = math.clamp(
+		round(Touch.CIRCLE_SHARE * math.max(0, math.min(box.safeW, box.safeH))),
+		Touch.CIRCLE_MIN,
+		Touch.CIRCLE_MAX
+	)
+	local r = d / 2
+	local lookRight = box.safeX + box.safeW - m
+	local lookBottom = box.safeY + box.safeH - m - box.barHeight
+	local rowBottom = box.safeY + box.safeH - 2 * m - math.max(box.iconSize, box.barHeight)
+	local side = math.max(Touch.MIN_TARGET, round(Touch.BUTTON_SHARE * d))
+	local fire: Rect = { x = lookRight - d - m - side, y = rowBottom - side, w = side, h = side }
 	return {
-		snap = Touch.snapRect(box),
-		fire = Touch.fireRect(box),
-		hop = Touch.hopRect(box),
-		pick = Touch.pickRect(box),
+		steer = { x = box.safeX + m + r, y = rowBottom - r, r = r },
+		look = { x = lookRight - r, y = lookBottom - r, r = r },
+		fire = fire,
+		pick = { x = fire.x - m - side, y = fire.y, w = side, h = side },
 	}
 end
 
