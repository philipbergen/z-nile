@@ -13,6 +15,26 @@ local UNITS = 120 -- Movement.UNITS: sub-tile units per tile
 
 local LAST = Levels.COUNT + 1 -- one level past the table, which repeats its last row
 
+-- c0177: the same config without f0125's tuning (f0147's ramp kept): the baseline f0125's 10% is measured against
+local function untunedOf(c: Session.Config): Session.Config
+	local u = table.clone(c) :: any
+	u.ghostTuning = nil
+	return u
+end
+
+-- c0177: the same config without f0147's ramp: the classic tables (before f0147 a config has no ramp)
+local function classicOf(c: Session.Config): Session.Config
+	local u = table.clone(c) :: any
+	u.ramp = nil
+	return u
+end
+
+-- c0177: the levels a config's speeds change over: its ramp's (f0147), or the classic table's
+local function levelsOf(c: Session.Config): number
+	local ramp = (c :: any).ramp
+	return if ramp then ramp.top else Levels.COUNT
+end
+
 local function edge(c: Session.Config, level: number): number
 	local sp = Session.speeds(c, level)
 	return sp.player / sp.ghost
