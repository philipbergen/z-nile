diff --git a/pickman/src/client/Sticks.luau b/pickman/src/client/Sticks.luau
new file mode 100644
index 00000000..be791f9a
--- /dev/null
+++ b/pickman/src/client/Sticks.luau
@@ -0,0 +1,33 @@
+--!strict
+-- Client adapter (f0146): the first gamepad's left stick turns. Every frame it reads the stick and folds it through
+-- Pad.steer, which emits one turn intent a push, and sends that intent on the Intent remote. The right stick's
+-- look is the camera's (Camera reads it in its render step).
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local RunService = game:GetService("RunService")
+local UserInputService = game:GetService("UserInputService")
+
+local Pad = require("@game/ReplicatedStorage/Shared/Logic/Pad")
+
+local Sticks = {}
+
+function Sticks.start()
+	local intent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Intent") :: RemoteEvent
+	local pad = (Enum.UserInputType :: any)[Pad.GAMEPAD]
+	local steer = Pad.steerStart()
+	RunService.Heartbeat:Connect(function()
+		if not UserInputService:GetGamepadConnected(pad) then
+			return
+		end
+		for _, state in UserInputService:GetGamepadState(pad) do
+			if state.KeyCode == Enum.KeyCode.Thumbstick1 then
+				local turn
+				steer, turn = Pad.steer(steer, state.Position.X, state.Position.Y)
+				if turn then
+					intent:FireServer(turn)
+				end
+			end
+		end
+	end)
+end
+
+return Sticks
diff --git a/pickman/src/lobby/client/LobbyPad.luau b/pickman/src/lobby/client/LobbyPad.luau
