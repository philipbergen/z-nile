{
  "name": "pickman",
  "tree": {
    "$className": "DataModel",
    "Players": {
      "$properties": { "CharacterAutoLoads": false }
    },
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "Remotes": {
        "$className": "Folder",
        "Ready": { "$className": "RemoteEvent" },
        "Intent": { "$className": "RemoteEvent" },
        "Snapshot": { "$className": "RemoteEvent" },
        "PlayAgain": { "$className": "RemoteEvent" }
      }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    }
  }
}
