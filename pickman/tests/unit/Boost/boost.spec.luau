--!strict
local Boost = require("@logic/Boost")
local t = require("@tests/lib/t")

return t.spec("Boost", function(it)
	it("knows its intent, exactly", function()
		t.expect(Boost.isIntent("Boost")).toBe(true)
		t.expect(Boost.isIntent("boost")).toBe(false)
		t.expect(Boost.isIntent(nil)).toBe(false)
	end)

	it("runs TICKS steps from its start, then cools down COOLDOWN steps", function()
		t.expect(Boost.active(5, 5)).toBe(true)
		t.expect(Boost.active(5, 5 + Boost.TICKS - 1)).toBe(true)
		t.expect(Boost.active(5, 5 + Boost.TICKS)).toBe(false)
		t.expect(Boost.canStart(5, 5 + Boost.TICKS + Boost.COOLDOWN - 1)).toBe(false)
		t.expect(Boost.canStart(5, 5 + Boost.TICKS + Boost.COOLDOWN)).toBe(true)
		t.expect(Boost.canStart(nil, 0)).toBe(true)
	end)

	it("raises the speed by the factor, rounded, within the cap", function()
		t.expect(Boost.speed(21, true, 120)).toBe(32)
		t.expect(Boost.speed(21, false, 120)).toBe(21)
		t.expect(Boost.speed(100, true, 120)).toBe(120)
	end)

	it("reports ready, boosting and cooling", function()
		t.expect(Boost.status(nil, 0)).toBe("ready")
		t.expect(Boost.status(5, 5)).toBe("boosting")
		t.expect(Boost.status(5, 5 + Boost.TICKS)).toBe("cooling")
	end)

	it("pairs two taps inside the window once", function()
		local taps = Boost.taps()
		local fired
		taps, fired = Boost.tap(taps, 1)
		t.expect(fired).toBe(false)
		taps, fired = Boost.tap(taps, 1.2)
		t.expect(fired).toBe(true)
		taps, fired = Boost.tap(taps, 1.3)
		t.expect(fired).toBe(false)
	end)

	it("widens the view over a boost and not outside it", function()
		t.expect(Boost.fov(10, 20)).toBe(Boost.FOV)
		t.expect(Boost.fov(10, 5)).toBe(0)
		t.expect(Boost.fov(nil, 20)).toBe(0)
	end)
end)
