diff --git a/portal/scripts/lib/experience.luau b/portal/scripts/lib/experience.luau
new file mode 100644
index 000000000..fdbc22c5a
--- /dev/null
+++ b/portal/scripts/lib/experience.luau
@@ -0,0 +1,241 @@
+--!strict
+-- The experience's manifest, portal/experience.json (c0210): every place of the experience, the variable that holds its
+-- Beta place id, the build it publishes and the name of its version in the deploy's output; and every build: its Rojo
+-- project file, its runtime scripts' folder and the extra id attributes it is told. The one reader of the format.
+-- Pure: it takes the file's text and returns the manifest or the first problem, naming the rule.
+local Catalog = require("../../../arcade/src/server/Catalog")
+local Places = require("@arcade/Places")
+local serde = require("@lune/serde")
+
+export type Build = {
+	project: string, -- the Rojo project file, relative to the manifest's folder
+	runtime: string?, -- the folder of its runtime scripts, relative to the manifest's folder
+	attributes: { [string]: string }, -- an extra attribute -> the place whose id it holds
+}
+export type Place = {
+	name: string, -- one of Places.NAMES
+	env: { string }, -- the variables that may hold its Beta place id, the first one first
+	build: string, -- a key of builds
+	output: string, -- the name of its version in the deploy's output
+}
+export type Manifest = { places: { Place }, builds: { [string]: Build } }
+
+local Experience = {}
+Experience.FILE = "experience.json"
+Experience.START_VAR = "ROBLOX_BETA_PLACE_ID"
+Experience.PAID_PLAY = "PaidPlay"
+
+local PLACE_KEYS = { "name", "env", "build", "output" }
+local BUILD_KEYS = { "project", "runtime", "attributes" }
+local FIELDS = { "places", "builds", "name", "env", "build", "output", "project", "runtime", "attributes" }
+
+local function fail(rule: string): (Manifest?, string?)
+	return nil, `{Experience.FILE}: {rule}`
+end
+
+local function isArray(v: any): boolean
+	if type(v) ~= "table" then
+		return false
+	end
+	local n = 0
+	for _ in v do
+		n += 1
+	end
+	return n == #v
+end
+
+local function isObject(v: any): boolean
+	if type(v) ~= "table" then
+		return false
+	end
+	for k in v do
+		if type(k) ~= "string" then
+			return false
+		end
+	end
+	return true
+end
+
+local function unknownKey(t: { [string]: any }, allowed: { string }): string?
+	for k in t do
+		if not table.find(allowed, k) then
+			return k
+		end
+	end
+	return nil
+end
+
+-- how many times `"<field>":` appears in the text: the decoder keeps the last of a repeated key, so each field is
+-- counted in the text and compared with the objects that hold it
+local function occurrences(text: string, field: string): number
+	local n = 0
+	for _ in string.gmatch(text, `"{field}"%s*:`) do
+		n += 1
+	end
+	return n
+end
+
+-- every attribute the publish writes itself: each place's id and paid play's (f0201's Catalog)
+function Experience.reserved(): { string }
+	local out: { string } = {}
+	for _, name in Places.NAMES do
+		table.insert(out, Places.attribute(name :: Places.Name))
+	end
+	table.insert(out, Experience.PAID_PLAY)
+	for _, entry in Catalog do
+		table.insert(out, entry.play)
+		table.insert(out, entry.revive)
+	end
+	return out
+end
+
+function Experience.parse(text: string): (Manifest?, string?)
+	local ok, decoded = pcall(serde.decode, "json" :: "json", text)
+	if not ok or not isObject(decoded) then
+		return fail("not a JSON object")
+	end
+	local doc = decoded :: { [string]: any }
+	local extra = unknownKey(doc, { "places", "builds" })
+	if extra then
+		return fail(`unknown key {extra}`)
+	end
+	if not isArray(doc.places) or #doc.places == 0 then
+		return fail("places must be a list of places")
+	end
+	if not isObject(doc.builds) then
+		return fail("builds must be an object of builds")
+	end
+	local counted: { [string]: number } = { places = 1, builds = 1 }
+	local builds: { [string]: Build } = {}
+	local reserved = Experience.reserved()
+	for key, raw in doc.builds :: { [string]: any } do
+		if not string.match(key, "^[a-z][a-z0-9-]*$") or table.find(FIELDS, key) then
+			return fail(
+				`build {key}: a build's name is lowercase letters, digits and dashes, and not a field's name`
+			)
+		end
+		if not isObject(raw) then
+			return fail(`build {key} must be an object`)
+		end
+		local bad = unknownKey(raw, BUILD_KEYS)
+		if bad then
+			return fail(`build {key}: unknown key {bad}`)
+		end
+		local project = raw.project
+		if
+			type(project) ~= "string"
+			or not string.match(project, "%.project%.json$")
+			or string.sub(project, 1, 1) == "/"
+		then
+			return fail(`build {key}: project must be a relative path to a *.project.json`)
+		end
+		counted.project = (counted.project or 0) + 1
+		local runtime = raw.runtime
+		if runtime ~= nil then
+			if type(runtime) ~= "string" or runtime == "" or string.sub(runtime, 1, 1) == "/" then
+				return fail(`build {key}: runtime must be a relative folder`)
+			end
+			counted.runtime = (counted.runtime or 0) + 1
+		end
+		local attributes: { [string]: string } = {}
+		if raw.attributes ~= nil then
+			if not isObject(raw.attributes) then
+				return fail(`build {key}: attributes must be an object`)
+			end
+			counted.attributes = (counted.attributes or 0) + 1
+			for attribute, place in raw.attributes :: { [string]: any } do
+				if not string.match(attribute, "^[A-Z][A-Za-z0-9]*$") then
+					return fail(`build {key}: attribute {attribute} must be a capitalized name`)
+				end
+				if table.find(reserved, attribute) then
+					return fail(`build {key}: attribute {attribute} is one the publish writes itself`)
+				end
+				if type(place) ~= "string" or not table.find(Places.NAMES, place :: any) then
+					return fail(`build {key}: attribute {attribute} must name a place of Places.NAMES`)
+				end
+				attributes[attribute] = place
+			end
+		end
+		builds[key] = { project = project, runtime = runtime, attributes = attributes }
+	end
+	local places: { Place } = {}
+	local names: { [string]: boolean } = {}
+	local vars: { [string]: string } = {}
+	local outputs: { [string]: boolean } = {}
+	local used: { [string]: string } = {}
+	local starts = 0
+	for i, raw in doc.places :: { any } do
+		if not isObject(raw) then
+			return fail(`place {i} must be an object`)
+		end
+		local bad = unknownKey(raw, PLACE_KEYS)
+		if bad then
+			return fail(`place {i}: unknown key {bad}`)
+		end
+		local name = raw.name
+		if type(name) ~= "string" or not table.find(Places.NAMES, name :: any) then
+			return fail(`place {i}: name must be one of Places.NAMES`)
+		end
+		if names[name] then
+			return fail(`place {name} is listed twice`)
+		end
+		names[name] = true
+		if not isArray(raw.env) or #raw.env == 0 then
+			return fail(`place {name}: env must be a list of variables`)
+		end
+		local env: { string } = {}
+		for _, var in raw.env :: { any } do
+			if type(var) ~= "string" or not string.match(var, "^ROBLOX_BETA_[A-Z0-9_]*PLACE_ID$") then
+				return fail(`place {name}: env {tostring(var)} is not a ROBLOX_BETA_…PLACE_ID variable`)
+			end
+			if vars[var] then
+				return fail(`place {name}: env {var} is also place {vars[var]}'s`)
+			end
+			vars[var] = name
+			table.insert(env, var)
+		end
+		if table.find(env, Experience.START_VAR) then
+			if #env ~= 1 then
+				return fail(`place {name}: the start place reads {Experience.START_VAR} alone`)
+			end
+			starts += 1
+		end
+		local build = raw.build
+		if type(build) ~= "string" or builds[build] == nil then
+			return fail(`place {name}: build must name a build`)
+		end
+		if used[build] then
+			return fail(`place {name}: build {build} is also place {used[build]}'s`)
+		end
+		used[build] = name
+		local output = raw.output
+		if type(output) ~= "string" or not string.match(output, "^[a-z][a-z0-9_]*$") then
+			return fail(`place {name}: output must be lowercase letters, digits and underscores`)
+		end
+		if outputs[output] then
+			return fail(`place {name}: output {output} is another place's`)
+		end
+		outputs[output] = true
+		table.insert(places, { name = name, env = env, build = build, output = output })
+	end
+	for _, name in Places.NAMES do
+		if not names[name] then
+			return fail(`place {name} is missing: every place of Places.NAMES is listed`)
+		end
+	end
+	if starts ~= 1 then
+		return fail(`exactly one place reads {Experience.START_VAR}, the start place`)
+	end
+	counted.name = #places
+	counted.env = #places
+	counted.build = #places
+	counted.output = #places
+	for _, field in FIELDS do
+		if occurrences(text, field) ~= (counted[field] or 0) then
+			return fail(`a key {field} is repeated`)
+		end
+	end
+	return { places = places, builds = builds }, nil
+end
+
+return Experience
