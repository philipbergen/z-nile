diff --git a/portal/scripts/lib/beta.luau b/portal/scripts/lib/beta.luau
new file mode 100644
index 000000000..3b54a4269
--- /dev/null
+++ b/portal/scripts/lib/beta.luau
@@ -0,0 +1,201 @@
+--!strict
+-- What the Beta publish does, as pure data (c0064, c0210): which places of the experience get which build, with which
+-- attributes, in which order, and the copy of a Rojo project with those attributes written into it. The places come
+-- from the manifest (portal/experience.json, scripts/lib/experience) and the ids from the environment: a place whose
+-- variable is unset or empty is not published, and its id attribute is 0. scripts/deploy-beta, scripts/runtime-test
+-- and scripts/cicd act on the plan; this file decides it and is tested without Rojo or a network.
+local Catalog = require("../../../arcade/src/server/Catalog")
+local Experience = require("./experience")
+local OpenCloud = require("./opencloud")
+local Places = require("@arcade/Places")
+local serde = require("@lune/serde")
+
+export type Value = number | string
+export type Target = {
+	name: string, -- the place's name (Places.NAMES)
+	build: string, -- the build it publishes
+	project: string, -- the Rojo project file, relative to the manifest's folder
+	runtime: string?, -- the folder of its runtime scripts, relative to the manifest's folder
+	placeId: string, -- digits: where it is published
+	variable: string, -- the variable the id came from
+	attributes: { [string]: Value }, -- written on ServerScriptService in the copy that is built
+	output: string, -- the name of its version in the deploy's output
+}
+export type Plan = { targets: { Target }, skipped: { string } }
+
+local Beta = {}
+Beta.MAX_PLACE_ID = 2 ^ 53 - 1
+Beta.START_VAR = Experience.START_VAR
+-- the Beta experience sells nothing for real: every place is in paid play's test mode, with no product (f0169 owns the
+-- live values)
+Beta.PAID_PLAY_MODE = "test"
+
+local function placeId(value: string, name: string): number
+	local n = tonumber(value)
+	if not string.match(value, "^[1-9]%d*$") or n == nil or n > Beta.MAX_PLACE_ID then
+		error(`beta: {name} must be a place id: digits, 1 to 2^53-1`, 0)
+	end
+	return n
+end
+
+-- A place's id and the variable it came from, or nil when none of its variables is set. Every set variable must be a
+-- place id, and two set variables of one place must agree.
+local function idOf(env: { [string]: string? }, place: Experience.Place): (string?, string?)
+	local found: string?, from: string? = nil, nil
+	for _, var in place.env do
+		local value = env[var]
+		if value ~= nil and value ~= "" then
+			placeId(value, var)
+			if found == nil then
+				found, from = value, var
+			elseif found ~= value then
+				error(`beta: {from} and {var} are both set, to different ids (the {place.name} place)`, 0)
+			end
+		end
+	end
+	return found, from
+end
+
+-- The attributes every published place is told: each place's id (0: not published), paid play's test mode and every
+-- catalog product id (0: none).
+function Beta.attributes(ids: { [string]: number }): { [string]: Value }
+	local out: { [string]: Value } = {}
+	for _, name in Places.NAMES do
+		out[Places.attribute(name :: Places.Name)] = ids[name] or 0
+	end
+	out[Experience.PAID_PLAY] = Beta.PAID_PLAY_MODE
+	for _, entry in Catalog do
+		out[entry.play] = 0
+		out[entry.revive] = 0
+	end
+	return out
+end
+
+-- The publish plan from the environment and the manifest, or nil when publishing is not configured
+-- (OpenCloud.configFromEnv: the key, the universe and the start place's id). Raises, naming the variable and never the
+-- key, on an id that is not a place id, on two variables of one place that disagree, and on two places with one id.
+-- The games come first in the manifest's order, then the start place.
+function Beta.plan(env: { [string]: string? }, manifest: Experience.Manifest): Plan?
+	if OpenCloud.configFromEnv(env) == nil then
+		return nil
+	end
+	local ids: { [string]: number } = {}
+	local digits: { [string]: string } = {}
+	local from: { [string]: string } = {}
+	local owner: { [string]: string } = {}
+	local skipped: { string } = {}
+	for _, place in manifest.places do
+		local id, var = idOf(env, place)
+		if id == nil or var == nil then
+			table.insert(skipped, `the {place.name} place is not published: set {place.env[1]}`)
+		else
+			if owner[id] then
+				error(
+					`beta: {from[owner[id]]} and {var} name the same place ({owner[id]} and {place.name})`,
+					0
+				)
+			end
+			owner[id] = place.name
+			ids[place.name] = placeId(id, var)
+			digits[place.name] = id
+			from[place.name] = var
+		end
+	end
+	local shared = Beta.attributes(ids)
+	local games: { Target } = {}
+	local start: Target? = nil
+	for _, place in manifest.places do
+		local id = digits[place.name]
+		if id then
+			local build = manifest.builds[place.build]
+			local attributes = table.clone(shared)
+			for attribute, name in build.attributes do
+				attributes[attribute] = ids[name] or 0
+			end
+			local target: Target = {
+				name = place.name,
+				build = place.build,
+				project = build.project,
+				runtime = build.runtime,
+				placeId = id,
+				variable = from[place.name],
+				attributes = attributes,
+				output = place.output,
+			}
+			if from[place.name] == Beta.START_VAR then
+				start = target
+			else
+				table.insert(games, target)
+			end
+		end
+	end
+	assert(start, "unreachable: configFromEnv needs the start place's variable, and the manifest names it")
+	table.insert(games, start)
+	return { targets = games, skipped = skipped }
+end
+
+-- The target of one place (by its name), or nil when the plan does not publish it.
+function Beta.target(plan: Plan, name: string): Target?
+	for _, target in plan.targets do
+		if target.name == name then
+			return target
+		end
+	end
+	return nil
+end
+
+-- Lune's process.cwd ends in `/`. Joining that with another slash writes `//` into every copied `$path`.
+local function directory(dir: string): string
+	if #dir > 1 and string.sub(dir, -1) == "/" then
+		return string.sub(dir, 1, -2)
+	end
+	return dir
+end
+
+local function absolute(dir: string, path: string): string
+	if string.sub(path, 1, 1) == "/" then
+		return path
+	end
+	return `{directory(dir)}/{path}`
+end
+
+local function rewrite(node: any, dir: string)
+	for key, value in node do
+		if key == "$path" and type(value) == "string" then
+			node[key] = absolute(dir, value)
+		elseif key == "$path" and type(value) == "table" and type(value.optional) == "string" then
+			value.optional = absolute(dir, value.optional)
+		elseif type(value) == "table" and string.sub(tostring(key), 1, 1) ~= "$" then
+			rewrite(value, dir)
+		end
+	end
+end
+
+-- A copy of a Rojo project (its JSON text) that builds the same place from anywhere: every `$path` made
+-- absolute against `dir` (the project file's directory, absolute), and `attributes` set on ServerScriptService
+-- beside the ones it has. The text given is not changed.
+function Beta.project(text: string, dir: string, attributes: { [string]: Value }): string
+	local project: any = serde.decode("json" :: "json", text)
+	if type(project) ~= "table" or type(project.tree) ~= "table" then
+		error("beta: not a Rojo project (no tree)", 0)
+	end
+	rewrite(project.tree, dir)
+	if next(attributes) ~= nil then
+		local sss = project.tree.ServerScriptService
+		if sss == nil then
+			sss = {}
+			project.tree.ServerScriptService = sss
+		end
+		local attrs = sss["$attributes"]
+		if attrs == nil then
+			attrs = {}
+			sss["$attributes"] = attrs
+		end
+		for name, value in attributes do
+			attrs[name] = value
+		end
+	end
+	return serde.encode("json" :: "json", project, true)
+end
+
+return Beta
