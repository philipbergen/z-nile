diff --git a/portal/scripts/runtime-test.luau b/portal/scripts/runtime-test.luau
new file mode 100644
index 000000000..fc1e4c8aa
--- /dev/null
+++ b/portal/scripts/runtime-test.luau
@@ -0,0 +1,116 @@
+--!strict
+-- Runs a place's runtime scripts in a real Roblox server of a published version, through Open Cloud's Luau Execution
+-- API. A script passes when it returns "PASS"; anything else, or an error, fails.
+-- Usage: lune run scripts/runtime-test -- [--place <name>] <version> [script files...]
+-- The place is a name of experience.json (read from the current folder; Pickman when --place is not given), published
+-- to the id its variable holds (scripts/lib/beta, c0210); the default scripts are its build's runtime folder's
+-- *.luau. Not configured (no key or ids, or the place not published): says so and succeeds.
+local Beta = require("@scripts/lib/beta")
+local Experience = require("@scripts/lib/experience")
+local OpenCloud = require("@scripts/lib/opencloud")
+local fs = require("@lune/fs")
+local process = require("@lune/process")
+
+local USAGE = "usage: lune run scripts/runtime-test -- [--place <name>] <version> [script files...]"
+
+-- `lune run scripts/runtime-test -- 5` hands the `--` on as the first argument: skip it
+local args: { string } = {}
+for i, a in process.args do
+	if not (i == 1 and a == "--") then
+		table.insert(args, a)
+	end
+end
+
+local place = "Pickman"
+if args[1] == "--place" then
+	if args[2] == nil then
+		print(USAGE)
+		process.exit(2)
+	end
+	place = args[2]
+	table.remove(args, 1)
+	table.remove(args, 1)
+end
+local version = tonumber(args[1])
+if version == nil or version ~= math.floor(version) or version < 1 then
+	print(USAGE)
+	process.exit(2)
+end
+local okCfg, configured = pcall(OpenCloud.configFromEnv, process.env)
+if not okCfg then
+	print(tostring(configured))
+	process.exit(1)
+end
+if configured == nil then
+	print(
+		"::warning::runtime tests are not configured (ROBLOX_API_KEY, ROBLOX_BETA_UNIVERSE_ID, ROBLOX_BETA_PLACE_ID); skipped"
+	)
+	process.exit(0)
+end
+local root = process.cwd
+if #root > 1 and string.sub(root, -1) == "/" then
+	root = string.sub(root, 1, -2)
+end
+local manifestPath = `{root}/{Experience.FILE}`
+if not fs.isFile(manifestPath) then
+	print(`{Experience.FILE} is missing in {root}: run this from the portal's home`)
+	process.exit(1)
+end
+local manifest, manifestErr = Experience.parse(fs.readFile(manifestPath))
+if manifest == nil then
+	print(manifestErr)
+	process.exit(1)
+end
+local known = false
+for _, p in (manifest :: Experience.Manifest).places do
+	known = known or p.name == place
+end
+if not known then
+	print(`runtime-test: {place} is not a place of {Experience.FILE}`)
+	print(USAGE)
+	process.exit(2)
+end
+local okPlan, planned = pcall(Beta.plan, process.env, manifest :: Experience.Manifest)
+if not okPlan then
+	print(tostring(planned))
+	process.exit(1)
+end
+local target = Beta.target(planned :: Beta.Plan, place)
+if target == nil then
+	print(`::warning::runtime tests of the {place} place are not configured (its variable is unset); skipped`)
+	process.exit(0)
+end
+
+assert(version and target, "unreachable: the checks above exit")
+local cfg = configured :: OpenCloud.Config
+cfg.placeId = target.placeId
+local files: { string } = {}
+for i = 2, #args do
+	table.insert(files, args[i])
+end
+if #files == 0 then
+	local runtime = target.runtime
+	if runtime == nil then
+		print(`::warning::the {place} place has no runtime scripts; skipped`)
+		process.exit(0)
+	end
+	local dir = `{root}/{runtime}`
+	for _, name in fs.readDir(dir) do
+		if string.match(name, "%.luau$") and fs.isFile(`{dir}/{name}`) then
+			table.insert(files, `{runtime}/{name}`)
+		end
+	end
+	table.sort(files)
+end
+
+local scripts: { OpenCloud.Script } = {}
+for _, file in files do
+	local path = if string.sub(file, 1, 1) == "/" then file else `{root}/{file}`
+	table.insert(scripts, { name = file, source = fs.readFile(path) })
+end
+local suite = OpenCloud.runSuite(cfg, version, scripts)
+for _, line in suite.lines do
+	print(line)
+end
+print(`{suite.passed} passed, {suite.failed} failed, {#scripts} runtime scripts`)
+process.exit(if suite.failed == 0 then 0 else 1)
