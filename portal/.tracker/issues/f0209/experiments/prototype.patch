diff --git a/portal/tests/runtime/structure.luau b/portal/tests/runtime/structure.luau
new file mode 100644
index 000000000..bc0d15f70
--- /dev/null
+++ b/portal/tests/runtime/structure.luau
@@ -0,0 +1,34 @@
+--!strict
+-- Runs inside a real Roblox server of the published start place (Open Cloud Luau Execution, `runtime-test --place
+-- Portal`), not under Lune (f0209). Returns "PASS"; anything else, or an error, fails. It proves the start place runs
+-- the portal, not pickman's lobby or game, and that the publish told it where Pickman is.
+local game: any = (getfenv() :: any).game -- Roblox's global; the Lune type definitions don't declare it
+
+local sss = game:GetService("ServerScriptService")
+assert(
+	sss:FindFirstChild("Lobby") == nil,
+	"pickman's lobby (ServerScriptService.Lobby) is at the start place"
+)
+local server = sss:FindFirstChild("Server")
+assert(server, "ServerScriptService.Server is missing")
+for _, name in { "Main", "Cards", "Plays" } do
+	assert(server:FindFirstChild(name), "Server." .. name .. " is missing: this is not the portal")
+end
+local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
+assert(remotes, "ReplicatedStorage.Remotes is missing")
+for _, name in { "Cards", "Play" } do
+	assert(remotes:FindFirstChild(name), "Remotes." .. name .. " is missing")
+end
+assert(remotes:FindFirstChild("Snapshot") == nil, "pickman's game (Remotes.Snapshot) is at the start place")
+assert(game:GetService("ReplicatedStorage"):FindFirstChild("Arcade"), "ReplicatedStorage.Arcade is missing")
+assert(game:GetService("ServerStorage"):FindFirstChild("Arcade"), "ServerStorage.Arcade is missing")
+for _, attribute in { "PickmanPlaceId", "PortalPlaceId" } do
+	local id = sss:GetAttribute(attribute)
+	assert(
+		type(id) == "number" and id >= 1 and id == math.floor(id),
+		"ServerScriptService." .. attribute .. " is not set to a place id"
+	)
+end
+assert(type(sss:GetAttribute("PaidPlay")) == "string", "ServerScriptService.PaidPlay is not set")
+assert(game:GetService("Players").CharacterAutoLoads == false, "CharacterAutoLoads must be false")
+return "PASS"
