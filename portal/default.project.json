{
  "name": "portal",
  "tree": {
    "$className": "DataModel",
    "Players": {
      "$properties": { "CharacterAutoLoads": false }
    },
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "Arcade": { "$path": "../arcade/src/shared" },
      "Remotes": {
        "$className": "Folder",
        "Cards": { "$className": "RemoteEvent" },
        "Play": { "$className": "RemoteEvent" },
        "Boards": { "$className": "RemoteEvent" }
      }
    },
    "ServerStorage": {
      "Arcade": { "$path": "../arcade/src/server" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    }
  }
}
