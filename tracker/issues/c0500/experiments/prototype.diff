diff --git a/scripts/tracker/store.luau b/scripts/tracker/store.luau
index 42992ef..e698e0b 100644
--- a/scripts/tracker/store.luau
+++ b/scripts/tracker/store.luau
@@ -126,6 +126,22 @@ function store.nextNumber(kind: Kind): number
 	return (math.floor(max / 10) + 1) * 10
 end
 
+-- Next free number for `renumber`: one above the highest number of `kind` in the local tree and in
+-- `otherIds` (ids seen elsewhere, such as origin/main). Ids of the other kind are ignored.
+function store.nextAbove(kind: Kind, otherIds: { string }): number
+	local max = 0
+	for _, item in store.all(kind) do
+		max = math.max(max, tonumber(string.sub(item.id, 2)) :: number)
+	end
+	for _, id in otherIds do
+		local ok = if kind == "raft" then store.isRaftId(id) else store.isIssueId(id)
+		if ok then
+			max = math.max(max, tonumber(string.sub(id, 2)) :: number)
+		end
+	end
+	return max + 1
+end
+
 function store.formatId(prefix: string, n: number): string
 	return string.format("%s%04d", prefix, n)
 end
