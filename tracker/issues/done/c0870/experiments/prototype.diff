diff --git a/tracker/issues/c0870/acceptance/publish-guard.spec.luau b/tracker/issues/c0870/acceptance/publish-guard.spec.luau
new file mode 100644
index 0000000..ee3629d
--- /dev/null
+++ b/tracker/issues/c0870/acceptance/publish-guard.spec.luau
@@ -0,0 +1,44 @@
+--!strict
+-- c0870: every publish from the tracker CLI goes through `publishFresh`, the one helper that refuses a tree from
+-- before a compaction. `cmd.remap` is the only exception: it is the way out of that state. A command added later
+-- (R0250's ready and stop, say) that calls publish.commit directly fails here instead of publishing from a stale tree.
+local fs = require("@lune/fs")
+local t = require("@tests/lib/t")
+
+-- the top-level function (a line starting `function ` or `local function `) around each `publish.commit(` call
+local function callers(text: string): { string }
+	local out: { string } = {}
+	local current = "(top level)"
+	for line in string.gmatch(text .. "\n", "([^\n]*)\n") do
+		local name = string.match(line, "^function ([%w_%.:]+)%(")
+			or string.match(line, "^local function ([%w_]+)%(")
+		if name then
+			current = name
+		end
+		local code = string.gsub(line, "%-%-.*$", "") -- comments do not count
+		if string.find(code, "publish.commit(", 1, true) then
+			table.insert(out, current)
+		end
+	end
+	return out
+end
+
+return t.spec("c0870 every publish checks for a stale tree", function(it)
+	it("main.luau calls publish.commit only in publishFresh and cmd.remap", function()
+		local found = callers(fs.readFile("scripts/tracker/main.luau"))
+		t.expect(#found > 0).toBe(true)
+		local seenFresh = false
+		for _, name in found do
+			t.expect(name == "publishFresh" or name == "cmd.remap").toBe(true)
+			seenFresh = seenFresh or name == "publishFresh"
+		end
+		t.expect(seenFresh).toBe(true)
+	end)
+
+	it("the finder sees a call in any other function, and ignores comments", function()
+		local sample = "local function publishFresh(a)\n\treturn publish.commit(a)\nend\n"
+			.. "function cmd.ready(p)\n\tlocal r = publish.commit(p)\nend\n"
+			.. "function cmd.stop()\n\t-- publish.commit( is not called here\nend\n"
+		t.expect(callers(sample)).toEqual({ "publishFresh", "cmd.ready" })
+	end)
+end)
diff --git a/tracker/issues/c0870/acceptance/remap.spec.luau b/tracker/issues/c0870/acceptance/remap.spec.luau
new file mode 100644
index 0000000..3091dd2
--- /dev/null
+++ b/tracker/issues/c0870/acceptance/remap.spec.luau
@@ -0,0 +1,188 @@
+--!strict
+-- c0870: `tracker.sh remap` brings a branch that was in flight during a compaction onto the new ids: it applies
+-- origin/main's tracker/compaction.txt to the branch, numbers the branch's own unmapped items from origin's counter,
+-- and commits, so that merging origin/main afterwards is clean. Fixture under .cache/c0870-remap.
+local fixture = require("@tests/lib/fixture")
+local fs = require("@lune/fs")
+local ids = require("@scripts/tracker/ids")
+local process = require("@lune/process")
+local t = require("@tests/lib/t")
+
+type Result = { ok: boolean, code: number, stdout: string, stderr: string }
+
+local function trim(s: string): string
+	return (string.gsub(string.gsub(s, "^%s+", ""), "%s+$", ""))
+end
+local root = trim(process.exec("git", { "rev-parse", "--show-toplevel" }).stdout)
+local base = `{root}/.cache/c0870-remap`
+local seed, origin, main = `{base}/seed`, `{base}/origin.git`, `{base}/main`
+
+local function git(cwd: string, args: { string }): string
+	return fixture.git(cwd, args)
+end
+local function tr(cwd: string, args: { string }, env: { [string]: string }?): Result
+	return fixture.exec(cwd, "bash", { "scripts/tracker.sh", table.unpack(args) }, { env = env })
+end
+local function trOk(cwd: string, args: { string }, env: { [string]: string }?): string
+	local r = tr(cwd, args, env)
+	if not r.ok then
+		error(`tracker.sh {table.concat(args, " ")} failed ({r.code}): {r.stderr}{r.stdout}`, 2)
+	end
+	return trim(r.stdout)
+end
+local function has(text: string?, needle: string): boolean
+	return text ~= nil and string.find(text, needle, 1, true) ~= nil
+end
+local function write(path: string, text: string)
+	fs.writeDir(string.match(path, "^(.*)/[^/]+$") :: string)
+	fs.writeFile(path, text)
+end
+local function identity(dir: string)
+	git(dir, { "config", "user.name", "remap" })
+	git(dir, { "config", "user.email", "remap@example.invalid" })
+end
+-- a document long enough for git to see a rewritten copy as a rename
+local function doc(id: string, extra: string): string
+	local lines = {}
+	for i = 1, 30 do
+		table.insert(lines, `Body line {i} of the document.`)
+	end
+	return `---\nid: {id}\ntype: chore\ntitle: T\nslug: s-{string.lower(id)}\n{extra}design: ready\ncreated: 2026-01-01\n---\n\n# {id}: T\n\nSee c0010 and f0020.\nline a\nline b\nline c\n{table.concat(
+		lines,
+		"\n"
+	)}\n`
+end
+local function worktree(name: string): string
+	local wt = trOk(main, { "worktree", name })
+	identity(wt)
+	return wt
+end
+
+local branch = ""
+
+return t.spec("c0870 remap", function(it)
+	it("sets up an origin and a branch with its own edits and an item of its own", function()
+		if fs.isDir(base) then
+			fs.removeDir(base)
+		end
+		fs.writeDir(seed)
+		process.exec("git", { "init", "-q", "-b", "main", seed }) -- raw: init to a named path
+		identity(seed)
+		for _, p in { "scripts", ".claude", ".luaurc", ".gitignore" } do
+			process.exec("cp", { "-R", `{root}/{p}`, `{seed}/{p}` })
+		end
+		fs.writeDir(`{seed}/tracker`)
+		process.exec("cp", { "-R", `{root}/tracker/templates`, `{seed}/tracker/templates` })
+		write(`{seed}/tracker/next`, "issue 41 a-b-c\nraft 31 a-b-c\n")
+		write(`{seed}/tracker/issues/c0010/c0010.md`, doc("c0010", "raft: R0030\n"))
+		write(`{seed}/tracker/issues/f0020/f0020.md`, doc("f0020", "raft: R0030\n"))
+		write(`{seed}/tracker/rafts/R0030/R0030.md`, doc("R0030", "issues: [c0010, f0020]\n"))
+		write(`{seed}/tests/acceptance/c0010/a.spec.luau`, "return 1\n")
+		git(seed, { "add", "-A" })
+		git(seed, { "commit", "-q", "-m", "seed" })
+		process.exec("git", { "clone", "-q", "--bare", seed, origin }) -- raw: clone to a named path
+		process.exec("git", { "clone", "-q", origin, main }) -- raw: clone to a named path
+		identity(main)
+		branch = worktree("prep-y")
+		local c10 = `{branch}/tracker/issues/c0010/c0010.md`
+		fs.writeFile(c10, (string.gsub(fs.readFile(c10), "line b", "line B, edited on the branch (c0010)")))
+		fs.writeFile(
+			`{branch}/tracker/issues/f0020/f0020.md`,
+			fs.readFile(`{branch}/tracker/issues/f0020/f0020.md`) .. "Appended on the branch for f0020.\n"
+		)
+		t.expect(trOk(branch, { "new", "issue", "c", "mine" }, { PICKMAN_PUBLISH = "0" }))
+			.toBe("tracker/issues/c0041/c0041.md")
+		t.expect(trOk(branch, { "new", "issue", "c", "also" }, { PICKMAN_PUBLISH = "0" }))
+			.toBe("tracker/issues/c0042/c0042.md")
+		git(branch, { "add", "-A" })
+		git(branch, { "commit", "-q", "-m", "branch work" })
+		git(branch, { "push", "-q", "-u", "origin", "prep-y" })
+	end)
+
+	it("refuses while origin/main has no compaction map", function()
+		local head = git(branch, { "rev-parse", "HEAD" })
+		local r = tr(branch, { "remap" })
+		t.expect(r.ok).toBe(false)
+		t.expect(has(r.stderr, ids.MAP_FILE)).toBe(true)
+		t.expect(git(branch, { "rev-parse", "HEAD" })).toBe(head)
+	end)
+
+	it("a forced compaction lands on main", function()
+		local wt = worktree("compact-z")
+		local r = tr(wt, { "compact", "--force" })
+		if not r.ok then
+			error(r.stderr .. r.stdout)
+		end
+		t.expect(has(r.stdout .. r.stderr, "prep-y")).toBe(true)
+		git(wt, { "push", "-q", "origin", "HEAD:main" }) -- stands in for the merged pull request
+		local c = ids.parse(git(origin, { "show", "main:tracker/next" }) .. "\n") :: ids.Counters
+		t.expect(c.issue).toBe(3)
+	end)
+
+	it("a branch from before the compaction cannot allocate until it remaps", function()
+		local before = git(origin, { "rev-parse", "main" })
+		local r = tr(branch, { "new", "issue", "c", "stale" })
+		t.expect(r.ok).toBe(false)
+		t.expect(has(r.stderr, "remap")).toBe(true)
+		t.expect(git(origin, { "rev-parse", "main" })).toBe(before)
+		t.expect(git(branch, { "status", "--porcelain" })).toBe("")
+		-- nor publish a status stamp: old ids name other items on origin now
+		local st = tr(branch, { "status", "c0010", "preparing" })
+		t.expect(st.ok).toBe(false)
+		t.expect(has(st.stderr, "remap")).toBe(true)
+		t.expect(git(origin, { "rev-parse", "main" })).toBe(before)
+	end)
+
+	it("remap renames the branch's items, numbers its own from origin's counter and commits", function()
+		local head = git(branch, { "rev-parse", "HEAD" })
+		local out = trOk(branch, { "remap" })
+		-- the branch's own items in plan order (number, then prefix), one reservation past the last
+		t.expect(has(out, "c0041 -> c0003")).toBe(true)
+		t.expect(has(out, "c0042 -> c0004")).toBe(true)
+		-- the remap commit, then a merge of origin/main against the remapped merge base
+		t.expect(git(branch, { "rev-parse", "HEAD^1^" })).toBe(head)
+		t.expect(git(branch, { "log", "-1", "--format=%s", "HEAD^1" })).toBe("tracker: remap ids")
+		t.expect(git(branch, { "rev-parse", "HEAD^2" })).toBe(git(branch, { "rev-parse", "origin/main" }))
+		t.expect(git(branch, { "status", "--porcelain" })).toBe("")
+		t.expect(fs.isFile(`{branch}/tracker/issues/c0001/c0001.md`)).toBe(true)
+		t.expect(fs.isFile(`{branch}/tracker/issues/f0002/f0002.md`)).toBe(true)
+		t.expect(fs.isFile(`{branch}/tracker/issues/c0003/c0003.md`)).toBe(true)
+		t.expect(fs.isFile(`{branch}/tracker/issues/c0004/c0004.md`)).toBe(true)
+		t.expect(fs.isDir(`{branch}/tracker/issues/c0042`)).toBe(false)
+		t.expect(fs.isDir(`{branch}/tracker/issues/c0041`)).toBe(false)
+		t.expect(fs.isFile(`{branch}/tests/acceptance/c0001/a.spec.luau`)).toBe(true)
+		t.expect(has(fs.readFile(`{branch}/tracker/rafts/R0001/R0001.md`), "issues: [c0001, f0002]"))
+			.toBe(true)
+		-- the number is reserved on origin
+		local c = ids.parse(git(origin, { "show", "main:tracker/next" }) .. "\n") :: ids.Counters
+		t.expect(c.issue).toBe(5)
+	end)
+
+	it("the branch then holds origin/main, with the branch's edits kept", function()
+		local r = fixture.exec(branch, "git", { "merge-base", "--is-ancestor", "origin/main", "HEAD" })
+		t.expect(r.ok).toBe(true)
+		t.expect(git(branch, { "status", "--porcelain" })).toBe("")
+		local c1 = fs.readFile(`{branch}/tracker/issues/c0001/c0001.md`)
+		t.expect(has(c1, "line B, edited on the branch (c0001)")).toBe(true)
+		t.expect(has(c1, "See c0001 and f0002.")).toBe(true)
+		t.expect(
+			has(fs.readFile(`{branch}/tracker/issues/f0002/f0002.md`), "Appended on the branch for f0002.")
+		)
+			.toBe(true)
+		t.expect(fs.isDir(`{branch}/tracker/issues/c0010`)).toBe(false)
+		t.expect(fs.isDir(`{branch}/tracker/rafts/R0030`)).toBe(false)
+		t.expect(fs.isFile(`{branch}/{ids.MAP_FILE}`)).toBe(true)
+		t.expect(trOk(branch, { "audit" }) ~= nil).toBe(true)
+	end)
+
+	it("a second remap refuses: the branch already has the compaction", function()
+		local head = git(branch, { "rev-parse", "HEAD" })
+		local r = tr(branch, { "remap" })
+		t.expect(r.ok).toBe(false)
+		t.expect(git(branch, { "rev-parse", "HEAD" })).toBe(head)
+	end)
+
+	it("cleans up", function()
+		fs.removeDir(base)
+	end)
+end)
diff --git a/tracker/issues/c0870/acceptance/renamed.spec.luau b/tracker/issues/c0870/acceptance/renamed.spec.luau
