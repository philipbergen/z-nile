@@ -0,0 +1,68 @@
+--!strict
+-- c0870: the tracker skill describes numbering from tracker/next, the legacy rule for a tree without it, and the
+-- compact and remap commands.
+local fs = require("@lune/fs")
+local t = require("@tests/lib/t")
+
+local function skill(): string
+	return fs.readFile(".claude/skills/tracker/SKILL.md")
+end
+local function bullet(prefix: string): string
+	for line in string.gmatch(skill(), "[^\n]+") do
+		if string.sub(line, 1, #prefix) == prefix then
+			return line
+		end
+	end
+	error(`no line starting {prefix} in the tracker skill`, 0)
+end
+local function says(s: string, needle: string): boolean
+	return string.find(s, needle, 1, true) ~= nil
+end
+
+return t.spec("c0870 tracker skill", function(it)
+	it("Numbering: ids come from tracker/next, counting by one, raised with a lease push", function()
+		local line = bullet("- **Numbering**")
+		t.expect(says(line, "`tracker/next`")).toBe(true)
+		t.expect(says(line, "by one")).toBe(true)
+		t.expect(says(line, "lease")).toBe(true)
+		t.expect(says(line, "**next multiple of 10**")).toBe(false)
+	end)
+
+	it("Numbering: a tree without tracker/next keeps the old rule", function()
+		local line = bullet("- **Numbering**")
+		t.expect(says(line, "without `tracker/next`")).toBe(true)
+		t.expect(says(line, "multiple of 10")).toBe(true)
+	end)
+
+	it("a Compaction bullet says how to run it and when, and that in-flight branches remap", function()
+		local line = bullet("- **Compaction**")
+		t.expect(says(line, "tracker.sh compact")).toBe(true)
+		t.expect(says(line, "--force")).toBe(true)
+		t.expect(says(line, "tracker.sh remap")).toBe(true)
+		t.expect(says(line, "tracker/compaction.txt")).toBe(true)
+		-- a busy branch remaps before it merges, and the compaction lands only on the main it was made from
+		t.expect(says(line, "before merging `origin/main`")).toBe(true)
+		t.expect(says(line, "still equals")).toBe(true)
+	end)
+
+	it("the testing skill tells spec writers how to survive a compaction", function()
+		local testing = fs.readFile(".claude/skills/testing/SKILL.md")
+		t.expect(says(testing, "tests/lib/renamed")).toBe(true)
+		t.expect(says(testing, "in two parts")).toBe(true)
+	end)
+
+	it("the direct-push exception names tracker/next, which may only go up", function()
+		local line = bullet("- **The direct-push exception.**")
+		t.expect(says(line, "`tracker/next`")).toBe(true)
+		t.expect(says(line, "only go up")).toBe(true)
+	end)
+
+	it("Other commands lists compact and remap", function()
+		local text = skill()
+		local other = string.match(text, "## Other commands\n(.-)\n## ") :: string
+		t.expect(other ~= nil).toBe(true)
+		for _, c in { "tracker.sh compact", "tracker.sh remap" } do
+			t.expect(says(other, c)).toBe(true)
+		end
+	end)
+end)
diff --git a/tracker/issues/c0880/acceptance/audit.spec.luau b/tracker/issues/c0880/acceptance/audit.spec.luau
new file mode 100644
index 0000000..62fe10f
--- /dev/null
+++ b/tracker/issues/c0880/acceptance/audit.spec.luau
@@ -0,0 +1,148 @@
+--!strict
+-- c0880: the whole-tree audit (scripts/tracker/audit.luau) reports every problem in a tracker tree and never stops
+-- at the first one. Plain folders under .cache/c0880-audit; no git.
+local audit = require("@scripts/tracker/audit")
+local fs = require("@lune/fs")
+local process = require("@lune/process")
+local t = require("@tests/lib/t")
+
+local function trim(s: string): string
+	return (string.gsub(string.gsub(s, "^%s+", ""), "%s+$", ""))
+end
+local root = trim(process.exec("git", { "rev-parse", "--show-toplevel" }).stdout)
+local base = `{root}/.cache/c0880-audit`
+
+local function write(path: string, text: string)
+	fs.writeDir(string.match(path, "^(.*)/[^/]+$") :: string)
+	fs.writeFile(path, text)
+end
+local function doc(id: string, extra: string?): string
+	return `---\nid: {id}\ntype: chore\ntitle: T\nslug: s\n{extra or ""}---\n\n# {id}\n`
+end
+-- a fresh tree: `items` maps an item path under tracker/ to its document text (false: the folder only)
+local function tree(name: string, items: { [string]: string | false }, next: (string | false)?): string
+	local dir = `{base}/{name}`
+	if fs.isDir(dir) then
+		fs.removeDir(dir)
+	end
+	fs.writeDir(`{dir}/tracker/issues/done`)
+	fs.writeDir(`{dir}/tracker/rafts/done`)
+	for path, text in items do
+		if type(text) == "string" then
+			local id = string.match(path, "([^/]+)$") :: string
+			write(`{dir}/tracker/{path}/{id}.md`, text)
+		else
+			fs.writeDir(`{dir}/tracker/{path}`)
+		end
+	end
+	if type(next) == "string" then
+		write(`{dir}/tracker/next`, next)
+	elseif next == nil then
+		write(`{dir}/tracker/next`, "issue 100 a-b-c\nraft 100 a-b-c\n")
+	end
+	return dir
+end
+local function codes(problems: { audit.Problem }): { string }
+	local out: { string } = {}
+	for _, p in problems do
+		table.insert(out, `{p.level} {p.code} {p.path}`)
+	end
+	return out
+end
+
+return t.spec("c0880 audit", function(it)
+	it("a sound tree has no problems", function()
+		local dir = tree("clean", {
+			["issues/c0001"] = doc("c0001"),
+			["issues/done/f0002"] = doc("f0002"),
+			["rafts/R0001"] = doc("R0001"),
+		}, "issue 3 a-b-c\nraft 2 a-b-c\n")
+		t.expect(audit.run(dir)).toEqual({})
+	end)
+
+	it("an id in two lifecycle folders is a duplicate, reported at every copy", function()
+		local dir = tree("duplicate", {
+			["issues/c0010"] = doc("c0010"),
+			["issues/done/c0010"] = doc("c0010"),
+			["issues/active/c0010"] = doc("c0010"),
+			["issues/c0020"] = doc("c0020"),
+		})
+		t.expect(codes(audit.run(dir))).toEqual({
+			"error duplicate tracker/issues/active/c0010",
+			"error duplicate tracker/issues/c0010",
+			"error duplicate tracker/issues/done/c0010",
+		})
+		local p = audit.run(dir)[1]
+		t.expect(string.find(p.message, "tracker/issues/done/c0010", 1, true) ~= nil).toBe(true)
+	end)
+
+	it("reports each kind of problem, all of them in one run, sorted by path", function()
+		local dir = tree("many", {
+			["issues/c0010"] = doc("c0010"),
+			["issues/done/c0010"] = doc("c0010"),
+			["issues/c0020"] = false, -- no document
+			["issues/c0040"] = doc("c0041"), -- frontmatter names another id
+			["issues/c0050"] = "---\nid: c0050\ntitle: T\n---\n", -- no slug
+			["rafts/c0060"] = doc("c0060"), -- an issue id among rafts
+			["issues/R0070"] = doc("R0070"), -- a raft id among issues
+		})
+		-- concatenated: c0420's guard bans a literal legacy document name in specs
+		write(`{dir}/tracker/issues/c0030/c0030` .. "-old-name.md", doc("c0030"))
+		t.expect(codes(audit.run(dir))).toEqual({
+			"error wrong-kind tracker/issues/R0070",
+			"error duplicate tracker/issues/c0010",
+			"error no-document tracker/issues/c0020",
+			"error legacy-name tracker/issues/c0030",
+			"error id-mismatch tracker/issues/c0040",
+			"error no-slug tracker/issues/c0050",
+			"error duplicate tracker/issues/done/c0010",
+			"error wrong-kind tracker/rafts/c0060",
+		})
+	end)
+
+	it("a document without an id: line is not a mismatch", function()
+		local dir = tree("no-id-line", { ["issues/c0010"] = "---\ntitle: T\nslug: s\n---\n" })
+		t.expect(audit.run(dir)).toEqual({})
+	end)
+
+	it("other names in the lifecycle folders are ignored", function()
+		local dir = tree("other-names", { ["issues/c0010"] = doc("c0010") })
+		write(`{dir}/tracker/issues/.gitkeep`, "")
+		write(`{dir}/tracker/issues/done/.gitkeep`, "")
+		write(`{dir}/tracker/rafts/README.md`, "notes\n")
+		t.expect(audit.run(dir)).toEqual({})
+	end)
+
+	it("a missing or malformed counter file is an error", function()
+		t.expect(codes(audit.run(tree("next-missing", { ["issues/c0010"] = doc("c0010") }, false)))).toEqual({
+			"error next-missing tracker/next",
+		})
+		t.expect(codes(audit.run(tree("next-bad", { ["issues/c0010"] = doc("c0010") }, "issue ten\n"))))
+			.toEqual({
+				"error next-malformed tracker/next",
+			})
+	end)
+
+	it("a counter at or below a number in use is a warning, per space", function()
+		local items: { [string]: string | false } =
+			{ ["issues/c0010"] = doc("c0010"), ["rafts/R0005"] = doc("R0005") }
+		t.expect(codes(audit.run(tree("next-at", items, "issue 10 a\nraft 6 a\n")))).toEqual({
+			"warning next-behind tracker/next",
+		})
+		t.expect(codes(audit.run(tree("raft-behind", items, "issue 11 a\nraft 5 a\n")))).toEqual({
+			"warning next-behind tracker/next",
+		})
+		t.expect(audit.run(tree("next-ok", items, "issue 11 a\nraft 6 a\n"))).toEqual({})
+	end)
+
+	it("format puts level, code and path first", function()
+		local p = audit.run(tree("fmt", { ["issues/c0020"] = false }))[1]
+		local line = audit.format(p)
+		t.expect(string.sub(line, 1, #"error no-document tracker/issues/c0020: "))
+			.toBe("error no-document tracker/issues/c0020: ")
+	end)
+
+	it("cleans up", function()
+		fs.removeDir(base)
+	end)
+end)
diff --git a/tracker/issues/c0880/acceptance/cli.spec.luau b/tracker/issues/c0880/acceptance/cli.spec.luau
new file mode 100644
index 0000000..de024d1
--- /dev/null
+++ b/tracker/issues/c0880/acceptance/cli.spec.luau
@@ -0,0 +1,173 @@
+--!strict
+-- c0880: `tracker.sh audit`, `list` on a tree with a duplicate id, and `renumber <item directory>` to separate the
+-- copies. A fixture repository without an origin under .cache/c0880-cli.
+local fixture = require("@tests/lib/fixture")
+local fs = require("@lune/fs")
+local process = require("@lune/process")
+local t = require("@tests/lib/t")
+
+type Result = { ok: boolean, code: number, stdout: string, stderr: string }
+
+local function trim(s: string): string
+	return (string.gsub(string.gsub(s, "^%s+", ""), "%s+$", ""))
+end
+local root = trim(process.exec("git", { "rev-parse", "--show-toplevel" }).stdout)
+local base = `{root}/.cache/c0880-cli`
+local repo = `{base}/repo`
+
+local function git(args: { string }): string
+	return fixture.git(repo, args)
+end
+local function tr(args: { string }): Result
+	return fixture.exec(repo, "bash", { "scripts/tracker.sh", table.unpack(args) })
+end
+local function has(text: string?, needle: string): boolean
+	return text ~= nil and string.find(text, needle, 1, true) ~= nil
+end
+-- the number of output lines that list `id` (its first column)
+local function rows(text: string, id: string): number
+	local n = 0
+	for line in string.gmatch(text, "[^\n]+") do
+		if string.match(line, "^(%S+)") == id then
+			n += 1
+		end
+	end
+	return n
+end
+local function write(path: string, text: string)
+	fs.writeDir(string.match(path, "^(.*)/[^/]+$") :: string)
+	fs.writeFile(path, text)
+end
+local function doc(id: string, body: string): string
+	return `---\nid: {id}\ntype: chore\ntitle: T {id}\nslug: s\nraft: \ndepends_on: []\ndesign: draft\n---\n\n# {id}: T\n\n{body}\n`
+end
+local C10 = doc("c0010", "The one in the backlog.")
+local DONE10 = doc("c0010", "The emergent one that was filed in done.")
+local C20 = doc("c0020", "Waits for c0010.")
+
+return t.spec("c0880 audit, list and renumber by directory", function(it)
+	it("sets up a tracker repository", function()
+		if fs.isDir(base) then
+			fs.removeDir(base)
+		end
+		fs.writeDir(repo)
+		process.exec("git", { "init", "-q", "-b", "main", repo }) -- raw: init to a named path
+		git({ "config", "user.name", "cli" })
+		git({ "config", "user.email", "cli@example.invalid" })
+		for _, p in { "scripts", ".luaurc" } do
+			process.exec("cp", { "-R", `{root}/{p}`, `{repo}/{p}` })
+		end
+		fs.writeDir(`{repo}/tracker`)
+		process.exec("cp", { "-R", `{root}/tracker/templates`, `{repo}/tracker/templates` })
+		write(`{repo}/tracker/next`, "issue 21 a-b-c\nraft 11 a-b-c\n")
+		write(`{repo}/tracker/issues/c0010/c0010.md`, C10)
+		write(`{repo}/tracker/issues/c0020/c0020.md`, C20)
+		write(
+			`{repo}/tracker/rafts/R0010/R0010.md`,
+			"---\nid: R0010\ntype: chore\ntitle: Raft\nslug: raft\nissues: []\ndesign: draft\n---\n\n# R0010\n"
+		)
+		git({ "add", "-A" })
+		git({ "commit", "-q", "-m", "seed" })
+		-- origin/main without a remote: renumber reads its ids, and nothing is published
+		git({ "update-ref", "refs/remotes/origin/main", "HEAD" })
+	end)
+
+	it("audit passes a sound tree and says so", function()
+		local r = tr({ "audit" })
+		t.expect(r.ok).toBe(true)
+		t.expect(has(r.stdout, "0 errors")).toBe(true)
+	end)
+
+	it("audit fails on a duplicate and names every copy", function()
+		write(`{repo}/tracker/issues/done/c0010/c0010.md`, DONE10)
+		write(`{repo}/tracker/issues/c0030/check.sh`, "#!/usr/bin/env bash\n") -- and a folder with no document
+		local r = tr({ "audit" })
+		t.expect(r.ok).toBe(false)
+		t.expect(r.code).toBe(1)
+		t.expect(has(r.stdout, "error duplicate tracker/issues/c0010")).toBe(true)
+		t.expect(has(r.stdout, "error duplicate tracker/issues/done/c0010")).toBe(true)
+		t.expect(has(r.stdout, "error no-document tracker/issues/c0030")).toBe(true)
+		t.expect(has(r.stdout, "3 errors")).toBe(true)
+		fs.removeDir(`{repo}/tracker/issues/c0030`)
+	end)
+
+	it("list prints every item it can, both copies included, then fails naming the duplicate", function()
+		local r = tr({ "list" })
+		t.expect(r.ok).toBe(false)
+		t.expect(r.code).toBe(1)
+		t.expect(has(r.stdout, "R0010")).toBe(true)
+		t.expect(has(r.stdout, "c0020")).toBe(true)
+		t.expect(rows(r.stdout, "c0010")).toBe(2)
+		t.expect(has(r.stderr, "duplicate")).toBe(true)
+		t.expect(has(r.stderr, "tracker/issues/done/c0010")).toBe(true)
+		-- a state filter still prints what it can
+		local done = tr({ "list", "done" })
+		t.expect(done.ok).toBe(false)
+		t.expect(rows(done.stdout, "c0010")).toBe(1)
+	end)
+
+	it("renumber refuses a path that is not an item directory", function()
+		for _, bad in
+			{
+				"tracker/issues",
+				"tracker/issues/done/c0099",
+				"src/c0010",
+				"tracker/issues/done/c0010/c0010.md",
+			}
+		do
+			local r = tr({ "renumber", bad })
+			t.expect(r.ok).toBe(false)
+		end
+		t.expect(fs.isDir(`{repo}/tracker/issues/done/c0010`)).toBe(true)
+	end)
+
+	it("renumber refuses a done copy and names the other one: its specs are promoted under its id", function()
+		local r = tr({ "renumber", "tracker/issues/done/c0010" })
+		t.expect(r.ok).toBe(false)
+		t.expect(has(r.stderr, "tracker/issues/c0010")).toBe(true)
+		t.expect(fs.readFile(`{repo}/tracker/issues/done/c0010/c0010.md`)).toBe(DONE10)
+	end)
+
+	it("renumber <directory> moves only that copy and rewrites ids only inside it", function()
+		local r = tr({ "renumber", "tracker/issues/c0010" })
+		if not r.ok then
+			error(r.stderr .. r.stdout)
+		end
+		t.expect(has(r.stdout, "c0010 -> c0021")).toBe(true)
+		local moved = fs.readFile(`{repo}/tracker/issues/c0021/c0021.md`)
+		t.expect(has(moved, "id: c0021")).toBe(true)
+		t.expect(has(moved, "# c0021: T")).toBe(true)
+		t.expect(has(moved, "The one in the backlog.")).toBe(true)
+		t.expect(fs.isDir(`{repo}/tracker/issues/c0010`)).toBe(false)
+		-- the other copy, and every reference elsewhere, still mean the done c0010
+		t.expect(fs.readFile(`{repo}/tracker/issues/done/c0010/c0010.md`)).toBe(DONE10)
+		t.expect(fs.readFile(`{repo}/tracker/issues/c0020/c0020.md`)).toBe(C20)
+		t.expect(tr({ "list" }).ok).toBe(true)
+		t.expect(tr({ "audit" }).ok).toBe(true)
+	end)
+
+	it("renumber <directory> <new> uses the number given", function()
+		local r = tr({ "renumber", "tracker/issues/c0021", "c0500" })
+		t.expect(r.ok).toBe(true)
+		t.expect(fs.isFile(`{repo}/tracker/issues/c0500/c0500.md`)).toBe(true)
+		t.expect(tr({ "renumber", "tracker/issues/c0500", "f0600" }).ok).toBe(false) -- prefix kept
+		t.expect(tr({ "renumber", "tracker/issues/c0500", "c0020" }).ok).toBe(false) -- taken
+	end)
+
+	it("the tracker skill documents audit and renumbering a duplicate's copy", function()
+		local skill = fs.readFile(`{root}/.claude/skills/tracker/SKILL.md`)
+		local other = string.match(skill, "## Other commands\n(.-)\n## ") :: string
+		t.expect(has(other, "tracker.sh audit")).toBe(true)
+		local readOnly = string.match(skill, "the read%-only tracker commands ([^\n]+)") :: string
+		t.expect(has(readOnly, "`audit`")).toBe(true)
+		local dup = string.match(skill, "\n%- %*%*Duplicate ids%*%*([^\n]+)") :: string
+		t.expect(dup ~= nil).toBe(true)
+		t.expect(has(dup, "tracker.sh audit")).toBe(true)
+		t.expect(has(dup, "tracker.sh renumber <directory>")).toBe(true)
+		t.expect(has(dup, "not in `done/`")).toBe(true)
+	end)
+
+	it("cleans up", function()
+		fs.removeDir(base)
+	end)
+end)
