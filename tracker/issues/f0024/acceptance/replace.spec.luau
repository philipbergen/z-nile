--!strict
-- f0024 AC2: one row per user. It is replaced only by a strictly higher score, or the same score
-- with a strictly higher level. The stored name changes only when the row does.
local Hiscores = require("@logic/Hiscores")
local t = require("@tests/lib/t")

local FRI = 1792108800

local function attempt(userId: string, score: number, level: number, name: string?): any
	return { userId = userId, score = score, level = level, name = if name == nil then "Ada" else name }
end

return t.spec("f0024 replace rule", function(it)
	it("a missing row qualifies, a lower score does not, and an equal score needs a higher level", function()
		local stored = { name = "Old", userId = "1", level = 5, score = 100 }
		t.expect(Hiscores.qualifies(nil, attempt("1", 10, 1))).toBe(true)
		t.expect(Hiscores.qualifies(stored, attempt("1", 99, 9))).toBe(false)
		t.expect(Hiscores.qualifies(stored, attempt("1", 100, 3, "New"))).toBe(false)
		t.expect(Hiscores.qualifies(stored, attempt("1", 100, 5, "New"))).toBe(false)
		t.expect(Hiscores.qualifies(stored, attempt("1", 100, 6, "New"))).toBe(true)
		t.expect(Hiscores.qualifies(stored, attempt("1", 101, 1, "New"))).toBe(true)
	end)

	it("a score of 0 is a score, and a fraction, a bad id or a huge score is not", function()
		t.expect(Hiscores.valid(attempt("-2", 0, 1))).toBe(true)
		t.expect(Hiscores.qualifies(nil, attempt("-2", 0, 1))).toBe(true)
		t.expect(Hiscores.qualifies(nil, attempt("1", 1.5, 1))).toBe(false)
		t.expect(Hiscores.valid(attempt("+2", 0, 1))).toBe(false)
		t.expect(Hiscores.valid(attempt("-", 0, 1))).toBe(false)
		t.expect(Hiscores.valid(attempt("1", 0, 0))).toBe(false)
		t.expect(Hiscores.valid(attempt("1", -1, 1))).toBe(false)
		t.expect(Hiscores.valid(attempt("1", 2 ^ 53, 1))).toBe(false)
		t.expect(Hiscores.valid(attempt("1", 2 ^ 53 - 1, 1))).toBe(false)
		t.expect(Hiscores.LEVEL_CAP).toBe(10000)
		local maxScore = math.floor(((2 ^ 53) - 1 - (Hiscores.LEVEL_CAP - 1)) / Hiscores.LEVEL_CAP)
		t.expect(Hiscores.valid(attempt("1", maxScore, 1))).toBe(true)
		t.expect(Hiscores.valid(attempt("1", maxScore + 1, 1))).toBe(false)
		t.expect(Hiscores.valid(attempt("1", 1, 10000))).toBe(true)
		t.expect(Hiscores.pack(10, 7)).toBe(10 * Hiscores.LEVEL_CAP + 7)
		t.expect(Hiscores.pack(10, 10000)).toBe(10 * Hiscores.LEVEL_CAP + 9999)
	end)

	it("the stored name is trimmed, stripped of controls, cut to 20, and never blank", function()
		t.expect(Hiscores.cleanName("hello\nworld")).toBe("helloworld")
		t.expect(Hiscores.cleanName("  abc  ")).toBe("abc")
		t.expect(#Hiscores.cleanName(string.rep("a", 25))).toBe(20)
		t.expect(Hiscores.cleanName("  \n")).toBe("Player")
		t.expect(Hiscores.cleanName("\n\t")).toBe("Player")
		t.expect(Hiscores.cleanName(nil)).toBe("Player")
	end)

	it("an equal or lower submit leaves the stored row, including its name", function()
		local store = Hiscores.fake()
		local wrote = Hiscores.submit(store, attempt("7", 50, 2, "Old"), FRI)
		t.expect(wrote.all).toBe(true)
		t.expect(wrote.day).toBe(true)
		t.expect(wrote.week).toBe(true)
		local again = Hiscores.submit(store, attempt("7", 50, 2, "New"), FRI)
		t.expect(again.all).toBe(false)
		t.expect(again.day).toBe(false)
		t.expect(again.week).toBe(false)
		local kept = store.get(Hiscores.board("all", FRI), "7")
		t.expect(kept.name).toBe("Old")
		t.expect(kept.score).toBe(50)
		t.expect(kept.level).toBe(2)
		local lower = Hiscores.submit(store, attempt("7", 10, 99, "Nope"), FRI)
		t.expect(lower.all).toBe(false)
		t.expect(store.get(Hiscores.board("all", FRI), "7").name).toBe("Old")
		t.expect(store.get(Hiscores.board("all", FRI), "7").score).toBe(50)
		t.expect(store.get(Hiscores.board("all", FRI), "7").level).toBe(2)
	end)

	it("a higher level at the same score replaces the row and its name", function()
		local store = Hiscores.fake()
		Hiscores.submit(store, attempt("7", 50, 2, "Old"), FRI)
		local better = Hiscores.submit(store, attempt("7", 50, 4, "New"), FRI)
		t.expect(better.all).toBe(true)
		t.expect(better.day).toBe(true)
		local row = store.get(Hiscores.board("all", FRI), "7")
		t.expect(row.name).toBe("New")
		t.expect(row.level).toBe(4)
		t.expect(row.score).toBe(50)
	end)

	it("an invalid attempt writes nothing", function()
		local store = Hiscores.fake()
		local wrote = Hiscores.submit(store, attempt("nope", 50, 2), FRI)
		t.expect(wrote.all).toBe(false)
		t.expect(wrote.day).toBe(false)
		t.expect(wrote.week).toBe(false)
		t.expect(store.get(Hiscores.board("all", FRI), "nope")).toBe(nil)
	end)
end)
