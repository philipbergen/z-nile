diff --git a/src/lobby/server/Starts.luau b/src/lobby/server/Starts.luau
new file mode 100644
index 0000000..ad0f811
--- /dev/null
+++ b/src/lobby/server/Starts.luau
@@ -0,0 +1,85 @@
+--!strict
+-- Lobby server adapter: a player's request to start the game becomes a teleport to the game place. It only
+-- relays the request, the clock and the engine's answer to Travel; whether the request is allowed is Logic.
+-- The destination is configuration (an attribute the publisher sets), never something the client sends.
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local RunService = game:GetService("RunService")
+local ServerScriptService = game:GetService("ServerScriptService")
+local TeleportService = game:GetService("TeleportService")
+
+local Travel = require("@game/ReplicatedStorage/Shared/Logic/Travel")
+
+local Starts = {}
+
+function Starts.start()
+	local remotes = ReplicatedStorage:WaitForChild("Remotes")
+	local startGame = remotes:WaitForChild("StartGame") :: RemoteEvent
+	local status = remotes:WaitForChild("Status") :: RemoteEvent
+
+	local destination = Travel.destination(ServerScriptService:GetAttribute("GamePlaceId"))
+	local travel = Travel.new()
+	local shown: { [Player]: string } = {}
+
+	local function push(player: Player, phase: Travel.Phase)
+		-- a report can arrive after the player has gone
+		if player.Parent == nil then
+			return
+		end
+		if shown[player] ~= phase then
+			shown[player] = phase
+			status:FireClient(player, phase, destination ~= nil)
+		end
+	end
+
+	-- tell the player what Travel says now (a report from the engine may have changed nothing)
+	local function sync(player: Player)
+		push(player, Travel.status(travel, tostring(player.UserId), os.clock()))
+	end
+
+	startGame.OnServerEvent:Connect(function(player: Player)
+		local id = tostring(player.UserId)
+		if destination == nil then
+			push(player, "idle")
+			return
+		end
+		local answer, ticket = Travel.request(travel, id, os.clock())
+		if answer == "go" then
+			push(player, "going")
+			local ok = pcall(TeleportService.TeleportAsync, TeleportService, destination, { player })
+			if ok then
+				Travel.answered(travel, id, os.clock(), ticket)
+			else
+				Travel.failed(travel, id, os.clock(), ticket)
+				sync(player)
+			end
+		end
+	end)
+
+	TeleportService.TeleportInitFailed:Connect(function(player: Player)
+		Travel.failed(travel, tostring(player.UserId), os.clock())
+		sync(player)
+	end)
+
+	Players.PlayerAdded:Connect(function(player: Player)
+		push(player, "idle")
+	end)
+	Players.PlayerRemoving:Connect(function(player: Player)
+		Travel.left(travel, tostring(player.UserId))
+		shown[player] = nil
+	end)
+
+	-- a cool-down or a timeout ends by itself: tell the player once a second
+	local last = 0
+	RunService.Heartbeat:Connect(function()
+		local now = os.clock()
+		if now - last >= 1 then
+			last = now
+			for _, player in Players:GetPlayers() do
+				push(player, Travel.status(travel, tostring(player.UserId), now))
+			end
+		end
+	end)
+end
+
+return Starts
diff --git a/src/shared/Logic/Lobby/init.luau b/src/shared/Logic/Lobby/init.luau
new file mode 100644
index 0000000..1dd39da
--- /dev/null
+++ b/src/shared/Logic/Lobby/init.luau
@@ -0,0 +1,44 @@
+--!strict
+-- Lobby: what the lobby screen shows. Pure view models: the hiscore panel (empty until the boards exist) and
+-- the start button for a travel status.
+local Travel = require("./Travel")
+
+export type Row = { rank: number, name: string, score: number, level: number }
+export type Panel = { title: string, rows: { Row }, empty: string? }
+export type Button = { text: string, enabled: boolean, message: string? }
+
+local Lobby = {}
+Lobby.TITLE = "HISCORES"
+Lobby.EMPTY = "No scores yet"
+Lobby.MAX_ROWS = 10
+Lobby.BUTTON_MIN_PX = 44 -- the smallest touch target (design: Mobile)
+
+-- The panel for the rows the boards give (nil or none: the empty state). Rows are shown in rank order, at most MAX_ROWS.
+function Lobby.panel(rows: { Row }?): Panel
+	local shown: { Row } = {}
+	local given: { Row } = rows or {}
+	for _, r in given do
+		table.insert(shown, { rank = r.rank, name = r.name, score = r.score, level = r.level })
+	end
+	table.sort(shown, function(a: Row, b: Row): boolean
+		return a.rank < b.rank
+	end)
+	while #shown > Lobby.MAX_ROWS do
+		table.remove(shown)
+	end
+	return { title = Lobby.TITLE, rows = shown, empty = if #shown == 0 then Lobby.EMPTY else nil }
+end
+
+-- The start button: live only when a destination is set and nothing is under way.
+function Lobby.button(status: Travel.Phase, configured: boolean): Button
+	if not configured then
+		return { text = "UNAVAILABLE", enabled = false, message = "Starting is not set up yet." }
+	elseif status == "going" then
+		return { text = "STARTING...", enabled = false, message = nil }
+	elseif status == "cooling" then
+		return { text = "START GAME", enabled = false, message = "Could not start. Try again in a moment." }
+	end
+	return { text = "START GAME", enabled = true, message = nil }
+end
+
+return Lobby
diff --git a/src/shared/Logic/Travel/init.luau b/src/shared/Logic/Travel/init.luau
new file mode 100644
index 0000000..01299cd
--- /dev/null
+++ b/src/shared/Logic/Travel/init.luau
@@ -0,0 +1,107 @@
+--!strict
+-- Travel: whether a player may be sent to another place right now. Pure state per player: one request at a
+-- time, a timeout when nothing happens after the engine call has returned, a cap for a call that never
+-- returns, and a short cool-down after a failure. Time comes in as `now` (seconds); the adapter owns the
+-- engine call and reports how it went.
+export type Phase = "idle" | "going" | "cooling"
+export type Config = { goingSeconds: number, coolSeconds: number, capSeconds: number }
+export type Entry = { phase: Phase, deadline: number, cap: number, ticket: number }
+export type Travel = { config: Config, entries: { [string]: Entry }, serial: number }
+
+export type Answer = "go" | "busy" | "cooling"
+
+local Travel = {}
+Travel.DEFAULT = table.freeze({ goingSeconds = 15, coolSeconds = 3, capSeconds = 60 } :: Config)
+Travel.MAX_PLACE_ID = 2 ^ 53 - 1
+
+function Travel.new(config: Config?): Travel
+	return { config = config or Travel.DEFAULT, entries = {}, serial = 0 }
+end
+
+-- A place id from configuration (an attribute, a number or text): a whole number from 1 to MAX_PLACE_ID,
+-- else nil. 0 and anything else mean "not configured".
+function Travel.destination(raw: any): number?
+	local n: any = raw
+	if type(raw) == "string" then
+		if not string.match(raw, "^%d+$") then
+			return nil
+		end
+		n = tonumber(raw)
+	end
+	if type(n) ~= "number" or n ~= n or n < 1 or n > Travel.MAX_PLACE_ID or n ~= math.floor(n) then
+		return nil
+	end
+	return n
+end
+
+-- idle, going (a request is in flight and not timed out) or cooling (a failure is being waited out)
+function Travel.status(t: Travel, id: string, now: number): Phase
+	local e = t.entries[id]
+	if e == nil then
+		return "idle"
+	end
+	if now >= e.deadline then
+		if e.phase == "going" then
+			-- the engine never answered: that is a failure
+			e.phase, e.deadline = "cooling", now + t.config.coolSeconds
+			return "cooling"
+		end
+		t.entries[id] = nil
+		return "idle"
+	end
+	return e.phase
+end
+
+-- A player asks to go. "go" means start the engine call now (it is recorded, with a ticket that names this
+-- request); the other answers say why not.
+function Travel.request(t: Travel, id: string, now: number): (Answer, number?)
+	local phase = Travel.status(t, id, now)
+	if phase == "idle" then
+		-- until the engine call returns the player stays going, up to the cap
+		local cap = now + t.config.capSeconds
+		t.serial += 1
+		t.entries[id] = { phase = "going", deadline = cap, cap = cap, ticket = t.serial }
+		return "go", t.serial
+	end
+	local answer: Answer = if phase == "going" then "busy" else "cooling"
+	return answer, nil
+end
+
+-- A report belongs to the player's current request when it names its ticket (or names none: some engine
+-- reports carry no request id).
+local function current(t: Travel, id: string, now: number, ticket: number?): Entry?
+	if Travel.status(t, id, now) ~= "going" then
+		return nil
+	end
+	local e = t.entries[id]
+	if ticket ~= nil and ticket ~= e.ticket then
+		return nil
+	end
+	return e
+end
+
+-- The engine call returned without an error: the player is still going, but nothing may be waiting any more,
+-- so the timeout now counts from here (never past the cap). Nothing for a player who is not going, or for a
+-- request that is not the current one.
+function Travel.answered(t: Travel, id: string, now: number, ticket: number?)
+	local e = current(t, id, now, ticket)
+	if e then
+		e.deadline = math.min(e.cap, now + t.config.goingSeconds)
+	end
+end
+
+-- The engine said the call failed. Only the current request of a player who is going can fail: a late report
+-- for a request that already timed out, an older one, or nobody, changes nothing.
+function Travel.failed(t: Travel, id: string, now: number, ticket: number?)
+	if current(t, id, now, ticket) then
+		local coolEnd = now + t.config.coolSeconds
+		t.entries[id] = { phase = "cooling", deadline = coolEnd, cap = coolEnd, ticket = 0 }
+	end
+end
+
+-- The player is gone (left, or the teleport took them).
+function Travel.left(t: Travel, id: string)
+	t.entries[id] = nil
+end
+
+return Travel
diff --git a/tests/lib/fakeengine.luau b/tests/lib/fakeengine.luau
new file mode 100644
index 0000000..20e5591
--- /dev/null
+++ b/tests/lib/fakeengine.luau
@@ -0,0 +1,446 @@
+--!strict
+-- A fake of the little Roblox the lobby adapters touch, so a spec can run an adapter's real source: the
+-- services it asks `game` for, the signals it connects, the instances it builds, with the real Logic.
+--
+-- What it models (the contract the adapters may rely on, and no more):
+--   * instances with Name, Parent, children, :WaitForChild / :FindFirstChild / child-by-name (dot index),
+--     :GetChildren / :GetDescendants and :GetAttribute; a WaitForChild on a missing name fails the spec,
+--     naming the path (the real call would wait for ever);
+--   * the remotes and the attributes are taken from the BUILT lobby place, so a wrong name in an adapter
+--     fails here, and the project file and the adapters cannot drift apart;
+--   * signals whose handlers run in their own coroutine (a handler that yields stays suspended while the
+--     spec carries on); `pcall` across a yield works;
+--   * `task.spawn`, `task.defer`, `task.delay` and `task.wait`, driven by the fake clock (`tick`);
+--   * `os.clock`, `Instance.new`, `Enum`, `UDim2`, `Vector2` and `Color3` as plain data.
+-- The fake must stay exact in both directions: it must not accept less than it does now (a correct idiom
+-- that works today must keep working), and it must not accept more (a wrong adapter that fails today must
+-- keep failing: the mutants in f0670's Rules and mutants table that depend on it are re-run, as exact
+-- substitutions, whenever it changes).
+-- It models nothing about what the real engine does with TeleportAsync (E7 in f0670).
+local Lobby = require("@logic/Lobby")
+local Travel = require("@logic/Travel")
+local luau = require("@lune/luau")
+
+local fake = {}
+
+export type Signal = {
+	connections: { (...any) -> () },
+	Connect: (self: Signal, fn: (...any) -> ()) -> any,
+	fire: (self: Signal, ...any) -> (),
+}
+
+function fake.signal(): Signal
+	local s: Signal
+	s = {
+		connections = {},
+		Connect = function(self: Signal, fn: (...any) -> ())
+			table.insert(self.connections, fn)
+			return { Disconnect = function() end }
+		end,
+		fire = function(self: Signal, ...: any)
+			for _, fn in self.connections do
+				local ok, err = coroutine.resume(coroutine.create(fn), ...)
+				if not ok then
+					error(err, 0)
+				end
+			end
+		end,
+	}
+	return s
+end
+
+local LOGIC: { [string]: any } = { Travel = Travel, Lobby = Lobby }
+
+local function fakeRequire(spec: string): any
+	local name = string.match(spec, "^@game/ReplicatedStorage/Shared/Logic/(%w+)$")
+	local found = name and LOGIC[name]
+	if found == nil then
+		error(`fake engine: no module for require("{spec}")`, 0)
+	end
+	return found
+end
+
+local function load(source: string, env: { [string]: any }, name: string): any
+	local chunk = luau.load(source, { environment = env, debugName = name })
+	return chunk()
+end
+
+-- The instance model ---------------------------------------------------------------------------------------
+
+local raws: { [any]: { [any]: any } } = setmetatable({}, { __mode = "k" }) :: any
+
+local function fullName(n: any): string
+	local parts: { string } = {}
+	local at: any = n
+	while at ~= nil do
+		table.insert(parts, 1, at.Name)
+		at = at.Parent
+	end
+	return table.concat(parts, ".")
+end
+
+local function descendants(n: any, out: { any })
+	for _, c in raws[n].children do
+		table.insert(out, c)
+		descendants(c, out)
+	end
+end
+
+function fake.node(className: string, name: string?): any
+	local raw: { [any]: any } =
+		{ ClassName = className, Name = name or className, children = {}, attributes = {} }
+	local proxy: any = {}
+	raw.FindFirstChild = function(_: any, childName: string): any
+		for _, c in raw.children do
+			if c.Name == childName then
+				return c
+			end
+		end
+		return nil
+	end
+	raw.WaitForChild = function(self: any, childName: string): any
+		local found = raw.FindFirstChild(self, childName)
+		if found == nil then
+			error(`fake engine: {fullName(self)}:WaitForChild("{childName}") would wait for ever`, 0)
+		end
+		return found
+	end
+	raw.GetChildren = function(): { any }
+		return table.clone(raw.children)
+	end
+	raw.GetDescendants = function(): { any }
+		local out: { any } = {}
+		descendants(proxy, out)
+		return out
+	end
+	raw.GetAttribute = function(_: any, attribute: string): any
+		return raw.attributes[attribute]
+	end
+	setmetatable(proxy, {
+		__index = function(_: any, key: any): any
+			local v = raw[key]
+			if v ~= nil then
+				return v
+			end
+			return raw.FindFirstChild(proxy, key)
+		end,
+		__newindex = function(_: any, key: any, value: any)
+			if key == "Parent" then
+				local old = raw.Parent
+				if old ~= nil then
+					local siblings = raws[old].children
+					local at = table.find(siblings, proxy)
+					if at then
+						table.remove(siblings, at)
+					end
+				end
+				raw.Parent = value
+				if value ~= nil then
+					table.insert(raws[value].children, proxy)
+				end
+			else
+				raw[key] = value
+			end
+		end,
+	})
+	raws[proxy] = raw
+	return proxy
+end
+
+local function child(parent: any, className: string, name: string): any
+	local n = fake.node(className, name)
+	n.Parent = parent
+	return n
+end
+
+-- ReplicatedStorage.Remotes with the RemoteEvents the built place has. Each remote has both ends: the
+-- server's (OnServerEvent, FireClient) and the client's (OnClientEvent, FireServer).
+local function replicatedStorage(lobbyPlace: any, sent: { Fired }, fired: { { any } }): any
+	local rs = fake.node("ReplicatedStorage")
+	local remotes = child(rs, "Folder", "Remotes")
+	for _, built in lobbyPlace.ReplicatedStorage.Remotes:GetChildren() do
+		local r = child(remotes, "RemoteEvent", built.Name)
+		r.OnServerEvent = fake.signal()
+		r.OnClientEvent = fake.signal()
+		r.FireClient = function(_: any, player: any, ...: any)
+			table.insert(sent, { player = player, args = { ... } })
+		end
+		r.FireServer = function(_: any, ...: any)
+			table.insert(fired, { ... })
+		end
+	end
+	return rs
+end
+
+export type Fired = { player: any, args: { any } }
+
+local function standardEnv(services: { [string]: any }): { [string]: any }
+	return {
+		game = {
+			GetService = function(_: any, name: string): any
+				local found = services[name]
+				if found == nil then
+					error(`fake engine: game:GetService("{name}") is not modelled`, 0)
+				end
+				return found
+			end,
+		},
+		require = fakeRequire,
+		Enum = setmetatable({}, {
+			__index = function(_: any, group: string): any
+				return setmetatable({}, {
+					__index = function(_: any, item: string): string
+						return `{group}.{item}`
+					end,
+				})
+			end,
+		}),
+		UDim2 = {
+			new = function(xs: number, xo: number, ys: number, yo: number): any
+				return { X = { Scale = xs, Offset = xo }, Y = { Scale = ys, Offset = yo } }
+			end,
+			fromScale = function(x: number, y: number): any
+				return { X = { Scale = x, Offset = 0 }, Y = { Scale = y, Offset = 0 } }
+			end,
+		},
+		Vector2 = {
+			new = function(x: number, y: number): any
+				return { X = x, Y = y }
+			end,
+		},
+		Color3 = {
+			new = function(r: number, g: number, b: number): any
+				return { R = r, G = g, B = b }
+			end,
+			fromRGB = function(r: number, g: number, b: number): any
+				return { R = r / 255, G = g / 255, B = b / 255 }
+			end,
+		},
+		Instance = {
+			new = function(className: string): any
+				local n = fake.node(className)
+				if className == "TextButton" then
+					n.Activated = fake.signal()
+				end
+				return n
+			end,
+		},
+	}
+end
+
+-- The server ------------------------------------------------------------------------------------------------
+
+export type Server = {
+	clock: { now: number },
+	engine: { calls: { { destination: any, players: any, options: any } }, mode: string, held: { thread } },
+	sent: { Fired },
+	boot: (source: string) -> (),
+	press: (player: any, ...any) -> (),
+	tick: (seconds: number) -> (),
+	here: (player: any) -> (),
+	join: (player: any) -> (),
+	leave: (player: any) -> (),
+	initFailed: (player: any) -> (),
+	release: (index: number, failure: boolean) -> (),
+	statuses: (player: any) -> { { any } },
+}
+
+-- The lobby's server side, over `lobbyPlace` (place.load("lobby.project.json")). `attributes` overrides the
+-- values of attributes the built ServerScriptService carries (naming one it does not carry is an error).
+function fake.server(lobbyPlace: any, attributes: { [string]: any }): Server
+	local clock = { now = 0 }
+	local sent: { Fired } = {}
+	local fired: { { any } } = {}
+	local storage = replicatedStorage(lobbyPlace, sent, fired)
+	local scripts = fake.node("ServerScriptService")
+	local builtAttributes = lobbyPlace.ServerScriptService:GetAttributes()
+	for name, value in builtAttributes do
+		raws[scripts].attributes[name] = value
+	end
+	for name, value in attributes do
+		if builtAttributes[name] == nil then
+			error(`fake engine: the built lobby has no ServerScriptService attribute "{name}"`, 0)
+		end
+		raws[scripts].attributes[name] = value
+	end
+	local engine = {
+		calls = {} :: { { destination: any, players: any, options: any } },
+		mode = "ok", -- "ok" returns, "error" raises, "hold" yields until the spec releases it
+		held = {} :: { thread },
+	}
+	local init = fake.signal()
+	local teleport = fake.node("TeleportService")
+	teleport.TeleportInitFailed = init
+	teleport.TeleportAsync = function(_: any, destination: any, players: any, options: any)
+		table.insert(engine.calls, { destination = destination, players = players, options = options })
+		if engine.mode == "error" then
+			error("fake teleport failure", 0)
+		elseif engine.mode == "hold" then
+			table.insert(engine.held, coroutine.running())
+			local failure = coroutine.yield()
+			if failure then
+				error("fake teleport failure", 0)
+			end
+		end
+	end
+	local playersService = fake.node("Players")
+	playersService.PlayerAdded = fake.signal()
+	playersService.PlayerRemoving = fake.signal()
+	playersService.GetPlayers = function(): { any }
+		return playersService:GetChildren()
+	end
+	local runService = fake.node("RunService")
+	runService.Heartbeat = fake.signal()
+	local waiting: { { co: thread, due: number } } = {}
+	local timers: { { due: number, fn: (...any) -> (), args: { any } } } = {}
+	local task = {
+		spawn = function(fn: (...any) -> (), ...: any)
+			coroutine.resume(coroutine.create(fn), ...)
+		end,
+		defer = function(fn: (...any) -> (), ...: any)
+			coroutine.resume(coroutine.create(fn), ...)
+		end,
+		delay = function(seconds: number, fn: (...any) -> (), ...: any)
+			table.insert(timers, { due = clock.now + seconds, fn = fn, args = { ... } })
+		end,
+		wait = function(seconds: number?): number
+			table.insert(waiting, { co = coroutine.running(), due = clock.now + (seconds or 0) })
+			coroutine.yield()
+			return seconds or 0
+		end,
+	}
+	local services: { [string]: any } = {
+		Players = playersService,
+		ReplicatedStorage = storage,
+		RunService = runService,
+		ServerScriptService = scripts,
+		TeleportService = teleport,
+	}
+	local env = standardEnv(services)
+	env.os = {
+		clock = function(): number
+			return clock.now
+		end,
+		time = os.time,
+	}
+	env.task = task
+	local startGame = storage.Remotes.StartGame
+	local server: Server
+	server = {
+		clock = clock,
+		engine = engine,
+		sent = sent,
+		boot = function(source: string)
+			local module = load(source, env, "fake lobby server")
+			module.start()
+		end,
+		press = function(player: any, ...: any)
+			startGame.OnServerEvent:fire(player, ...)
+		end,
+		tick = function(seconds: number)
+			clock.now += seconds
+			for i = #timers, 1, -1 do
+				local timer = timers[i]
+				if timer.due <= clock.now then
+					table.remove(timers, i)
+					coroutine.resume(coroutine.create(timer.fn), table.unpack(timer.args))
+				end
+			end
+			for i = #waiting, 1, -1 do
+				local w = waiting[i]
+				if w.due <= clock.now then
+					table.remove(waiting, i)
+					coroutine.resume(w.co)
+				end
+			end
+			runService.Heartbeat:fire(seconds)
+		end,
+		here = function(player: any)
+			player.Parent = playersService
+		end,
+		join = function(player: any)
+			player.Parent = playersService
+			playersService.PlayerAdded:fire(player)
+		end,
+		leave = function(player: any)
+			playersService.PlayerRemoving:fire(player)
+			player.Parent = nil
+		end,
+		initFailed = function(player: any)
+			init:fire(player, "Failure", "fake init failure")
+		end,
+		release = function(index: number, failure: boolean)
+			local ok, err = coroutine.resume(engine.held[index], failure)
+			if not ok then
+				error(err, 0)
+			end
+		end,
+		statuses = function(player: any): { { any } }
+			local out: { { any } } = {}
+			for _, f in sent do
+				if f.player == player then
+					table.insert(out, f.args)
+				end
+			end
+			return out
+		end,
+	}
+	return server
+end
+
+-- A fake player: an instance, so Parent says whether it is still in the game.
+function fake.player(userId: number): any
+	local p = fake.node("Player", `Player{userId}`)
+	p.UserId = userId
+	return p
+end
+
+-- The client ------------------------------------------------------------------------------------------------
+
+export type Client = {
+	boot: (source: string) -> (),
+	find: (name: string) -> any,
+	status: (phase: string, configured: boolean) -> (),
+	activate: () -> (),
+	fired: { { any } },
+}
+
+-- The lobby's client side over `lobbyPlace`: whatever the view builds is found only if it ends up, through
+-- its Parent links, under the PlayerGui.
+function fake.client(lobbyPlace: any): Client
+	local sent: { Fired } = {}
+	local fired: { { any } } = {}
+	local storage = replicatedStorage(lobbyPlace, sent, fired)
+	local playerGui = fake.node("PlayerGui")
+	local localPlayer = fake.node("Player", "LocalPlayer")
+	playerGui.Parent = localPlayer
+	local services: { [string]: any } = {
+		Players = { LocalPlayer = localPlayer },
+		ReplicatedStorage = storage,
+	}
+	local env = standardEnv(services)
+	local function find(name: string): any
+		for _, d in playerGui:GetDescendants() do
+			if d.Name == name then
+				return d
+			end
+		end
+		return nil
+	end
+	return {
+		boot = function(source: string)
+			local module = load(source, env, "fake lobby client")
+			module.start()
+		end,
+		find = find,
+		status = function(phase: string, configured: boolean)
+			storage.Remotes.Status.OnClientEvent:fire(phase, configured)
+		end,
+		activate = function()
+			find("Start").Activated:fire()
+		end,
+		fired = fired,
+	}
+end
+
+return fake
