diff --git a/src/client/BlastView.luau b/src/client/BlastView.luau
new file mode 100644
index 0000000..da179be
--- /dev/null
+++ b/src/client/BlastView.luau
@@ -0,0 +1,61 @@
+--!strict
+-- Client adapter: the blaster's beam (f0100). When a shot is sent while the latest frame holds one, a thin neon
+-- beam runs from the eye along the shot's heading to View.beamEnd for a moment. The server decides the hit: a
+-- ghost it hits turns into eyes in the next frames. A shot sent with none held shows nothing.
+local Debris = game:GetService("Debris")
+
+local Maze = require("@game/ReplicatedStorage/Shared/Logic/Maze")
+local Session = require("@game/ReplicatedStorage/Shared/Logic/Session")
+local View = require("@game/ReplicatedStorage/Shared/Logic/View")
+
+local BEAM_SECONDS = 0.15 -- real time
+local BEAM_STUDS = 0.4 -- thickness
+local COLOR = Color3.fromRGB(0, 255, 255)
+
+local BlastView = {}
+
+local latest: Session.Frame? = nil
+local getPose: () -> { x: number, y: number }? = function()
+	return nil
+end
+
+function BlastView.push(frame: Session.Frame)
+	if latest == nil or frame.tick > latest.tick then
+		latest = frame
+	end
+end
+
+function BlastView.start(pose: () -> { x: number, y: number }?)
+	getPose = pose
+end
+
+function BlastView.fire(heading: Maze.Heading)
+	local frame, p = latest, getPose()
+	if frame == nil or p == nil or (frame.shots or 0) <= 0 then
+		return
+	end
+	local m = Maze.layout(frame.maze)
+	local ex, ey = View.beamEnd(m, p.x, p.y, heading)
+	local x0, z0 = View.world(p.x, p.y)
+	local x1, z1 = View.world(ex, ey)
+	local length = math.max(math.abs(x1 - x0), math.abs(z1 - z0))
+	if length <= 0 then
+		return
+	end
+	local beam = Instance.new("Part")
+	beam.Name = "Beam"
+	beam.Anchored = true
+	beam.CanCollide = false
+	beam.CanQuery = false
+	beam.CanTouch = false
+	beam.Material = Enum.Material.Neon
+	beam.Color = COLOR
+	beam.Size = if x1 ~= x0
+		then Vector3.new(length, BEAM_STUDS, BEAM_STUDS)
+		else Vector3.new(BEAM_STUDS, BEAM_STUDS, length)
+	beam.Position = Vector3.new((x0 + x1) / 2, View.SCALE.eyeHeight - 0.5, (z0 + z1) / 2)
+	beam.Parent = workspace
+	Debris:AddItem(beam, BEAM_SECONDS)
+end
+
+return BlastView
