diff --git a/src/client/DangerHud.luau b/src/client/DangerHud.luau
new file mode 100644
index 0000000..dc0ba9d
--- /dev/null
+++ b/src/client/DangerHud.luau
@@ -0,0 +1,141 @@
+--!strict
+-- Client adapter: the danger aids. A radar in the top-right corner (the maze around the player, turned so up
+-- is where the camera looks) and arrows on the screen edge for ghosts out of view, larger and brighter the
+-- closer they are along the maze. All the geometry is Awareness; this only draws it.
+local Players = game:GetService("Players")
+local RunService = game:GetService("RunService")
+
+local Awareness = require("@game/ReplicatedStorage/Shared/Logic/Awareness")
+local Maze = require("@game/ReplicatedStorage/Shared/Logic/Maze")
+local Session = require("@game/ReplicatedStorage/Shared/Logic/Session")
+
+local CELL = 8 -- pixels per tile on the radar
+local ARROW_MAX = 56 -- pixels at full size
+local LOOK_COLORS: { [string]: Color3 } = {
+	normal = Color3.fromRGB(255, 60, 60),
+	frightened = Color3.fromRGB(80, 80, 255),
+	blinking = Color3.fromRGB(230, 230, 255),
+	eyes = Color3.fromRGB(200, 200, 200),
+}
+
+local DangerHud = {}
+
+local function arrow(parent: Instance): TextLabel
+	local a = Instance.new("TextLabel")
+	a.AnchorPoint = Vector2.new(0.5, 0.5)
+	a.BackgroundTransparency = 1
+	a.Text = "▲"
+	a.Font = Enum.Font.GothamBold
+	a.Parent = parent
+	return a
+end
+
+local latest: Session.Snapshot? = nil
+local maze: Maze.Maze? = nil
+
+function DangerHud.push(snap: Session.Snapshot, m: Maze.Maze)
+	if latest == nil or snap.tick > latest.tick then
+		latest = snap
+		maze = m
+	end
+end
+
+function DangerHud.start(getPose: () -> Awareness.Pose?)
+	local gui = Instance.new("ScreenGui")
+	gui.Name = "Danger"
+	gui.ResetOnSpawn = false
+	gui.IgnoreGuiInset = true
+	gui.Parent = (Players.LocalPlayer :: Player):WaitForChild("PlayerGui")
+
+	local radarSize = (Awareness.RADAR_RADIUS * 2 + 1) * CELL
+	local radar = Instance.new("Frame")
+	radar.Name = "Radar"
+	radar.AnchorPoint = Vector2.new(1, 0)
+	radar.Position = UDim2.new(1, -16, 0, 16)
+	radar.Size = UDim2.fromOffset(radarSize, radarSize)
+	radar.BackgroundColor3 = Color3.new(0, 0, 0)
+	radar.BackgroundTransparency = 0.35
+	radar.ClipsDescendants = true
+	radar.Parent = gui
+	local function dot(parent: Instance, color: Color3, size: number): Frame
+		local f = Instance.new("Frame")
+		f.AnchorPoint = Vector2.new(0.5, 0.5)
+		f.Size = UDim2.fromOffset(size, size)
+		f.BackgroundColor3 = color
+		f.BorderSizePixel = 0
+		f.Parent = parent
+		return f
+	end
+	local you = dot(radar, Color3.fromRGB(255, 255, 0), CELL)
+	you.Position = UDim2.fromOffset(radarSize / 2, radarSize / 2)
+	local walls: { Frame } = {}
+	local blips: { Frame } = {}
+	local arrows: { TextLabel } = {}
+
+	RunService.RenderStepped:Connect(function()
+		local snap, m, pose = latest, maze, getPose()
+		if snap == nil or m == nil or pose == nil or snap.ghosts == nil then
+			return
+		end
+		local ghosts: { Awareness.Ghost } = {}
+		for _, g in snap.ghosts do
+			table.insert(ghosts, { x = g.x, y = g.y, look = g.look })
+		end
+		local r = Awareness.radar(m, pose, ghosts)
+		for i, w in r.walls do
+			local f: Frame = walls[i] or dot(radar, Color3.fromRGB(33, 33, 222), CELL)
+			walls[i] = f
+			f.Visible = true
+			f.Position = UDim2.fromOffset(radarSize / 2 + w.x * CELL, radarSize / 2 + w.y * CELL)
+		end
+		for i = #r.walls + 1, #walls do
+			walls[i].Visible = false
+		end
+		for i = 1, #ghosts do
+			local f: Frame = blips[i] or dot(radar, Color3.new(1, 1, 1), CELL)
+			blips[i] = f
+			f.Visible = false
+		end
+		for i, b in r.blips do
+			local f: Frame = blips[i]
+			f.Visible = true
+			f.BackgroundColor3 = LOOK_COLORS[b.look] or LOOK_COLORS.normal
+			f.Position = UDim2.fromOffset(radarSize / 2 + b.x * CELL, radarSize / 2 + b.y * CELL)
+		end
+
+		local view = gui.AbsoluteSize
+		local aspect = view.X / math.max(view.Y, 1)
+		local list = Awareness.indicators(m, pose, ghosts, {
+			verticalFieldOfView = math.rad(workspace.CurrentCamera.FieldOfView),
+			aspect = aspect,
+		})
+		for i = 1, #ghosts do
+			local a: TextLabel = arrows[i] or arrow(gui)
+			arrows[i] = a
+			a.Visible = false
+		end
+		for i, ind in list do
+			local a: TextLabel = arrows[i]
+			local u, v = Awareness.edgePoint(ind.bearing, aspect)
+			local px = (u * 0.5 + 0.5) * view.X
+			local py = (v * 0.5 + 0.5) * view.Y
+			-- keep the arrow fully on screen
+			local size = ARROW_MAX * ind.size
+			px = math.clamp(px, size / 2, view.X - size / 2)
+			py = math.clamp(py, size / 2, view.Y - size / 2)
+			a.Visible = true
+			a.Position = UDim2.fromOffset(px, py)
+			a.Size = UDim2.fromOffset(size, size)
+			a.TextSize = size
+			a.TextColor3 = (LOOK_COLORS[ind.look] or LOOK_COLORS.normal):Lerp(
+				Color3.new(1, 1, 1),
+				1 - ind.brightness
+			)
+			a.TextTransparency = 1 - ind.brightness
+			-- the arrow points at the ghost: toward the screen centre rotated by the bearing
+			a.Rotation = math.deg(-ind.bearing)
+		end
+	end)
+end
+
+return DangerHud
diff --git a/src/client/GhostView.luau b/src/client/GhostView.luau
new file mode 100644
index 0000000..4f671ee
--- /dev/null
+++ b/src/client/GhostView.luau
@@ -0,0 +1,115 @@
+--!strict
+-- Client adapter: one model per ghost, moved to View's interpolated pose every frame and coloured by its look.
+-- It draws what the snapshots say; every decision about a ghost was made on the server.
+local RunService = game:GetService("RunService")
+
+local Session = require("@game/ReplicatedStorage/Shared/Logic/Session")
+local View = require("@game/ReplicatedStorage/Shared/Logic/View")
+
+local COLORS: { [string]: Color3 } = {
+	blinky = Color3.fromRGB(255, 0, 0),
+	pinky = Color3.fromRGB(255, 184, 255),
+	inky = Color3.fromRGB(0, 255, 255),
+	clyde = Color3.fromRGB(255, 184, 82),
+}
+local FRIGHTENED = Color3.fromRGB(33, 33, 255)
+local FLASH_WHITE = Color3.fromRGB(255, 255, 255)
+local EYE = Color3.fromRGB(255, 255, 255)
+local PUPIL = Color3.fromRGB(33, 33, 255)
+local EYES = {
+	{ name = "EyeL", offset = CFrame.new(-1.4, 1.2, -2.6) },
+	{ name = "EyeR", offset = CFrame.new(1.4, 1.2, -2.6) },
+	{ name = "PupilL", offset = CFrame.new(-1.4, 1.2, -3.2) },
+	{ name = "PupilR", offset = CFrame.new(1.4, 1.2, -3.2) },
+}
+local BODY = Vector3.new(6, 7, 6) -- taller than the 4-stud eye height, so a ghost shows over the pellets
+
+local GhostView = {}
+
+local models: { Model } = {}
+local prev: Session.Snapshot? = nil
+local latest: Session.Snapshot? = nil
+local arrived = 0
+
+local function part(parent: Model, name: string, size: Vector3, color: Color3, shape: Enum.PartType): Part
+	local p = Instance.new("Part")
+	p.Name = name
+	p.Shape = shape
+	p.Anchored = true
+	p.CanCollide = false
+	p.CanQuery = false
+	p.CanTouch = false
+	p.Size = size
+	p.Color = color
+	p.Material = Enum.Material.Neon
+	p.Parent = parent
+	return p
+end
+
+local function build(name: string): Model
+	local model = Instance.new("Model")
+	model.Name = name
+	local body = part(model, "Body", BODY, COLORS[name] or FLASH_WHITE, Enum.PartType.Block)
+	model.PrimaryPart = body
+	for _, part_ in EYES do
+		local size = if string.sub(part_.name, 1, 3) == "Eye"
+			then Vector3.new(1.6, 2, 1.6)
+			else Vector3.new(0.8, 1, 0.8)
+		part(
+			model,
+			part_.name,
+			size,
+			if string.sub(part_.name, 1, 3) == "Eye" then EYE else PUPIL,
+			Enum.PartType.Ball
+		)
+	end
+	model.Parent = workspace
+	return model
+end
+
+local function paint(model: Model, name: string, look: string, flash: boolean)
+	local body = model:FindFirstChild("Body") :: Part
+	body.Transparency = if look == "eyes" then 1 else 0
+	if look == "frightened" then
+		body.Color = FRIGHTENED
+	elseif look == "blinking" then
+		body.Color = if flash then FLASH_WHITE else FRIGHTENED
+	else
+		body.Color = COLORS[name] or FLASH_WHITE
+	end
+end
+
+-- Snapshots only move forward, as in Camera.
+function GhostView.push(snap: Session.Snapshot)
+	if latest == nil or snap.tick > latest.tick then
+		prev = latest
+		latest = snap
+		arrived = os.clock()
+	end
+end
+
+function GhostView.start()
+	RunService:BindToRenderStep("PickmanGhosts", Enum.RenderPriority.Camera.Value, function()
+		local snap = latest
+		if snap == nil or snap.ghosts == nil then
+			return
+		end
+		local poses = View.interpolateGhosts(prev, snap, View.alpha(os.clock() - arrived))
+		for i, pose in poses do
+			local g = (snap.ghosts :: { Session.GhostSnapshot })[i]
+			local model: Model = models[i] or build(g.name)
+			models[i] = model
+			paint(model, g.name, pose.look, pose.flash)
+			local x, z = View.world(pose.x, pose.y)
+			local facing = CFrame.new(x, BODY.Y / 2, z) * CFrame.Angles(0, View.headingYaw(pose.heading), 0)
+			model:PivotTo(facing)
+			-- the eyes sit on the front face, so a ghost coming toward the player reads differently
+			for _, eye in EYES do
+				local p = model:FindFirstChild(eye.name) :: Part
+				p.CFrame = facing * eye.offset
+			end
+		end
+	end)
+end
+
+return GhostView
