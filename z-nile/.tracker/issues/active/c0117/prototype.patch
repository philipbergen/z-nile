+		at(p, "Run `{{LESSONS_COMMAND}}`", "prompt.md")
+		at(p, "{{LESSONS}}", "prompt.md") -- the index stays (c0111); the text is named
+		absent(p, "verbatim from z-nile/skills/", "prompt.md")
