+		for _, rel in { "z-nile/roots.luau", "z-nile/engine/projects.luau", "z-nile/projects.toml" } do
+			put(rel, fs.readFile(rel))
+		end
+		put("readme", "x\n")
+		fixture.git(dir, { "add", "-A" })
