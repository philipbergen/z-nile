+				["pickman/.tracker/issues/active/f0010/acceptance/a.spec.luau"] = "--!strict\nreturn nil\n",
+				["pickman/.tracker/issues/active/f0010/acceptance/notes.md"] = "not a spec\n",
+			}
+			local f = trackerfix.new("c0120-ci", seed)
