diff --git a/z-nile/tests/lib/pruning.luau b/z-nile/tests/lib/pruning.luau
new file mode 100644
index 00000000..d8e2c9da
--- /dev/null
+++ b/z-nile/tests/lib/pruning.luau
@@ -0,0 +1,65 @@
+--!strict
+-- What a run clears out of the images folder before any spec starts (c0178). Run once, by the launcher, under the run's
+-- lock: nothing in the run is using an image yet, which is the only time removing one is safe (design review 002 F1).
+-- Images of a kind beyond the newest `keep` that are older than `minAge` go, and so do build folders and locks older than
+-- `minAge`. The kind is the whole id minus its 24-hex key, so "seed" never matches "seed-nolessons".
+local DateTime = require("@lune/datetime")
+local fs = require("@lune/fs")
+local process = require("@lune/process")
+
+local pruning = {}
+
+local KEY_LENGTH = 24
+
+local function age(path: string): number
+	local ok, meta = pcall(fs.metadata, path)
+	if not ok or meta.modifiedAt == nil then
+		return 0
+	end
+	return DateTime.now().unixTimestamp - (meta.modifiedAt :: any).unixTimestamp
+end
+
+-- Returns how many folders it removed.
+-- The images folder of the run's current folder (a project's home): <home>/.cache/images, from the kernel's own path. The one
+-- place that decides where images live; images.dir() and the launcher's prune both read it.
+function pruning.dir(): string
+	return `{string.gsub(process.cwd, "/+$", "")}/.cache/images`
+end
+
+function pruning.run(home: string, keep: number?, minAge: number?): number
+	if not fs.isDir(home) then
+		return 0
+	end
+	local keepN, old = keep or 2, minAge or 3600
+	local kinds: { [string]: { { path: string, age: number } } } = {}
+	local removed = 0
+	for _, entry in fs.readDir(home) do
+		local path = `{home}/{entry}`
+		local name, key = string.match(entry, "^(.+)%-(%x+)$")
+		if name ~= nil and key ~= nil and #key == KEY_LENGTH then
+			local list = kinds[name] or {}
+			table.insert(list, { path = path, age = age(path) })
+			kinds[name] = list
+		elseif
+			(string.sub(entry, 1, 7) == ".build." or string.find(entry, ".lock", 1, true) ~= nil)
+			and age(path) > old
+		then
+			if pcall(fs.removeDir, path) then
+				removed += 1
+			end
+		end
+	end
+	for _, list in kinds do
+		table.sort(list, function(a, b)
+			return a.age < b.age -- newest first
+		end)
+		for i = keepN + 1, #list do
+			if list[i].age > old and pcall(fs.removeDir, list[i].path) then
+				removed += 1
+			end
+		end
+	end
+	return removed
+end
+
+return pruning
diff --git a/z-nile/tests/lib/swept.luau b/z-nile/tests/lib/swept.luau
new file mode 100644
index 00000000..a131a187
--- /dev/null
+++ b/z-nile/tests/lib/swept.luau
@@ -0,0 +1,67 @@
+--!strict
+-- Fixtures a passing spec file removes (c0178): a helper that makes a folder for a spec registers it here, and the
+-- runner sweeps the registered folders when every case of the file passed. A file with a failing case keeps its
+-- folders to look at. Only folders strictly inside the home's .cache are registered, and never an image.
+local cleanup = require("@tests/lib/cleanup")
+local process = require("@lune/process")
+
+local swept = {}
+
+local registered: { string } = {}
+
+-- <home>/.cache/ for the run's current folder (the kernel's, so symlinks are resolved), without starting a process.
+local function cache(): string
+	return `{string.gsub(process.cwd, "/+$", "")}/.cache/`
+end
+
+-- The first segment of a path inside the home's .cache that is never a fixture: the images, the runner's own state and
+-- anything hidden (the fence's sentinel, c0194's .tmp).
+local OWN = { images = true, ["tests-run.lock"] = true, ["spec-durations.tsv"] = true }
+
+-- Registers `path`, an absolute folder strictly inside the home's .cache. Raises, naming it, for anything else: a path
+-- with an empty, "." or ".." segment, one whose first segment under .cache is hidden, an image folder or a runner file.
+function swept.register(path: string)
+	local root = cache()
+	local bad = string.sub(path, 1, #root) ~= root or #path == #root
+	if not bad then
+		local first = true
+		for segment in string.gmatch(string.sub(path, #root + 1) .. "/", "([^/]*)/") do
+			if segment == "" or segment == "." or segment == ".." then
+				bad = true
+			elseif first and (OWN[string.lower(segment)] or string.sub(segment, 1, 1) == ".") then
+				bad = true
+			end
+			first = false
+		end
+	end
+	if bad then
+		error(
+			`swept: {path} is not a folder inside {root} (a fixture's own, not an image, a hidden or a runner file): refusing to register it`,
+			2
+		)
+	end
+	table.insert(registered, path)
+end
+
+-- The folders waiting to be swept, in registration order.
+function swept.pending(): { string }
+	return table.clone(registered)
+end
+
+-- Removes every registered folder (one already gone is fine) and forgets them. Returns how many it removed and, for each
+-- folder it could not remove, "<path>: <error>" (a process still writing into it, say): the caller shows those.
+function swept.sweep(): (number, { string })
+	local n, failed = 0, {}
+	for _, path in registered do
+		local ok, err = pcall(cleanup.removeTree, path)
+		if ok then
+			n += 1
+		else
+			table.insert(failed, `{path}: {err}`)
+		end
+	end
+	table.clear(registered)
+	return n, failed
+end
+
+return swept
diff --git a/z-nile/tests/lib/tally.luau b/z-nile/tests/lib/tally.luau
new file mode 100644
index 00000000..d9543613
--- /dev/null
+++ b/z-nile/tests/lib/tally.luau
@@ -0,0 +1,98 @@
+--!strict
+-- What the fixture helpers cost a spec file (c0178): files written and processes started. Each helper counts the
+-- processes it starts with tally.started and the files it makes with tally.files; the runner flushes each spec file's
+-- counts into the run's tally folder and prints the sums beside `slowest:`. A lower bound: the processes a fixture's own
+-- commands start (tracker.sh, ./zn and everything they run) are not counted.
+local fs = require("@lune/fs")
+local process = require("@lune/process")
+
+local tally = {}
+
+local started, written = 0, 0
+
+-- Adds `n` processes started: a helper calls this beside each process it starts itself.
+function tally.started(n: number)
+	started += n
+end
+
+-- Adds `n` files written.
+function tally.files(n: number)
+	written += n
+end
+
+-- The number of regular files under `dir` (links are not followed or counted), by one `find`: not a helper's own
+-- process, so not counted as one.
+function tally.count(dir: string): number
+	local r = process.exec("find", { dir, "-type", "f" })
+	if not r.ok then
+		return 0
+	end
+	local n = 0
+	for _ in string.gmatch(r.stdout, "[^\n]+") do
+		n += 1
+	end
+	return n
+end
+
+-- This process's counts so far, as (files, processes).
+function tally.read(): (number, number)
+	return written, started
+end
+
+-- The folder this run's counts are flushed into: made by tally.begin in the runner that prints them, or handed down to
+-- a worker through PICKMAN_TALLY.
+local current: string? = nil
+
+local function folder(): string?
+	if current then
+		return current
+	end
+	local given = process.env.PICKMAN_TALLY
+	if given ~= nil and given ~= "" then
+		return given
+	end
+	return nil
+end
+
+-- Starts a tally for this run: a fresh folder in the run's temp folder, which workers are given in PICKMAN_TALLY.
+-- Returns it, or nil when there is no run temp folder (nothing is counted then).
+function tally.begin(): string?
+	local tmp = process.env.TMPDIR
+	if tmp == nil or tmp == "" then
+		return nil
+	end
+	local dir =
+		`{string.gsub(tmp, "/+$", "")}/tally/{math.random(1, 1e9)}-{string.format("%.0f", os.clock() * 1e6)}`
+	fs.writeDir(dir)
+	current = dir
+	return dir
+end
+
+-- Writes this process's counts, if any, as one file of the run's tally, and starts again from zero.
+function tally.flush()
+	local dir = folder()
+	if dir and (written > 0 or started > 0) then
+		fs.writeDir(dir)
+		fs.writeFile(
+			`{dir}/{math.random(1, 1e9)}-{string.format("%.0f", os.clock() * 1e6)}`,
+			`{written} {started}\n`
+		)
+	end
+	written, started = 0, 0
+end
+
+-- The sums of everything flushed into the run's tally, as (files, processes).
+function tally.total(): (number, number)
+	local dir = folder()
+	local files, procs = 0, 0
+	if dir and fs.isDir(dir) then
+		for _, name in fs.readDir(dir) do
+			local a, b = string.match(fs.readFile(`{dir}/{name}`), "^(%d+) (%d+)")
+			files += tonumber(a) or 0
+			procs += tonumber(b) or 0
+		end
+	end
+	return files, procs
+end
+
+return tally
