+			pcall(fs.removeDir, lock)
+		end
+		error(`images: cannot make a build folder in {home}: {made.stderr}`, 2)
+	end
+	local build = (string.gsub(made.stdout, "%s+$", ""))
+	local ok, err = pcall(function(): any
+		spec.build(build)
+		return nil
+	end)
