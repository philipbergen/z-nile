diff --git a/scripts/hooks/session-tmp.sh b/scripts/hooks/session-tmp.sh
new file mode 100755
index 00000000..d55a1da8
--- /dev/null
+++ b/scripts/hooks/session-tmp.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+# Claude Code SessionStart hook (c0194): every Bash command this session and its subagents run gets TMPDIR under the
+# project's .cache/.tmp (never the system temp folder, which Spotlight indexes) and z-nile/bin first on PATH, whose
+# mktemp honours TMPDIR (macOS mktemp does not). Stale trees there are swept. Quiet and fail-open: a session without
+# it is only back to the system temp folder, and the stale-tree report is `./zn tmp leftovers`.
+export PATH="$HOME/.rokit/bin:$PATH"
+top=${CLAUDE_PROJECT_DIR:-}
+[[ -n $top && -n ${CLAUDE_ENV_FILE:-} && -f $top/z-nile/lib/tmpcli.luau ]] || exit 0
+root=$(cd "$top" && lune run z-nile/lib/tmpcli -- root --dir "$top" 2>/dev/null) || root=
+case $root in
+*$'\n'* | "") root= ;;
+*/.cache/.tmp) ;;
+*) root= ;;
+esac
+if [[ -z $root ]]; then
+  echo "session-tmp: could not make $top/.cache/.tmp (run ./zn tmp root to see why); TMPDIR left as it was" >&2
+  exit 0
+fi
+{
+  printf 'export TMPDIR=%q\n' "$root"
+  printf 'case ":$PATH:" in *":%s:"*) ;; *) export PATH=%q:"$PATH" ;; esac\n' "$top/z-nile/bin" "$top/z-nile/bin"
+} >>"$CLAUDE_ENV_FILE"
+(cd "$top" && lune run z-nile/lib/tmpcli -- sweep --dir "$top" >/dev/null) || true
+exit 0
diff --git a/z-nile/bin/mktemp b/z-nile/bin/mktemp
new file mode 100755
index 00000000..48ec6ae3
--- /dev/null
+++ b/z-nile/bin/mktemp
@@ -0,0 +1,25 @@
+#!/bin/sh
+# mktemp that honours TMPDIR (c0194). macOS mktemp ignores TMPDIR and uses the user temp folder, outside the repository
+# and so inside Spotlight's reach. With no template, or -t <prefix>, this puts the tree in $TMPDIR; a template (and
+# so -p <dir>, whose folder is the first non-option) names its place and is passed through. The runner copies this file into each run's own bin/ (tests/lib/fence.luau).
+real=/usr/bin/mktemp
+[ -x "$real" ] || real=/bin/mktemp
+f=
+p=tmp
+while [ $# -gt 0 ]; do
+  case $1 in
+  -t) p=${2:-tmp}; shift; [ $# -gt 0 ] && shift ;;
+  -?*t) f="$f ${1%t}"; p=${2:-tmp}; shift; [ $# -gt 0 ] && shift ;; # a cluster ending in t, such as -dt <prefix>
+  -*) f="$f $1"; shift ;;
+  *) exec "$real" $f "$@" ;;
+  esac
+done
+if [ -z "${TMPDIR:-}" ] || [ ! -d "$TMPDIR" ]; then
+  echo "mktemp: TMPDIR is unset or not a folder; using the system temp folder" >&2
+  exec "$real" $f
+fi
+case $TMPDIR in
+*/.cache/.tmp | */.cache/.tmp/*) ;;
+*) echo "mktemp: TMPDIR is not under a .cache/.tmp folder; the tree will be outside the repository" >&2 ;;
+esac
+exec "$real" $f "${TMPDIR%/}/$p.XXXXXXXXXX"
