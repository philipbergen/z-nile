 local rest = table.move(args, 2, #args, 1, {})
 local pos, opts = flags(rest)
+-- ENVELOPE (scratch, never landed): c0275 and c0276's captured effects in their plainest correct form, so this layer's
+-- sequestered specs are proven to hold on the final raft tree. c0275: a claim path (status <id> preparing, ready) beats at
+-- once, and every command in a worktree beats the claims its memory holds (no throttle). c0276: the board's verdicts are
+-- read after a publish. Variant A: the old owner is told on stdout by the autobeat. Variant B: a worktree whose remembered
+-- stamp differs from main's refuses every command but run, reap and beat (c0277's discard guard).
+function hb.envelopeDiffers(id: string): boolean
+	local f = `.cache/tracker-stamp-{id}`
+	if not fs.isFile(f) then
+		return false
+	end
+	local paths = hb.beatPaths()
+	if not paths then
+		return false
+	end
+	local cur = hb.claimStampOf(paths, id)
+	return cur ~= sh.trim(fs.readFile(f))
+end
+function hb.envelopeId(id: string)
+	if guarded(true) or not publishing() then
+		return
+	end
+	pcall(function()
+		local paths = hb.beatPaths()
+		local held = if paths then hb.claimStampOf(paths, id) else nil
+		if held then
+			hb.beatOnce(id, held)
+		end
+	end)
+end
+function hb.envelopeHeld(): { string }
+	local out: { string } = {}
+	if fs.isDir(".cache") then
+		for _, f in fs.readDir(".cache") do
+			local id = string.match(f, "^tracker%-stamp%-(.+)$") or string.match(f, "^tracker%-claim%-(.+)$")
+			if id then
+				table.insert(out, id)
+			end
+		end
+	end
+	return out
+end
+if
+	not READ_ONLY[name :: string]
+	and name ~= "beat"
+	and name ~= "run"
+	and name ~= "reap"
+	and sh.git({ "rev-parse", "--show-toplevel" }) ~= mainRoot()
+then
+	for _, id in hb.envelopeHeld() do
+		hb.envelopeId(id)
+	end
+end
 local ok, err = pcall(handler, pos, opts)
 if not ok then
 	fail(`tracker {name}: {err}`)
 end
+if (name == "status" and pos[2] == "preparing" and pos[1]) or name == "ready" then
+	hb.envelopeId(pos[1] :: string)
+	if not guarded(true) and publishing() then
+		pcall(function()
+			hb.judgeAll(originPaths())
+		end)
+	end
+end
