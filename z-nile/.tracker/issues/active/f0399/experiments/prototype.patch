+	if i.status == "preparing" then
+		return {
+			raft = "",
+			layer = "",
+			ticket = i.id,
+			action = "draft",
+			why = `{i.id} is being designed: resume its prep worktree (z-design, guess mode), then ask again.`,
+		}
