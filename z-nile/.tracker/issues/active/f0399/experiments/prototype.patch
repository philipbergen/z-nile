+local function keptIssues(issues: { IssueFact }?, scope: string?): { IssueFact }
+	local out: { IssueFact } = {}
+	for _, i in (issues or {}) :: { IssueFact } do
+		if not scope or scope == "" or i.root == scope then
+			table.insert(out, i)
+		end
+	end
+	table.sort(out, function(a, b)
+		return a.id < b.id
+	end)
+	return out
+end
