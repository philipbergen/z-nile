+	all: { IssueFact },
+	tier: number,
+	action: string,
+	input: Input
+): IssueFact?
+	for _, i in issues do -- sorted by id
+		if issuePick(i, all, tier, work.free(i.id, input)) == action then
+			return i
+		end
+	end
+	return nil
+end
