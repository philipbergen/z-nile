diff --git a/z-nile/lib/suites.luau b/z-nile/lib/suites.luau
new file mode 100644
index 000000000..77fc6226c
--- /dev/null
+++ b/z-nile/lib/suites.luau
@@ -0,0 +1,90 @@
+--!strict
+-- The two suites (c0083): the harness suite is the tooling's specs (z-nile's home) and the game suite is every game
+-- project's (pickman, arcade, portal, snake, invaders, asteroids). A change runs a suite only when it touches that
+-- suite's files. Pure: plain tables.
+-- The spec-level rule is the watch map's (watch.forSuite keeps a spec to its own suite's paths); this module names
+-- the suites for the gate (`check.sh --suite`) and refuses a watch file that crosses.
+
+local select = require("./select")
+local watch = require("./watch")
+
+local suites = {}
+
+export type Suite = "harness" | "game"
+
+-- The game suite's projects. watch.forSuite keeps its own copy of this list; the suites spec pins that the two agree.
+suites.GAME = { "arcade", "pickman", "portal", "snake", "invaders", "asteroids" }
+
+function suites.of(project: string): Suite
+	if table.find(suites.GAME, project) then
+		return "game"
+	end
+	return "harness"
+end
+
+-- The registered projects of one suite, in the registry's order. `which` is harness, game or all.
+function suites.projects(names: { string }, which: string): { string }
+	local out: { string } = {}
+	for _, n in names do
+		if which == "all" or suites.of(n) == which then
+			table.insert(out, n)
+		end
+	end
+	return out
+end
+
+-- The suites a change set touches, sorted. A spec runs for a path when the spec's watch list may name it, and
+-- watch.forSuite decides that by location: a game spec's list holds paths under a game home, a tooling spec's every other
+-- path (z-nile's home, the root's files, zn, scripts/, .github/). So a path under a game home touches the game suite,
+-- a path under any other home or under no home touches the harness, and a tracker document (a path under a project
+-- root) touches none, because it selects no spec. A change is the union of its paths. The projects `--suite changed`
+-- runs are `suites.projects` of the result.
+function suites.changed(rules: select.Rules, changed: { string }): { Suite }
+	local hit: { [string]: boolean } = {}
+	for _, path in changed do
+		local under = false
+		for _, r in rules.roots do
+			if string.sub(path, 1, #r + 1) == r .. "/" then
+				under = true
+			end
+		end
+		if not under then
+			local best: select.Home? = nil
+			for _, h in rules.homes do
+				if
+					h.prefix ~= ""
+					and string.sub(path, 1, #h.prefix) == h.prefix
+					and (best == nil or #h.prefix > #(best :: select.Home).prefix)
+				then
+					best = h
+				end
+			end
+			hit[if best then suites.of((best :: select.Home).name) else "harness"] = true
+		end
+	end
+	local out: { Suite } = {}
+	if hit.game then
+		table.insert(out, "game")
+	end
+	if hit.harness then
+		table.insert(out, "harness")
+	end
+	return out
+end
+
+-- The paths of a spec's watch list that its own suite does not keep: what watch.forSuite would drop.
+function suites.crossings(spec: string, paths: { string }): { string }
+	local kept: { [string]: boolean } = {}
+	for _, p in watch.forSuite(spec, paths) do
+		kept[p] = true
+	end
+	local out: { string } = {}
+	for _, p in paths do
+		if not kept[p] then
+			table.insert(out, p)
+		end
+	end
+	return out
+end
+
+return suites
