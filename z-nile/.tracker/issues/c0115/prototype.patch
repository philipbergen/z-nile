+			end
+			t.expect(has(zt, "## Simulations")).toBe(false)
+			t.expect(has(zt, "| `tests/scenario/`")).toBe(false)
+			local pt = read("pickman/skills/pickman-test/SKILL.md")
+			for _, needle in
+				{
