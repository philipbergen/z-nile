+			t.expect(raftplan.recordHash("c0001", moved)).toBe(h)
+			t.expect(raftplan.isDesignFile("c0001.md", "c0001")).toBe(true)
+			t.expect(raftplan.isDesignFile("c0002.md", "c0001")).toBe(false)
+		end
+	)
+end)
