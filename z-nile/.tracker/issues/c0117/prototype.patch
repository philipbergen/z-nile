new file mode 100755
index 00000000..377c5995
--- /dev/null
+++ b/z-nile/bin/git
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+# The git a dispatched agent runs (c0117), first on the PATH ./zn dispatch gives a model step: a convenience layer, not
+# the boundary (the agent's credential and the dispatcher's tripwire are). A push, a plumbing push, any `-c` or
+# `--config-env`, and an alias go to z-nile/engine/wrap.luau, which decides from git's own dry run; every other
+# command is the real git at once.
+real="${ZN_REAL_GIT:-}"
+if [[ -z $real ]]; then
+  echo "git (z-nile wrapper): the real git is not known (run under ./zn dispatch)" >&2
+  exit 2
+fi
+wrap() { exec lune run "$(cd "$(dirname "${BASH_SOURCE[0]}")/../engine" && pwd -P)/wrap" -- git "$@"; }
+skip=0
+first=
+for a in "$@"; do
+  case "$a" in
+  push | send-pack | http-push | receive-pack | -c | -c* | --config-env | --config-env=*) wrap "$@" ;;
+  esac
+done
+for a in "$@"; do
+  if [[ $skip == 1 ]]; then skip=0; continue; fi
+  case "$a" in
+  -C | --git-dir | --work-tree | --namespace | --super-prefix) skip=1 ;;
+  -*) ;;
+  *) first=$a; break ;;
+  esac
+done
+if [[ -n $first ]] && "$real" config --get "alias.$first" >/dev/null 2>&1; then wrap "$@"; fi
+exec "$real" "$@"
diff --git a/z-nile/engine/adapters.luau b/z-nile/engine/adapters.luau
new file mode 100644
index 00000000..d622049a
--- /dev/null
+++ b/z-nile/engine/adapters.luau
@@ -0,0 +1,483 @@
+--!strict
+-- One adapter per runtime (c0117): the command line that starts a model step headless and unattended, the reader of
+-- its output stream (a token count as it runs, the final count, a quota or error signal), and the outcome. Pure: the
+-- runner (runner.luau) starts the process and feeds this module its lines.
+--
+-- The token count is the same for every CLI: input + cache writes + output (reasoning included), cache reads left
+-- out. Probed 2026-10-21 (c0117 E1, E2): `claude -p --output-format stream-json --verbose` gives `usage` on each
+-- assistant message, a `rate_limit_event` per call and a final `result` with `modelUsage`; `grok -p --output-format
+-- streaming-json` gives a `usage` line per model call and an `end` line with the total; `agent -p --output-format
+-- stream-json` gives usage only on its final `result` line, so its step is capped by model calls instead.
+local serde = require("@lune/serde")
+
+local adapters = {}
+
+export type Request = {
+	prompt: string,
+	model: string,
+	effort: string?,
+	cwd: string,
+	session: string, -- a fresh UUID: grok's session id, the others' marker in the run state
+}
+export type Acc = {
+	live: number, -- the running count (an estimate for agent)
+	final: number?, -- the count the CLI reported at its end
+	byMessage: { [string]: number },
+	quota: string?, -- why the CLI is out of quota, when it said so
+	errorText: string?,
+	cliText: string, -- the last text the CLI itself printed (not the model's words): a stall's wait message
+	open: { [string]: boolean }, -- the tool calls started and not finished yet
+	calls: number, -- model calls seen (agent: distinct model_call_id values, and turns that carry none)
+	callIds: { [string]: boolean },
+	turns: number,
+	inTurn: boolean,
+	turnHasId: boolean,
+	noIdTurns: number, -- turns in a row that carried no model_call_id
+	unknown: string?, -- why the call cap can't be trusted on this stream (fail closed)
+	session: string?,
+}
+export type Outcome = "ok" | "failed" | "quota"
+export type Adapter = {
+	cli: string,
+	runtime: string,
+	callCapped: boolean, -- no running token count: the step stops on max_calls, and the row takes the final total
+	argv: (Request) -> { string },
+	feed: (Acc, string) -> (),
+}
+
+-- What a CLI prints when it is out of quota or rate limited (any of these, case-insensitive).
+adapters.QUOTA = {
+	"rate limit",
+	"rate_limit",
+	"rate-limit",
+	"usage limit",
+	"quota",
+	"insufficient credit",
+	"insufficient balance",
+	"out of credits",
+	"limit reached",
+	"too many requests",
+	"status 429",
+	"error 429",
+	"http 429",
+}
+-- What a CLI prints while it waits for quota instead of failing: a stall after one of these is a quota failure.
+adapters.WAITING = { "retrying in", "retry in", "waiting for", "try again", "resets at", "reset at" }
+
+local function mentions(text: string, words: { string }): string?
+	local lower = string.lower(text)
+	for _, w in words do
+		if string.find(lower, w, 1, true) then
+			return w
+		end
+	end
+	return nil
+end
+adapters.mentions = mentions
+
+function adapters.newAcc(): Acc
+	return {
+		live = 0,
+		final = nil,
+		byMessage = {},
+		quota = nil,
+		errorText = nil,
+		cliText = "",
+		open = {},
+		calls = 0,
+		callIds = {},
+		turns = 0,
+		inTurn = false,
+		turnHasId = false,
+		noIdTurns = 0,
+		unknown = nil,
+		session = nil,
+	}
+end
+
+local function num(v: any): number
+	return if type(v) == "number" then v else 0
+end
+
+local function decode(line: string): { [string]: any }?
+	if string.sub(line, 1, 1) ~= "{" then
+		return nil
+	end
+	local ok, value = pcall(function()
+		return serde.decode("json", line)
+	end)
+	return if ok and type(value) == "table" then value else nil
+end
+
+-- claude's and grok's usage objects (snake_case): input + cache writes + output.
+local function snake(u: any): number
+	if type(u) ~= "table" then
+		return 0
+	end
+	return num(u.input_tokens) + num(u["cache_creation_input_tokens"]) + num(u.output_tokens)
+end
+
+local function sumLive(acc: Acc)
+	local n = 0
+	for _, v in acc.byMessage do
+		n += v
+	end
+	acc.live = n
+end
+
+-- Whether a tool call is running: the stall timer gives way to the tool ceiling while one is (c0117 review 001 F8).
+function adapters.toolRunning(acc: Acc): boolean
+	return next(acc.open) ~= nil
+end
+
+local function claudeFeed(acc: Acc, line: string)
+	local j = decode(line)
+	if not j then
+		acc.cliText = line
+		return
+	end
+	if j.session_id then
+		acc.session = j.session_id
+	end
+	if j.type == "assistant" and type(j.message) == "table" then
+		local m = j.message
+		local id = if type(m.id) == "string" then m.id else "message"
+		-- every content block of one message repeats its usage: count the message once, at its largest
+		acc.byMessage[id] = math.max(acc.byMessage[id] or 0, snake(m.usage))
+		sumLive(acc)
+		if type(m.content) == "table" then
+			for _, block in m.content do
+				if type(block) == "table" and block.type == "tool_use" and type(block.id) == "string" then
+					acc.open[block.id] = true
+				end
+			end
+		end
+	elseif j.type == "user" and type(j.message) == "table" and type(j.message.content) == "table" then
+		for _, block in j.message.content do
+			if
+				type(block) == "table"
+				and block.type == "tool_result"
+				and type(block.tool_use_id) == "string"
+			then
+				acc.open[block.tool_use_id] = nil
+			end
+		end
+	elseif j.type == "rate_limit_event" and type(j.rate_limit_info) == "table" then
+		local info = j.rate_limit_info
+		if info.status == "rejected" then
+			acc.quota = `rate limit rejected ({tostring(info.rateLimitType or "?")}, resets {tostring(
+				info.resetsAt or "?"
+			)})`
+		end
+	elseif j.type == "system" then
+		-- the CLI's own notices (an API retry names its error): text the stall rule may read
+		if type(j.error) == "string" or type(j.message) == "string" then
+			acc.cliText = tostring(j.error or j.message)
+		end
+	elseif j.type == "result" then
+		if type(j.modelUsage) == "table" then
+			local n = 0
+			for _, u in j.modelUsage do
+				if type(u) == "table" then
+					n += num(u.inputTokens) + num(u["cacheCreationInputTokens"]) + num(u.outputTokens)
+				end
+			end
+			acc.final = n
+		elseif type(j.usage) == "table" then
+			acc.final = snake(j.usage)
+		end
+		if j.is_error == true or (type(j.subtype) == "string" and j.subtype ~= "success") then
+			-- an error result is the CLI's report, not the model's prose
+			local text = if type(j.result) == "string" then j.result else tostring(j.subtype)
+			acc.errorText = text
+			acc.cliText = text
+			if mentions(text, adapters.QUOTA) then
+				acc.quota = acc.quota or text
+			end
+		end
+	end
+end
+
+local function grokFeed(acc: Acc, line: string)
+	local j = decode(line)
+	if not j then
+		acc.cliText = line
+		return
+	end
+	if j.type == "usage" then
+		acc.live += snake(j.usage)
+	elseif j.type == "end" then
+		acc.final = snake(j.usage)
+		if type(j.sessionId) == "string" then
+			acc.session = j.sessionId
+		end
+	elseif j.type == "tool_call" and type(j.toolCallId) == "string" then
+		acc.open[j.toolCallId] = true
+	elseif j.type == "tool_call_update" and type(j.toolCallId) == "string" then
+		if j.status == "completed" or j.status == "failed" then
+			acc.open[j.toolCallId] = nil
+		end
+	elseif j.type == "error" or j.error ~= nil then
+		local text = tostring(j.message or j.error or j.data or line)
+		acc.errorText = text
+		acc.cliText = text
+		if mentions(text, adapters.QUOTA) then
+			acc.quota = text
+		end
+	end
+end
+
+-- agent's line types (probes E1, E3): anything else is a stream the call cap can't be trusted on
+local AGENT_TYPES =
+	{ system = true, user = true, assistant = true, thinking = true, tool_call = true, result = true }
+-- turns in a row with no model_call_id after which the call cap is unknown (fail closed: review 002 F8)
+adapters.NO_ID_TURNS = 3
+
+local function agentFeed(acc: Acc, line: string)
+	local j = decode(line)
+	if not j then
+		acc.cliText = line
+		acc.unknown = acc.unknown or "a line that is not JSON"
+		return
+	end
+	if not AGENT_TYPES[j.type] then
+		acc.unknown = acc.unknown or `a line of type {tostring(j.type)}`
+	end
+	if j.type == "result" then
+		local u = j.usage
+		if type(u) == "table" then
+			acc.final = num(u.inputTokens) + num(u["cacheWriteTokens"]) + num(u.outputTokens)
+		end
+		if j.is_error == true then
+			local text = tostring(j.result or j.subtype or "error")
+			acc.errorText = text
+			acc.cliText = text
+			if mentions(text, adapters.QUOTA) then
+				acc.quota = text
+			end
+		end
+		return
+	end
+	if j.type == "user" then
+		acc.inTurn = false
+	end
+	if j.type == "tool_call" and type(j.call_id) == "string" then
+		if j.subtype == "started" then
+			acc.open[j.call_id] = true
+		elseif j.subtype == "completed" then
+			acc.open[j.call_id] = nil
+			acc.inTurn = false
+		end
+	end
+	-- a turn starts at the first thinking or assistant line, or tool call started without a model_call_id, after a user
+	-- line or a finished tool call: a model call, counted even when it carries no model_call_id (the fallback count;
+	-- review 003 F7: a stream of bare tool calls is turns too)
+	local bareTool = j.type == "tool_call" and j.subtype == "started" and type(j.model_call_id) ~= "string"
+	if (j.type == "thinking" or j.type == "assistant" or bareTool) and not acc.inTurn then
+		if acc.turns > 0 and not acc.turnHasId then
+			acc.noIdTurns += 1
+		elseif acc.turnHasId then
+			acc.noIdTurns = 0
+		end
+		acc.turns += 1
+		acc.inTurn = true
+		acc.turnHasId = false
+		acc.calls += 1
+		if acc.noIdTurns >= adapters.NO_ID_TURNS then
+			acc.unknown = acc.unknown
+				or `{adapters.NO_ID_TURNS} turns with no model_call_id: max_calls can't be enforced`
+		end
+	end
+	-- the calls themselves (probe E3): one per distinct model_call_id; an id inside a turn already counted is that
+	-- turn's own. The running token count stays 0 and the row takes the result's real total (the user's decision)
+	if type(j.model_call_id) == "string" and not acc.callIds[j.model_call_id] then
+		acc.callIds[j.model_call_id] = true
+		if acc.inTurn and not acc.turnHasId then
+			acc.turnHasId = true
+		else
+			acc.calls += 1
+		end
+	elseif type(j.model_call_id) == "string" and acc.inTurn then
+		acc.turnHasId = true
+	end
+end
+
+-- claude's own sandbox off, whatever the user's settings say, so the gate's jail can engage inside the step
+-- (programme review E6; macOS can't nest sandboxes)
+adapters.CLAUDE_SETTINGS = '{"sandbox":{"enabled":false}}'
+
+-- What a runtime's step environment adds (review 004 F2): Claude Code stops one shell command after
+-- BASH_DEFAULT_TIMEOUT_MS (120 s by default) and never allows more than BASH_MAX_TIMEOUT_MS (600 s), but an author
+-- waits on its nested review as one command (`./zn dispatch zz-review …`), and reviews here take up to 29 minutes. Two
+-- hours (a guess, G22; E15 measures each CLI's own limit), while the heartbeat keeps the dispatcher's stall clock honest.
+adapters.STEP_ENV = {
+	["claude-cli"] = { BASH_DEFAULT_TIMEOUT_MS = "7200000", BASH_MAX_TIMEOUT_MS = "7200000" },
+} :: { [string]: { [string]: string } }
+
+local function withEffort(args: { string }, flag: string, effort: string?): { string }
+	if effort then
+		table.insert(args, flag)
+		table.insert(args, effort)
+	end
+	return args
+end
+
+local ADAPTERS: { [string]: Adapter } = {
+	["claude-cli"] = {
+		cli = "claude",
+		runtime = "claude-cli",
+		callCapped = false,
+		argv = function(r: Request): { string }
+			return withEffort({
+				"claude",
+				"-p",
+				r.prompt,
+				"--output-format",
+				"stream-json",
+				"--verbose",
+				"--model",
+				r.model,
+				"--permission-mode",
+				"bypassPermissions",
+				"--permission-prompts",
+				"none",
+				"--session-id",
+				r.session,
+				"--settings",
+				adapters.CLAUDE_SETTINGS,
+			}, "--effort", r.effort)
+		end,
+		feed = claudeFeed,
+	},
+	["claude-cloud"] = {
+		cli = "claude",
+		runtime = "claude-cloud",
+		callCapped = false,
+		argv = function(r: Request): { string }
+			return withEffort({
+				"claude",
+				"--cloud",
+				r.prompt,
+				"-p",
+				"--output-format",
+				"stream-json",
+				"--verbose",
+				"--model",
+				r.model,
+			}, "--effort", r.effort)
+		end,
+		feed = claudeFeed,
+	},
+	["grok-cli"] = {
+		cli = "grok",
+		runtime = "grok-cli",
+		callCapped = false,
+		argv = function(r: Request): { string }
+			return withEffort({
+				"grok",
+				"-p",
+				r.prompt,
+				"--output-format",
+				"streaming-json",
+				"-m",
+				r.model,
+				"--always-approve",
+				"--cwd",
+				r.cwd,
+				"-s",
+				r.session,
+			}, "--reasoning-effort", r.effort)
+		end,
+		feed = grokFeed,
+	},
+	["grok-bot"] = {
+		cli = "grok",
+		runtime = "grok-bot",
+		callCapped = false,
+		argv = function(r: Request): { string }
+			local args = withEffort({ "grok", "agent", "-m", r.model }, "--reasoning-effort", r.effort)
+			table.insert(args, "--always-approve")
+			table.insert(args, "headless")
+			return args
+		end,
+		feed = grokFeed,
+	},
+	["cursor-cli"] = {
+		cli = "agent",
+		runtime = "cursor-cli",
+		callCapped = true,
+		argv = function(r: Request): { string }
+			return {
+				"agent",
+				"-p",
+				"--output-format",
+				"stream-json",
+				"--model",
+				if r.effort then `{r.model}[effort={r.effort}]` else r.model,
+				"--force",
+				"--trust",
+				"--sandbox",
+				"disabled",
+				"--workspace",
+				r.cwd,
+				r.prompt,
+			}
+		end,
+		feed = agentFeed,
+	},
+	["cursor-app"] = {
+		cli = "agent",
+		runtime = "cursor-app",
+		callCapped = true,
+		argv = function(r: Request): { string }
+			return {
+				"agent",
+				"worker",
+				"--model",
+				if r.effort then `{r.model}[effort={r.effort}]` else r.model,
+				"--workspace",
+				r.cwd,
+			}
+		end,
+		feed = agentFeed,
+	},
+}
+
+-- The runtimes whose prompt goes on stdin (they take none on the command line).
+adapters.STDIN = { ["grok-bot"] = true, ["cursor-app"] = true }
+
+function adapters.get(runtime: string): Adapter
+	local a = ADAPTERS[runtime]
+	if not a then
+		error(`no adapter for runtime {runtime}`, 0)
+	end
+	return a
+end
+
+-- The outcome of a step that ended by itself: quota when the CLI said so (in its stream or its stderr), ok when it
+-- exited 0 with a token count and no error, else failed. A step that exits 0 with no count failed: every adapter
+-- returns one (the capture's Solution).
+function adapters.finish(acc: Acc, exitOk: boolean, stderr: string, runtime: string): (Outcome, string)
+	if acc.quota then
+		return "quota", acc.quota
+	end
+	local w = mentions(stderr, adapters.QUOTA)
+	if not exitOk and w then
+		return "quota", (string.match(stderr, "[^\n]*$") or w)
+	end
+	if exitOk and acc.final ~= nil and not acc.errorText then
+		return "ok", "done"
+	end
+	if exitOk and acc.final == nil then
+		return "failed", `{runtime} exited without a token count`
+	end
+	local why = acc.errorText or (string.match(string.gsub(stderr, "%s+$", ""), "[^\n]*$") or "")
+	return "failed", if why ~= "" then why else `{runtime} failed`
+end
+
+-- The count a step's row records: the CLI's final count when it gave one, else the running count.
+function adapters.tokens(acc: Acc): number
+	return acc.final or acc.live
+end
+
+return adapters
diff --git a/z-nile/engine/broker.luau b/z-nile/engine/broker.luau
new file mode 100644
index 00000000..6f3f2f6a
--- /dev/null
+++ b/z-nile/engine/broker.luau
@@ -0,0 +1,129 @@
+--!strict
+-- The publish broker (c0117): a dispatched agent's credential can't push to `main`, so the tracker's own pushes of
+-- tracker state (`publish`'s push, `land`) from inside a step are handed to the dispatcher that runs the step, which
+-- pushes them with the user's credential after checking them. A request is a file in that dispatcher's own broker
+-- folder (`ZN_PUBLISH_BROKER`), bound to it by its run token (`ZN_PUBLISH_TOKEN`); the answer is a file beside it.
+-- The push is a fast-forward of a freshly fetched `main` only (never forced), and only of tracker state as
+-- trackerstate.luau defines it, commit by commit (design review 002 F1 to F3, F7; 003 F1, F3, F10). Like every guard
+-- here it detects honest mistakes and casual misbehaviour, not a determined agent of the same OS user.
+local fs = require("@lune/fs")
+local process = require("@lune/process")
+local serde = require("@lune/serde")
+local task = require("@lune/task")
+local trackerstate = require("./trackerstate")
+
+local broker = {}
+
+-- how long a client waits for its answer: the dispatcher may be fetching for its tripwire when the request lands
+broker.WAIT_SECONDS = 600
+-- the ref the dispatcher fetches `main` into: its own, never the tracking ref an agent can rewrite
+broker.FRESH = "refs/zn-dispatch/main"
+
+local function uuid(): string
+	return string.lower((string.gsub(process.exec("uuidgen", {}).stdout, "%s+", "")))
+end
+
+-- Client side: asks the dispatcher to put `sha` on main. Waits for its answer.
+function broker.request(dir: string, token: string, sha: string, base: string?): (boolean, string)
+	fs.writeDir(dir)
+	local stem = `{dir}/{uuid()}`
+	fs.writeFile(`{stem}.tmp`, serde.encode("json", { token = token, sha = sha, base = base or "" }))
+	fs.move(`{stem}.tmp`, `{stem}.req`)
+	local waited = 0
+	while waited < broker.WAIT_SECONDS do
+		if fs.isFile(`{stem}.res`) then
+			local ok, res = pcall(function()
+				return serde.decode("json", fs.readFile(`{stem}.res`))
+			end)
+			pcall(fs.removeFile, `{stem}.res`)
+			if ok and type(res) == "table" then
+				return res.ok == true, tostring(res.message or "")
+			end
+			return false, "the broker's answer does not parse"
+		end
+		waited += task.wait(0.1)
+	end
+	return false, `no answer from the dispatcher's publish broker in {broker.WAIT_SECONDS} s`
+end
+
+-- Server side: claims every request in `dir` (a rename, which only one server wins) and answers it with `push`;
+-- a request without this run's `token` is refused. Never raises: a failure is an answer, never a dead dispatcher.
+function broker.serve(dir: string, token: string, push: (sha: string) -> (boolean, string))
+	pcall(function()
+		if not fs.isDir(dir) then
+			return
+		end
+		for _, name in fs.readDir(dir) do
+			if string.match(name, "%.req$") then
+				local stem = `{dir}/{string.sub(name, 1, -5)}`
+				local claimed = pcall(fs.move, `{stem}.req`, `{stem}.taken`)
+				if claimed then
+					local good, message = false, "the request does not parse"
+					local ok, req = pcall(function()
+						return serde.decode("json", fs.readFile(`{stem}.taken`))
+					end)
+					if ok and type(req) == "table" then
+						if req.token ~= token then
+							good, message =
+								false, "the request is not this dispatcher's (its run token differs)"
+						elseif type(req.sha) == "string" and string.match(req.sha, "^%x+$") then
+							local pok, a, b = pcall(push, req.sha)
+							if pok then
+								good, message = a, b
+							else
+								good, message = false, `the broker failed: {tostring(a)}`
+							end
+						end
+					end
+					pcall(fs.removeFile, `{stem}.taken`)
+					pcall(function()
+						fs.writeFile(`{stem}.rtmp`, serde.encode("json", { ok = good, message = message }))
+						fs.move(`{stem}.rtmp`, `{stem}.res`)
+					end)
+				end
+			end
+		end
+	end)
+end
+
+-- The URLs a run pinned at its start (review 003 F3): every fetch and push names them, never `origin` as the shared
+-- configuration resolves it later.
+export type Origin = { fetch: string, push: string }
+
+-- The push itself, in the repository `root`: fetch `main` fresh from the pinned URL, refuse anything but a fast-forward
+-- of it, refuse a history the watermark would refuse (each first-parent commit judged against its parent, by its
+-- parent's registry, sequestered: review 003 F10), then a plain push to the pinned push URL (never forced: a `main` that
+-- moved since the fetch refuses it, and the client rebuilds on it and asks again). `roots` reads the registry's roots at
+-- a ref.
+function broker.push(
+	root: string,
+	sha: string,
+	roots: (ref: string) -> { string }?,
+	origin: Origin?
+): (boolean, string)
+	local function git(args: { string }): (boolean, string)
+		local r = process.exec("git", args, { cwd = root })
+		return r.ok, (string.gsub(r.stdout, "%s+$", ""))
+	end
+	local from = if origin then origin.fetch else "origin"
+	local to = if origin then origin.push else "origin"
+	if not git({ "fetch", "-q", from, `+refs/heads/main:{broker.FRESH}` }) then
+		return false, "the dispatcher could not fetch origin's main"
+	end
+	local _, fresh = git({ "rev-parse", broker.FRESH })
+	if not process.exec("git", { "merge-base", "--is-ancestor", fresh, sha }, { cwd = root }).ok then
+		return false, `{sha} is not a fast-forward of main ({fresh}): rebuild it on main and ask again`
+	end
+	local why = trackerstate.checkEach(git, fresh, sha, roots, true)
+	if why then
+		return false,
+			`the dispatcher pushes only tracker state to main, commit by commit (squash it and ask again): {why}`
+	end
+	local r = process.exec("git", { "push", "-q", to, `{sha}:refs/heads/main` }, { cwd = root })
+	if r.ok then
+		return true, "pushed"
+	end
+	return false, (string.gsub(r.stderr, "%s+$", ""))
+end
+
+return broker
diff --git a/z-nile/engine/credential.luau b/z-nile/engine/credential.luau
new file mode 100644
index 00000000..3023d828
--- /dev/null
+++ b/z-nile/engine/credential.luau
@@ -0,0 +1,76 @@
+--!strict
+-- The agent's GitHub credential (c0117, the user's "Bot token, no bypass"): a dispatched model step runs with a token
+-- of its own (a fine-grained token or a GitHub App's) that can push branches and open pull requests but can't merge,
+-- bypass `main`'s protection or write protection or rulesets. The user's token never enters the step's environment:
+-- GH_TOKEN and GITHUB_TOKEN are the agent's, gh reads an empty configuration folder of the step's own, and git's
+-- credential helpers are reset to one that answers with the agent's token. What the OS can't stop: a process of the
+-- same user can still read the user's own credentials where they live (the keychain, ~/.config/gh); only a separate
+-- OS user would close that, and the dispatcher's tripwire and main's protection are what catch its use.
+local fs = require("@lune/fs")
+local process = require("@lune/process")
+
+local credential = {}
+
+-- Where the agent's token is read from: the file ZN_AGENT_TOKEN_FILE names (then nowhere else), else
+-- ~/.config/zn/agent-token, else the macOS keychain item `zn-dispatch-agent`.
+credential.KEYCHAIN = "zn-dispatch-agent"
+
+function credential.token(): (string?, string)
+	local file = process.env.ZN_AGENT_TOKEN_FILE
+	if file and file ~= "" then
+		-- a named file is the only place looked at
+		local t = if fs.isFile(file) then (string.gsub(fs.readFile(file), "%s+", "")) else ""
+		if t ~= "" then
+			return t, file
+		end
+		return nil,
+			`no agent credential in {file} (ZN_AGENT_TOKEN_FILE): store the agent's token first (zz-rules, Dispatch, the agent credential)`
+	end
+	local home = process.env.HOME or ""
+	for _, path in { `{home}/.config/zn/agent-token` } do
+		if path ~= "" and fs.isFile(path) then
+			local t = (string.gsub(fs.readFile(path), "%s+", ""))
+			if t ~= "" then
+				return t, path
+			end
+		end
+	end
+	local r = process.exec("security", { "find-generic-password", "-s", credential.KEYCHAIN, "-w" })
+	if r.ok then
+		local t = (string.gsub(r.stdout, "%s+", ""))
+		if t ~= "" then
+			return t, `keychain {credential.KEYCHAIN}`
+		end
+	end
+	return nil,
+		"no agent credential: store the agent's token (zz-rules, Dispatch, the agent credential) first"
+end
+
+-- The variables a step's environment gets on top of `base` (the dispatcher's): the agent's token for gh and git, an
+-- empty gh configuration folder, no ssh agent, no prompts. git configuration entries are appended after any the
+-- environment already carries (the repository guards' own, in a check), never in their place.
+function credential.agentEnv(
+	base: { [string]: string? },
+	token: string,
+	configDir: string
+): { [string]: string }
+	fs.writeDir(configDir)
+	local n = tonumber(base.GIT_CONFIG_COUNT or "0") or 0
+	local env: { [string]: string } = {
+		GH_TOKEN = token,
+		GITHUB_TOKEN = token,
+		ZN_AGENT_GH_TOKEN = token,
+		GH_CONFIG_DIR = configDir,
+		GH_PROMPT_DISABLED = "1",
+		GIT_TERMINAL_PROMPT = "0",
+		SSH_AUTH_SOCK = "",
+		GIT_CONFIG_COUNT = tostring(n + 2),
+		[`GIT_CONFIG_KEY_{n}`] = "credential.helper",
+		[`GIT_CONFIG_VALUE_{n}`] = "",
+		[`GIT_CONFIG_KEY_{n + 1}`] = "credential.helper",
+		[`GIT_CONFIG_VALUE_{n + 1}`] = '!f() { test "$1" = get && echo username=x-access-token && echo "password=$ZN_AGENT_GH_TOKEN"; }; f',
+	}
+	return env
+end
+
+return credential
diff --git a/z-nile/engine/dispatch.luau b/z-nile/engine/dispatch.luau
new file mode 100644
index 00000000..df8d7fe8
--- /dev/null
+++ b/z-nile/engine/dispatch.luau
@@ -0,0 +1,371 @@
+--!strict
+-- The dispatcher's rules (c0117), pure: which steps are scripts and which need a model, the prompt a model step gets,
+-- and the chain: from an item's tracker state, the next step, merge or stop. dispatcher.luau reads the state, runs the
+-- steps and records their spend; it never reads a model's prose to decide.
+local models = require("./models")
+local serde = require("@lune/serde")
+
+local dispatch = {}
+
+export type Step = {
+	kind: "model" | "script",
+	lessons: string?, -- "design" or "build": the lessons a model step reads (`./zn lessons --when <it>`)
+	phase: string?, -- the spend phase of the step's own session row
+	argv: { string }?, -- a script step: the ./zn command ("{id}" is the item)
+	where: string?, -- a script step runs in the main checkout ("main") or the step's worktree ("worktree")
+}
+
+-- Every z-nile skill and every script the chain runs, classified. Ready, stop, recombine and recording spend need
+-- no model: they are script steps, and nothing starts an agent for them.
+dispatch.STEPS = {
+	["z-ticket"] = { kind = "model", lessons = "design", phase = "capture" },
+	["z-design"] = { kind = "model", lessons = "design", phase = "prep" },
+	["z-raft"] = { kind = "model", lessons = "design", phase = "prep" },
+	["z-run"] = { kind = "model", lessons = "build", phase = "deliver" },
+	["zz-review"] = { kind = "model", lessons = "design", phase = "design-review" },
+	["z-ready"] = { kind = "script", argv = { "ready", "{id}" }, where = "main" },
+	["z-stop"] = { kind = "script", argv = { "stop", "{id}" }, where = "main" },
+	["raft-plan"] = { kind = "script", argv = { "raft-plan", "--apply" }, where = "worktree" },
+	["recombine"] = { kind = "script", argv = { "recombine" }, where = "worktree" },
+	["fold"] = { kind = "script", argv = { "fold" }, where = "worktree" },
+	["release"] = { kind = "script", argv = { "release", "{id}" }, where = "worktree" },
+	["spend"] = { kind = "script", argv = { "spend", "{id}" }, where = "worktree" },
+	["zz-stats"] = { kind = "script", argv = { "metrics" }, where = "main" },
+} :: { [string]: Step }
+-- Skills read inside a step, never run as one.
+dispatch.READ_INSIDE = { ["zz-rules"] = true, ["zz-arch"] = true, ["zz-test"] = true }
+-- zz-review's modes: the lessons each reads and the phase of its row.
+dispatch.REVIEW_MODES = {
+	design = { lessons = "design", phase = "design-review" },
+	raft = { lessons = "design", phase = "design-review" },
+	code = { lessons = "build", phase = "code-review" },
+	-- a stream's review (z-run Phase 2B) under the dispatcher: the review model of the CLI, like a code review
+	stream = { lessons = "build", phase = "code-review" },
+} :: { [string]: { lessons: string, phase: string } }
+
+-- The step `name` is, or an error naming it: a skill read inside steps, a project's skill, or an unknown name.
+function dispatch.step(name: string): Step
+	local s = dispatch.STEPS[name]
+	if s then
+		return s
+	end
+	if dispatch.READ_INSIDE[name] then
+		error(`{name} is not a step: it is read inside one`, 0)
+	end
+	if not string.match(name, "^zz?%-") and string.match(name, "^[a-z][a-z0-9]*%-") then
+		error(`{name} is a project's skill, read inside a step: it is not a step`, 0)
+	end
+	error(`unknown step {name} (model steps: z-ticket, z-design, z-raft, z-run, zz-review)`, 0)
+end
+
+-- A script step's command line, `./zn` first.
+function dispatch.scriptArgv(name: string, id: string, extra: { string }?): { string }
+	local s = dispatch.step(name)
+	if s.kind ~= "script" then
+		error(`{name} is a model step`, 0)
+	end
+	local out = { "./zn" }
+	for _, a in s.argv :: { string } do
+		table.insert(out, (string.gsub(a, "{id}", id)))
+	end
+	local more: { string } = extra or {}
+	for _, a in more do
+		table.insert(out, a)
+	end
+	return out
+end
+
+-- The lessons a model step reads, and the phase of its row (zz-review's depend on its mode).
+function dispatch.lessonsOf(name: string, mode: string?): string
+	if name == "zz-review" then
+		local m = dispatch.REVIEW_MODES[mode or "design"]
+		if not m then
+			error(`zz-review has no mode {tostring(mode)} (design, raft, code, stream)`, 0)
+		end
+		return m.lessons
+	end
+	local s = dispatch.step(name)
+	if s.kind ~= "model" then
+		error(`{name} is a script step: it takes no model`, 0)
+	end
+	return s.lessons or "design"
+end
+
+function dispatch.phaseOf(name: string, mode: string?): string
+	if name == "zz-review" then
+		dispatch.lessonsOf(name, mode)
+		return dispatch.REVIEW_MODES[mode or "design"].phase
+	end
+	return dispatch.step(name).phase or "build"
+end
+
+export type PromptInput = {
+	step: string,
+	id: string, -- the item, or "" for z-ticket
+	mode: string?, -- zz-review's mode
+	skillPath: string, -- the skill's real SKILL.md (z-nile/skills/<name>/SKILL.md)
+	worktree: string,
+	stateDir: string, -- where questions.md goes
+	promptPath: string?, -- z-run: the raft's readied prompt.md
+	description: string?, -- z-ticket: the user's words
+	project: string?, -- z-ticket: the project to capture into
+}
+
+-- The prompt of a model step. It names the skill's file and the lessons command, which every CLI reads itself; no
+-- skill text, architecture map or other issue is pasted (the user's "Name the files in the prompt").
+function dispatch.prompt(p: PromptInput): string
+	local lessons = dispatch.lessonsOf(p.step, p.mode)
+	local what: string
+	if p.step == "z-ticket" then
+		what = `Read \`{p.skillPath}\` and follow it to capture this as one issue{if p.project
+			then ` in the {p.project} project`
+			else ""}: "{p.description or ""}".`
+	elseif p.step == "z-run" then
+		what =
+			`Read \`{p.skillPath}\` and follow it for {p.id}: its input is the raft's prompt, \`{p.promptPath or `./zn prompt {p.id} --path`}\`; read the whole file first.`
+	elseif p.step == "zz-review" then
+		what =
+			`Read \`{p.skillPath}\` and act as the clean adversarial reviewer of {p.id} in {p.mode or "design"} mode. Write only the review file that mode names.`
+	else
+		what = `Read \`{p.skillPath}\` and follow it for {p.id}.`
+	end
+	local lines = {
+		`You are running the z-nile step {p.step}{if p.id ~= "" then ` for {p.id}` else ""}, headless and unattended, under ./zn dispatch.`,
+		what,
+		`Before you start, run \`./zn lessons --when {lessons} --full\` and ask each lesson's check of your work.`,
+		`Work only in \`{p.worktree}\`: it is your working directory. Never edit the main checkout.`,
+		`Nobody will answer a question. When a decision needs the user (a scope change, a final review round that goes to the user, a missing credential), write \`{p.stateDir}/questions.md\`, one \`## Q<n>\` heading per question with the options and what each costs, and stop.`,
+		"Never merge a pull request and never push to main yourself: the dispatcher merges at its gates, and `git` and `gh` refuse.",
+		"Record your own spend as the skill says, without --tokens for this session: the dispatcher records this session's tokens and model.",
+	}
+	return table.concat(lines, "\n") .. "\n"
+end
+
+-- The chain's view of an item, read from tracker state (origin/main, the step's worktree, the PR, the run state).
+export type Pr = {
+	number: number,
+	state: string,
+	draft: boolean,
+	green: boolean,
+	mergeable: boolean,
+	head: string, -- the head commit the gate checked (the merge is pinned to it)
+	-- why its fetched head is not this gate's to merge (the one tracker-state function on the head, review 003 F5),
+	-- or nil; the dispatcher judges it before the chain decides
+	judged: string?,
+}
+export type Facts = {
+	id: string,
+	folder: string, -- the item's folder on origin/main
+	root: string, -- its project root
+	kind: "issue" | "raft" | "none",
+	where: string, -- origin/main: "backlog", "active", "done" or "none"
+	status: string, -- the effective status on origin/main (new, preparing, prepared, active, done)
+	design: string, -- origin/main's design: line
+	raft: string, -- origin/main's raft: line (an issue)
+	ownClaim: boolean, -- the preparing claim is the one this checkout's dispatcher made
+	localRaft: string, -- the raft: line in the rafting worktree, when the dispatcher rafted it ("" when none)
+	pr: Pr?, -- the PR of the step that holds the item now (prep, rafting or run)
+	questions: boolean, -- the run state holds questions.md
+	last: { step: string, outcome: string }?, -- the last step's outcome in the run state
+	uncovered: { string }, -- `./zn lessons --uncovered <id>` in the step's worktree, after a review step
+	autoMerge: { string },
+	description: string?, -- `dispatch new`'s words
+}
+export type Action = {
+	kind: "step" | "merge" | "stop",
+	step: string?, -- kind step: the step to run
+	target: string?, -- the item it runs on
+	gate: string?, -- kind merge or a gate stop: "prep", "raft" or "run"
+	pr: number?,
+	head: string?, -- a merge: the head commit it is pinned to
+	why: string?,
+	code: number?, -- kind stop: 0 done, 1 failure, 3 needs the user, 4 waiting at a merge gate
+}
+
+-- the most actions one chain run takes before it stops
+dispatch.MAX_ACTIONS = 30
+
+dispatch.EXIT = { done = 0, failure = 1, user = 3, gate = 4, tripwire = 5 }
+
+local REVIEW_STEPS = { ["z-design"] = true, ["z-raft"] = true, ["z-run"] = true, ["zz-review"] = true }
+
+local function stop(code: number, why: string): Action
+	return { kind = "stop", code = code, why = why }
+end
+
+-- A skill lesson's path (`<z-nile or a project>/skills/<skill>/lessons/<name>.md`): a prep PR may carry those.
+function dispatch.isLesson(path: string): boolean
+	return string.match(path, "^[^/]+/skills/[^/]+/lessons/[^/]+%.md$") ~= nil
+end
+
+-- Whether GitHub's `commits/<sha>/pulls` answer names a pull request merged into main whose merge commit is `sha`
+-- (the watermark's pull-request rule, G20; review 003 F6: into main only, never another branch).
+function dispatch.prMergedFrom(text: string, sha: string): boolean
+	local ok, list = pcall(function()
+		return serde.decode("json", text)
+	end)
+	if not ok or type(list) ~= "table" then
+		return false
+	end
+	for _, pr in list :: { any } do
+		if
+			type(pr) == "table"
+			and type(pr.merged_at) == "string"
+			and pr.merge_commit_sha == sha
+			and type(pr.base) == "table"
+			and pr.base.ref == "main"
+		then
+			return true
+		end
+	end
+	return false
+end
+
+local function gate(f: Facts, name: string, pr: Pr): Action
+	if pr.state == "CLOSED" then
+		return stop(dispatch.EXIT.failure, `the {name} PR #{pr.number} was closed without merging`)
+	end
+	if pr.state == "MERGED" then
+		return stop(
+			dispatch.EXIT.failure,
+			`the {name} PR #{pr.number} merged but origin/main does not show it: ./zn sync`
+		)
+	end
+	local carries = if name ~= "run" then pr.judged else nil
+	local head = pr.head or ""
+	if
+		name ~= "run"
+		and table.find(f.autoMerge, name)
+		and not pr.draft
+		and pr.green
+		and pr.mergeable
+		and not carries
+		and head ~= ""
+	then
+		return { kind = "merge", gate = name, pr = pr.number, target = f.id, head = head }
+	end
+	local why = if name == "run"
+		then `ready to merge: the run PR #{pr.number} is a human's to merge (then ./zn dispatch {f.id} again)`
+		elseif
+			not table.find(f.autoMerge, name)
+		then `the {name} PR #{pr.number} waits for a merge (dispatch.auto_merge leaves it to a human)`
+		elseif pr.draft then `the {name} PR #{pr.number} is a draft`
+		elseif not pr.green then `the {name} PR #{pr.number} waits for green CI`
+		elseif not pr.mergeable then `the {name} PR #{pr.number} is not mergeable`
+		elseif carries then `the {name} PR #{pr.number} waits for a human: {carries}`
+		else `the {name} PR #{pr.number} waits for a human: its head commit is unknown`
+	return { kind = "stop", code = dispatch.EXIT.gate, gate = name, pr = pr.number, why = why }
+end
+
+-- The next thing the chain does for the item. Stops first: questions.md, a failed step, a review step that left an
+-- unharvested finding. Then by state: capture, design, the prep gate, raft-plan, z-raft, the rafting gate, ready,
+-- run, the run's gate (always a human's), done.
+function dispatch.next(f: Facts): Action
+	if f.questions then
+		return stop(
+			dispatch.EXIT.user,
+			"needs the user: answer questions.md, then ./zn dispatch retry " .. f.id
+		)
+	end
+	if f.last and f.last.outcome == "tripwire" then
+		return stop(
+			dispatch.EXIT.tripwire,
+			`{f.last.step} tripped the wire: main or the main checkout moved in a way the dispatcher did not make (state.json names it); a human looks first`
+		)
+	end
+	if f.last and f.last.outcome ~= "ok" then
+		return stop(dispatch.EXIT.failure, `{f.last.step} ended {f.last.outcome}: ./zn dispatch retry {f.id}`)
+	end
+	if f.last and REVIEW_STEPS[f.last.step] and #f.uncovered > 0 then
+		return stop(
+			dispatch.EXIT.failure,
+			`{f.last.step} left unharvested findings ({table.concat(f.uncovered, "; ")}): harvest them before the chain goes on`
+		)
+	end
+	-- a step that ended ok but moved nothing stops the chain instead of running again
+	local done = f.last and f.last.outcome == "ok" and f.last.step or nil
+	if done == "z-design" and f.kind == "issue" and f.status == "new" then
+		return stop(
+			dispatch.EXIT.failure,
+			`z-design ended but {f.id} is still new on origin/main: it claimed nothing`
+		)
+	elseif done == "z-design" and f.kind == "issue" and f.status == "preparing" and not f.pr then
+		return stop(dispatch.EXIT.failure, `z-design ended without opening {f.id}'s prep PR`)
+	elseif done == "raft-plan" and f.localRaft == "" then
+		return stop(dispatch.EXIT.failure, `raft-plan put {f.id} in no raft (see its skip line)`)
+	elseif done == "z-ready" and f.kind == "raft" and f.where == "backlog" then
+		return stop(dispatch.EXIT.failure, `z-ready ended but {f.id} is not active on origin/main`)
+	elseif done == "z-run" and f.kind == "raft" and f.where == "active" and (not f.pr or f.pr.draft) then
+		return stop(
+			dispatch.EXIT.failure,
+			`z-run ended but {f.id}'s PR is still a draft: ./zn done did not run`
+		)
+	end
+	if f.kind == "none" then
+		if f.description then
+			return { kind = "step", step = "z-ticket", target = "" }
+		end
+		return stop(dispatch.EXIT.failure, `{f.id} is not on origin/main`)
+	end
+	if f.kind == "issue" then
+		if f.where == "done" then
+			return stop(dispatch.EXIT.done, `{f.id} is done`)
+		end
+		if f.raft ~= "" and (f.where == "active" or f.status == "prepared") then
+			return { kind = "step", step = "follow", target = f.raft }
+		end
+		if f.status == "new" or (f.status == "preparing" and f.ownClaim) then
+			if f.pr then
+				return gate(f, "prep", f.pr)
+			end
+			return { kind = "step", step = "z-design", target = f.id }
+		end
+		if f.status == "preparing" then
+			return stop(dispatch.EXIT.failure, `{f.id} is being prepared by another terminal`)
+		end
+		if f.status == "prepared" and f.design == "ready" then
+			if f.pr then
+				return gate(f, "raft", f.pr)
+			end
+			if f.localRaft == "" then
+				return { kind = "step", step = "raft-plan", target = f.id }
+			end
+			if not (f.last and f.last.step == "z-raft") then
+				return { kind = "step", step = "z-raft", target = f.localRaft }
+			end
+			return stop(dispatch.EXIT.failure, `{f.localRaft} is rafted but its rafting PR is not open`)
+		end
+		return stop(dispatch.EXIT.failure, `{f.id} is {f.status} with design: {f.design}: nothing to run`)
+	end
+	-- a raft
+	if f.where == "done" then
+		return { kind = "stop", code = dispatch.EXIT.done, why = `{f.id} is done`, step = "flush" }
+	end
+	if f.where == "backlog" then
+		if f.status == "prepared" then
+			return { kind = "step", step = "z-ready", target = f.id }
+		end
+		return stop(dispatch.EXIT.failure, `{f.id} is {f.status} in the backlog: z-raft prepares it first`)
+	end
+	-- active: z-run, until its PR leaves draft (`./zn done`); the merge is always a human's
+	if f.pr and f.pr.state == "OPEN" and not f.pr.draft then
+		return gate(f, "run", f.pr)
+	end
+	return { kind = "step", step = "z-run", target = f.id }
+end
+
+-- One line per CLI a model step would try, for --dry-run.
+function dispatch.describe(r: models.Resolved): { string }
+	local out: { string } = {}
+	for i, spec in models.tries(r) do
+		table.insert(
+			out,
+			`try={i} cli={spec.cli} runtime={spec.runtime} model={models.id(spec)} rank={spec.rank} max_tokens={spec.maxTokens}`
+				.. (if spec.maxCalls then ` max_calls={spec.maxCalls}` else "")
+				.. (if spec.maxMinutes then ` max_minutes={spec.maxMinutes}` else "")
+		)
+	end
+	return out
+end
+
+return dispatch
diff --git a/z-nile/engine/dispatcher.luau b/z-nile/engine/dispatcher.luau
