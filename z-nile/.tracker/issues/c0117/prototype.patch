+		'author) ( while :; do echo \'{"type":"system"}\'; sleep 0.5; done ) & hb=$!; ./zn dispatch zz-review "$id" --mode design >> "$FAKE_DIR/log" 2>&1; echo "review=$?" >> "$FAKE_DIR/log"; kill $hb; '
