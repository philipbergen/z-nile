+local function section(text: string, heading: string): string
+	local a = string.find(text, "\n" .. heading .. "\n", 1, true)
+	if not a then
+		error(`no {heading}`, 2)
+	end
+	local b = string.find(text, "\n## ", (a :: number) + #heading + 2, true)
+	return string.sub(text, a :: number, (b or 0) - 1)
+end
