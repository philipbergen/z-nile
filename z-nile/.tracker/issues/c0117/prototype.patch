+			.. " ;;",
+		'stop) ( sleep 2; touch "$FAKE_DIR/grandchild-stop" ) & echo \'{"type":"system"}\'; sleep 0.5; ./zn dispatch stop "$FAKE_STOP" >> "$FAKE_DIR/log" 2>&1; sleep 20 ;;',
