+model = "claude-opus-5-5-high"
+rank = 3
+runtime = "cursor-cli"
+# agent reports no running token count: its step stops after max_calls model calls (calls are not tokens: tune it)
+max_calls = 200
+# and a wall-time ceiling, since a stream can hide its calls (fail closed)
+max_minutes = 240
+max_tokens = 3000000
+
+[z-raft.claude]
+model = "claude-sonnet-5"
+rank = 2
+runtime = "claude-cli"
+max_tokens = 600000
+
+[z-raft.grok]
+model = "grok-4.7"
+effort = "medium"
+rank = 2
+runtime = "grok-cli"
+max_tokens = 600000
+
+[z-raft.agent]
+model = "claude-sonnet-5-thinking-high"
+rank = 2
+runtime = "cursor-cli"
+# agent reports no running token count: its step stops after max_calls model calls (calls are not tokens: tune it)
+max_calls = 200
+# and a wall-time ceiling, since a stream can hide its calls (fail closed)
+max_minutes = 240
+max_tokens = 600000
+
+[z-run.claude]
+model = "claude-opus-5-5"
+effort = "high"
+rank = 3
+runtime = "claude-cli"
+max_tokens = 12000000
+
+[z-run.grok]
+model = "grok-4.7"
+effort = "high"
+rank = 3
+runtime = "grok-cli"
+max_tokens = 12000000
+
+[z-run.agent]
+model = "claude-opus-5-5-high"
+rank = 3
+runtime = "cursor-cli"
+# agent reports no running token count: its step stops after max_calls model calls (calls are not tokens: tune it)
