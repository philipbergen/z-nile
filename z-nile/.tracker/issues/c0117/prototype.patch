diff --git a/z-nile/engine/broker.luau b/z-nile/engine/broker.luau
new file mode 100644
index 00000000..99a2caae
--- /dev/null
+++ b/z-nile/engine/broker.luau
@@ -0,0 +1,70 @@
+--!strict
+-- The publish broker (c0117): a dispatched agent's credential can't push to `main`, so the tracker's own pushes of
+-- tracker state (`publish`'s lease push, `land`) from inside a step are handed to the dispatcher, which pushes them with
+-- the user's credential after checking that they are tracker state. A request is a file in the broker folder
+-- (ZN_PUBLISH_BROKER); the answer is a file beside it.
+local fs = require("@lune/fs")
+local process = require("@lune/process")
+local serde = require("@lune/serde")
+local task = require("@lune/task")
+
+local broker = {}
+
+broker.WAIT_SECONDS = 120
+
+local function fresh(dir: string): string
+	local r = process.exec("uuidgen", {})
+	return `{dir}/{string.lower((string.gsub(r.stdout, "%s+", "")))}`
+end
+
+-- Client side: asks the dispatcher to push `sha` onto main (with a lease on `base` when given). Waits for its answer.
+function broker.request(dir: string, sha: string, base: string?): (boolean, string)
+	fs.writeDir(dir)
+	local stem = fresh(dir)
+	fs.writeFile(`{stem}.tmp`, serde.encode("json", { sha = sha, base = base or "" }))
+	fs.move(`{stem}.tmp`, `{stem}.req`)
+	local waited = 0
+	while waited < broker.WAIT_SECONDS do
+		if fs.isFile(`{stem}.res`) then
+			local ok, res = pcall(function()
+				return serde.decode("json", fs.readFile(`{stem}.res`))
+			end)
+			fs.removeFile(`{stem}.res`)
+			if ok and type(res) == "table" then
+				return res.ok == true, tostring(res.message or "")
+			end
+			return false, "the broker's answer does not parse"
+		end
+		waited += task.wait(0.1)
+	end
+	return false, `no answer from the dispatcher's publish broker in {broker.WAIT_SECONDS} s`
+end
+
+-- Server side: answers every request in `dir` with `push(sha, base)`.
+function broker.serve(dir: string, push: (sha: string, base: string?) -> (boolean, string))
+	if not fs.isDir(dir) then
+		return
+	end
+	for _, name in fs.readDir(dir) do
+		if string.match(name, "%.req$") then
+			local stem = `{dir}/{string.sub(name, 1, -5)}`
+			local ok, req = pcall(function()
+				return serde.decode("json", fs.readFile(`{stem}.req`))
+			end)
+			fs.removeFile(`{stem}.req`)
+			local good, message = false, "the request does not parse"
+			if
+				ok
+				and type(req) == "table"
+				and type(req.sha) == "string"
+				and string.match(req.sha, "^%x+$")
+			then
+				good, message = push(req.sha, if req.base ~= "" then req.base else nil)
+			end
+			fs.writeFile(`{stem}.tmp`, serde.encode("json", { ok = good, message = message }))
+			fs.move(`{stem}.tmp`, `{stem}.res`)
+		end
+	end
+end
+
+return broker
diff --git a/z-nile/engine/credential.luau b/z-nile/engine/credential.luau
new file mode 100644
index 00000000..3023d828
--- /dev/null
+++ b/z-nile/engine/credential.luau
@@ -0,0 +1,76 @@
+--!strict
+-- The agent's GitHub credential (c0117, the user's "Bot token, no bypass"): a dispatched model step runs with a token
+-- of its own (a fine-grained token or a GitHub App's) that can push branches and open pull requests but can't merge,
+-- bypass `main`'s protection or write protection or rulesets. The user's token never enters the step's environment:
+-- GH_TOKEN and GITHUB_TOKEN are the agent's, gh reads an empty configuration folder of the step's own, and git's
+-- credential helpers are reset to one that answers with the agent's token. What the OS can't stop: a process of the
+-- same user can still read the user's own credentials where they live (the keychain, ~/.config/gh); only a separate
+-- OS user would close that, and the dispatcher's tripwire and main's protection are what catch its use.
+local fs = require("@lune/fs")
+local process = require("@lune/process")
+
+local credential = {}
+
+-- Where the agent's token is read from: the file ZN_AGENT_TOKEN_FILE names (then nowhere else), else
+-- ~/.config/zn/agent-token, else the macOS keychain item `zn-dispatch-agent`.
+credential.KEYCHAIN = "zn-dispatch-agent"
+
+function credential.token(): (string?, string)
+	local file = process.env.ZN_AGENT_TOKEN_FILE
+	if file and file ~= "" then
+		-- a named file is the only place looked at
+		local t = if fs.isFile(file) then (string.gsub(fs.readFile(file), "%s+", "")) else ""
+		if t ~= "" then
+			return t, file
+		end
+		return nil,
+			`no agent credential in {file} (ZN_AGENT_TOKEN_FILE): store the agent's token first (zz-rules, Dispatch, the agent credential)`
+	end
+	local home = process.env.HOME or ""
+	for _, path in { `{home}/.config/zn/agent-token` } do
+		if path ~= "" and fs.isFile(path) then
+			local t = (string.gsub(fs.readFile(path), "%s+", ""))
+			if t ~= "" then
+				return t, path
+			end
+		end
+	end
+	local r = process.exec("security", { "find-generic-password", "-s", credential.KEYCHAIN, "-w" })
+	if r.ok then
+		local t = (string.gsub(r.stdout, "%s+", ""))
+		if t ~= "" then
+			return t, `keychain {credential.KEYCHAIN}`
+		end
+	end
+	return nil,
+		"no agent credential: store the agent's token (zz-rules, Dispatch, the agent credential) first"
+end
+
+-- The variables a step's environment gets on top of `base` (the dispatcher's): the agent's token for gh and git, an
+-- empty gh configuration folder, no ssh agent, no prompts. git configuration entries are appended after any the
+-- environment already carries (the repository guards' own, in a check), never in their place.
+function credential.agentEnv(
+	base: { [string]: string? },
+	token: string,
+	configDir: string
+): { [string]: string }
+	fs.writeDir(configDir)
+	local n = tonumber(base.GIT_CONFIG_COUNT or "0") or 0
+	local env: { [string]: string } = {
+		GH_TOKEN = token,
+		GITHUB_TOKEN = token,
+		ZN_AGENT_GH_TOKEN = token,
+		GH_CONFIG_DIR = configDir,
+		GH_PROMPT_DISABLED = "1",
+		GIT_TERMINAL_PROMPT = "0",
+		SSH_AUTH_SOCK = "",
+		GIT_CONFIG_COUNT = tostring(n + 2),
+		[`GIT_CONFIG_KEY_{n}`] = "credential.helper",
+		[`GIT_CONFIG_VALUE_{n}`] = "",
+		[`GIT_CONFIG_KEY_{n + 1}`] = "credential.helper",
+		[`GIT_CONFIG_VALUE_{n + 1}`] = '!f() { test "$1" = get && echo username=x-access-token && echo "password=$ZN_AGENT_GH_TOKEN"; }; f',
+	}
+	return env
+end
+
+return credential
diff --git a/z-nile/engine/dispatch.luau b/z-nile/engine/dispatch.luau
new file mode 100644
index 00000000..b0da325b
--- /dev/null
+++ b/z-nile/engine/dispatch.luau
@@ -0,0 +1,315 @@
+--!strict
+-- The dispatcher's rules (c0117), pure: which steps are scripts and which need a model, the prompt a model step gets,
+-- and the chain: from an item's tracker state, the next step, merge or stop. dispatcher.luau reads the state, runs the
+-- steps and records their spend; it never reads a model's prose to decide.
+local models = require("./models")
+
+local dispatch = {}
+
+export type Step = {
+	kind: "model" | "script",
+	lessons: string?, -- "design" or "build": the lessons a model step reads (`./zn lessons --when <it>`)
+	phase: string?, -- the spend phase of the step's own session row
+	argv: { string }?, -- a script step: the ./zn command ("{id}" is the item)
+	where: string?, -- a script step runs in the main checkout ("main") or the step's worktree ("worktree")
+}
+
+-- Every z-nile skill and every script the chain runs, classified. Ready, stop, recombine and recording spend need
+-- no model: they are script steps, and nothing starts an agent for them.
+dispatch.STEPS = {
+	["z-ticket"] = { kind = "model", lessons = "design", phase = "capture" },
+	["z-design"] = { kind = "model", lessons = "design", phase = "prep" },
+	["z-raft"] = { kind = "model", lessons = "design", phase = "prep" },
+	["z-run"] = { kind = "model", lessons = "build", phase = "deliver" },
+	["zz-review"] = { kind = "model", lessons = "design", phase = "design-review" },
+	["z-ready"] = { kind = "script", argv = { "ready", "{id}" }, where = "main" },
+	["z-stop"] = { kind = "script", argv = { "stop", "{id}" }, where = "main" },
+	["raft-plan"] = { kind = "script", argv = { "raft-plan", "--apply" }, where = "worktree" },
+	["recombine"] = { kind = "script", argv = { "recombine" }, where = "worktree" },
+	["fold"] = { kind = "script", argv = { "fold" }, where = "worktree" },
+	["release"] = { kind = "script", argv = { "release", "{id}" }, where = "worktree" },
+	["spend"] = { kind = "script", argv = { "spend", "{id}" }, where = "worktree" },
+	["zz-stats"] = { kind = "script", argv = { "metrics" }, where = "main" },
+} :: { [string]: Step }
+-- Skills read inside a step, never run as one.
+dispatch.READ_INSIDE = { ["zz-rules"] = true, ["zz-arch"] = true, ["zz-test"] = true }
+-- zz-review's modes: the lessons each reads and the phase of its row.
+dispatch.REVIEW_MODES = {
+	design = { lessons = "design", phase = "design-review" },
+	raft = { lessons = "design", phase = "design-review" },
+	code = { lessons = "build", phase = "code-review" },
+	-- a stream's review (z-run Phase 2B) under the dispatcher: the review model of the CLI, like a code review
+	stream = { lessons = "build", phase = "code-review" },
+} :: { [string]: { lessons: string, phase: string } }
+
+-- The step `name` is, or an error naming it: a skill read inside steps, a project's skill, or an unknown name.
+function dispatch.step(name: string): Step
+	local s = dispatch.STEPS[name]
+	if s then
+		return s
+	end
+	if dispatch.READ_INSIDE[name] then
+		error(`{name} is not a step: it is read inside one`, 0)
+	end
+	if not string.match(name, "^zz?%-") and string.match(name, "^[a-z][a-z0-9]*%-") then
+		error(`{name} is a project's skill, read inside a step: it is not a step`, 0)
+	end
+	error(`unknown step {name} (model steps: z-ticket, z-design, z-raft, z-run, zz-review)`, 0)
+end
+
+-- A script step's command line, `./zn` first.
+function dispatch.scriptArgv(name: string, id: string, extra: { string }?): { string }
+	local s = dispatch.step(name)
+	if s.kind ~= "script" then
+		error(`{name} is a model step`, 0)
+	end
+	local out = { "./zn" }
+	for _, a in s.argv :: { string } do
+		table.insert(out, (string.gsub(a, "{id}", id)))
+	end
+	local more: { string } = extra or {}
+	for _, a in more do
+		table.insert(out, a)
+	end
+	return out
+end
+
+-- The lessons a model step reads, and the phase of its row (zz-review's depend on its mode).
+function dispatch.lessonsOf(name: string, mode: string?): string
+	if name == "zz-review" then
+		local m = dispatch.REVIEW_MODES[mode or "design"]
+		if not m then
+			error(`zz-review has no mode {tostring(mode)} (design, raft, code, stream)`, 0)
+		end
+		return m.lessons
+	end
+	local s = dispatch.step(name)
+	if s.kind ~= "model" then
+		error(`{name} is a script step: it takes no model`, 0)
+	end
+	return s.lessons or "design"
+end
+
+function dispatch.phaseOf(name: string, mode: string?): string
+	if name == "zz-review" then
+		dispatch.lessonsOf(name, mode)
+		return dispatch.REVIEW_MODES[mode or "design"].phase
+	end
+	return dispatch.step(name).phase or "build"
+end
+
+export type PromptInput = {
+	step: string,
+	id: string, -- the item, or "" for z-ticket
+	mode: string?, -- zz-review's mode
+	skillPath: string, -- the skill's real SKILL.md (z-nile/skills/<name>/SKILL.md)
+	worktree: string,
+	stateDir: string, -- where questions.md goes
+	promptPath: string?, -- z-run: the raft's readied prompt.md
+	description: string?, -- z-ticket: the user's words
+	project: string?, -- z-ticket: the project to capture into
+}
+
+-- The prompt of a model step. It names the skill's file and the lessons command, which every CLI reads itself; no
+-- skill text, architecture map or other issue is pasted (the user's "Name the files in the prompt").
+function dispatch.prompt(p: PromptInput): string
+	local lessons = dispatch.lessonsOf(p.step, p.mode)
+	local what: string
+	if p.step == "z-ticket" then
+		what = `Read \`{p.skillPath}\` and follow it to capture this as one issue{if p.project
+			then ` in the {p.project} project`
+			else ""}: "{p.description or ""}".`
+	elseif p.step == "z-run" then
+		what =
+			`Read \`{p.skillPath}\` and follow it for {p.id}: its input is the raft's prompt, \`{p.promptPath or `./zn prompt {p.id} --path`}\`; read the whole file first.`
+	elseif p.step == "zz-review" then
+		what =
+			`Read \`{p.skillPath}\` and act as the clean adversarial reviewer of {p.id} in {p.mode or "design"} mode. Write only the review file that mode names.`
+	else
+		what = `Read \`{p.skillPath}\` and follow it for {p.id}.`
+	end
+	local lines = {
+		`You are running the z-nile step {p.step}{if p.id ~= "" then ` for {p.id}` else ""}, headless and unattended, under ./zn dispatch.`,
+		what,
+		`Before you start, run \`./zn lessons --when {lessons} --full\` and ask each lesson's check of your work.`,
+		`Work only in \`{p.worktree}\`: it is your working directory. Never edit the main checkout.`,
+		`Nobody will answer a question. When a decision needs the user (a scope change, a final review round that goes to the user, a missing credential), write \`{p.stateDir}/questions.md\`, one \`## Q<n>\` heading per question with the options and what each costs, and stop.`,
+		"Never merge a pull request and never push to main yourself: the dispatcher merges at its gates, and `git` and `gh` refuse.",
+		"Record your own spend as the skill says, without --tokens for this session: the dispatcher records this session's tokens and model.",
+	}
+	return table.concat(lines, "\n") .. "\n"
+end
+
+-- The chain's view of an item, read from tracker state (origin/main, the step's worktree, the PR, the run state).
+export type Pr = { number: number, state: string, draft: boolean, green: boolean, mergeable: boolean }
+export type Facts = {
+	id: string,
+	kind: "issue" | "raft" | "none",
+	where: string, -- origin/main: "backlog", "active", "done" or "none"
+	status: string, -- the effective status on origin/main (new, preparing, prepared, active, done)
+	design: string, -- origin/main's design: line
+	raft: string, -- origin/main's raft: line (an issue)
+	ownClaim: boolean, -- the preparing claim is the one this checkout's dispatcher made
+	localRaft: string, -- the raft: line in the rafting worktree, when the dispatcher rafted it ("" when none)
+	pr: Pr?, -- the PR of the step that holds the item now (prep, rafting or run)
+	questions: boolean, -- the run state holds questions.md
+	last: { step: string, outcome: string }?, -- the last step's outcome in the run state
+	uncovered: { string }, -- `./zn lessons --uncovered <id>` in the step's worktree, after a review step
+	autoMerge: { string },
+	description: string?, -- `dispatch new`'s words
+}
+export type Action = {
+	kind: "step" | "merge" | "stop",
+	step: string?, -- kind step: the step to run
+	target: string?, -- the item it runs on
+	gate: string?, -- kind merge or a gate stop: "prep", "raft" or "run"
+	pr: number?,
+	why: string?,
+	code: number?, -- kind stop: 0 done, 1 failure, 3 needs the user, 4 waiting at a merge gate
+}
+
+-- the most actions one chain run takes before it stops
+dispatch.MAX_ACTIONS = 30
+
+dispatch.EXIT = { done = 0, failure = 1, user = 3, gate = 4, tripwire = 5 }
+
+local REVIEW_STEPS = { ["z-design"] = true, ["z-raft"] = true, ["z-run"] = true, ["zz-review"] = true }
+
+local function stop(code: number, why: string): Action
+	return { kind = "stop", code = code, why = why }
+end
+
+local function gate(f: Facts, name: string, pr: Pr): Action
+	if pr.state == "CLOSED" then
+		return stop(dispatch.EXIT.failure, `the {name} PR #{pr.number} was closed without merging`)
+	end
+	if pr.state == "MERGED" then
+		return stop(
+			dispatch.EXIT.failure,
+			`the {name} PR #{pr.number} merged but origin/main does not show it: ./zn sync`
+		)
+	end
+	if name ~= "run" and table.find(f.autoMerge, name) and not pr.draft and pr.green and pr.mergeable then
+		return { kind = "merge", gate = name, pr = pr.number, target = f.id }
+	end
+	local why = if name == "run"
+		then `ready to merge: the run PR #{pr.number} is a human's to merge (then ./zn dispatch {f.id} again)`
+		elseif
+			not table.find(f.autoMerge, name)
+		then `the {name} PR #{pr.number} waits for a merge (dispatch.auto_merge leaves it to a human)`
+		elseif pr.draft then `the {name} PR #{pr.number} is a draft`
+		elseif not pr.green then `the {name} PR #{pr.number} waits for green CI`
+		else `the {name} PR #{pr.number} is not mergeable`
+	return { kind = "stop", code = dispatch.EXIT.gate, gate = name, pr = pr.number, why = why }
+end
+
+-- The next thing the chain does for the item. Stops first: questions.md, a failed step, a review step that left an
+-- unharvested finding. Then by state: capture, design, the prep gate, raft-plan, z-raft, the rafting gate, ready,
+-- run, the run's gate (always a human's), done.
+function dispatch.next(f: Facts): Action
+	if f.questions then
+		return stop(
+			dispatch.EXIT.user,
+			"needs the user: answer questions.md, then ./zn dispatch retry " .. f.id
+		)
+	end
+	if f.last and f.last.outcome == "tripwire" then
+		return stop(
+			dispatch.EXIT.tripwire,
+			`{f.last.step} tripped the wire: main or the main checkout moved in a way the dispatcher did not make (state.json names it); a human looks first`
+		)
+	end
+	if f.last and f.last.outcome ~= "ok" then
+		return stop(dispatch.EXIT.failure, `{f.last.step} ended {f.last.outcome}: ./zn dispatch retry {f.id}`)
+	end
+	if f.last and REVIEW_STEPS[f.last.step] and #f.uncovered > 0 then
+		return stop(
+			dispatch.EXIT.failure,
+			`{f.last.step} left unharvested findings ({table.concat(f.uncovered, "; ")}): harvest them before the chain goes on`
+		)
+	end
+	-- a step that ended ok but moved nothing stops the chain instead of running again
+	local done = f.last and f.last.outcome == "ok" and f.last.step or nil
+	if done == "z-design" and f.kind == "issue" and f.status == "new" then
+		return stop(
+			dispatch.EXIT.failure,
+			`z-design ended but {f.id} is still new on origin/main: it claimed nothing`
+		)
+	elseif done == "z-design" and f.kind == "issue" and f.status == "preparing" and not f.pr then
+		return stop(dispatch.EXIT.failure, `z-design ended without opening {f.id}'s prep PR`)
+	elseif done == "raft-plan" and f.localRaft == "" then
+		return stop(dispatch.EXIT.failure, `raft-plan put {f.id} in no raft (see its skip line)`)
+	elseif done == "z-ready" and f.kind == "raft" and f.where == "backlog" then
+		return stop(dispatch.EXIT.failure, `z-ready ended but {f.id} is not active on origin/main`)
+	elseif done == "z-run" and f.kind == "raft" and f.where == "active" and (not f.pr or f.pr.draft) then
+		return stop(
+			dispatch.EXIT.failure,
+			`z-run ended but {f.id}'s PR is still a draft: ./zn done did not run`
+		)
+	end
+	if f.kind == "none" then
+		if f.description then
+			return { kind = "step", step = "z-ticket", target = "" }
+		end
+		return stop(dispatch.EXIT.failure, `{f.id} is not on origin/main`)
+	end
+	if f.kind == "issue" then
+		if f.where == "done" then
+			return stop(dispatch.EXIT.done, `{f.id} is done`)
+		end
+		if f.raft ~= "" and (f.where == "active" or f.status == "prepared") then
+			return { kind = "step", step = "follow", target = f.raft }
+		end
+		if f.status == "new" or (f.status == "preparing" and f.ownClaim) then
+			if f.pr then
+				return gate(f, "prep", f.pr)
+			end
+			return { kind = "step", step = "z-design", target = f.id }
+		end
+		if f.status == "preparing" then
+			return stop(dispatch.EXIT.failure, `{f.id} is being prepared by another terminal`)
+		end
+		if f.status == "prepared" and f.design == "ready" then
+			if f.pr then
+				return gate(f, "raft", f.pr)
+			end
+			if f.localRaft == "" then
+				return { kind = "step", step = "raft-plan", target = f.id }
+			end
+			if not (f.last and f.last.step == "z-raft") then
+				return { kind = "step", step = "z-raft", target = f.localRaft }
+			end
+			return stop(dispatch.EXIT.failure, `{f.localRaft} is rafted but its rafting PR is not open`)
+		end
+		return stop(dispatch.EXIT.failure, `{f.id} is {f.status} with design: {f.design}: nothing to run`)
+	end
+	-- a raft
+	if f.where == "done" then
+		return { kind = "stop", code = dispatch.EXIT.done, why = `{f.id} is done`, step = "flush" }
+	end
+	if f.where == "backlog" then
+		if f.status == "prepared" then
+			return { kind = "step", step = "z-ready", target = f.id }
+		end
+		return stop(dispatch.EXIT.failure, `{f.id} is {f.status} in the backlog: z-raft prepares it first`)
+	end
+	-- active: z-run, until its PR leaves draft (`./zn done`); the merge is always a human's
+	if f.pr and f.pr.state == "OPEN" and not f.pr.draft then
+		return gate(f, "run", f.pr)
+	end
+	return { kind = "step", step = "z-run", target = f.id }
+end
+
+-- One line per CLI a model step would try, for --dry-run.
+function dispatch.describe(r: models.Resolved): { string }
+	local out: { string } = {}
+	for i, spec in models.tries(r) do
+		table.insert(
+			out,
+			`try={i} cli={spec.cli} runtime={spec.runtime} model={models.id(spec)} rank={spec.rank} max_tokens={spec.maxTokens}`
+		)
+	end
+	return out
+end
+
+return dispatch
diff --git a/z-nile/engine/dispatcher.luau b/z-nile/engine/dispatcher.luau
new file mode 100644
index 00000000..884ab132
--- /dev/null
+++ b/z-nile/engine/dispatcher.luau
@@ -0,0 +1,1147 @@
+--!strict
+-- `./zn dispatch` (c0117): runs script steps itself and model steps on .models.toml's CLIs, headless and unattended,
+-- and chains them from an item's tracker state up to the run's pull request. The rules are dispatch.luau's (pure);
+-- this module reads the state, starts the processes (runner.luau), keeps the run state and records the spend.
+--
+-- The boundary (the user's "Bot token, no bypass"): a model step runs with the agent's own GitHub credential
+-- (the credential module), which can't merge or bypass main's protection; the tracker's pushes of tracker state from inside
+-- a step go through the dispatcher's publish broker (broker.luau), which checks them and pushes with the user's
+-- credential; only the dispatcher merges; and after every step a tripwire checks that main and the main checkout moved
+-- only as the dispatcher moved them.
+--
+-- Run state (ignored, in the main checkout): .cache/dispatch/<id>/state.json, lock, questions.md (a step that needs the
+-- user), pending.json rows in state.json, stop (the stop marker), pid, stdin, gh/ (the step's empty gh configuration),
+-- and <step>-<mode>-<n>/ for a step a step dispatched (a review), with its own state; .cache/dispatch/broker/.
+local adapters = require("./adapters")
+local broker = require("./broker")
+local cred = require("./credential")
+local dispatch = require("./dispatch")
+local fs = require("@lune/fs")
+local models = require("./models")
+local process = require("@lune/process")
+local projects = require("./projects")
+local runner = require("./runner")
+local serde = require("@lune/serde")
+local sh = require("../lib/sh")
+local stdio = require("@lune/stdio")
+local store = require("./store")
+
+local dispatcher = {}
+
+export type OriginItem = { path: string, front: { [string]: string }, state: string, status: string }
+export type Ctx = {
+	fail: (string) -> never,
+	mainRoot: () -> string,
+	onGitHub: () -> boolean,
+	checking: () -> boolean, -- inside a guarded run (a spec or a check.sh): only a CLI under .cache may start
+	origin: (id: string) -> OriginItem?,
+	originIssueIds: () -> { string },
+	prView: (branch: string) -> string?, -- `gh pr view <branch> --json …`'s output, or nil
+}
+export type Attempt = {
+	step: string,
+	cli: string,
+	runtime: string,
+	model: string,
+	outcome: string, -- runner.Outcome, "tripwire", or "failed" for a CLI that never started
+	detail: string,
+	tokens: number,
+	minutes: number,
+}
+export type Row = { id: string, phase: string, tokens: number, model: string, minutes: number, note: string }
+export type State = {
+	id: string,
+	dir: string, -- the folder this state lives in
+	mode: string, -- "chain" or "step"
+	step: string?,
+	reviewMode: string?,
+	cli: string?,
+	runtime: string?,
+	model: string?,
+	run: runner.Identity?, -- the running step's group: its id, leader start time and command
+	worktree: string?,
+	startedAt: string?,
+	tokens: number?,
+	outcome: string?,
+	detail: string?,
+	follows: string?, -- the raft an issue's chain moved on to
+	merged: { number }, -- the PRs the dispatcher merged
+	pushed: { string }, -- the commits its publish broker pushed to main
+	history: { Attempt },
+	pending: { Row },
+}
+
+local HOME = ".cache/dispatch"
+-- the state folder of a step that another step dispatched (a review from its author), set once in `main`
+local nested: string? = nil
+
+local function now(): string
+	return os.date("!%Y-%m-%dT%H:%M:%SZ") :: string
+end
+
+local function trim(s: string): string
+	return sh.trim(s)
+end
+
+function dispatcher.home(ctx: Ctx): string
+	return `{ctx.mainRoot()}/{HOME}`
+end
+
+local function dirOf(ctx: Ctx, id: string): string
+	return nested or `{dispatcher.home(ctx)}/{id}`
+end
+
+local function blank(id: string, dir: string): State
+	return { id = id, dir = dir, mode = "chain", history = {}, pending = {}, merged = {}, pushed = {} }
+end
+
+local function loadAt(id: string, dir: string): State
+	local path = `{dir}/state.json`
+	if fs.isFile(path) then
+		local text = fs.readFile(path)
+		local ok, s = pcall(function()
+			return serde.decode("json", text)
+		end)
+		if ok and type(s) == "table" then
+			local st = s :: any
+			st.history = st.history or {}
+			st.pending = st.pending or {}
+			st.merged = st.merged or {}
+			st.pushed = st.pushed or {}
+			st.dir = dir
+			return st :: State
+		end
+	end
+	return blank(id, dir)
+end
+
+local function load(ctx: Ctx, id: string): State
+	return loadAt(id, dirOf(ctx, id))
+end
+
+local function save(st: State)
+	fs.writeDir(st.dir)
+	sh.writeReplacing(`{st.dir}/state.json`, serde.encode("json", st, true) .. "\n")
+end
+
+-- `<dir>/zn <args>`; returns success and captured stdout and stderr.
+local function zn(dir: string, args: { string }, quiet: boolean?): (boolean, string, string)
+	local r = process.exec(`{dir}/zn`, args, {
+		cwd = dir,
+		stdio = if quiet then "default" else { stdout = "default", stderr = "forward" },
+	})
+	return r.ok, trim(r.stdout), trim(r.stderr)
+end
+
+local function git(dir: string, args: { string }): (boolean, string)
+	local r = process.exec("git", args, { cwd = dir })
+	return r.ok, trim(r.stdout)
+end
+
+-- The worktree named `name`, made (or reused) from the main checkout.
+local function worktree(ctx: Ctx, name: string): string
+	local ok, out, err = zn(ctx.mainRoot(), { "worktree", name }, true)
+	if not ok then
+		error(`./zn worktree {name}: {err}{out}`, 0)
+	end
+	local lines = string.split(out, "\n")
+	return lines[#lines]
+end
+
+-- The caller's PATH without any z-nile/bin (a folder beside an engine with wrap.luau): the real tools resolve there,
+-- never the shims, whatever the environment says (c0117 review 001 F5).
+function dispatcher.realPath(): string
+	local out: { string } = {}
+	for _, entry in string.split(process.env.PATH or "/usr/bin:/bin", ":") do
+		if entry ~= "" and not fs.isFile(`{entry}/../engine/wrap.luau`) then
+			table.insert(out, entry)
+		end
+	end
+	return table.concat(out, ":")
+end
+
+-- The physical path of the program `name` on `path`, or nil.
+local function resolveBin(name: string, path: string): string?
+	local r = process.exec("sh", { "-c", 'command -v "$1"', "_", name }, { env = { PATH = path } })
+	if not r.ok or trim(r.stdout) == "" then
+		return nil
+	end
+	local real = process.exec("perl", { "-MCwd", "-e", "print Cwd::realpath($ARGV[0])", trim(r.stdout) })
+	return if real.ok and real.stdout ~= "" then real.stdout else trim(r.stdout)
+end
+
+-- Where a CLI that may start inside a check lives, physically.
+local function physicalCache(): string
+	-- the outermost .cache this checkout lies in (a spec's fixture is a checkout under the real one's .cache, beside
+	-- the spec's fakes), else this checkout's own
+	local here = trim(process.exec("pwd", { "-P" }).stdout) .. "/"
+	local at = string.find(here, "/.cache/", 1, true)
+	return if at then string.sub(here, 1, at + 7) else here .. ".cache/"
+end
+
+-- The run locks this process holds (flock holders that let go when it ends or dies), by folder.
+local holders: { [string]: any } = {}
+
+-- Takes the run lock of a dispatch on `dir`: an flock held by a helper that lives as long as this process, so a dead
+-- dispatcher's lock is free at once. Refuses while another live dispatcher holds it. Returns the refusal, or nil.
+local function lock(dir: string, _takeOver: boolean): string?
+	fs.writeDir(dir)
+	if holders[dir] then
+		return nil
+	end
+	local h = runner.holdLock(`{dir}/lock`)
+	if not h then
+		return `{dir} is being dispatched by another live ./zn dispatch: wait for it, or ./zn dispatch stop`
+	end
+	holders[dir] = h
+	return nil
+end
+
+local function unlock(dir: string)
+	local h = holders[dir]
+	if h then
+		h.stdin:close()
+		holders[dir] = nil
+	end
+end
+
+-- The walk of `skill` for an item: an issue's own folder; a raft's members, strongest per CLI, ordered by the
+-- raft's own walk; z-ticket's, its project's home.
+function dispatcher.resolve(skill: string, id: string, project: string?): models.Resolved
+	if id == "" then
+		local reg = projects.load(".")
+		local p = if project then projects.named(reg, project) else reg.projects[1]
+		if not p then
+			error(`no project {tostring(project)} in {projects.FILE}`, 0)
+		end
+		return models.resolve(models.walk(".", (p :: projects.Project).home), skill)
+	end
+	local item = store.get(id)
+	if item.kind == "issue" then
+		return models.resolve(models.walk(".", item.dir), skill)
+	end
+	local own = models.resolve(models.walk(".", item.dir), skill)
+	local members: { models.Resolved } = {}
+	for _, m in store.members(id) do
+		table.insert(members, models.resolve(models.walk(".", m.dir), skill))
+	end
+	return models.forRaft(own, members)
+end
+
+-- The dispatcher's settings for an item, from its own walk; any error means no auto-merge (fail closed).
+function dispatcher.settings(id: string): (models.Settings, string?)
+	local ok, r = pcall(function(): models.Settings
+		local item = if id ~= "" then store.find(id) else nil
+		return models.settings(models.walk(".", if item then item.dir else "."))
+	end)
+	if ok then
+		return r :: models.Settings, nil
+	end
+	return { autoMerge = {}, stallSeconds = models.STALL_SECONDS, toolSeconds = models.TOOL_SECONDS },
+		tostring(r)
+end
+
+local function minutesSince(t0: number): number
+	return math.floor((os.time() - t0) / 6 + 0.5) / 10
+end
+
+-- Records the rows the step's attempts spent: on the item now when its spend may be written (backlog), else kept in
+-- pending for the next legal point (a run's rows after its merge). A code review's row is printed for the author's
+-- `./zn commit` (it rides with the review file).
+local function record(ctx: Ctx, st: State, id: string, phase: string, attempts: { Attempt }, note: string)
+	for _, a in attempts do
+		if a.tokens > 0 then
+			local row: Row = {
+				id = id,
+				phase = phase,
+				tokens = a.tokens,
+				model = a.model,
+				minutes = a.minutes,
+				note = note,
+			}
+			if phase == "code-review" then
+				print(
+					`record: ./zn commit -m "{id}: {note}" --phase code-review --time {a.minutes} --tokens {a.tokens} --model {a.model}`
+				)
+			else
+				local origin = ctx.origin(id)
+				if phase == "deliver" or (origin and origin.state ~= "backlog") then
+					table.insert(st.pending, row)
+				else
+					local wt = worktree(ctx, "zn-dispatch")
+					zn(wt, { "sync" }, true)
+					local ok, out, err = zn(wt, {
+						"spend",
+						id,
+						"--phase",
+						phase,
+						"--time",
+						tostring(a.minutes),
+						"--tokens",
+						tostring(a.tokens),
+						"--model",
+						a.model,
+						"--note",
+						note,
+					}, true)
+					if ok then
+						print(`spend: {id} {phase} {a.tokens} tokens {a.model}`)
+					else
+						stdio.ewrite(
+							`dispatch: could not record {id}'s {phase} row ({err}{out}): kept as pending\n`
+						)
+						table.insert(st.pending, row)
+					end
+				end
+			end
+		end
+	end
+end
+
+-- Writes the pending rows whose item may now take them (a done raft takes its run's row as deliver).
+local function flush(ctx: Ctx, st: State)
+	local keep: { Row } = {}
+	for _, row in st.pending do
+		local origin = ctx.origin(row.id)
+		if origin and origin.state == "done" and row.phase == "deliver" then
+			local wt = worktree(ctx, "zn-dispatch")
+			zn(wt, { "sync" }, true)
+			local ok = zn(wt, {
+				"spend",
+				row.id,
+				"--phase",
+				"deliver",
+				"--time",
+				tostring(row.minutes),
+				"--tokens",
+				tostring(row.tokens),
+				"--model",
+				row.model,
+				"--note",
+				row.note,
+			}, true)
+			if not ok then
+				table.insert(keep, row)
+			end
+		else
+			table.insert(keep, row)
+		end
+	end
+	st.pending = keep
+end
+
+local function reviewFiles(dir: string): { [string]: boolean }
+	local out: { [string]: boolean } = {}
+	if fs.isDir(dir) then
+		for _, name in fs.readDir(dir) do
+			if string.match(name, "^design%-review%-%d+%.md$") or string.match(name, "^review%-%d+%.md$") then
+				out[name] = true
+			end
+		end
+	end
+	return out
+end
+
+-- origin's main, freshly fetched into a ref of the dispatcher's own (never the tracking ref an agent can rewrite).
+local function freshMain(ctx: Ctx): string?
+	local root = ctx.mainRoot()
+	if not git(root, { "fetch", "-q", "origin", "+refs/heads/main:refs/zn-dispatch/main" }) then
+		return nil
+	end
+	local ok, sha = git(root, { "rev-parse", "refs/zn-dispatch/main" })
+	return if ok then sha else nil
+end
+
+-- The paths under tracker state by the fresh main's registry (lesson zz-arch/guards-trust-only-origin).
+local function trackerPrefixes(ctx: Ctx): { string }
+	local out = { "z-nile/next" }
+	local reg = projects.at("refs/zn-dispatch/main", ctx.mainRoot())
+	if reg then
+		for _, r in projects.roots(reg) do
+			table.insert(out, r .. "/")
+		end
+	end
+	return out
+end
+
+local function stray(paths: { string }, allowed: { string }): string?
+	for _, p in paths do
+		local ok = false
+		for _, prefix in allowed do
+			if p == prefix or string.sub(p, 1, #prefix) == prefix then
+				ok = true
+			end
+		end
+		if not ok then
+			return p
+		end
+	end
+	return nil
+end
+
+local function namesOf(root: string, from: string, to: string): { string }
+	local _, out = git(root, { "diff", "--name-only", from, to })
+	local list: { string } = {}
+	for line in string.gmatch(out, "[^\n]+") do
+		table.insert(list, line)
+	end
+	return list
+end
+
+-- The publish broker's push: `sha` goes onto main with the user's credential only when everything it adds there is
+-- tracker state, on a lease on `base` (or on the fresh main).
+local function brokerPush(ctx: Ctx, st: State): (string, string?) -> (boolean, string)
+	return function(sha: string, base: string?): (boolean, string)
+		local root = ctx.mainRoot()
+		local main = freshMain(ctx)
+		if not main then
+			return false, "the dispatcher could not fetch origin's main"
+		end
+		local okBase, mb = git(root, { "merge-base", main, sha })
+		if not okBase then
+			return false, `{sha} shares no history with main`
+		end
+		local bad = stray(namesOf(root, mb, sha), trackerPrefixes(ctx))
+		if bad then
+			return false, `the dispatcher pushes only tracker state to main: {bad} is not`
+		end
+		local lease = base or main
+		local r = process.exec(
+			"git",
+			{ "push", "-q", `--force-with-lease=refs/heads/main:{lease}`, "origin", `{sha}:refs/heads/main` },
+			{ cwd = root }
+		)
+		if r.ok then
+			table.insert(st.pushed, sha)
+			return true, "pushed"
+		end
+		return false, trim(r.stderr)
+	end
+end
+
+export type Snapshot = { main: string?, head: string, status: string }
+
+local function snapshot(ctx: Ctx): Snapshot
+	local root = ctx.mainRoot()
+	local _, head = git(root, { "rev-parse", "HEAD" })
+	local _, status = git(root, { "status", "--porcelain", "--untracked-files=no" })
+	return { main = freshMain(ctx), head = head, status = status }
+end
+
+-- The tripwire, after a step's group is gone: every commit main gained during the step is one the dispatcher's broker
+-- pushed, or tracker state another terminal published; the main checkout's HEAD and tracked files did not move.
+-- Returns what tripped it, or nil.
+function dispatcher.tripwire(ctx: Ctx, st: State, before: Snapshot): string?
+	local root = ctx.mainRoot()
+	local after = snapshot(ctx)
+	if after.status ~= "" and after.status ~= before.status then
+		return `the main checkout changed: {after.status}`
+	end
+	if not before.main or not after.main then
+		return "origin's main could not be fetched to check it"
+	end
+	-- ./zn fast-forwards the main checkout after each publish: its HEAD may only move along origin's main, which the
+	-- commit check below covers
+	if after.head ~= before.head then
+		local onMain = process.exec(
+			"git",
+			{ "merge-base", "--is-ancestor", after.head, after.main :: string },
+			{ cwd = root }
+		).ok
+		local forward =
+			process.exec("git", { "merge-base", "--is-ancestor", before.head, after.head }, { cwd = root }).ok
+		if not (onMain and forward) then
+			return `the main checkout's HEAD moved from {before.head} to {after.head}, off origin's main`
+		end
+	end
+	if before.main == after.main then
+		return nil
+	end
+	local ancestor = process.exec(
+		"git",
+		{ "merge-base", "--is-ancestor", before.main :: string, after.main :: string },
+		{ cwd = root }
+	)
+	local okList, list = git(root, { "rev-list", "--reverse", `{before.main}..{after.main}` })
+	if not ancestor.ok or not okList then
+		return `origin's main was rewritten during the step ({before.main} is no longer in it)`
+	end
+	local allowed = trackerPrefixes(ctx)
+	local pushed: { [string]: boolean } = {}
+	for _, s in st.pushed do
+		pushed[s] = true
+	end
+	for sha in string.gmatch(list, "%x+") do
+		if not pushed[sha] then
+			local _, names = git(root, { "diff-tree", "--no-commit-id", "--name-only", "-r", "-m", sha })
+			local paths: { string } = {}
+			for line in string.gmatch(names, "[^\n]+") do
+				table.insert(paths, line)
+			end
+			local bad = stray(paths, allowed)
+			if bad then
+				return `main gained {sha}, which the dispatcher did not make and which changes {bad}`
+			end
+		end
+	end
+	return nil
+end
+
+-- Runs one model step: each CLI of the order in turn, moving down only when one fails on quota. Returns the outcome.
+function dispatcher.modelStep(
+	ctx: Ctx,
+	st: State,
+	step: string,
+	id: string,
+	opts: { [string]: { string } }
+): string
+	local mode = opts["--mode"] and opts["--mode"][1]
+	local project = opts["--project"] and opts["--project"][1]
+	local resolved = dispatcher.resolve(step, id, project)
+	local tries = models.tries(resolved)
+	local stateDir = st.dir
+	local cwd: string
+	if step == "zz-review" then
+		cwd = process.env.ZN_CWD or process.cwd
+		if trim(cwd) == trim(ctx.mainRoot()) then
+			error("zz-review runs in its author's worktree, not the main checkout", 0)
+		end
+	elseif step == "z-ticket" then
+		cwd = worktree(ctx, `capture-zn-{os.time()}`)
+	elseif step == "z-design" then
+		cwd = worktree(ctx, `prep-{store.get(id).slug}`)
+	elseif step == "z-raft" then
+		cwd = worktree(ctx, `raft-{opts["--for"] and opts["--for"][1] or string.lower(id)}`)
+	else
+		cwd = worktree(ctx, id)
+	end
+	local skillPath = `z-nile/skills/{step}/SKILL.md`
+	local promptPath: string? = nil
+	if step == "z-run" then
+		local ok, out = zn(ctx.mainRoot(), { "prompt", id, "--path" }, true)
+		if not ok then
+			error(`{id} has no readied prompt: ./zn ready {id} first`, 0)
+		end
+		promptPath = out
+	end
+	local prompt = dispatch.prompt({
+		step = step,
+		id = id,
+		mode = mode,
+		skillPath = skillPath,
+		worktree = cwd,
+		stateDir = stateDir,
+		promptPath = promptPath,
+		description = opts["--description"] and opts["--description"][1],
+		project = project,
+	})
+	local attempts: { Attempt } = {}
+	local function refused(spec: models.Spec, why: string)
+		table.insert(attempts, {
+			step = step,
+			cli = spec.cli,
+			runtime = spec.runtime,
+			model = models.id(spec),
+			outcome = "failed",
+			detail = why,
+			tokens = 0,
+			minutes = 0,
+		})
+		stdio.ewrite(`dispatch: {why}\n`)
+	end
+	local basePath = dispatcher.realPath()
+	local repo = trim(process.exec("pwd", { "-P" }).stdout)
+	local token, where = cred.token()
+	local env: { [string]: string } = {
+		PATH = `{repo}/z-nile/bin:{basePath}`,
+		ZN_DISPATCH = "1",
+		ZN_HEADLESS = "1",
+		ZN_DISPATCH_DIR = stateDir,
+		ZN_DISPATCH_HOME = dispatcher.home(ctx),
+		ZN_REAL_GIT = resolveBin("git", basePath) or "",
+		ZN_REAL_GH = resolveBin("gh", basePath) or "",
+		-- the top dispatcher serves the broker; a nested step uses the one it inherited
+		ZN_PUBLISH_BROKER = process.env.ZN_PUBLISH_BROKER or `{dispatcher.home(ctx)}/broker`,
+		-- this dispatcher's pid (the step's lifeline is the supervisor's stdin; this only names it)
+		ZN_DISPATCHER_PID = trim(process.exec("sh", { "-c", "echo $PPID" }).stdout),
+	}
+	if token then
+		for k, v in cred.agentEnv(process.env, token :: string, `{stateDir}/gh`) do
+			env[k] = v
+		end
+	end
+	local serving = process.env.ZN_PUBLISH_BROKER == nil or process.env.ZN_PUBLISH_BROKER == ""
+	local reviewDir: string? = nil
+	if step == "zz-review" and id ~= "" then
+		reviewDir = `{cwd}/{store.get(id).dir}`
+	end
+	local before = if reviewDir then reviewFiles(reviewDir) else {}
+	local outcome = "failed"
+	fs.writeDir(stateDir)
+	for _, spec in tries do
+		local adapter = adapters.get(spec.runtime)
+		local argv = adapter.argv({
+			prompt = prompt,
+			model = spec.model,
+			effort = spec.effort,
+			cwd = cwd,
+			session = string.lower(trim(process.exec("uuidgen", {}).stdout)),
+		})
+		local bin = resolveBin(argv[1], basePath)
+		if not token then
+			outcome = "failed"
+			refused(spec, where)
+			break
+		end
+		if not bin then
+			outcome = "failed"
+			refused(spec, `{argv[1]} is not installed (the {spec.cli} CLI)`)
+			break
+		end
+		if ctx.checking() and string.sub(bin :: string, 1, #physicalCache()) ~= physicalCache() then
+			outcome = "failed"
+			refused(
+				spec,
+				`refusing to start {argv[1]}: inside a check run only a CLI under this checkout's .cache may start (found {bin})`
+			)
+			break
+		end
+		argv[1] = bin :: string
+		local t0 = os.time()
+		print(
+			`dispatch: {step} {id} on {spec.cli} ({spec.runtime}, {models.id(spec)}, max_tokens {spec.maxTokens})`
+		)
+		st.step, st.cli, st.runtime, st.model = step, spec.cli, spec.runtime, models.id(spec)
+		st.worktree, st.startedAt, st.outcome, st.reviewMode = cwd, now(), "running", mode
+		save(st)
+		local shot = if serving then snapshot(ctx) else nil
+		local push = brokerPush(ctx, st)
+		local result = runner.run({
+			argv = argv,
+			cwd = cwd,
+			env = env,
+			stdin = if adapters.STDIN[spec.runtime] then prompt else nil,
+			adapter = adapter,
+			cap = spec.maxTokens,
+			stallSeconds = resolved.settings.stallSeconds,
+			toolSeconds = resolved.settings.toolSeconds,
+			stateDir = stateDir,
+			onStart = function(identity: runner.Identity)
+				st.run = identity
+				save(st)
+			end,
+			onTick = if serving
+				then function()
+					broker.serve(env.ZN_PUBLISH_BROKER, push)
+				end
+				else nil,
+		})
+		local outcomeNow: string = result.outcome
+		local detail = result.detail
+		if shot then
+			broker.serve(env.ZN_PUBLISH_BROKER, push)
+			local tripped = dispatcher.tripwire(ctx, st, shot :: Snapshot)
+			if tripped then
+				outcomeNow, detail = "tripwire", tripped
+				stdio.ewrite(`dispatch: TRIPWIRE: {tripped}\n`)
+			end
+		end
+		table.insert(attempts, {
+			step = step,
+			cli = spec.cli,
+			runtime = spec.runtime,
+			model = models.id(spec),
+			outcome = outcomeNow,
+			detail = detail,
+			tokens = result.tokens,
+			minutes = minutesSince(t0),
+		})
+		print(`dispatch: {step} on {spec.cli}: {outcomeNow} ({detail}), {result.tokens} tokens`)
+		outcome = outcomeNow
+		if outcomeNow ~= "quota" then
+			break
+		end
+	end
+	if outcome == "quota" then
+		stdio.ewrite(`dispatch: every CLI in the order failed on quota\n`)
+	end
+	for _, a in attempts do
+		table.insert(st.history, a)
+	end
+	-- the item z-ticket made: the one new issue on origin/main
+	local target = id
+	if step == "z-ticket" and outcome == "ok" then
+		local made: { string } = {}
+		local had: { [string]: boolean } = {}
+		local earlier: { string } = opts["--before"] or {}
+		for _, i in earlier do
+			had[i] = true
+		end
+		for _, i in ctx.originIssueIds() do
+			if not had[i] then
+				table.insert(made, i)
+			end
+		end
+		if #made ~= 1 then
+			outcome = "failed"
+			local why: Attempt = {
+				step = step :: string,
+				cli = "",
+				runtime = "",
+				model = "",
+				outcome = "failed",
+				detail = `z-ticket made {#made} issues on origin/main, not one`,
+				tokens = 0,
+				minutes = 0,
+			}
+			table.insert(attempts, why)
+		else
+			target = made[1]
+			st.id = target
+			st.dir = `{dispatcher.home(ctx)}/{target}`
+		end
+	end
+	local note = `dispatch {step}`
+	if reviewDir then
+		for name in reviewFiles(reviewDir) do
+			if not before[name] then
+				note = (string.gsub(name, "%.md$", ""))
+			end
+		end
+	end
+	if target ~= "" then
+		record(ctx, st, target, dispatch.phaseOf(step, mode), attempts, note)
+	end
+	st.outcome = outcome
+	st.detail = attempts[#attempts] and attempts[#attempts].detail or ""
+	st.tokens = 0
+	for _, a in attempts do
+		st.tokens = (st.tokens :: number) + a.tokens
+	end
+	st.run = nil
+	save(st)
+	return outcome
+end
+
+-- Runs a script step: `./zn <command>` in the main checkout or the step's worktree, never a model.
+function dispatcher.scriptStep(ctx: Ctx, st: State, step: string, id: string, extra: { string }?): string
+	local argv = dispatch.scriptArgv(step, id, extra)
+	local where = dispatch.step(step).where
+	local dir = if where == "main" then ctx.mainRoot() else worktree(ctx, `raft-{id}`)
+	print(`dispatch: {step} {id}: {table.concat(argv, " ")} (in {dir})`)
+	local args = table.move(argv, 2, #argv, 1, {})
+	local r =
+		process.exec(`{dir}/zn`, args, { cwd = dir, stdio = { stdout = "forward", stderr = "forward" } })
+	local outcome = if r.ok then "ok" else "failed"
+	st.step, st.cli, st.runtime, st.model, st.worktree, st.outcome = step, nil, nil, nil, dir, outcome
+	st.detail = if r.ok then "done" else `exit {r.code}`
+	table.insert(st.history, {
+		step = step,
+		cli = "",
+		runtime = "script",
+		model = "",
+		outcome = outcome,
+		detail = st.detail :: string,
+		tokens = 0,
+		minutes = 0,
+	})
+	save(st)
+	return outcome
+end
+
+-- `gh pr view`'s JSON as the chain's Pr, or nil.
+function dispatcher.parsePr(text: string?): dispatch.Pr?
+	if not text then
+		return nil
+	end
+	local okj, j = pcall(function()
+		return serde.decode("json", text :: string)
+	end)
+	if not okj or type(j) ~= "table" or type(j.number) ~= "number" then
+		return nil
+	end
+	local checks = j.statusCheckRollup
+	local green = type(checks) == "table" and #checks > 0
+	for _, c in (checks or {}) :: { any } do
+		local v = c.conclusion or c.state
+		if v ~= "SUCCESS" and v ~= "NEUTRAL" and v ~= "SKIPPED" then
+			green = false
+		end
+	end
+	return {
+		number = j.number,
+		state = tostring(j.state),
+		draft = j.isDraft == true,
+		green = green,
+		mergeable = j.mergeable == "MERGEABLE",
+	}
+end
+
+-- What the chain sees of `id` now.
+function dispatcher.facts(ctx: Ctx, st: State, id: string, description: string?): dispatch.Facts
+	local o = if id ~= "" then ctx.origin(id) else nil
+	local kind = if not o then "none" elseif store.isRaftId(id) then "raft" else "issue"
+	local front: { [string]: string } = if o then o.front else {}
+	local own = false
+	for _, a in st.history do
+		if a.step == "z-design" then
+			own = true
+		end
+	end
+	local localRaft = ""
+	local rafting = `{ctx.mainRoot()}/.worktree/raft-{id}`
+	if o and kind == "issue" and fs.isFile(`{rafting}/{o.path}`) then
+		localRaft = store.readFront(`{rafting}/{o.path}`).raft or ""
+	end
+	local last = if st.outcome
+			and st.step
+			and st.outcome ~= "running"
+		then { step = st.step :: string, outcome = st.outcome :: string }
+		else nil
+	local uncovered: { string } = {}
+	if last and last.outcome == "ok" and st.worktree and id ~= "" then
+		local ok, out = zn(st.worktree :: string, { "lessons", "--uncovered", id }, true)
+		if not ok then
+			for line in string.gmatch(out, "[^\n]+") do
+				table.insert(uncovered, line)
+			end
+		end
+	end
+	local pr: dispatch.Pr? = nil
+	if o then
+		local branch: string? = nil
+		if kind == "issue" and o.status == "preparing" then
+			branch = `prep-{front.slug or ""}`
+		elseif kind == "issue" and o.status == "prepared" and (front.raft or "") == "" then
+			branch = `raft-{id}`
+		elseif kind == "raft" and o.state == "active" then
+			branch = `{id}-{front.slug or ""}`
+		end
+		if branch then
+			pr = dispatcher.parsePr(ctx.prView(branch :: string))
+		end
+	end
+	local settings = dispatcher.settings(id)
+	return {
+		id = id,
+		kind = kind :: any,
+		where = if o then o.state else "none",
+		status = if o then o.status else "none",
+		design = front.design or "",
+		raft = front.raft or "",
+		ownClaim = own,
+		localRaft = localRaft,
+		pr = pr,
+		questions = fs.isFile(`{st.dir}/questions.md`),
+		last = last,
+		uncovered = uncovered,
+		autoMerge = settings.autoMerge,
+		description = description,
+	}
+end
+
+local function describeAction(a: dispatch.Action): string
+	if a.kind == "step" then
+		return `next: {a.step} {a.target or ""}`
+	elseif a.kind == "merge" then
+		return `next: merge the {a.gate} PR #{a.pr}`
+	end
+	return `stop: {a.why}`
+end
+
+-- Merges a gate's PR itself, with the real gh and the user's credential (an agent never merges).
+local function merge(ctx: Ctx, st: State, pr: number): boolean
+	local gh = resolveBin("gh", dispatcher.realPath()) or "gh"
+	local r = process.exec(gh, { "pr", "merge", tostring(pr), "--squash" }, { stdio = "forward" })
+	if r.ok then
+		table.insert(st.merged, pr)
+		save(st)
+		zn(ctx.mainRoot(), { "sync" }, true)
+	end
+	return r.ok
+end
+
+-- The chain on `id` (or a new issue from `description`), until a gate, questions.md, a failure or done.
+function dispatcher.chain(ctx: Ctx, id: string, opts: { [string]: { string } }, given: State?): number
+	local description: string? = opts["--description"] and opts["--description"][1]
+	local st = given or load(ctx, if id == "" then "new" else id)
+	if st.mode ~= "chain" and st.outcome ~= "tripwire" and st.outcome ~= "lost" then
+		-- a one-step run's outcome is not the chain's: the chain reads its own steps only (a tripped wire or a lost
+		-- step stops every run on the item until a human retries it)
+		st.outcome = nil
+	end
+	st.mode = "chain"
+	for _ = 1, dispatch.MAX_ACTIONS do
+		local f = dispatcher.facts(ctx, st, id, description)
+		local action = dispatch.next(f)
+		print(describeAction(action))
+		if opts["--dry-run"] then
+			if action.kind == "step" and action.step and dispatch.STEPS[action.step] then
+				local s = dispatch.STEPS[action.step :: string]
+				if s.kind == "model" then
+					local okr, r = pcall(dispatcher.resolve, action.step :: string, action.target or "", nil)
+					if okr then
+						for _, line in dispatch.describe(r :: models.Resolved) do
+							print(line)
+						end
+					else
+						print(`error: {r}`)
+					end
+				end
+			end
+			return 0
+		end
+		if action.kind == "stop" then
+			if action.step == "flush" then
+				flush(ctx, st)
+			end
+			save(st)
+			return action.code or 1
+		elseif action.kind == "merge" then
+			if not merge(ctx, st, action.pr :: number) then
+				print(`stop: the {action.gate} PR #{action.pr} did not merge`)
+				return dispatch.EXIT.failure
+			end
+		elseif action.step == "follow" then
+			st.follows = action.target
+			save(st)
+			unlock(st.dir)
+			id = action.target :: string
+			local nextState = load(ctx, id)
+			local refusal = lock(nextState.dir, false)
+			if refusal then
+				print(`stop: {refusal}`)
+				return dispatch.EXIT.failure
+			end
+			nextState.mode = "chain"
+			for _, a in st.history do
+				table.insert(nextState.history, a)
+			end
+			st = nextState
+		else
+			local step = action.step :: string
+			local target = action.target or ""
+			local kind = dispatch.step(step).kind
+			if kind == "script" then
+				dispatcher.scriptStep(ctx, st, step, if step == "raft-plan" then id else target)
+			else
+				local o2 = table.clone(opts)
+				if step == "z-ticket" then
+					o2["--before"] = ctx.originIssueIds()
+				elseif step == "z-raft" then
+					o2["--for"] = { id }
+				end
+				local oldDir = st.dir
+				dispatcher.modelStep(ctx, st, step, target, o2)
+				if step == "z-ticket" and st.outcome == "ok" then
+					id = st.id
+					description = nil
+					unlock(oldDir)
+					lock(st.dir, true)
+					save(st)
+				end
+			end
+			zn(ctx.mainRoot(), { "sync" }, true)
+		end
+	end
+	print(`stop: the chain ran {dispatch.MAX_ACTIONS} actions without reaching a gate`)
+	return dispatch.EXIT.failure
+end
+
+-- Every state folder of `dir` and of the steps its steps dispatched, deepest last.
+local function runsUnder(dir: string): { string }
+	local out = { dir }
+	if fs.isDir(dir) then
+		for _, name in fs.readDir(dir) do
+			if fs.isDir(`{dir}/{name}`) and fs.isFile(`{dir}/{name}/state.json`) then
+				for _, d in runsUnder(`{dir}/{name}`) do
+					table.insert(out, d)
+				end
+			end
+		end
+	end
+	return out
+end
+
+-- Stops the step of `dir` (and every step it dispatched): the stop marker, then the group, only when it is still the
+-- same run (its supervisor still holds the run's lock); otherwise it is marked lost and nothing is signalled.
+local function stopAt(id: string, dir: string): string
+	fs.writeDir(dir)
+	sh.writeReplacing(`{dir}/{runner.STOP}`, now() .. "\n")
+	local st = loadAt(id, dir)
+	local said: string
+	if st.run and runner.sameRun(st.run :: runner.Identity) then
+		runner.killGroup((st.run :: runner.Identity).pgid)
+		st.outcome, st.detail = "stopped", "stopped by ./zn dispatch stop"
+		said = "stopped"
+	elseif st.outcome == "running" then
+		st.outcome, st.detail =
+			"lost", "its process group is gone or is no longer this run's: nothing was signalled"
+		said = "lost"
+	else
+		said = "not running"
+	end
+	st.run = nil
+	save(st)
+	return said
+end
+
+-- `./zn dispatch …`
+function dispatcher.main(ctx: Ctx, pos: { string }, opts: { [string]: { string } }): number
+	local first = pos[1]
+	if not first then
+		ctx.fail(
+			'usage: ./zn dispatch <id> | new "<description>" | <step> <id> [--mode design|code|raft|stream] | stop|retry|status <id> [--dry-run]'
+		)
+	end
+	if first == "status" then
+		local id = pos[2] or ctx.fail("usage: ./zn dispatch status <id>")
+		for _, dir in runsUnder(dirOf(ctx, id)) do
+			print(serde.encode("json", loadAt(id, dir), true))
+		end
+		return 0
+	elseif first == "stop" then
+		local id = pos[2] or ctx.fail("usage: ./zn dispatch stop <id>")
+		local runs = runsUnder(dirOf(ctx, id))
+		for i = #runs, 1, -1 do
+			print(`dispatch: {id} ({runs[i]}): {stopAt(id, runs[i])}`)
+		end
+		return 0
+	elseif first == "retry" then
+		local id = pos[2] or ctx.fail("usage: ./zn dispatch retry <id>")
+		local dir = dirOf(ctx, id)
+		local refusal = lock(dir, true)
+		if refusal then
+			print(`stop: {refusal}`)
+			return dispatch.EXIT.failure
+		end
+		local st = load(ctx, id)
+		local q = `{dir}/questions.md`
+		if fs.isFile(q) then
+			local n = 1
+			while fs.isFile(`{dir}/answered-{n}.md`) do
+				n += 1
+			end
+			fs.move(q, `{dir}/answered-{n}.md`)
+		end
+		local step, mode = st.step, st.mode
+		st.outcome, st.detail = nil, nil
+		save(st)
+		local code: number
+		if mode == "step" and step then
+			local o2 = table.clone(opts)
+			if st.reviewMode then
+				o2["--mode"] = { st.reviewMode :: string }
+			end
+			code = dispatcher.oneStep(ctx, step :: string, id, o2, st)
+		else
+			code = dispatcher.chain(ctx, id, opts, st)
+		end
+		unlock(dir)
+		return code
+	elseif first == "new" then
+		local words = pos[2] or ctx.fail('usage: ./zn dispatch new "<description>" [--project <name>]')
+		local o2 = table.clone(opts)
+		o2["--description"] = { words }
+		return dispatcher.top(ctx, "", o2, function(st: State): number
+			return dispatcher.chain(ctx, "", o2, st)
+		end)
+	elseif
+		dispatch.STEPS[first]
+		or dispatch.READ_INSIDE[first]
+		or string.match(first, "^[a-z][a-z0-9]*%-")
+	then
+		local id = pos[2] or ctx.fail(`usage: ./zn dispatch {first} <id>`)
+		return dispatcher.oneStep(ctx, first, id, opts)
+	end
+	return dispatcher.top(ctx, first, opts, function(st: State): number
+		return dispatcher.chain(ctx, first, opts, st)
+	end)
+end
+
+-- A top-level run: --dry-run takes no lock and writes nothing; any other takes the item's run lock.
+function dispatcher.top(ctx: Ctx, id: string, opts: { [string]: { string } }, body: (State) -> number): number
+	local key = if id == "" then "new" else id
+	if opts["--dry-run"] then
+		return body(blank(key, dirOf(ctx, key)))
+	end
+	local dir = dirOf(ctx, key)
+	local refusal = lock(dir, false)
+	if refusal then
+		print(`stop: {refusal}`)
+		return dispatch.EXIT.failure
+	end
+	local st = load(ctx, key)
+	if st.outcome == "running" then
+		-- the run lock is free, so the dispatcher that left this running is gone: its step is lost, never resumed
+		st.outcome, st.detail, st.run = "lost", "its dispatcher died mid-step", nil
+		save(st)
+		unlock(dir)
+		print(`stop: {key}'s last step was lost (its dispatcher died): ./zn dispatch retry {key}`)
+		return dispatch.EXIT.failure
+	end
+	local ok, code = pcall(body, st)
+	unlock(dir)
+	if not ok then
+		error(code, 0)
+	end
+	return code :: number
+end
+
+-- One step on one item (`./zn dispatch <step> <id>`); --dry-run prints its plan and starts nothing. A step started
+-- from inside a dispatched step (a review from its author) gets a state folder of its own under the author's.
+function dispatcher.oneStep(
+	ctx: Ctx,
+	step: string,
+	id: string,
+	opts: { [string]: { string } },
+	given: State?
+): number
+	local s = dispatch.step(step)
+	local mode = opts["--mode"] and opts["--mode"][1]
+	if step == "zz-review" then
+		dispatch.lessonsOf(step, mode)
+	end
+	if opts["--dry-run"] then
+		print(`step={step} id={id} kind={s.kind}`)
+		if s.kind == "script" then
+			print(`run={table.concat(dispatch.scriptArgv(step, id), " ")}`)
+		else
+			for _, line in dispatch.describe(dispatcher.resolve(step, id, nil)) do
+				print(line)
+			end
+		end
+		return 0
+	end
+	local parent = process.env.ZN_DISPATCH_DIR
+	if not given and parent and parent ~= "" then
+		local n = 1
+		while fs.isDir(`{parent}/{step}-{mode or "step"}-{n}`) do
+			n += 1
+		end
+		nested = `{parent}/{step}-{mode or "step"}-{n}`
+	end
+	local function body(st: State): number
+		st.mode = "step"
+		local outcome = if s.kind == "script"
+			then dispatcher.scriptStep(ctx, st, step, id)
+			else dispatcher.modelStep(ctx, st, step, id, opts)
+		if fs.isFile(`{st.dir}/questions.md`) then
+			print(`stop: needs the user: answer {st.dir}/questions.md, then ./zn dispatch retry {id}`)
+			return dispatch.EXIT.user
+		end
+		if outcome == "tripwire" then
+			return dispatch.EXIT.tripwire
+		end
+		return if outcome == "ok" then 0 else dispatch.EXIT.failure
+	end
+	if given then
+		return body(given)
+	end
+	if nested then
+		return body(load(ctx, id))
+	end
+	return dispatcher.top(ctx, id, opts, body)
+end
+
+return dispatcher
