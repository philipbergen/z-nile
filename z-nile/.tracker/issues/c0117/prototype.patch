@@ -0,0 +1,117 @@
+# Which model runs each model step (c0117). Files stack like .gitignore: a .models.toml closer to the work (a
+# project's home, an issue's folder) replaces only the keys it sets. A step about one issue reads that issue's walk; a
+# step about a raft takes, for each CLI, the strongest of its members' specs (higher rank, then larger max_tokens).
+# Only the CLIs below are supported, and nothing defaults: a skill no file names is an error. See zz-rules, Dispatch.
+#
+# Guess (pending user): the order, the models, the ranks and the caps below are the prep's first guess.
+# max_tokens counts input + cache writes + output (cache reads are left out); the step is killed when it passes it.
+
+# The CLI priority order: the dispatcher moves down it only when a CLI fails on quota.
+order = ["claude", "grok", "agent"]
+
+[dispatch]
+# the merge gates the dispatcher passes itself when the PR is green and mergeable; the run's PR is always a human's.
+# Unset, or unreadable, means none: a closer file's `auto_merge = []` turns them off for its items.
+auto_merge = ["prep", "raft"]
+# a step that prints nothing for this long is killed (a CLI never waits for quota)
+stall_seconds = 300
+# the same limit while a tool call runs (a full gate is quiet for minutes)
+tool_seconds = 900
+
+[z-ticket.claude]
+model = "claude-sonnet-5"
+rank = 2
+runtime = "claude-cli"
+max_tokens = 300000
+
+[z-ticket.grok]
+model = "grok-4.7"
+effort = "medium"
+rank = 2
+runtime = "grok-cli"
+max_tokens = 300000
+
+[z-ticket.agent]
+model = "claude-sonnet-5-thinking-high"
+rank = 2
+runtime = "cursor-cli"
+max_tokens = 300000
+
+[z-design.claude]
+model = "claude-opus-5-5"
+effort = "high"
+rank = 3
+runtime = "claude-cli"
+max_tokens = 3000000
+
+[z-design.grok]
+model = "grok-4.7"
+effort = "high"
+rank = 3
+runtime = "grok-cli"
+max_tokens = 3000000
+
+[z-design.agent]
+model = "claude-opus-5-5-high"
+rank = 3
+runtime = "cursor-cli"
+max_tokens = 3000000
+
+[z-raft.claude]
+model = "claude-sonnet-5"
+rank = 2
+runtime = "claude-cli"
+max_tokens = 600000
+
+[z-raft.grok]
+model = "grok-4.7"
+effort = "medium"
+rank = 2
+runtime = "grok-cli"
+max_tokens = 600000
+
+[z-raft.agent]
+model = "claude-sonnet-5-thinking-high"
+rank = 2
+runtime = "cursor-cli"
+max_tokens = 600000
+
+[z-run.claude]
+model = "claude-opus-5-5"
+effort = "high"
+rank = 3
+runtime = "claude-cli"
+max_tokens = 12000000
+
+[z-run.grok]
+model = "grok-4.7"
+effort = "high"
+rank = 3
+runtime = "grok-cli"
+max_tokens = 12000000
+
+[z-run.agent]
+model = "claude-opus-5-5-high"
+rank = 3
+runtime = "cursor-cli"
+max_tokens = 12000000
+
+# The review model belongs to the CLI (the user's decision): Opus through claude or agent, grok-4.7-xhigh through grok.
+[zz-review.claude]
+model = "claude-opus-5-5"
+rank = 4
+runtime = "claude-cli"
+max_tokens = 2000000
+
+[zz-review.grok]
+model = "grok-4.7"
+effort = "xhigh"
+rank = 4
+runtime = "grok-cli"
+max_tokens = 2000000
+
+[zz-review.agent]
+model = "claude-opus-5-5-high"
+rank = 4
+runtime = "cursor-cli"
+max_tokens = 2000000
diff --git a/AGENTS.md b/AGENTS.md
index d63b5de0..7e64b9e4 100644
--- a/AGENTS.md
+++ b/AGENTS.md
@@ -2,7 +2,7 @@
 
 A first-person Pac-Man clone for Roblox, built with Rojo, strict Luau, and Lune for headless tests. New machine: see `SETUP.md`. The game is the `pickman` project, in `pickman/` (its `src/`, specs, Rojo projects and issues, `pickman/.tracker/`); the tooling that tracks and gates it is `z-nile/` (zz-rules skill, Projects).
 
-**Non-negotiable:** no code without a tracker issue, and work is done only when its `check.sh` passes. **Every change is made in a git worktree under `.worktree/` and lands by pull request** (a capture lands with `./zn land`, after a local full gate); the main checkout is never edited, except by `./zn` itself (`ready`, `stop`, `sync`, and the board refresh after every publish or `land`), which only fast-forwards it, clears ignored files from item folders that left it, and writes ignored files (`prompt.md`, `.cache/board.html`) (zz-rules skill, Worktrees and Landing a change). Start execution with `/z-run <R-id>` in a session in the main checkout. Before doing anything, read the skill that applies. The skills hold all the rules.
+**Non-negotiable:** no code without a tracker issue, and work is done only when its `check.sh` passes. **Every change is made in a git worktree under `.worktree/` and lands by pull request** (a capture lands with `./zn land`, after a local full gate); the main checkout is never edited, except by `./zn` itself (`ready`, `stop`, `sync`, and the board refresh after every publish or `land`), which only fast-forwards it, clears ignored files from item folders that left it, and writes ignored files (`prompt.md`, `.cache/board.html`, the dispatcher's run state in `.cache/dispatch/`) (zz-rules skill, Worktrees and Landing a change). Start execution with `/z-run <R-id>` in a session in the main checkout, or run the whole pipeline headless with `./zn dispatch <id>` (zz-rules skill, Dispatch; `.models.toml` names the models). Before doing anything, read the skill that applies. The skills hold all the rules.
 
 **No check may ever change the real repository.** Specs, `check.sh` files and the scripts they run change only throwaway fixtures under `.cache/`. The runner enforces it. On macOS it runs specs in a jail that denies every write to the repository outside `.cache`; a run that can't be jailed (inside another sandbox) refuses to start unless that sandbox already protects the repository. Everywhere it fences git into `.cache`, refuses ref updates and pushes into the real repository, runs one suite per checkout and project home at a time, and fails any run during which the remotes, config, branch or history changed. What it can't see (unjailed runs on Linux, `check.sh` files' own commands, work handed to processes outside the jail), review must catch (zz-test skill, "Specs never touch the real repository"). If its tripwire fires, stop and report: never repair the shared git configuration yourself.
 
