+			while fs.isFile(`{dir}/answered-{n}.md`) do
+				n += 1
+			end
+			fs.move(q, `{dir}/answered-{n}.md`)
+		end
+		local step, mode = st.step, st.mode
+		st.outcome, st.detail = nil, nil
+		save(st)
+		local code: number
+		if mode == "step" and step then
+			local o2 = table.clone(opts)
+			if st.reviewMode then
