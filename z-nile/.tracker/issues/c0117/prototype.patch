diff --git a/z-nile/engine/trackerstate.luau b/z-nile/engine/trackerstate.luau
new file mode 100644
index 00000000..9baaf157
--- /dev/null
+++ b/z-nile/engine/trackerstate.luau
@@ -0,0 +1,359 @@
+--!strict
+-- What counts as tracker state (c0117 design reviews 002 F1, F2 and 003 F1, F4, F8, F10): the one definition every
+-- guard that lets "tracker-only" changes reach `main` uses: the git wrapper, the dispatcher's publish broker, the
+-- tripwire and the watermark, and the merge gates on a PR's fetched head. Like every guard here it catches honest
+-- mistakes and casual misbehaviour; it is not a boundary against a determined agent of the same OS user (the user's
+-- "Keep same user, accept detection", 2026-10-21).
+--
+-- It reads git's raw diff with renames off (`git diff-tree -r --raw --no-renames`), so a rename's source is a deletion
+-- it sees, and every side's file mode. A change is tracker state when every path:
+--   - is under a project root of the registry it is judged against (`<root>/`, with the slash) or is exactly
+--     `z-nile/next`;
+--   - is plain: ASCII with no quote or backslash (so no Unicode normalisation games), and no component that is empty,
+--     `.`, `..` or `.git` (any case);
+--   - is a regular file (100644 or 100755: no symlink, no submodule);
+--   - is not git's or the dispatcher's configuration, in any case: `.gitattributes`, `.gitmodules`, `.models.toml`
+--     (a setting that grants authority, a gate or a cap, is never tracker state: review 003 F4);
+--   - added, doesn't differ only in case from another path of the resulting tree (macOS would overwrite it).
+-- With `sequestered`, each item's sequestered files (its `check.sh` and everything under its `acceptance/`, names in
+-- that exact case) are judged per item, never per blob (review 003 F1): for every item the change touches, the set of
+-- its sequestered files (relative to its folder) is the same before and after, each with the same content, or, for a
+-- `check.sh` whose item folder moved, the content `paths.rewrite` gives for that move (as `ready`, `stop` and `done`
+-- write it); the item lies in one folder after; and only an item that has no file on the base may add them (a new
+-- item's stub). A gate passes `own`, the ids whose sequestered files its PR may change.
+local paths = require("./paths")
+
+local trackerstate = {}
+
+export type Entry = {
+	oldMode: string,
+	newMode: string,
+	oldBlob: string,
+	newBlob: string,
+	status: string,
+	path: string,
+}
+-- a tree: path -> blob
+export type Tree = { [string]: string }
+export type Options = {
+	sequestered: boolean?,
+	own: { [string]: boolean }?, -- ids whose sequestered files may change (a gate's own items)
+	allow: ((path: string) -> boolean)?, -- paths accepted beyond the roots (a prep gate's skill lessons)
+	only: ((path: string) -> string?)?, -- a narrower rule: why a path is not this caller's, or nil
+	base: Tree?, -- the trees before and after; without them, what the entries show
+	result: Tree?,
+	read: ((blob: string) -> string?)?, -- a blob's content (for the rewrite of a moved check.sh)
+}
+
+trackerstate.COUNTER = "z-nile/next"
+-- git's empty tree: the base of a branch that shares no history with main
+trackerstate.EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"
+local REGULAR = { ["100644"] = true, ["100755"] = true }
+local NONE = "000000"
+local CONFIG = { [".gitattributes"] = true, [".gitmodules"] = true, [".models.toml"] = true }
+local LIFECYCLE = { active = true, done = true, retired = true }
+
+-- `git diff-tree -r --raw --no-renames` lines (`:<old mode> <new mode> <old blob> <new blob> <status>\t<path>`).
+function trackerstate.parseRaw(text: string): ({ Entry }?, string?)
+	local out: { Entry } = {}
+	for line in string.gmatch(text, "[^\n]+") do
+		if string.sub(line, 1, 1) == ":" then
+			local om, nm, ob, nb, st, path = string.match(line, "^:(%d+) (%d+) (%x+) (%x+) (%u)%d*\t(.+)$")
+			if not om then
+				return nil, `not a raw diff line: {line}`
+			end
+			table.insert(out, {
+				oldMode = om :: string,
+				newMode = nm :: string,
+				oldBlob = ob :: string,
+				newBlob = nb :: string,
+				status = st :: string,
+				path = path :: string,
+			})
+		end
+	end
+	return out, nil
+end
+
+-- `git ls-tree -r --full-tree` lines (`<mode> <type> <blob>\t<path>`) as a tree.
+function trackerstate.parseTree(text: string): Tree
+	local out: Tree = {}
+	for line in string.gmatch(text, "[^\n]+") do
+		local blob, path = string.match(line, "^%d+ %a+ (%x+)\t(.+)$")
+		if blob and path then
+			out[path] = blob
+		end
+	end
+	return out
+end
+
+local function under(path: string, roots: { string }): boolean
+	if path == trackerstate.COUNTER then
+		return true
+	end
+	for _, r in roots do
+		local prefix = r .. "/"
+		if string.sub(path, 1, #prefix) == prefix then
+			return true
+		end
+	end
+	return false
+end
+
+local function basename(path: string): string
+	return string.match(path, "([^/]+)$") or path
+end
+
+-- why `path` is not plain, or nil
+local function plain(path: string): string?
+	if string.find(path, "[^%w%._%-/]") then
+		return "a character outside ASCII letters, digits, `.`, `_`, `-` and `/`"
+	end
+	for _, seg in string.split(path, "/") do
+		local low = string.lower(seg)
+		if seg == "" or seg == "." or seg == ".." or low == ".git" then
+			return `a path component "{seg}"`
+		end
+	end
+	return nil
+end
+
+-- The item a path belongs to: `<root>/<issues|rafts>/[active/|done/|retired/]<ID>/<rel>` -> id, its folder, rel.
+function trackerstate.itemOf(path: string, roots: { string }): (string?, string?, string?)
+	for _, r in roots do
+		local prefix = r .. "/"
+		if string.sub(path, 1, #prefix) == prefix then
+			local rest = string.sub(path, #prefix + 1)
+			local kind, tail = string.match(rest, "^(%a+)/(.+)$")
+			if (kind == "issues" or kind == "rafts") and tail then
+				local life, after = string.match(tail :: string, "^(%a+)/(.+)$")
+				local lead = ""
+				if life and LIFECYCLE[life :: string] then
+					lead, tail = life .. "/", after
+				end
+				local id, rel = string.match(tail :: string, "^([%w]+)/(.+)$")
+				local okId = id
+					and (
+						if kind == "issues"
+							then string.match(id, "^[fdc]%d%d%d%d$") ~= nil
+							else string.match(id, "^R%d%d%d%d$") ~= nil
+					)
+				if okId then
+					return id, `{r}/{kind}/{lead}{id}`, rel
+				end
+			end
+		end
+	end
+	return nil, nil, nil
+end
+
+local function isSequesteredRel(rel: string): boolean
+	return rel == "check.sh" or string.sub(rel, 1, 11) == "acceptance/"
+end
+
+-- an item's sequestered files in a tree: rel -> { blob, dir }, and every folder the item has there
+local function seqMap(
+	tree: Tree,
+	id: string,
+	roots: { string }
+): ({ [string]: { blob: string, dir: string } }, { [string]: boolean }, boolean)
+	local out: { [string]: { blob: string, dir: string } } = {}
+	local dirs: { [string]: boolean } = {}
+	local any = false
+	for path, blob in tree do
+		local pid, dir, rel = trackerstate.itemOf(path, roots)
+		if pid == id then
+			any = true
+			dirs[dir :: string] = true
+			if isSequesteredRel(rel :: string) then
+				out[rel :: string] = { blob = blob, dir = dir :: string }
+			end
+		end
+	end
+	return out, dirs, any
+end
+
+local function count(set: { [string]: any }): number
+	local n = 0
+	for _ in set do
+		n += 1
+	end
+	return n
+end
+
+-- Whether `entries` are tracker state against `roots`. Returns nil when they are, else why not, naming the first path.
+-- `opts` may be `true` (sequestered, judged from the entries alone).
+function trackerstate.judge(entries: { Entry }, roots: { string }, given: (boolean | Options)?): string?
+	local opts: Options = if type(given) == "table" then given :: Options else { sequestered = given == true }
+	-- the trees: given, or what the entries show (enough for the per-item rule: files they don't touch are equal)
+	local base: Tree = opts.base or {}
+	local result: Tree = opts.result or {}
+	if not opts.base or not opts.result then
+		for _, e in entries do
+			if e.oldMode ~= NONE and not opts.base then
+				base[e.path] = e.oldBlob
+			end
+			if e.newMode ~= NONE and not opts.result then
+				result[e.path] = e.newBlob
+			end
+		end
+	end
+	local folded: { [string]: number } = {}
+	for path in result do
+		local low = string.lower(path)
+		folded[low] = (folded[low] or 0) + 1
+	end
+	local touched: { [string]: boolean } = {}
+	for _, e in entries do
+		local name = string.lower(basename(e.path))
+		local bad = plain(e.path)
+		if bad then
+			return `{e.path} is not tracker state ({bad})`
+		end
+		if not under(e.path, roots) and not (opts.allow and opts.allow(e.path)) then
+			return `{e.path} is not tracker state (not under a project root's folder or {trackerstate.COUNTER})`
+		end
+		if CONFIG[name] then
+			return `{e.path} is not tracker state (configuration: git's, or a setting that grants authority)`
+		end
+		for _, mode in { e.oldMode, e.newMode } do
+			if mode ~= NONE and not REGULAR[mode] then
+				return `{e.path} is not tracker state (mode {mode}: a link or a submodule)`
+			end
+		end
+		if e.status == "A" and (folded[string.lower(e.path)] or 0) > 1 then
+			return `{e.path} is not tracker state (another path differs from it only in case)`
+		end
+		if opts.only then
+			local why = opts.only(e.path)
+			if why then
+				return why
+			end
+		end
+		local id, _, rel = trackerstate.itemOf(e.path, roots)
+		if opts.sequestered and id then
+			local r = rel :: string
+			if isSequesteredRel(string.lower(r)) and not isSequesteredRel(r) then
+				return `{e.path} is a sequestered name in another case`
+			end
+			if isSequesteredRel(r) and not (opts.own and opts.own[id :: string]) then
+				touched[id :: string] = true
+			end
+		end
+	end
+	if not next(touched) then
+		return nil
+	end
+	-- the folders every touched item moved to (for paths.rewrite, as moveOnOrigin computes them)
+	local moved: { [string]: string } = {}
+	for _, e in entries do
+		local id = trackerstate.itemOf(e.path, roots)
+		if id and not moved[id :: string] then
+			local _, before = seqMap(base, id :: string, roots)
+			local _, after = seqMap(result, id :: string, roots)
+			local only = next(after)
+			if count(after) == 1 and not before[only :: string] then
+				moved[id :: string] = only :: string
+			end
+		end
+	end
+	for id in touched do
+		local before, _, existed = seqMap(base, id, roots)
+		local after, afterDirs = seqMap(result, id, roots)
+		if existed then
+			if count(afterDirs) > 1 then
+				return `{id}'s files lie in two folders after the change (its sequestered files may only move with it)`
+			end
+			for rel, b in before do
+				local a = after[rel]
+				if not a then
+					return `{b.dir}/{rel} is sequestered: a step may move it with its item, never remove it`
+				end
+				if a.blob ~= b.blob then
+					local same = false
+					if rel == "check.sh" and a.dir ~= b.dir and opts.read then
+						local old, new = opts.read(b.blob), opts.read(a.blob)
+						same = old ~= nil and new ~= nil and paths.rewrite(old :: string, moved) == new
+					end
+					if not same then
+						return `{a.dir}/{rel} is sequestered: a step may move it with its item, never change it`
+					end
+				end
+			end
+			for rel, a in after do
+				if not before[rel] then
+					return `{a.dir}/{rel} is sequestered: a step may not add one to an item that exists`
+				end
+			end
+		end
+	end
+	return nil
+end
+
+export type Git = (args: { string }) -> (boolean, string)
+
+-- The raw diff of `base..sha` through `git` (a function running git in the repository), judged with both trees.
+-- Returns nil when it is tracker state, else why not (a git failure is a refusal: fail closed).
+function trackerstate.check(
+	git: Git,
+	base: string,
+	sha: string,
+	roots: { string },
+	given: (boolean | Options)?
+): string?
+	local ok, raw = git({ "diff-tree", "-r", "--raw", "--no-renames", "--no-abbrev", base, sha })
+	if not ok then
+		return `could not read the change {base}..{sha}`
+	end
+	local entries, err = trackerstate.parseRaw(raw)
+	if not entries then
+		return err
+	end
+	local opts: Options = if type(given) == "table"
+		then table.clone(given :: Options)
+		else { sequestered = given == true }
+	local okBase, baseTree = git({ "ls-tree", "-r", "--full-tree", base })
+	local okResult, resultTree = git({ "ls-tree", "-r", "--full-tree", sha })
+	if not okBase or not okResult then
+		return `could not read the trees of {base}..{sha}`
+	end
+	opts.base = trackerstate.parseTree(baseTree)
+	opts.result = trackerstate.parseTree(resultTree)
+	opts.read = function(blob: string): string?
+		local okRead, text = git({ "cat-file", "blob", blob })
+		return if okRead then text else nil
+	end
+	return trackerstate.judge(entries :: { Entry }, roots, opts)
+end
+
+-- Each first-parent commit of `from..to`, judged against its own parent by its parent's registry (`rootsAt`), as the
+-- watermark vets main (review 003 F10: the broker judges the same way, so it never pushes what the watermark refuses).
+-- `pass(sha)` may accept a commit that isn't tracker state (the watermark's pull-request merges). Returns nil, or why
+-- the first refused commit is refused.
+function trackerstate.checkEach(
+	git: Git,
+	from: string,
+	to: string,
+	rootsAt: (ref: string) -> { string }?,
+	given: (boolean | Options)?,
+	pass: ((sha: string) -> boolean)?
+): string?
+	local ok, list = git({ "rev-list", "--reverse", "--first-parent", `{from}..{to}` })
+	if not ok then
+		return `could not list {from}..{to}`
+	end
+	for sha in string.gmatch(list, "%x+") do
+		local okParent, parent = git({ "rev-parse", "--verify", "-q", `{sha}^1` })
+		local base = if okParent then parent else trackerstate.EMPTY_TREE
+		local roots = rootsAt(if okParent then parent else sha)
+		local why = if roots
+			then trackerstate.check(git, base, sha, roots :: { string }, given)
+			else "the registry could not be read"
+		if why and not (pass and pass(sha)) then
+			return `{sha}: {why}`
+		end
+	end
+	return nil
+end
+
+return trackerstate
diff --git a/z-nile/engine/wrap.luau b/z-nile/engine/wrap.luau
new file mode 100644
index 00000000..1f034ca6
--- /dev/null
+++ b/z-nile/engine/wrap.luau
@@ -0,0 +1,132 @@
+--!strict
+-- The entry of z-nile/bin/git and z-nile/bin/gh (c0117): gathers what the tools themselves say (git's alias, git's own
+-- dry run of the push, a private fresh copy of origin's main, gh's aliases), decides with wrapper.luau, then runs the
+-- real tool ($ZN_REAL_GIT, $ZN_REAL_GH, set by ./zn dispatch) or refuses with exit 1.
+--   lune run z-nile/engine/wrap -- git|gh <args...>
+local process = require("@lune/process")
+local projects = require("./projects")
+local stdio = require("@lune/stdio")
+local trackerstate = require("./trackerstate")
+local wrapper = require("./wrapper")
+
+local args = table.clone(process.args)
+if args[1] == "--" then
+	table.remove(args, 1)
+end
+local tool = table.remove(args, 1)
+if tool ~= "git" and tool ~= "gh" then
+	stdio.ewrite("usage: lune run z-nile/engine/wrap -- git|gh <args...>\n")
+	process.exit(2)
+end
+local real = process.env[if tool == "git" then "ZN_REAL_GIT" else "ZN_REAL_GH"]
+if not real or real == "" then
+	stdio.ewrite(`{tool} (z-nile wrapper): the real {tool} is not known (run under ./zn dispatch)\n`)
+	process.exit(2)
+end
+local realTool = real :: string
+
+local function refuse(why: string): never
+	stdio.ewrite(`{tool} (z-nile wrapper): {why}\n`)
+	return process.exit(1)
+end
+
+local function run(a: { string }): (boolean, string, string)
+	local r = process.exec(realTool, a)
+	return r.ok, (string.gsub(r.stdout, "%s+$", "")), r.stderr
+end
+
+if tool == "git" then
+	local globals, command, rest = wrapper.splitGit(args)
+	local function with(more: { string }): { string }
+		local out = table.clone(globals)
+		for _, a in more do
+			table.insert(out, a)
+		end
+		return out
+	end
+	-- an alias resolves under the same options (`-c alias.p=push` included), up to a few levels
+	for _ = 1, 5 do
+		if not command then
+			break
+		end
+		local ok, expansion = run(with({ "config", "--get", `alias.{command}` }))
+		if not ok or expansion == "" then
+			break
+		end
+		if string.sub(expansion, 1, 1) == "!" then
+			refuse(`a shell alias ({command}) is refused under the dispatcher`)
+		end
+		local words = string.split(expansion, " ")
+		local nextCommand = table.remove(words, 1)
+		for _, a in rest do
+			table.insert(words, a)
+		end
+		command, rest = nextCommand, words
+	end
+	if command and wrapper.PLUMBING[command] then
+		refuse(`git {command} is refused under the dispatcher: push with git push`)
+	end
+	if command == "push" then
+		-- `-q` would silence the porcelain lines the decision reads
+		local dry: { string } = {}
+		for _, a in rest do
+			if a ~= "-q" and a ~= "--quiet" then
+				table.insert(dry, a)
+			end
+		end
+		table.insert(dry, 1, "--porcelain")
+		table.insert(dry, 1, "--dry-run")
+		table.insert(dry, 1, "push")
+		local ok, out, err = run(with(dry))
+		local updates = wrapper.parsePorcelain(out)
+		if not string.find(out, "\nDone", 1, true) and not string.match(out, "^Done") then
+			refuse(`git push refused: its dry run did not finish ({(string.gsub(err, "%s+$", ""))})`)
+		end
+		if not ok and #updates == 0 then
+			refuse(`git push refused: its dry run failed ({(string.gsub(err, "%s+$", ""))})`)
+		end
+		local url = string.match(out, "To ([^\n]+)") or "origin"
+		local fetched: boolean? = nil
+		local function fresh(): boolean
+			if fetched == nil then
+				fetched = (run(with({ "fetch", "-q", url, "+refs/heads/main:refs/zn-wrap/main" })))
+			end
+			return fetched :: boolean
+		end
+		local decision = wrapper.decidePush({
+			updates = updates,
+			check = function(src: string): string?
+				if not fresh() then
+					return "could not fetch a fresh copy of main"
+				end
+				local okSha, sha = run(with({ "rev-parse", "--verify", `{src}^\{commit\}` }))
+				if not okSha then
+					return `could not resolve {src}`
+				end
+				local okBase, base = run(with({ "merge-base", "refs/zn-wrap/main", sha }))
+				-- tracker state by the fresh main's registry: a branch can't widen what may go to main (lesson
+				-- zz-arch/guards-trust-only-origin)
+				local _, top = run(with({ "rev-parse", "--show-toplevel" }))
+				local reg = projects.at("refs/zn-wrap/main", top)
+				if not reg then
+					return "could not read the fresh main's registry"
+				end
+				return trackerstate.check(function(a: { string }): (boolean, string)
+					local done, said = run(with(a))
+					return done, said
+				end, if okBase then base else trackerstate.EMPTY_TREE, sha, projects.roots(reg :: any), true)
+			end,
+		})
+		if not decision.ok then
+			refuse(decision.why or "refused")
+		end
+	end
+else
+	local okA, aliasText = run({ "alias", "list" })
+	local decision = wrapper.decideGh(args, if okA then wrapper.parseGhAliases(aliasText) else {})
+	if not decision.ok then
+		refuse(decision.why or "refused")
+	end
+end
+local r = process.exec(realTool, args, { stdio = "inherit" })
+process.exit(r.code)
diff --git a/z-nile/engine/wrapper.luau b/z-nile/engine/wrapper.luau
new file mode 100644
index 00000000..19104d83
--- /dev/null
+++ b/z-nile/engine/wrapper.luau
@@ -0,0 +1,236 @@
+--!strict
+-- The git and gh rules for dispatched agents (c0117). A convenience layer, not the boundary: the boundary is the
+-- agent's own GitHub credential, which can't merge or bypass `main`'s protection, and the dispatcher's tripwire after
+-- every step (zz-rules, Dispatch). `z-nile/bin/git` and `z-nile/bin/gh` come first on a model step's PATH; this module
+-- decides, pure, from facts `wrap.luau` gathers from the tools themselves:
+--   - git: what a push would do is read from git's own resolution (`push --dry-run --porcelain`, after aliases and
+--     `-c` resolve), never parsed from the arguments, and what it would put on main is diffed from a private, freshly
+--     fetched copy of origin's main (refs/zn-wrap/main), never from the tracking ref the agent can rewrite;
+--   - gh: an allow-list of commands (no merge, no alias edits), and `gh api` reads plus an allow-list of write
+--     endpoints (comments); a GraphQL mutation is a write.
+local wrapper = {}
+
+export type Decision = { ok: boolean, why: string? }
+export type Update = { flag: string, src: string, dst: string }
+export type PushFacts = {
+	updates: { Update }, -- git's dry run: every ref the push would update on the remote
+	-- why what `src` would put on the fresh main is not tracker state (trackerstate.luau, the one definition), or nil
+	check: (src: string) -> string?,
+}
+
+local function refuse(why: string): Decision
+	return { ok = false, why = why }
+end
+local OK: Decision = { ok = true }
+
+-- git's options that take their value as the next word, before the command
+local GIT_VALUE: { [string]: boolean } = {
+	["-C"] = true,
+	["-c"] = true,
+	["--git-dir"] = true,
+	["--work-tree"] = true,
+	["--namespace"] = true,
+	["--config-env"] = true,
+	["--super-prefix"] = true,
+	["--exec-path"] = false,
+}
+
+-- git's own options before the command, the command, and the rest.
+function wrapper.splitGit(args: { string }): ({ string }, string?, { string })
+	local globals: { string } = {}
+	local i = 1
+	while i <= #args do
+		local a = args[i]
+		if string.sub(a, 1, 1) ~= "-" then
+			return globals, a, table.move(args, i + 1, #args, 1, {})
+		end
+		table.insert(globals, a)
+		if GIT_VALUE[a] and not string.find(a, "=", 1, true) then
+			table.insert(globals, args[i + 1] or "")
+			i += 1
+		end
+		i += 1
+	end
+	return globals, nil, {}
+end
+
+-- The commands that send objects to a remote without `git push`'s dry run: refused under the dispatcher.
+wrapper.PLUMBING = { ["send-pack"] = true, ["http-push"] = true, ["receive-pack"] = true }
+
+-- Reads `git push --dry-run --porcelain`'s lines: `<flag>\t<src>:<dst>\t<summary>`.
+function wrapper.parsePorcelain(text: string): { Update }
+	local out: { Update } = {}
+	for line in string.gmatch(text, "[^\n]+") do
+		local flag, src, dst = string.match(line, "^(.)\t([^:\t]*):([^\t]+)\t")
+		if flag and dst then
+			table.insert(out, { flag = flag, src = src :: string, dst = dst })
+		end
+	end
+	return out
+end
+
+-- A push passes when nothing it updates is main, or what it puts on main is tracker state.
+function wrapper.decidePush(f: PushFacts): Decision
+	for _, u in f.updates do
+		if u.dst == "refs/heads/main" then
+			if u.flag == "-" or u.src == "(delete)" or u.src == "" then
+				return refuse("git push would delete main")
+			end
+			local why = f.check(u.src)
+			if why then
+				return refuse(
+					`git push to main refused: {why} (open a pull request; only ./zn publishes to main)`
+				)
+			end
+		end
+	end
+	return OK
+end
+
+-- gh's global options that take a value before the command.
+local GH_VALUE: { [string]: boolean } = { ["-R"] = true, ["--repo"] = true, ["--hostname"] = true }
+-- The gh commands a dispatched agent may run (the skills' own: tests walk them); everything else is refused.
+wrapper.GH_ALLOWED = {
+	pr = {
+		create = true,
+		view = true,
+		comment = true,
+		ready = true,
+		edit = true,
+		list = true,
+		checks = true,
+		diff = true,
+		status = true,
+		close = true,
+	},
+	issue = { view = true, list = true, comment = true },
+	run = { view = true, list = true, watch = true, rerun = true, download = true },
+	workflow = { run = true, view = true, list = true },
+	release = { download = true, view = true, list = true },
+	repo = { view = true },
+	auth = { status = true },
+	api = {},
+} :: { [string]: { [string]: boolean } }
+-- `gh api` write endpoints a dispatched agent may use (a PR or issue comment); any other write is refused.
+wrapper.API_WRITES =
+	{ "^/?repos/[^/]+/[^/]+/issues/%d+/comments$", "^/?repos/[^/]+/[^/]+/pulls/%d+/comments$" }
+
+-- gh's words after its global options, with an alias expanded by `aliases` (name -> expansion words).
+function wrapper.splitGh(args: { string }, aliases: { [string]: { string } }): { string }
+	local words: { string } = {}
+	local i = 1
+	while i <= #args do
+		local a = args[i]
+		local attached = string.match(a, "^%-%-repo=")
+			or string.match(a, "^%-%-hostname=")
+			or string.match(a, "^%-R.")
+		if GH_VALUE[a] then
+			i += 1
+		elseif not attached then
+			table.move(args, i, #args, 1, words)
+			break
+		end
+		i += 1
+	end
+	local expansion = words[1] and aliases[words[1]]
+	if expansion then
+		local out = table.clone(expansion)
+		for j = 2, #words do
+			table.insert(out, words[j])
+		end
+		return out
+	end
+	return words
+end
+
+local function apiDecision(rest: { string }): Decision
+	local endpoint = ""
+	local method: string? = nil
+	local fields = false
+	local query = ""
+	local i = 1
+	while i <= #rest do
+		local a = rest[i]
+		local attached = string.match(a, "^%-X(.+)$") or string.match(a, "^%-%-method=(.+)$")
+		if attached then
+			method = string.upper(attached)
+		elseif a == "-X" or a == "--method" then
+			method = string.upper(rest[i + 1] or "")
+			i += 1
+		elseif a == "-f" or a == "-F" or a == "--field" or a == "--raw-field" or a == "--input" then
+			fields = true
+			local v = rest[i + 1] or ""
+			if string.match(v, "^query=") then
+				query = v
+			end
+			i += 1
+		elseif
+			string.match(a, "^%-[fF].")
+			or string.match(a, "^%-%-field=")
+			or string.match(a, "^%-%-raw%-field=")
+		then
+			fields = true
+			if string.find(a, "query=", 1, true) then
+				query = a
+			end
+		elseif string.sub(a, 1, 1) ~= "-" and endpoint == "" then
+			endpoint = a
+		end
+		i += 1
+	end
+	if endpoint == "graphql" then
+		if string.find(string.lower(query), "mutation", 1, true) then
+			return refuse("gh api graphql mutations are refused under the dispatcher")
+		end
+		return OK
+	end
+	local writes = (method ~= nil and method ~= "GET") or (method == nil and fields)
+	if not writes then
+		return OK
+	end
+	for _, pattern in wrapper.API_WRITES do
+		if string.match(endpoint, pattern) and (method == nil or method == "POST") then
+			return OK
+		end
+	end
+	return refuse(`gh api write to {endpoint} refused: only PR and issue comments are an agent's to write`)
+end
+
+function wrapper.decideGh(args: { string }, aliases: { [string]: { string } }): Decision
+	local words = wrapper.splitGh(args, aliases)
+	local command, sub = words[1], words[2]
+	if not command or command == "--help" or command == "--version" or command == "help" then
+		return OK
+	end
+	local allowed = wrapper.GH_ALLOWED[command]
+	if not allowed then
+		return refuse(`gh {command} is not a dispatched agent's (the dispatcher merges; zz-rules, Dispatch)`)
+	end
+	if command == "api" then
+		return apiDecision(table.move(words, 2, #words, 1, {}))
+	end
+	if not sub or not allowed[sub] then
+		return refuse(
+			`gh {command} {sub or ""} is not a dispatched agent's (the dispatcher merges; zz-rules, Dispatch)`
+		)
+	end
+	return OK
+end
+
+-- `gh alias list`'s lines (`name: expansion`), as words; an alias that runs a shell (`!…`) expands to `!`.
+function wrapper.parseGhAliases(text: string): { [string]: { string } }
+	local out: { [string]: { string } } = {}
+	for line in string.gmatch(text, "[^\n]+") do
+		local name, expansion = string.match(line, "^%s*([^:%s]+):%s*(.-)%s*$")
+		if name and expansion then
+			if string.sub(expansion, 1, 1) == "!" then
+				out[name] = { "!" }
+			else
+				out[name] = string.split((string.gsub(expansion, "^'(.*)'$", "%1")), " ")
+			end
+		end
+	end
+	return out
+end
+
+return wrapper
diff --git a/z-nile/lib/fence.sh b/z-nile/lib/fence.sh
index b2567204..d67792a0 100644
--- a/z-nile/lib/fence.sh
+++ b/z-nile/lib/fence.sh
@@ -200,3 +200,14 @@ pickman_guarded() {
   done
   echo unguarded
 }
+
+# Answers whether this process runs inside a guarded run (a spec run, or a check.sh fenced through ac.sh): prints exactly
