diff --git a/z-nile/.tracker/issues/c0121/acceptance/cli.spec.luau b/z-nile/.tracker/issues/c0121/acceptance/cli.spec.luau
new file mode 100644
index 00000000..21a5fec0
--- /dev/null
+++ b/z-nile/.tracker/issues/c0121/acceptance/cli.spec.luau
@@ -0,0 +1,132 @@
+--!strict
+-- c0121 AC4: `./zn board --serve [--port N]` in a fixture checkout: it refuses a bad port, `-O` and `--out`, a linked
+-- worktree (it runs in the main checkout), and a taken port, each naming why and serving nothing; it is guarded
+-- (refused where git's root is not the checkout) though `board` alone only reads; the usage names it. No case starts a
+-- server that keeps running: the in-process server is AC2's. Fixture under .cache/c0121-cli; git through fixture.
+local engine = require("@tests/lib/engine")
+local fixture = require("@tests/lib/fixture")
+local fs = require("@lune/fs")
+local net = require("@lune/net")
+local process = require("@lune/process")
+local t = require("@tests/lib/t")
+
+local function trim(s: string): string
+	return (string.gsub(string.gsub(s, "^%s+", ""), "%s+$", ""))
+end
+local top = trim(process.exec("git", { "rev-parse", "--show-toplevel" }).stdout)
+local REPO = `{top}/.cache/c0121-cli`
+local WT = `{top}/.cache/c0121-cli-wt`
+
+local function zn(dir: string, args: { string }): any
+	local r = fixture.exec(dir, "./zn", args)
+	return { ok = r.ok, out = r.stdout .. r.stderr }
+end
+-- A port this spec holds: a command that wrongly gets past its refusal fails on the taken port, never serves and hangs.
+local function occupy(): (number, any)
+	for _ = 1, 30 do
+		local port = math.random(30000, 60000)
+		local ok, h = pcall(net.serve :: any, port, {
+			address = "http://127.0.0.1",
+			handleRequest = function()
+				return { status = 200, body = "someone else" }
+			end,
+		})
+		if ok then
+			return port, h
+		end
+	end
+	error("no free port in 30 tries")
+end
+local function has(s: string, needle: string): boolean
+	return string.find(s, needle, 1, true) ~= nil
+end
+
+return t.spec("c0121 board --serve command", function(it)
+	it("sets up a fixture checkout with the engine and a linked worktree", function()
+		for _, d in { REPO, WT } do
+			if fs.isDir(d) then
+				fs.removeDir(d)
+			end
+		end
+		fs.writeDir(REPO)
+		process.exec("git", { "init", "-q", "-b", "main", REPO }) -- raw: init to a named path
+		fixture.git(REPO, { "config", "user.name", "c0121-cli" })
+		fixture.git(REPO, { "config", "user.email", "c0121-cli@example.invalid" })
+		engine.copy(top, REPO)
+		engine.roots(REPO)
+		fixture.git(REPO, { "add", "-A" })
+		fixture.git(REPO, { "commit", "-q", "-m", "engine" })
+		fixture.git(REPO, { "worktree", "add", "-q", "-b", "elsewhere", WT })
+		fs.writeDir(`{REPO}/nogit`)
+		engine.copy(top, `{REPO}/nogit`)
+	end)
+
+	it("refuses a port outside 1024 to 65535, or not a number", function()
+		-- values that cannot bind come first: a regression fails on them before it could reach one that binds
+		for _, p in { "70000", "abc", "1.5", "1023" } do
+			local r = zn(REPO, { "board", "--serve", "--port", p })
+			t.expect(r.ok).toBe(false)
+			t.expect(has(r.out, `--port {p} is not a port from 1024 to 65535`)).toBe(true)
+		end
+	end)
+
+	it("refuses -O, --out and --open with --serve, since it writes no file", function()
+		for _, extra in { { "-O" }, { "--out", "x.html" }, { "--open" } } do
+			local port, h = occupy()
+			local args = { "board", "--serve", "--port", tostring(port) }
+			for _, a in extra do
+				table.insert(args, a)
+			end
+			local r = zn(REPO, args)
+			h:stop()
+			t.expect(r.ok).toBe(false)
+			t.expect(has(r.out, "usage: board --serve [--port N]")).toBe(true)
+		end
+		t.expect(fs.isFile(`{REPO}/x.html`)).toBe(false)
+	end)
+
+	it("runs only in the main checkout", function()
+		local port, h = occupy()
+		local r = zn(WT, { "board", "--serve", "--port", tostring(port) })
+		h:stop()
+		t.expect(r.ok).toBe(false)
+		t.expect(has(r.out, "board --serve runs in the main checkout")).toBe(true)
+	end)
+
+	it("fails clearly when the port is taken, and serves nothing", function()
+		local port, handle = occupy()
+		local r = zn(REPO, { "board", "--serve", "--port", tostring(port) })
+		handle:stop()
+		t.expect(r.ok).toBe(false)
+		t.expect(has(r.out, `port {port} is taken`)).toBe(true)
+		t.expect(has(r.out, "--port")).toBe(true)
+	end)
+
+	it("is guarded where git's root is not the checkout, while board alone only reads", function()
+		-- run from the fixture's top (the helper checks it); ./zn changes into its own folder, nogit/, which git's root is not
+		local function nogit(args: { string }): any
+			local r = fixture.exec(REPO, "nogit/zn", args)
+			return { ok = r.ok, out = r.stdout .. r.stderr }
+		end
+		local port, h = occupy()
+		local served = nogit({ "board", "--serve", "--port", tostring(port) })
+		h:stop()
+		t.expect(served.ok).toBe(false)
+		t.expect(has(served.out, "refusing to run: git's repository root is")).toBe(true)
+		local page = nogit({ "board", "-O", "--out", ".cache/page.html" })
+		t.expect(has(page.out, "refusing to run")).toBe(false)
+	end)
+
+	it("the usage line names board --serve", function()
+		local r = zn(REPO, {})
+		t.expect(has(r.out, "board --serve [--port N]")).toBe(true)
+		-- board's own continuation line still follows board's line
+		local after = string.match(r.out, "board %[%-%-out PATH%] %[%-O%][^\n]*\n([^\n]*)") or ""
+		t.expect(has(after, "open it in the browser")).toBe(true)
+	end)
+
+	it("cleans up", function()
+		fixture.git(REPO, { "worktree", "remove", "--force", WT })
+		fs.removeDir(REPO)
+	end)
+end)
diff --git a/z-nile/.tracker/issues/c0121/acceptance/docs.spec.luau b/z-nile/.tracker/issues/c0121/acceptance/docs.spec.luau
new file mode 100644
index 00000000..3402f9cf
--- /dev/null
+++ b/z-nile/.tracker/issues/c0121/acceptance/docs.spec.luau
@@ -0,0 +1,68 @@
+--!strict
+-- c0121 AC5: zz-rules names `./zn board --serve` in the main checkout's command list and describes it in the board
+-- row, in the Design's words; the README says it is built; c0118's row words stay.
+local fs = require("@lune/fs")
+local t = require("@tests/lib/t")
+
+local SKILL = fs.readFile("z-nile/skills/zz-rules/SKILL.md")
+local function boardRow(): string
+	local row = ""
+	for line in string.gmatch(SKILL, "[^\n]+") do
+		if string.sub(line, 1, 10) == "| board | " then
+			row = line
+		end
+	end
+	return row
+end
+local function has(s: string, needle: string): boolean
+	return string.find(s, needle, 1, true) ~= nil
+end
+
+return t.spec("c0121 docs", function(it)
+	it("the main checkout's command list names board --serve and what it may do there", function()
+		local a = string.find(SKILL, "The complete list of commands that may run there:", 1, true)
+		local b = string.find(SKILL, "The tracker enforces part of this", 1, true)
+		t.expect(a ~= nil and b ~= nil).toBe(true)
+		local list = string.sub(SKILL, a :: number, b :: number)
+		t.expect(
+			has(
+				list,
+				"`./zn board --serve [--port N]` (c0121), which only reads, except for the three actions on its page (stop, retry, open), each delegated"
+			)
+		).toBe(true)
+		t.expect(has(list, "it runs only here, where the dispatcher's run state lives")).toBe(true)
+	end)
+
+	it("the board row describes the served page, its guards and its three actions", function()
+		local row = boardRow()
+		for _, phrase in
+			{
+				"`./zn board --serve [--port N]` (c0121; main checkout only; default port 8417) serves the same page on 127.0.0.1 and prints its URL once, with a session token",
+				"the page polls `/api/state` every 5 s",
+				"`gh pr list` at most every 30 s, in the background",
+				"a launched raft's spend read from its worktree",
+				'"checks unavailable" when `gh` fails',
+				'says "server is out of date: restart" when the engine changed since start',
+				"stop and retry (`./zn dispatch stop|retry <id>`) and open (the PR, else the worktree)",
+				"It refuses a foreign Host or Origin, any OPTIONS, a request without the token, an action that is not a JSON POST, and an id the model lacks.",
+				"PR and checks are live only on the served board (c0121)",
+				"Views Rafts and Issues",
+			}
+		do
+			if not has(row, phrase) then
+				error(`the board row lacks: {phrase}`)
+			end
+		end
+	end)
+
+	it("the README says the served board is built", function()
+		local text = fs.readFile("z-nile/README.md")
+		t.expect(
+			has(
+				text,
+				"`./zn board --serve` (c0121) serves the same page live from the main checkout, with stop, retry and open."
+			)
+		).toBe(true)
+		t.expect(has(text, "c0121, planned")).toBe(false)
+	end)
+end)
diff --git a/z-nile/.tracker/issues/c0121/acceptance/guard.spec.luau b/z-nile/.tracker/issues/c0121/acceptance/guard.spec.luau
new file mode 100644
index 00000000..0cc8836b
--- /dev/null
+++ b/z-nile/.tracker/issues/c0121/acceptance/guard.spec.luau
@@ -0,0 +1,265 @@
+--!strict
+-- c0121 AC1: the server's pure rules. serve.guard refuses DNS rebinding (a foreign Host), CSRF (OPTIONS, a foreign
+-- Origin, no token, an action that is not a JSON POST) and lets the rest through; serve.plan turns an action on an id
+-- the model has into an argument array or an open target, and refuses anything else; serve.parsePrs reads `gh pr list`.
+local serve = require("@znile/engine/serve")
+local t = require("@tests/lib/t")
+
+local PORT, TOKEN = 41234, "t0k"
+local function req(o: { [string]: any }): serve.Request
+	return {
+		path = o.path or "/api/state",
+		query = o.query or {},
+		method = o.method or "GET",
+		headers = o.headers or { host = `127.0.0.1:{PORT}`, ["x-zn-token"] = TOKEN },
+		body = o.body or "",
+	}
+end
+local function status(r: serve.Request): number?
+	local res = serve.guard(r, PORT, TOKEN)
+	return if res then res.status else nil
+end
+local function headers(extra: { [string]: string }): { [string]: string }
+	local h: { [string]: string } = { host = `127.0.0.1:{PORT}`, ["x-zn-token"] = TOKEN }
+	for k, v in extra do
+		h[k] = v
+	end
+	return h
+end
+
+local MODEL: any = {
+	home = { R0020 = "R0020", R0030 = "R0030", f0021 = "f0021", f0031 = "f0031", c0099 = "c0099" },
+	rafts = {
+		{
+			id = "R0020",
+			pr = { number = 7, url = "https://example.invalid/pr/7", state = "draft" },
+			worktree = "/w/R0020",
+		},
+		{ id = "R0030", worktree = "/w/R0030" },
+	} :: { any },
+	issues = {
+		{ id = "f0021", raft = "R0020" },
+		{
+			id = "f0031",
+			raft = "R0030",
+			pr = { number = 9, url = "https://example.invalid/pr/9", state = "open" },
+		},
+		{ id = "c0099" },
+	} :: { any },
+}
+
+return t.spec("c0121 server rules", function(it)
+	it("lets a same-host request with the token through, by 127.0.0.1 or localhost", function()
+		t.expect(status(req({}))).toBe(nil)
+		t.expect(status(req({ headers = { host = `localhost:{PORT}`, ["x-zn-token"] = TOKEN } }))).toBe(nil)
+		-- some clients send the bare loopback name, without the port
+		t.expect(status(req({ headers = { host = "127.0.0.1", ["x-zn-token"] = TOKEN } }))).toBe(nil)
+	end)
+
+	it("refuses a foreign Host (DNS rebinding), another port, and no Host", function()
+		t.expect(status(req({ headers = headers({ host = "evil.example" }) }))).toBe(403)
+		t.expect(status(req({ headers = headers({ host = `evil.example:{PORT}` }) }))).toBe(403)
+		t.expect(status(req({ headers = headers({ host = "127.0.0.1:1" }) }))).toBe(403)
+		t.expect(status(req({ headers = { ["x-zn-token"] = TOKEN } }))).toBe(403)
+		t.expect(status(req({ headers = headers({ host = "localhost.evil.example" }) }))).toBe(403)
+	end)
+
+	it("refuses every OPTIONS, with no CORS header, so a cross-site preflight fails", function()
+		local res = serve.guard(req({ method = "OPTIONS", path = "/api/action" }), PORT, TOKEN)
+		t.expect(res ~= nil and res.status).toBe(403)
+		for k in (res :: any).headers or {} do
+			t.expect((string.find(string.lower(k), "access-control", 1, true))).toBe(nil)
+		end
+	end)
+
+	it("refuses a foreign Origin, and lets the server's own through", function()
+		t.expect(status(req({ headers = headers({ origin = "http://evil.example" }) }))).toBe(403)
+		t.expect(status(req({ headers = headers({ origin = `http://127.0.0.1:{PORT + 1}` }) }))).toBe(403)
+		t.expect(status(req({ headers = headers({ origin = `http://127.0.0.1:{PORT}` }) }))).toBe(nil)
+		t.expect(status(req({ headers = headers({ origin = `http://localhost:{PORT}` }) }))).toBe(nil)
+	end)
+
+	it("serves the page only as a GET with the token in its query", function()
+		local h = { host = `127.0.0.1:{PORT}` }
+		t.expect(status(req({ path = "/", headers = h }))).toBe(403)
+		t.expect(status(req({ path = "/", headers = h, query = { token = "wrong" } }))).toBe(403)
+		t.expect(status(req({ path = "/", headers = h, query = { token = TOKEN } }))).toBe(nil)
+		t.expect(status(req({ path = "/", method = "POST", headers = h, query = { token = TOKEN } })))
+			.toBe(405)
+	end)
+
+	it("refuses an /api/ call without the token or with a wrong one", function()
+		t.expect(status(req({ headers = { host = `127.0.0.1:{PORT}` } }))).toBe(403)
+		t.expect(status(req({ headers = headers({ ["x-zn-token"] = "t0k2" }) }))).toBe(403)
+		t.expect(status(req({ headers = headers({ ["x-zn-token"] = "" }) }))).toBe(403)
+	end)
+
+	it("takes an action only as a POST with a JSON body; a GET never acts", function()
+		t.expect(status(req({ path = "/api/action", method = "GET" }))).toBe(405)
+		t.expect(status(req({
+			path = "/api/action",
+			method = "POST",
+			headers = headers({ ["content-type"] = "text/plain" }),
+		}))).toBe(415)
+		t.expect(status(req({ path = "/api/action", method = "POST" }))).toBe(415) -- no Content-Type
+		t.expect(status(req({
+			path = "/api/action",
+			method = "POST",
+			headers = headers({ ["content-type"] = "application/json" }),
+		}))).toBe(nil)
+		t.expect(status(req({ path = "/api/state", method = "POST" }))).toBe(405)
+	end)
+
+	it("answers 404 for any other path", function()
+		t.expect(status(req({ path = "/api/other" }))).toBe(404)
+		t.expect(status(req({ path = "/etc/passwd" }))).toBe(404)
+	end)
+
+	it(
+		"plans stop (waited) and retry (started) as argument arrays for ./zn dispatch, on ids the model has",
+		function()
+			t.expect((serve.plan(MODEL, "stop", "R0020")))
+				.toEqual({ kind = "run", args = { "dispatch", "stop", "R0020" }, wait = true })
+			t.expect((serve.plan(MODEL, "retry", "f0021")))
+				.toEqual({ kind = "run", args = { "dispatch", "retry", "f0021" }, wait = false })
+		end
+	)
+
+	it(
+		"refuses an unknown id, an id with shell text, a non-string id and an unknown action, naming why",
+		function()
+			local p1, why1 = serve.plan(MODEL, "stop", "R9999")
+			t.expect(p1).toBe(nil)
+			t.expect(string.find(why1 :: string, "unknown id", 1, true) ~= nil).toBe(true)
+			t.expect((serve.plan(MODEL, "stop", "R0020; rm -rf ~"))).toBe(nil)
+			t.expect((serve.plan(MODEL, "stop", 42 :: any))).toBe(nil)
+			local p2, why2 = serve.plan(MODEL, "delete", "R0020")
+			t.expect(p2).toBe(nil)
+			t.expect(string.find(why2 :: string, "unknown action", 1, true) ~= nil).toBe(true)
+		end
+	)
+
+	it("opens an item's own PR, else its raft's PR, else its raft's worktree, and nothing else", function()
+		t.expect((serve.plan(MODEL, "open", "f0031")))
+			.toEqual({ kind = "open", target = "https://example.invalid/pr/9" })
+		t.expect((serve.plan(MODEL, "open", "f0021")))
+			.toEqual({ kind = "open", target = "https://example.invalid/pr/7" })
+		t.expect((serve.plan(MODEL, "open", "R0020")))
+			.toEqual({ kind = "open", target = "https://example.invalid/pr/7" })
+		t.expect((serve.plan(MODEL, "open", "R0030"))).toEqual({ kind = "open", target = "/w/R0030" })
+		local p, why = serve.plan(MODEL, "open", "c0099")
+		t.expect(p).toBe(nil)
+		t.expect(string.find(why :: string, "no PR and no worktree", 1, true) ~= nil).toBe(true)
+	end)
+
+	it("reads gh pr list: drafts, and checks as passing, failing, pending or none", function()
+		local prs = serve.parsePrs([[
+[{"number":7,"headRefName":"R0020-alpha","state":"OPEN","isDraft":true,"url":"https://example.invalid/pr/7",
+  "statusCheckRollup":[{"conclusion":"SUCCESS"},{"state":"SUCCESS"}]},
+ {"number":8,"headRefName":"R0030-beta","state":"OPEN","isDraft":false,"url":"u8",
+  "statusCheckRollup":[{"conclusion":"SUCCESS"},{"conclusion":"FAILURE"}]},
+ {"number":9,"headRefName":"R0040-gamma","state":"MERGED","isDraft":false,"url":"u9",
+  "statusCheckRollup":[{"conclusion":"SUCCESS"},{"status":"IN_PROGRESS","conclusion":""}]},
+ {"number":10,"headRefName":"R0050-delta","state":"CLOSED","isDraft":false,"url":"u10","statusCheckRollup":[]},
+ {"headRefName":"no-number"}]
+]]) :: any
+		t.expect(prs["R0020-alpha"].pr)
