+      assign+=("$name=${!name}")
+    elif [[ $name != PATH && $name != PICKMAN_CLEANED ]]; then
+      dirty=1
+      case $name in [A-Za-z_]*) case $name in *[!A-Za-z0-9_]*) bad=1 ;; esac ;; *) bad=1 ;; esac
+      [[ $# -gt 0 ]] || { [[ -n $bad ]] || unset "$name"; }
+    fi
+  done
+  for p in ${fixed[@]+"${fixed[@]}"}; do kept+=("$p"); done
+  value=
+  for p in ${kept[@]+"${kept[@]}"}; do value=${value:+$value:}$p; done
+  [[ ${PATH-} == "$value" ]] || dirty=1
+  [[ -n ${GIT_CONFIG_GLOBAL+x} ]] || dirty=1
+  if [[ $# -eq 0 ]]; then
+    # no script to restart (an inline `bash -c 'source ...'`): the names are unset here, PATH is set here, and only a
+    # carrier of an imported function (a name that is no identifier) cannot be removed: that refuses
+    if [[ -n $bad ]]; then
+      echo "cleanenv: this shell carries imported functions (BASH_FUNC_*) it cannot drop; start it with bash -p. Refusing." >&2
+      return 1
+    fi
+    PATH=$value
+    GIT_CONFIG_GLOBAL=$gcg
+    export PATH GIT_CONFIG_GLOBAL
+    hash -r
+    return 0
+  fi
+  if [[ -z $dirty ]]; then
+    unset PICKMAN_CLEANED
+    return 0
+  fi
+  if [[ ${PICKMAN_CLEANED-} == "$$" ]]; then
+    echo "cleanenv: the environment is still not the allow-list after a restart; refusing." >&2
+    return 1
+  fi
+  exec /usr/bin/env -i ${assign[@]+"${assign[@]}"} "PATH=$value" "GIT_CONFIG_GLOBAL=$gcg" "PICKMAN_CLEANED=$$" /bin/bash -p "$@"
+}
diff --git a/z-nile/lib/fence.sh b/z-nile/lib/fence.sh
index a35a9ef1..892268f2 100644
--- a/z-nile/lib/fence.sh
+++ b/z-nile/lib/fence.sh
@@ -12,7 +12,9 @@
