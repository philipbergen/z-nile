+    # bin folder anywhere else (a leftover, a folder an agent made in .cache/.tmp, another spelling of either) is dropped
+    ok=
+    for f in ${internal[@]+"${internal[@]}"}; do
+      # shellcheck disable=SC2254
+      case $res in $f) ok=1 ;; esac
+    done
