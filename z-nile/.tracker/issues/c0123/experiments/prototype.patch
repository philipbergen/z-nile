+  if [[ ${HOME-} != "$acct_home" && -f $gcg ]]; then
+    while IFS= read -r line || [[ -n $line ]]; do
+      case $line in
+      *=*)
+        v=${line#*=}; v=${v#"${v%%[![:space:]]*}"}
+        f=${line%%=*}; f=${f%"${f##*[![:space:]]}"}; f=${f#"${f%%[![:space:]]*}"}
+        # data files git only reads (ignore patterns, attributes, a message template) are not a way to run a program
+        case $v in '~'*) case $f in [Ee]xcludes[Ff]ile | [Aa]ttributes[Ff]ile | template | [Ii]gnore[Rr]evs[Ff]ile) ;; *) echo "cleanenv: $gcg has a ~ path ($line) and HOME is not the account's home; git would read another file. Refusing." >&2; return 1 ;; esac ;; esac ;;
+      esac
+    done <"$gcg"
+  fi
+  # where this checkout is, from this file's own location (a copy under a .cache belongs to the checkout above it)
+  _pickman_canon "${_pickman_clean_list%/*}/../.." && here=$_pickman_res || here=
+  [[ -n $here ]] || { echo "cleanenv: cannot tell where $list is; refusing." >&2; return 1; }
+  trust=$here
+  case $here in *"/.cache/"*) trust=${here%%/.cache/*} ;; esac
+  # the folders the runner registered for its run: tests-run.lock/folders of this checkout's project homes (a glob skips
+  # a dot-folder), each line an absolute path, kept as the filesystem spells it; a line that is no folder, or whose run no longer holds it (_pickman_holds), is dropped
+  for f in "$here"/.cache/tests-run.lock/folders "$here"/*/.cache/tests-run.lock/folders "$trust"/.cache/tests-run.lock/folders "$trust"/*/.cache/tests-run.lock/folders; do
+    [[ -f $f ]] || continue
+    while IFS= read -r line || [[ -n $line ]]; do
+      case $line in /*) _pickman_canon "$line" && _pickman_holds "$_pickman_res" && registered+=("$_pickman_res") ;; esac
+    done <"$f"
+  done
+  while IFS= read -r line || [[ -n $line ]]; do
+    case $line in '' | '#'*) continue ;; esac
+    [[ $line == *" "* ]] || { echo "cleanenv: $list: unknown entry '$line'; refusing." >&2; return 1; }
+    kind=${line%% *}
+    value=${line#* }
+    [[ -n $value ]] || { echo "cleanenv: $list: unknown entry '$line'; refusing." >&2; return 1; }
+    case $kind in
+    allow) allow+=("$value") ;;
+    fence) fence+=("$value") ;;
+    path) case $value in '~'*) value=$acct_home${value#'~'} ;; esac; fixed+=("$value") ;;
+    internal) internal+=("$value") ;;
+    proof) proof+=("$value") ;;
+    *) echo "cleanenv: $list: unknown entry '$line'; refusing." >&2; return 1 ;;
+    esac
+  done <"$list"
