+# keeps the caller's letter case on a case-insensitive disk; the program asks the kernel), or fails: not a folder, not
+# one absolute line. CDPATH is emptied for the cd.
+_pickman_canon() {
+  local r
+  _pickman_res=
+  r=$(CDPATH= cd -P -- "$1" 2>/dev/null && "$_pickman_pwd" -P && printf x) || return 1
+  r=${r%x}
+  r=${r%$'\n'}
+  case $r in /*) ;; *) return 1 ;; esac
+  case $r in *$'\n'*) return 1 ;; esac
+  _pickman_res=$r
+}
+# The program that prints a process's start id: the text of tests/lib/fence.luau's STARTED (a spec pins them equal), the
+# kernel's own record, so a reused pid prints another id. Exit 1: no such process; 2: cannot tell.
+# (a plain string: a here-document would make bash write a temp file in TMPDIR, which a jailed caller cannot)
+_pickman_startid='my $pid = shift; exit 2 unless defined $pid && $pid =~ /^\d+$/;
+if ($^O eq '\''darwin'\'') { my $mib = pack('\''i4'\'', 1, 14, 1, $pid); my $buf = "\0" x 4096;
+my $len = pack('\''Q'\'', length $buf); exit 2 unless syscall(202, $mib, 4, $buf, $len, 0, 0) == 0;
+exit 1 unless unpack('\''Q'\'', $len) > 0; my ($sec, $usec) = unpack('\''q l'\'', $buf); exit 1 unless $sec > 0;
+print "$sec.$usec\n"; exit 0 }
+if ($^O eq '\''linux'\'') { open(my $b, '\''<'\'', '\''/proc/sys/kernel/random/boot_id'\'') or exit 2; my $boot = <$b>;
+close $b; chomp $boot; open(my $st, '\''<'\'', "/proc/$pid/stat") or exit 1; my $line = <$st>; close $st;
+$line =~ s/^.*\)\s+//s or exit 2; my $ticks = (split /\s+/, $line)[19];
+exit 2 unless $boot ne '\'''\'' && defined $ticks && $ticks =~ /^\d+$/; print "$boot:$ticks\n"; exit 0 }
+exit 2;'
+_pickman_perl=/usr/bin/perl
+# Whether the run that registered folder $1 still holds it: its .pickman-owner (pid, tab, start id) names a live
+# process, and not a reused pid. An answer of Operation not permitted (a signal across the jail's edge, or another user's
+# process) reads as alive, as the runner's own fence.alive does inside the jail; an id that is missing or cannot be read
+# now leaves it holding, as fence.holds does. A folder with no readable owner (or one naming pid 0) is dead. The probe
+# runs in the C locale (the message is translated otherwise) and perl under `env -i`, so no variable of the caller's
+# (PERL5LIB, PERL5OPT) can decide the verdict.
+_pickman_holds() {
+  local pid id cur err
+  [[ -r $1/.pickman-owner ]] || return 1
+  IFS=$'\t' read -r pid id <"$1/.pickman-owner" || [[ -n $pid ]] || return 1
+  case $pid in '' | *[!0-9]* | 0 | 00*) return 1 ;; esac
+  err=$(LC_ALL=C kill -0 "$pid" 2>&1) || case $err in *"Operation not permitted"*) ;; *) return 1 ;; esac
+  [[ -n $id ]] || return 0
+  cur=$(/usr/bin/env -i "$_pickman_perl" -e "$_pickman_startid" "$pid" 2>/dev/null) || return 0
+  [[ -z $cur || $cur == "$id" ]]
+}
+pickman_clean_env() {
+  local list=$_pickman_clean_list line kind value name f keep p rest dirty= fence_active= bad= acct acct_home gcg here trust res v ok
+  local -a allow=() fence=() fixed=() internal=() proof=() kept=() assign=() registered=()
+  # with no script to restart only a privileged shell can be trusted: in any other every builtin may be an imported function
+  if [[ $# -eq 0 && $- != *p* ]]; then
+    echo "cleanenv: used inline from a shell started without -p, whose builtins may be the caller's functions; start it with bash -p. Refusing." >&2
+    return 1
+  fi
+  if [[ $- != *p* && ( -n ${BASH_ENV+x} || -n ${ENV+x} ) ]]; then
+    echo "cleanenv: this shell was started without -p with BASH_ENV or ENV set, so it ran the caller's file before any check; start it through ./zn, or with bash -p. Refusing." >&2
+    return 1
+  fi
+  [[ -r $list ]] || { echo "cleanenv: cannot read $list; refusing." >&2; return 1; }
+  # The account's home from the passwd database (tilde expansion of ~user reads getpwnam, never $HOME), and the git
+  # global config pinned to its file: HOME and XDG_CONFIG_HOME of the caller choose neither the fixed PATH nor the
+  # config git reads.
+  acct=$(/usr/bin/id -un 2>/dev/null) || acct=
+  case $acct in '' | *[!A-Za-z0-9._-]*) echo "cleanenv: cannot tell the account's name (id -un); refusing." >&2; return 1 ;; esac
+  acct_home=$(eval "echo ~$acct") || acct_home=
+  [[ $acct_home == /* ]] || { echo "cleanenv: cannot tell $acct's home; refusing." >&2; return 1; }
+  if [[ -f $acct_home/.gitconfig ]]; then gcg=$acct_home/.gitconfig
+  elif [[ -f $acct_home/.config/git/config ]]; then gcg=$acct_home/.config/git/config
+  else gcg=/dev/null; fi
