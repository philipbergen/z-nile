+  for f in $(compgen -A function); do
+    [[ $f == pickman_clean_env || $f == _pickman_canon || $f == _pickman_holds ]] || { unset -f "$f"; dirty=1; }
+  done
+  # PATH: this run's own entries first, each believed by where it is (see the header), then the fixed directories
+  rest=${PATH-}
+  while [[ -n $rest ]]; do
+    p=${rest%%:*}
+    if [[ $rest == *:* ]]; then rest=${rest#*:}; else rest=; fi
+    ok=
+    for f in ${internal[@]+"${internal[@]}"}; do
+      # shellcheck disable=SC2254
+      case $p in $f) ok=1 ;; esac
+    done
+    [[ -n $ok ]] || continue
+    _pickman_canon "$p" && res=$_pickman_res || continue
