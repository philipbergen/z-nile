diff --git a/z-nile/lib/cleanenv.list b/z-nile/lib/cleanenv.list
new file mode 100644
index 00000000..0bd8cfb8
--- /dev/null
+++ b/z-nile/lib/cleanenv.list
@@ -0,0 +1,82 @@
+# The environment every launcher passes on (c0123). Readers: z-nile/lib/cleanenv.sh (the entry scripts, ac.sh) and
+# z-nile/lib/cleanenv.luau (tests/run). Anything not listed here is dropped at the first process of ours; nothing is
+# added from outside this file. One entry per line, `kind value`:
+#   allow <NAME>      kept, exactly; a trailing * keeps the family (LC_*)
+#   fence <NAME>      kept only while a fence is active here (PICKMAN_FENCE_REAL_GIT is set): the state the guards
+#                     themselves export to everything a check starts (z-nile/lib/fence.sh)
+#   path <dir>        a directory of the PATH, in this order; a leading ~ is the account's home from the passwd
+#                     database, never $HOME, so a caller cannot choose the directory; Rokit's comes first because
+#                     it pins the tools (lune, stylua, selene), as the scripts' own PATH line did
+#   internal <glob>   a PATH entry the run makes for itself (stubs, the run's temp bin, the browser guard's folder) is
+#                     kept when its name matches AND its canonical path (the spelling the filesystem stores, not the
+#                     caller's) lies inside a folder the runner registered for this run (tests-run.lock/folders, found
+#                     from this file's location, never from a variable) and its run still holds it (a live process that is not a reused
+#                     pid, so a killed run's registry proves nothing). A leftover, a folder an agent made in
+#                     .cache/.tmp and another spelling of either are dropped
+#   proof <glob>      an internal entry that matches proves a run of ours is live here: only then do the `fence` names
+#                     pass
+allow HOME
+allow USER
+allow LOGNAME
+allow SHELL
+allow TERM
+allow COLORTERM
+allow NO_COLOR
+allow CLICOLOR
+allow CLICOLOR_FORCE
+allow FORCE_COLOR
+allow LANG
+allow LC_*
+allow TZ
+allow TMPDIR
+allow __CF_USER_TEXT_ENCODING
+allow SSH_AUTH_SOCK
+allow GH_TOKEN
+allow GITHUB_TOKEN
+allow GH_ENTERPRISE_TOKEN
+allow GITHUB_ENTERPRISE_TOKEN
+allow GH_HOST
+allow GH_CONFIG_DIR
+allow http_proxy
+allow https_proxy
+allow all_proxy
+allow no_proxy
+allow HTTP_PROXY
+allow HTTPS_PROXY
+allow ALL_PROXY
+allow NO_PROXY
+allow SSL_CERT_FILE
+allow SSL_CERT_DIR
+allow CI
+allow GITHUB_ACTIONS
+allow GITHUB_PATH
+allow PWD
+allow OLDPWD
+allow SHLVL
+allow _
+allow AC_LIST
+allow ZN_*
+allow CLAUDE_PROJECT_DIR
+allow CLAUDE_ENV_FILE
+allow GIT_AUTHOR_*
+allow GIT_COMMITTER_*
+allow PICKMAN_*
+fence GIT_CEILING_DIRECTORIES
+fence GIT_CONFIG_COUNT
+fence GIT_CONFIG_KEY_*
+fence GIT_CONFIG_VALUE_*
+fence GIT_ALLOW_PROTOCOL
+fence GIT_SSH_COMMAND
+fence GIT_TERMINAL_PROMPT
+path ~/.rokit/bin
+path /opt/homebrew/bin
+path /usr/local/bin
+path /usr/bin
+path /bin
+path /usr/sbin
+path /sbin
+internal */pickman-guard.*
+internal */pickman-run.*/bin
+internal */pickman-stub.*
+proof */pickman-run.*/bin
+proof */pickman-guard.*
diff --git a/z-nile/lib/cleanenv.luau b/z-nile/lib/cleanenv.luau
new file mode 100644
index 00000000..df864c2e
--- /dev/null
+++ b/z-nile/lib/cleanenv.luau
@@ -0,0 +1,366 @@
+--!strict
+-- The allow-listed environment (c0123), the Lune side of z-nile/lib/cleanenv.sh: both read z-nile/lib/cleanenv.list and
+-- both apply the same rules (a spec feeds them one planted environment and compares). Pure over texts and tables; the
+-- two functions at the edge (`load`, `relaunch`) read the list and start the process again.
+local fs = require("@lune/fs")
+local process = require("@lune/process")
+
+local cleanenv = {}
+
+export type Spec = {
+	allow: { string },
+	fence: { string },
+	path: { string },
+	internal: { string },
+	proof: { string },
+}
+export type Env = { [string]: string }
+
+-- A glob (`*` matches anything) as a Lua pattern
+local function globToPattern(glob: string): string
+	local escaped = string.gsub(glob, "[%^%$%(%)%%%.%[%]%+%-%?]", "%%%0")
+	return "^" .. string.gsub(escaped, "%*", ".*") .. "$"
+end
+
+local function matches(globs: { string }, text: string): boolean
+	for _, glob in globs do
+		if string.find(text, globToPattern(glob)) then
+			return true
+		end
+	end
+	return false
+end
+
+-- Parses the list's text. Returns the spec, or nil and the problem (an unknown entry is a problem, never skipped).
+function cleanenv.parse(text: string, home: string): (Spec?, string?)
+	local spec: Spec = { allow = {}, fence = {}, path = {}, internal = {}, proof = {} }
+	for line in string.gmatch(text, "[^\n]+") do
+		if line == "" or string.sub(line, 1, 1) == "#" then
+			continue
+		end
+		local kind, value = string.match(line, "^(%S+) (.+)$")
+		if kind == nil or value == nil then
+			return nil, `cleanenv.list: unknown entry '{line}'`
+		end
+		if kind == "allow" then
+			table.insert(spec.allow, value)
+		elseif kind == "fence" then
+			table.insert(spec.fence, value)
+		elseif kind == "path" then
+			table.insert(spec.path, (string.gsub(value, "^~", home)))
+		elseif kind == "internal" then
+			table.insert(spec.internal, value)
+		elseif kind == "proof" then
+			table.insert(spec.proof, value)
+		else
+			return nil, `cleanenv.list: unknown entry '{line}'`
+		end
+	end
+	return spec, nil
+end
+
+-- The program that prints a folder's canonical path: /bin/pwd, else /usr/bin/pwd.
+local function pwdProgram(): string
+	return if fs.isFile("/bin/pwd") then "/bin/pwd" else "/usr/bin/pwd"
+end
+
+local function isName(name: string): boolean
+	return string.find(name, "^[A-Za-z_][A-Za-z0-9_]*$") ~= nil
+end
+
+-- What the account database and this module's own location say (read at the edge, never from the environment): the home,
+-- the git global config pinned from it, the trusted checkout (a copy kept under a `.cache` belongs to the checkout above
+-- it), the folders the runner registered, and the first `~` path the pinned config holds, if any.
+export type Facts = {
+	home: string,
+	gitConfigGlobal: string,
+	trust: string,
+	tildeLine: string?,
+	-- the run folders a runner registered in a tests-run.lock/folders file of this checkout's project homes, canonical
+	registered: { string },
+}
+
+-- A PATH entry is believed when its name matches an `internal` glob, its canonical path (`resolve`: `cd -P`, then the
+-- filesystem's own spelling) matches one again, and that path lies inside a folder the runner registered for this run
+-- (`facts.registered`, canonical too). `resolve` is the edge function below at run time and a stand-in in a spec.
+local function anchored(spec: Spec, facts: Facts, resolve: (string) -> string?, entry: string): string?
+	if not matches(spec.internal, entry) then
+		return nil
+	end
+	local res = resolve(entry)
+	if res == nil or not matches(spec.internal, res) then
+		return nil
+	end
+	for _, folder in facts.registered do
+		if res == folder or string.sub(res, 1, #folder + 1) == folder .. "/" then
+			return res
+		end
+	end
+	return nil
+end
+
+-- Why the cleaner must refuse here, or nil: the caller moved HOME while the account's pinned git config names a `~` path,
+-- which git would expand from the caller's HOME.
+function cleanenv.refusal(env: Env, facts: Facts): string?
+	if facts.tildeLine and env.HOME ~= facts.home then
+		return `cleanenv: {facts.gitConfigGlobal} has a ~ path ({facts.tildeLine}) and HOME is not the account's home; git would read another file. Refusing.`
+	end
+	return nil
+end
+
+-- The environment `env` becomes, and whether that changes it. Names not on the list are dropped; the `fence` names pass
+-- only while an anchored `proof` folder is on PATH; PATH keeps the anchored `internal` entries, once each, then the
+-- fixed directories.
+function cleanenv.clean(env: Env, spec: Spec, facts: Facts, resolve: (string) -> string?): (Env, boolean)
+	local out: Env = {}
+	local dirty = false
+	local parts: { string } = {}
+	local seen: { [string]: boolean } = {}
+	local live = false
+	for entry in string.gmatch(env.PATH or "", "[^:]+") do
+		local res = anchored(spec, facts, resolve, entry)
+		if res and not seen[res] then
+			seen[res] = true
+			table.insert(parts, res)
+			if matches(spec.proof, res) then
+				live = true
+			end
+		end
+	end
+	for _, dir in spec.path do
+		table.insert(parts, dir)
+	end
+	out.PATH = table.concat(parts, ":")
+	if out.PATH ~= (env.PATH or "") then
+		dirty = true
+	end
+	for name, value in env do
+		if name == "PATH" then
+			continue
+		end
+		if name == "GIT_CONFIG_GLOBAL" then
+			if value ~= facts.gitConfigGlobal then
+				dirty = true
+			end
+			continue
+		end
+		local keep = isName(name) and (matches(spec.allow, name) or (live and matches(spec.fence, name)))
+		if keep then
+			out[name] = value
+		else
+			dirty = true
+		end
+	end
+	out.GIT_CONFIG_GLOBAL = facts.gitConfigGlobal
+	if env.GIT_CONFIG_GLOBAL == nil then
+		dirty = true
+	end
+	return out, dirty
+end
+
+local FLAG = "--cleaned"
+
+-- The arguments without the restart marker, and whether it was there.
+function cleanenv.args(args: { string }): ({ string }, boolean)
+	local out: { string } = {}
+	local marked = false
+	for _, a in args do
+		if a == FLAG then
+			marked = true
+		else
+			table.insert(out, a)
+		end
+	end
+	return out, marked
+end
+
+-- The command line that starts `argv` again under exactly `clean` (an absolute `env`, which finds argv[1] in the clean PATH).
+function cleanenv.command(clean: Env, argv: { string }): { string }
+	local out = { "-i" }
+	local names: { string } = {}
+	for name in clean do
+		table.insert(names, name)
+	end
+	table.sort(names)
+	for _, name in names do
+		table.insert(out, `{name}={clean[name]}`)
+	end
+	for _, a in argv do
+		table.insert(out, a)
+	end
+	return out
+end
+
+-- Edge: the list as shipped, read from this module's own folder.
+function cleanenv.load(home: string): Spec
+	local folder = string.match(debug.info(1, "s"), "^(.*)/[^/]+$") or "z-nile/lib"
+	local spec, problem = cleanenv.parse(fs.readFile(`{folder}/cleanenv.list`), home)
+	if not spec then
+		error(problem or "cleanenv.list does not parse", 0)
+	end
+	return spec
+end
+
+-- Edge: the account's home (the passwd database's, through the shell's ~user, never $HOME) and the git global config
+-- file pinned from it: ~/.gitconfig, else ~/.config/git/config, else /dev/null.
+function cleanenv.facts(): Facts
+	local who = process.exec("/usr/bin/id", { "-un" })
+	local user = string.gsub(who.stdout, "%s+$", "")
+	if not who.ok or user == "" or string.find(user, "[^A-Za-z0-9._-]") then
+		error("cleanenv: cannot tell the account's name (id -un); refusing.", 0)
+	end
+	local home = process.exec("/bin/sh", { "-p", "-c", 'eval "echo ~$1"', "_", user })
+	local dir = string.gsub(home.stdout, "%s+$", "")
+	if not home.ok or string.sub(dir, 1, 1) ~= "/" then
+		error(`cleanenv: cannot tell {user}'s home; refusing.`, 0)
+	end
+	local config = "/dev/null"
+	if fs.isFile(`{dir}/.gitconfig`) then
+		config = `{dir}/.gitconfig`
+	elseif fs.isFile(`{dir}/.config/git/config`) then
+		config = `{dir}/.config/git/config`
+	end
+	local tilde: string? = nil
+	if config ~= "/dev/null" then
+		for line in string.gmatch(fs.readFile(config), "[^\n]+") do
+			local key, value = string.match(line, "^%s*([^=%s]*)%s*=%s*(.-)%s*$")
+			if value and string.sub(value, 1, 1) == "~" then
+				-- data files git only reads (ignore patterns, attributes, a message template) cannot run a program
+				local data =
+					{ excludesfile = true, attributesfile = true, template = true, ignorerevsfile = true }
+				if not data[string.lower(key or "")] then
+					tilde = line
+					break
+				end
+			end
+		end
+	end
+	local folder = string.match(debug.info(1, "s"), "^(.*)/[^/]+$") or "z-nile/lib"
+	local here = cleanenv.resolve(`{folder}/../..`)
+	if here == nil then
+		error("cleanenv: cannot tell where cleanenv.luau is; refusing.", 0)
+	end
+	local trust = here
+	local cut = string.find(here, "/.cache/", 1, true)
+	if cut then
+		trust = string.sub(here, 1, cut - 1)
+	end
+	local registered = cleanenv.registered({ here, trust })
+	return { home = dir, gitConfigGlobal = config, trust = trust, tildeLine = tilde, registered = registered }
+end
+
+-- Edge: the canonical path of folder `path`: `cd -P` (CDPATH unset), then /bin/pwd -P, which gives the spelling the
+-- filesystem stores (the shell's own pwd -P keeps the caller's letter case on a case-insensitive disk). Exactly one
+-- absolute line, or nil. The same command as cleanenv.sh's `_pickman_canon`. `env` is added to the environment of that
+-- shell only so a spec can show it ignores a caller's CDPATH.
+function cleanenv.resolve(path: string, env: { [string]: string }?): string?
+	local r = process.exec("/bin/sh", {
+		"-p",
+		"-c",
+		'unset CDPATH; cd -P -- "$1" 2>/dev/null && "$2" -P && printf x',
+		"_",
+		path,
+		pwdProgram(),
+	}, if env then { env = env } else nil)
+	if not r.ok or string.sub(r.stdout, -1) ~= "x" then
+		return nil
+	end
+	local out = string.sub(r.stdout, 1, -2)
+	if string.sub(out, -1) == "\n" then
+		out = string.sub(out, 1, -2)
+	end
+	if string.sub(out, 1, 1) ~= "/" or string.find(out, "\n", 1, true) then
+		return nil
+	end
+	return out
+end
+
+-- The kernel's start id of a process: the text of tests/lib/fence.luau's STARTED and of cleanenv.sh's `_pickman_startid`
+-- (cleanenv.spec pins the three equal). Exit 1: no such process; 2: cannot tell.
+cleanenv.STARTID = table.concat({
+	"my $pid = shift; exit 2 unless defined $pid && $pid =~ /^\\d+$/;",
+	"if ($^O eq 'darwin') { my $mib = pack('i4', 1, 14, 1, $pid); my $buf = \"\\0\" x 4096;",
+	"my $len = pack('Q', length $buf); exit 2 unless syscall(202, $mib, 4, $buf, $len, 0, 0) == 0;",
+	"exit 1 unless unpack('Q', $len) > 0; my ($sec, $usec) = unpack('q l', $buf); exit 1 unless $sec > 0;",
+	'print "$sec.$usec\\n"; exit 0 }',
+	"if ($^O eq 'linux') { open(my $b, '<', '/proc/sys/kernel/random/boot_id') or exit 2; my $boot = <$b>;",
+	"close $b; chomp $boot; open(my $st, '<', \"/proc/$pid/stat\") or exit 1; my $line = <$st>; close $st;",
+	"$line =~ s/^.*\\)\\s+//s or exit 2; my $ticks = (split /\\s+/, $line)[19];",
+	"exit 2 unless $boot ne '' && defined $ticks && $ticks =~ /^\\d+$/; print \"$boot:$ticks\\n\"; exit 0 }",
+	"exit 2;",
+}, "\n")
+
+-- Whether the run that registered the folder `folder` still holds it: its .pickman-owner (pid, tab, start id) names a live
+-- process that is not a reused pid. Operation not permitted (a signal across the jail's edge, another user's process)
+-- reads as alive, an id that is missing or unreadable leaves it holding (as the runner's fence.holds does), and a folder
+-- with no readable owner is dead. The same decision as cleanenv.sh's `_pickman_holds`.
+function cleanenv.holds(folder: string, env: { [string]: string }?): boolean
+	local ok, text = pcall(fs.readFile, `{folder}/.pickman-owner`)
+	if not ok then
+		return false
+	end
+	local pid, id = string.match(text, "^(%d+)\t([^\n]*)")
+	if pid == nil then
+		return false
+	end
+	if (tonumber(pid) :: number) < 1 then
+		return false
+	end
+	local alive = process.exec("/bin/sh", { "-p", "-c", 'LC_ALL=C kill -0 "$1" 2>&1', "_", pid })
+	if not alive.ok and not string.find(alive.stdout .. alive.stderr, "Operation not permitted", 1, true) then
+		return false
+	end
+	if id == nil or id == "" then
+		return true
+	end
+	-- with an empty environment: process.exec merges its env option into the parent's, so env starts perl with nothing (PERL5LIB and
+	-- PERL5OPT of the caller cannot decide the verdict); the `env` parameter is for a spec to show it
+	local r = process.exec(
+		"/usr/bin/env",
+		{ "-i", "/usr/bin/perl", "-e", cleanenv.STARTID, pid },
+		if env then { env = env } else nil
+	)
+	local current = string.gsub(r.stdout, "\n$", "")
+	return not r.ok or current == "" or current == id
+end
+
+-- Edge: the run folders registered in tests-run.lock/folders of each top's project homes (`<top>/.cache` and
+-- `<top>/<name>/.cache`, never a dot-folder: the shell reader's glob skips those), each line an absolute path made
+-- canonical; a line that is no folder, or whose run no longer holds it, is dropped.
+function cleanenv.registered(tops: { string }): { string }
+	local out: { string } = {}
+	for _, top in tops do
+		local files = { `{top}/.cache/tests-run.lock/folders` }
+		if fs.isDir(top) then
+			for _, name in fs.readDir(top) do
+				if string.sub(name, 1, 1) ~= "." and fs.isDir(`{top}/{name}`) then
+					table.insert(files, `{top}/{name}/.cache/tests-run.lock/folders`)
+				end
+			end
+		end
+		for _, file in files do
+			if fs.isFile(file) then
+				for line in string.gmatch(fs.readFile(file), "[^\n]+") do
+					local canon = if string.sub(line, 1, 1) == "/" then cleanenv.resolve(line) else nil
+					if canon and cleanenv.holds(canon) then
+						table.insert(out, canon)
+					end
+				end
+			end
+		end
+	end
+	return out
+end
+
+-- Edge: this process's environment as a table.
+function cleanenv.current(): Env
+	local env: Env = {}
+	for name, value in process.env do
+		if value ~= nil then
+			env[name] = value
+		end
+	end
+	return env
+end
+
+return cleanenv
