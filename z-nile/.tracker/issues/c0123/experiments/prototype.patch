+    ok=
+    for f in ${registered[@]+"${registered[@]}"}; do
+      case $res in "$f" | "$f"/*) ok=1 ;; esac
+    done
+    for f in ${kept[@]+"${kept[@]}"}; do [[ $f == "$res" ]] && ok=; done
+    [[ -n $ok ]] || continue
+    kept+=("$res")
