index 000000000..4159ea4f2
--- /dev/null
+++ b/z-nile/engine/slugs.luau
@@ -0,0 +1,25 @@
+--!strict
+-- c0135: choosing a free slug, the one rule for every writer that picks a slug itself (`raft-plan`'s new rafts,
+-- watch-net's slow-tier defect). Pure: the caller says which slugs of the kind are taken (audit.sluggedLocal's).
+local slugs = {}
+
+-- `base` when it is free, else the first of `base-2`, `base-3`, … that is. The loop is bounded (d0413's scan): `count`
+-- slugs are taken, `base` among them, so one of the `count` candidates `base-2` … `base-{count+1}` is free.
+function slugs.free(base: string, taken: { [string]: boolean }): string
+	if not taken[base] then
+		return base
+	end
+	local count = 0
+	for _ in taken do
+		count += 1
+	end
+	for n = 2, count + 1 do
+		local candidate = `{base}-{n}`
+		if not taken[candidate] then
+			return candidate
+		end
+	end
+	return `{base}-{count + 2}` -- not reached: the pigeonhole above
+end
+
+return slugs
