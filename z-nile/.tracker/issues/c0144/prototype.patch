+local SGR: { [string]: string } = {
+	bold = "1",
+	dim = "2",
+	underline = "4",
+	red = "31",
+	green = "32",
+	yellow = "33",
+	blue = "34",
+	magenta = "35",
+	cyan = "36",
+}
+
+-- What each kind of thing looks like: item types, lifecycle states, check outcomes, audit severities.
+local STYLE: { [string]: { string } } = {
+	feature = { "green" },
+	defect = { "red" },
+	chore = { "blue" },
+	raft = { "magenta" },
+	new = {},
+	preparing = { "cyan" },
+	prepared = { "green" },
+	active = { "yellow", "bold" },
+	done = { "dim" },
+	backlog = {},
+	retired = { "dim" },
+	pass = { "green", "bold" },
+	fail = { "red", "bold" },
+	error = { "red", "bold" },
+	warning = { "yellow" },
+	ok = { "green" },
+	heading = { "bold" },
+	id = { "bold" },
+	muted = { "dim" },
+}
