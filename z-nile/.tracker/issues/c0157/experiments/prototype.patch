diff --git a/z-nile/tests/lib/gateslot.luau b/z-nile/tests/lib/gateslot.luau
new file mode 100644
index 00000000..cb4fa7a0
--- /dev/null
+++ b/z-nile/tests/lib/gateslot.luau
@@ -0,0 +1,105 @@
+--!strict
+-- The machine-wide gate slots (c0157): a gate's spec stage runs only while it holds one of `max` slots shared by every
+-- checkout of this user on this machine, so concurrent gates queue instead of oversubscribing the CPUs. A slot is a
+-- folder `slot-<n>` (mkdir is atomic) holding `owner`: "<pid> <start id> <label>". A slot whose owner is gone, or a
+-- reused pid (its start id differs), is free. Taken by z-nile/tests/slot.luau around each project's spec stage of
+-- z-nile/check.sh.
+local fs = require("@lune/fs")
+local process = require("@lune/process")
+
+local gateslot = {}
+
+-- the runner's lane cap (z-nile/tests/run.luau): a gate's spec stage uses up to this many CPUs
+gateslot.LANES = 8
+
+-- How many gates may run their specs at once: the CPUs divided by a gate's lanes, at least 1, so the running gates'
+-- lanes never add up to more than the machine has (one gate alone always runs at once).
+function gateslot.slotsFor(cpus: number, lanes: number): number
+	return math.max(1, math.floor(cpus / lanes))
+end
+
+-- The slot folder: ZN_GATE_SLOTS, or `$XDG_STATE_HOME/zn/gate-slots`, or `~/.local/state/zn/gate-slots`.
+function gateslot.dir(env: { [string]: string? }): string?
+	local set = env.ZN_GATE_SLOTS
+	if set ~= nil and set ~= "" then
+		return set
+	end
+	local state = env.XDG_STATE_HOME
+	if state ~= nil and state ~= "" then
+		return `{state}/zn/gate-slots`
+	end
+	local home = env.HOME
+	if home ~= nil and home ~= "" then
+		return `{home}/.local/state/zn/gate-slots`
+	end
+	return nil
+end
+
+-- "<pid> <start id> <label>" parsed; nil for anything else (a slot whose owner is not written yet)
+function gateslot.parseOwner(text: string): (string?, string?, string?)
+	local pid, id, label = string.match(text, "^(%d+) (%S+) ?(.*)$")
+	return pid, id, label
+end
+
+export type Probe = { holds: (pid: string, id: string) -> boolean }
+
+local function readMaybe(path: string): string
+	local ok, text = pcall(fs.readFile, path)
+	return if ok then (string.gsub(text :: string, "%s+$", "")) else ""
+end
+
+-- One attempt: takes a free slot of `max` under `dir` for (`me`, `myId`, `label`) and returns its folder, or nil and
+-- the labels of the slots' holders. A slot whose owner file stays unwritten for `unownedSeconds` (its taker died
+-- between mkdir and writing it) is free too.
+function gateslot.try(
+	dir: string,
+	max: number,
+	me: string,
+	myId: string,
+	label: string,
+	probe: Probe,
+	unownedSeconds: number
+): (string?, { string })
+	fs.writeDir(dir)
+	local holders: { string } = {}
+	for n = 1, max do
+		local slot = `{dir}/slot-{n}`
+		if process.exec("mkdir", { slot }).ok then
+			fs.writeFile(`{slot}/owner`, `{me} {myId} {label}`)
+			return slot, {}
+		end
+		local pid, id, held = gateslot.parseOwner(readMaybe(`{slot}/owner`))
+		local free
+		if pid and id then
+			free = not probe.holds(pid, id)
+		else
+			local ok, meta = pcall(fs.metadata, slot)
+			local age = if ok and meta.modifiedAt then os.time() - meta.modifiedAt.unixTimestamp else 0
+			free = age >= unownedSeconds
+		end
+		if free then
+			-- a stale slot: remove it and retry this one; another waiter may win the mkdir, which is fine
+			pcall(fs.removeDir, slot)
+			if process.exec("mkdir", { slot }).ok then
+				fs.writeFile(`{slot}/owner`, `{me} {myId} {label}`)
+				return slot, {}
+			end
+		else
+			table.insert(
+				holders,
+				if held and held ~= "" then `pid {pid} ({held})` else `pid {pid or "starting"}`
+			)
+		end
+	end
+	return nil, holders
+end
+
+-- Gives a slot back, only if this process still owns it.
+function gateslot.release(slot: string, me: string)
+	local pid = gateslot.parseOwner(readMaybe(`{slot}/owner`))
+	if pid == me then
+		pcall(fs.removeDir, slot)
+	end
+end
+
+return gateslot
diff --git a/z-nile/tests/slot.luau b/z-nile/tests/slot.luau
new file mode 100644
index 00000000..8c97b73a
--- /dev/null
+++ b/z-nile/tests/slot.luau
@@ -0,0 +1,77 @@
+--!strict
+-- c0157: takes or gives back a machine-wide gate slot (z-nile/tests/lib/gateslot.luau) for a holder process.
+-- Usage: lune run <this file> -- acquire <pid>   waits for a free slot and records <pid> (and its start id) as its holder
+--        lune run <this file> -- release <pid>   gives back the slot <pid> holds, if any
+-- z-nile/check.sh acquires for its own shell before each project's spec stage and releases after it (and on exit), so a
+-- gate killed mid-stage leaves a slot whose holder is gone, which the next waiter takes.
+-- No slot is taken inside a guarded test run (`fence.inRun()`: a gate a spec runs in a fixture already runs in its
+-- outer gate's slot, and the jail refuses the slot folder), unless ZN_GATE_SLOTS names one (the slots' own specs).
+-- ZN_GATE_SLOTS_MAX overrides the count; 0 takes no slot. ZN_GATE_SLOT_WAIT bounds the wait in seconds (the Stop
+-- hook's 300 s budget): past it acquire returns without a slot, and says so. Unset, a gate waits for a slot.
+local fence = require("./lib/fence")
+local gateslot = require("./lib/gateslot")
+local process = require("@lune/process")
+local stdio = require("@lune/stdio")
+local task = require("@lune/task")
+
+local argv: { string } = {}
+for _, a in process.args do
+	if a ~= "--" then
+		table.insert(argv, a)
+	end
+end
+local verb, holder = argv[1], argv[2]
+if (verb ~= "acquire" and verb ~= "release") or holder == nil or not string.match(holder, "^%d+$") then
+	stdio.ewrite("usage: lune run z-nile/tests/slot -- acquire|release <pid>\n")
+	process.exit(2)
+end
+
+local env = process.env
+local explicit = (env.ZN_GATE_SLOTS or "") ~= ""
+local dir = gateslot.dir(env)
+local function cpus(): number
+	local r = if process.os == "macos"
+		then process.exec("sysctl", { "-n", "hw.ncpu" })
+		else process.exec("nproc")
+	return if r.ok then tonumber((string.gsub(r.stdout, "%s+", ""))) or 1 else 1
+end
+local max = tonumber(env.ZN_GATE_SLOTS_MAX or "") or gateslot.slotsFor(cpus(), gateslot.LANES)
+if (fence.inRun() and not explicit) or dir == nil or max < 1 then
+	process.exit(0)
+end
+
+if verb == "release" then
+	for n = 1, max do
+		gateslot.release(`{dir}/slot-{n}`, holder)
+	end
+	process.exit(0)
+end
+
+local holderId = fence.startOf(holder) or "unknown"
+local label = process.cwd
+local probe: gateslot.Probe = {
+	holds = function(pid: string, id: string): boolean
+		local alive = process.exec("kill", { "-0", pid }).ok
+		return fence.holds(alive, if id == "unknown" then nil else id, fence.startOf(pid))
+	end,
+}
+local limit = tonumber(env.ZN_GATE_SLOT_WAIT or "")
+local waited, said = 0, false
+while true do
+	local got, holders = gateslot.try(dir :: string, max, holder, holderId, label, probe, 5)
+	if got then
+		process.exit(0)
+	end
+	if not said then
+		stdio.ewrite(
+			`waiting for a gate slot: {max} of {max} held ({table.concat(holders, ", ")}); slots in {dir}\n`
+		)
+		said = true
+	end
+	if limit ~= nil and waited >= limit then
+		stdio.ewrite(`no gate slot after {limit}s; running without one\n`)
+		process.exit(0)
+	end
+	task.wait(1)
+	waited += 1
+end
