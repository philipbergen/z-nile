   local h=$1
   shift
+  lune run "$slot" -- acquire $$
   if [[ $h == . ]]; then
     lune run tests/run -- "$@"
   else
     (cd "$h" && lune run tests/run -- "$@")
   fi
+  lune run "$slot" -- release $$
 }
 for i in "${!names[@]}"; do
   picked "${names[$i]}" || continue
