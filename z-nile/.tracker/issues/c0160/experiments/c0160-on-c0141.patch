+local FOLDER_PREFIXES = { "src/", "tests/", "scripts/", "tracker/", ".tracker/", ".github/", ".claude/" }
+
+-- every registered project's home folder in the registry of the checkout at `top` ("" or "." for the current folder)
+local function homesAt(top: string): { string }
+	local reg = projects.load(if top == "" then "." else top, true)
+	local out: { string } = {}
+	for _, r in projects.roots(reg) do
+		local folder = projects.folderOf(r)
+		if folder then
+			table.insert(out, folder)
+		end
+	end
+	return out
+end
+
+-- the homes of the checkout this module runs in, read once (the default for `literals` called without homes)
+local ownHomes: { string }? = nil
+local function checkoutHomes(): { string }
+	if ownHomes == nil then
+		local r = process.exec("git", { "rev-parse", "--show-toplevel" })
+		ownHomes = homesAt(if r.ok then (string.gsub(r.stdout, "%s+$", "")) else ".")
+	end
+	return ownHomes :: { string }
+end
