+--!strict
+-- c0180: the one reader of <home>/.cache/spec-commands.tsv, the record of which `./zn` commands each spec ran in its
+-- last passing multi-file run, keyed by a hash of the spec's test-side require closure. Pure: the runner writes the
+-- record and the selector's context reads it, each through these functions.
+local serde = require("@lune/serde")
+
+local commandrecord = {}
+
+-- clean: the recording worktree's engine equalled its merge base's (only then may another worktree use the entry)
+export type Entry = { key: string, commands: { string }, clean: boolean }
+export type Records = { [string]: Entry }
+
+commandrecord.HEADER = "# spec commands v1"
+
+local function sha(text: string): string
+	return serde.hash("sha256", text)
+end
+
+-- the closure key: sha256 of a versioned text with one `<path>\t<sha256 of its bytes>` line per distinct path, sorted,
+-- then the extra lines in their order
+function commandrecord.key(paths: { string }, bytes: (string) -> string, extra: { string }?): string
+	local seen: { [string]: boolean } = {}
+	local sorted: { string } = {}
+	for _, p in paths do
+		if not seen[p] then
+			seen[p] = true
+			table.insert(sorted, p)
+		end
+	end
+	table.sort(sorted)
+	local parts = { "spec commands key v1\n" }
+	for _, p in sorted do
+		table.insert(parts, `{p}\t{sha(bytes(p))}\n`)
+	end
+	for _, line in (extra or {}) :: { string } do
+		table.insert(parts, line .. "\n")
+	end
+	return sha(table.concat(parts))
+end
+
+local function validCommand(name: string): boolean
+	return string.match(name, "^[a-z][a-z%-]*$") ~= nil
+end
+
+function commandrecord.parse(text: string): (Records?, string?)
+	if string.sub(text, -1) ~= "\n" then
+		local n = 1
+		for _ in string.gmatch(text, "\n") do
+			n += 1
+		end
+		return nil, `line {n}: the record must end with a newline`
+	end
+	local records: Records = {}
+	local n = 0
+	for line in string.gmatch(text, "([^\n]*)\n") do
+		n += 1
+		if n == 1 then
+			if line ~= commandrecord.HEADER then
+				return nil, `line 1: the first line must be "{commandrecord.HEADER}"`
+			end
+			continue
+		end
+		local fields = string.split(line, "\t")
+		if #fields ~= 4 then
+			return nil, `line {n}: a record line has four tab-separated fields`
+		end
+		local spec, key, list, engine = fields[1], fields[2], fields[3], fields[4]
+		if string.match(spec, "^tests/.+%.spec%.luau$") == nil then
+			return nil, `line {n}: the spec must be a tests/…/*.spec.luau path`
+		end
+		if #key ~= 64 or string.match(key, "^[0-9a-f]+$") == nil then
+			return nil, `line {n}: the key must be 64 lowercase hex characters`
+		end
+		local commands: { string } = {}
+		if list ~= "-" then
+			local names = string.split(list, ",")
+			for i, name in names do
+				if not validCommand(name) then
+					return nil, `line {n}: "{name}" is not a command name`
+				end
+				if i > 1 and names[i - 1] >= name then
+					return nil, `line {n}: the commands must be sorted and distinct`
+				end
+				table.insert(commands, name)
+			end
+		end
+		if records[spec] then
+			return nil, `line {n}: {spec} appears twice`
+		end
+		if engine ~= "clean" and engine ~= "edited" then
+			return nil, `line {n}: the engine field must be clean or edited`
+		end
+		records[spec] = { key = key, commands = commands, clean = engine == "clean" }
+	end
+	if n == 0 then
+		return nil, `line 1: the first line must be "{commandrecord.HEADER}"`
+	end
+	return records, nil
+end
+
+function commandrecord.render(records: Records): string
+	local specs: { string } = {}
+	for spec in records do
+		table.insert(specs, spec)
+	end
+	table.sort(specs)
+	local out = { commandrecord.HEADER .. "\n" }
+	for _, spec in specs do
+		local e = records[spec]
+		local list = if #e.commands == 0 then "-" else table.concat(e.commands, ",")
+		table.insert(out, `{spec}\t{e.key}\t{list}\t{if e.clean then "clean" else "edited"}\n`)
+	end
+	return table.concat(out)
+end
+
+-- every new entry over the old (the union of their commands when the key is unchanged, clean only if both were); old entries kept unless `keep`
+-- is given and lacks them; the inputs are not changed
+function commandrecord.merge(old: Records, new: Records, keep: { [string]: boolean }?): Records
+	local out: Records = {}
+	for spec, e in old do
+		if keep == nil or keep[spec] then
+			out[spec] = { key = e.key, commands = table.clone(e.commands), clean = e.clean }
+		end
+	end
+	for spec, e in new do
+		local before = old[spec]
+		if before and before.key == e.key then
+			-- the same code: what any run recorded, together
+			local set: { [string]: boolean } = {}
+			for _, c in before.commands do
+				set[c] = true
+			end
+			for _, c in e.commands do
+				set[c] = true
+			end
+			local union: { string } = {}
+			for c in set do
+				table.insert(union, c)
+			end
+			table.sort(union)
+			-- one run on an edited engine makes the whole union the edited engine's
+			out[spec] = { key = e.key, commands = union, clean = before.clean and e.clean }
+		else
+			out[spec] = { key = e.key, commands = table.clone(e.commands), clean = e.clean }
+		end
+	end
+	return out
+end
+
+return commandrecord
