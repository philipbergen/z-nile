+-- c0180: the spec runner's command trace. Each ZN_SPEC_TRACE entry gets an empty file named after the command (`usage`
+-- for none or an unknown one), before the command does anything. An entry counts only when its physical path is itself
+-- and ends .cache/spec-trace/<name>; a bad entry or a failed write refuses (exit 2), so a traced run never loses one.
+do
+	local trace = process.env.ZN_SPEC_TRACE
+	if trace and trace ~= "" then
+		local dirs = string.split(trace, ":")
+		for _, dir in dirs do
+			local ran, real = pcall(process.exec, "pwd", { "-P" }, { cwd = dir })
+			local physical = if ran and real.ok then sh.trim(real.stdout) else nil
+			if physical ~= dir or string.match(dir, "/%.cache/spec%-trace/[^/]+$") == nil then
+				stdio.ewrite(
+					`zn: ZN_SPEC_TRACE entry {dir} is not a .cache/spec-trace/<name> directory by its physical path\n`
+				)
+				process.exit(2)
+			end
+		end
+		local recorded = if handler then name :: string else "usage"
+		for _, dir in dirs do
+			local why: any = nil
+			local wrote = xpcall(sh.writeReplacing, function(e: any)
+				why = e
+			end, `{dir}/{recorded}`, "")
+			if not wrote then
+				stdio.ewrite(`zn: cannot record the spec trace in {dir}: {why}\n`)
+				process.exit(2)
+			end
+		end
+	end
+end
