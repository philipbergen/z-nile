diff --git a/z-nile/lib/recordkey.luau b/z-nile/lib/recordkey.luau
new file mode 100644
index 00000000..ebbd0fb3
--- /dev/null
+++ b/z-nile/lib/recordkey.luau
@@ -0,0 +1,140 @@
+--!strict
+-- c0180: the one key function of the spec-commands record. A spec's key covers the files that decide which `./zn`
+-- commands it runs: its require closure under its home's tests/, and the tooling that launches `./zn` (zn, scripts/,
+-- z-nile/check.sh, z-nile/lib/, z-nile/templates/). The runner (through z-nile/recordkey.luau) and the selector's
+-- context both call `keys`, from the repository root, so their keys agree by construction.
+local commandrecord = require("../tests/lib/commandrecord")
+local fs = require("@lune/fs")
+local graph = require("./graph")
+local process = require("@lune/process")
+local projects = require("../engine/projects")
+
+local recordkey = {}
+
+-- the tooling folders and files whose bytes join every key
+recordkey.TOOLING = { "zn", "scripts", "z-nile/check.sh", "z-nile/lib", "z-nile/templates" }
+
+-- pure: the spec's closure files under its home's tests/, then the tooling files
+function recordkey.files(g: graph.Graph, spec: string, tooling: { string }): { string }
+	local prefix = string.match(spec, "^(.-)tests/") or ""
+	local tests = prefix .. "tests/"
+	local out: { string } = {}
+	for path in graph.closure(g, spec) do
+		if string.sub(path, 1, #tests) == tests then
+			table.insert(out, path)
+		end
+	end
+	for _, path in tooling do
+		table.insert(out, path)
+	end
+	return out
+end
+
+-- the tooling files at `root`: tracked and untracked (not ignored), as git lists them
+function recordkey.tooling(root: string): { string }
+	local args = { "ls-files", "-co", "--exclude-standard", "--" }
+	for _, p in recordkey.TOOLING do
+		table.insert(args, p)
+	end
+	local r = process.exec("git", args, { cwd = root })
+	if not r.ok then
+		error(`recordkey: git ls-files failed in {root}: {r.stderr}`, 0)
+	end
+	local out: { string } = {}
+	for line in string.gmatch(r.stdout, "[^\n]+") do
+		table.insert(out, line)
+	end
+	table.sort(out)
+	return out
+end
+
+-- the tree id of z-nile/engine at the merge base of HEAD and origin/main, or "none" when either can't be read
+function recordkey.engineBase(root: string): string
+	local base = process.exec("git", { "merge-base", "HEAD", "refs/remotes/origin/main" }, { cwd = root })
+	if not base.ok then
+		return "none"
+	end
+	local commit = (string.gsub(base.stdout, "%s+$", ""))
+	local tree = process.exec(
+		"git",
+		{ "rev-parse", "--verify", "-q", `{commit}:z-nile/engine` },
+		{ cwd = root }
+	)
+	if not tree.ok then
+		return "none"
+	end
+	return (string.gsub(tree.stdout, "%s+$", ""))
+end
+
+-- "clean" when the working tree equals the merge base's everywhere but the project roots' tracker documents (no
+-- change, staged or not, and no untracked file), else "edited": the runner, the programs and the engine a record's
+-- commands came from are then the base's; with no merge base, "edited", so other worktrees never trust the record
+recordkey.STATE_PATHS = { ".", ":(exclude,glob)**/.tracker/**" }
+function recordkey.treeState(root: string): string
+	local base = process.exec("git", { "merge-base", "HEAD", "refs/remotes/origin/main" }, { cwd = root })
+	if not base.ok then
+		return "edited"
+	end
+	local commit = (string.gsub(base.stdout, "%s+$", ""))
+	local diffArgs = { "diff", "--quiet", commit, "--" }
+	local lsArgs = { "ls-files", "-o", "--exclude-standard", "--" }
+	for _, p in recordkey.STATE_PATHS do
+		table.insert(diffArgs, p)
+		table.insert(lsArgs, p)
+	end
+	local diff = process.exec("git", diffArgs, { cwd = root })
+	local untracked = process.exec("git", lsArgs, { cwd = root })
+	if diff.code == 0 and untracked.ok and untracked.stdout == "" then
+		return "clean"
+	end
+	return "edited"
+end
+
+-- the one graph of the selector's context and of the keys, built from the repository root: every home's src, tests
+-- and scripts, the root's scripts (the forwarders in it included, so a spec's closure goes through them), the engine,
+-- z-nile/lib, and the Luau files at the top of z-nile/ (the programs)
+function recordkey.graph(): graph.Graph
+	local roots: { string } = { "scripts", "z-nile/engine", "z-nile/lib" }
+	for _, p in projects.load().projects do
+		local prefix = if p.home == "." then "" else p.home .. "/"
+		for _, d in { "src", "tests", "scripts" } do
+			table.insert(roots, prefix .. d)
+		end
+	end
+	for _, name in fs.readDir("z-nile") do
+		if string.match(name, "%.luau$") then
+			table.insert(roots, "z-nile/" .. name)
+		end
+	end
+	return graph.build(roots)
+end
+
+-- the files of a spec's closure the graph never built (a require into a folder outside its roots): a spec with any is
+-- treated as having no record, so a missed root can only widen selection
+function recordkey.dangling(g: graph.Graph, spec: string): { string }
+	local out: { string } = {}
+	for path in graph.closure(g, spec) do
+		if g.deps[path] == nil then
+			table.insert(out, path)
+		end
+	end
+	table.sort(out)
+	return out
+end
+
+-- the key of each repo-relative spec; the current directory must be the repository root `root`
+function recordkey.keys(root: string, specs: { string }, g: graph.Graph?): { [string]: string }
+	local built = g or recordkey.graph()
+	local tooling = recordkey.tooling(root)
+	local extra = { "engine-base " .. recordkey.engineBase(root) }
+	local out: { [string]: string } = {}
+	for _, spec in specs do
+		if not fs.isFile(spec) then
+			error(`recordkey: no spec {spec}`, 0)
+		end
+		out[spec] = commandrecord.key(recordkey.files(built, spec, tooling), fs.readFile, extra)
+	end
+	return out
+end
+
+return recordkey
diff --git a/z-nile/recordkey.luau b/z-nile/recordkey.luau
new file mode 100644
index 00000000..4c3d4ea6
--- /dev/null
+++ b/z-nile/recordkey.luau
@@ -0,0 +1,37 @@
+--!strict
+-- c0180: `lune run z-nile/recordkey -- <repo-relative spec paths>`, from the repository root: prints `engine\t<clean|edited>`,
+-- then `<spec>\t<key>` per spec (z-nile/lib/recordkey.luau); exits 2 naming what it can't key. The spec runner calls it after a multi-file
+-- run to key the spec-commands record.
+local process = require("@lune/process")
+local recordkey = require("./lib/recordkey")
+local stdio = require("@lune/stdio")
+
+local specs: { string } = {}
+local dangling = false
+for _, a in process.args do
+	if a == "--dangling" then
+		dangling = true
+	elseif a ~= "--" then
+		table.insert(specs, a)
+	end
+end
+-- --dangling: print `<spec>\t<file>` for each file of a spec's closure the graph never built (none is the healthy answer)
+if dangling then
+	local g = recordkey.graph()
+	for _, spec in specs do
+		for _, file in recordkey.dangling(g, spec) do
+			print(`{spec}\t{file}`)
+		end
+	end
+	process.exit(0)
+end
+local root = (string.gsub(process.exec("pwd", { "-P" }).stdout, "%s+$", ""))
+local ok, keys = pcall(recordkey.keys, root, specs)
+if not ok then
+	stdio.ewrite(`recordkey: {keys}\n`)
+	process.exit(2)
+end
+print(`engine\t{recordkey.treeState(root)}`)
+for _, spec in specs do
+	print(`{spec}\t{(keys :: { [string]: string })[spec]}`)
+end
