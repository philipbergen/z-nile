index 00000000..3e2c4238
--- /dev/null
+++ b/z-nile/lib/repo-hooks/reference-transaction
@@ -0,0 +1,77 @@
+#!/bin/sh
+# pickman-repo-hook: reference-transaction
+# The repository's own ref guard (c0189; zz-test skill, "Specs never touch the real repository"). ./zn hooks installs
+# origin/main's copy of this file as <git common dir>/hooks/reference-transaction, so it covers the main checkout and
+# every worktree.
+# It refuses an update of HEAD or of a ref to a commit whose author or committer email ends in @example.invalid (any
+# letter case), the identity reserved for spec fixtures: every running gate reads a ref at such a commit as a spec's
+# escape (the tripwire), so a prototype committed under it would fail other sessions' gates.
+# Only the "prepared" phase acts. Allowed: deleting a ref, an update of a ref to the value it already holds (whether the
+# line says old = new or leaves old unverified: rebase --abort, pack-refs; not for HEAD, see below), a symbolic update, a pseudo-ref (ORIG_HEAD,
+# CHERRY_PICK_HEAD, ...) and an object that is not a commit. If the new commits cannot be read, it refuses.
+[ "$1" = prepared ] || exit 0
+refuse() {
+  echo "reference-transaction (z-nile/lib/repo-hooks): $1" >&2
+  exit 1
+}
+# One awk reads the transaction. Its output is the distinct new object names of the updates of HEAD or a refs/ ref
+# to a non-zero hex name, a blank line, then "sha ref" per such update (for the message).
+nl='
+'
+out=$(awk '
+  $1 != $2 && ($3 == "HEAD" || $3 ~ /^refs\//) && $2 ~ /^[0-9a-f]+$/ && $2 !~ /^0+$/ {
+    pairs = pairs $2 " " $3 "\n"
+    if (!seen[$2]++) shas = shas $2 "\n"
+  }
+  END { if (pairs != "") printf "%s\n%s", shas, pairs }')
+[ -n "$out" ] || exit 0
+shas=${out%%"$nl$nl"*}
+updates=${out#*"$nl$nl"}
+# "commit <sha>" then "<author email>, a tab, <committer email>" per distinct new commit (a tree or blob prints nothing)
+who=$(printf '%s\n' "$shas" | git rev-list --no-walk=unsorted --stdin --format='%ae%x09%ce' 2>/dev/null) ||
+  refuse "cannot read the new commits; refusing (remove the hook only if git itself is broken)"
+# cheap test first: no fixture identity anywhere in the output, in any letter case
+case $who in
+*@[eE][xX][aA][mM][pP][lL][eE].[iI][nN][vV][aA][lL][iI][dD]*) ;;
+*) exit 0 ;;
+esac
+# exact test: one "sha role email" line per identity that ends in the fixture domain
+found=$(printf '%s\n' "$who" | awk -F '\t' '
+  /^commit / { sha = substr($0, 8); next }
+  { if (tolower($1) ~ /@example\.invalid$/) print sha, "author", $1
