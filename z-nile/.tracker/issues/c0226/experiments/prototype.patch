+-- One compaction map file's change in one commit, read from a `--no-renames` patch: added, deleted, or changed in
+-- place, with its added and removed lines (c0118, c0226).
+export type MapDiff = { path: string, added: boolean, deleted: boolean, plus: { string }, minus: { string } }
+
+-- Applies one line of a map file's patch (after its `diff --git` line) to `m`: `new file mode` or `--- /dev/null` marks
+-- it added, `deleted file mode` or `+++ /dev/null` deleted, a `+` or `-` line that is not a `+++ `/`--- ` header is a
+-- content line, and every other line (`index`, hunk headers, modes, `\ No newline at end of file`) is ignored. The one
+-- reader of a map's patch: history and trail.cuts both read through it (c0226).
+function ids.mapPatchLine(m: MapDiff, line: string)
+	if string.sub(line, 1, 13) == "new file mode" or line == "--- /dev/null" then
+		m.added = true
+	elseif string.sub(line, 1, 17) == "deleted file mode" or line == "+++ /dev/null" then
+		m.deleted = true
+	else
+		local c1 = string.sub(line, 1, 1)
+		if c1 == "+" and string.sub(line, 1, 4) ~= "+++ " then
+			table.insert(m.plus, string.sub(line, 2))
+		elseif c1 == "-" and string.sub(line, 1, 4) ~= "--- " then
+			table.insert(m.minus, string.sub(line, 2))
+		end
+	end
+end
+
+-- Which commits are compactions (c0226: the one rule history and trail.cuts both judge by). A commit is one when it
+-- changes a map in place, or adds one whose content no map it deletes in the same commit had: moving the map unchanged
+-- (c0114) is none, and moving it and changing it in the same commit is one. Returns the first such map file of `maps`,
+-- in their order, or nil when the commit is no compaction.
+function ids.cutFile(maps: { MapDiff }): string?
+	local gone: { [string]: boolean } = {}
+	for _, m in maps do
+		if m.deleted then
+			gone[table.concat(m.minus, "\n")] = true
+		end
+	end
+	for _, m in maps do
+		if m.added then
+			if not gone[table.concat(m.plus, "\n")] then
+				return m.path
+			end
+		elseif not m.deleted then
+			return m.path
+		end
+	end
+	return nil
+end
+
