+--!strict
+-- The per-file cost budget of a spec run (c0230; lesson zz-test/specs-never-burn-real-resources). Pure: the runner hands
+-- it each file's wall seconds and, where its measurer printed it, the CPU seconds of the worker and every process it
+-- waited for; it says which files are over and renders the report the coordinator prints before its summary. It
+-- reports only: a file over budget never changes a result.
+
+local budget = {}
+
+export type Limits = { seconds: number, cpu: number }
+export type Cost = { file: string, seconds: number, cpu: number? }
+
+budget.DEFAULT = { seconds = 60, cpu = 5 } :: Limits
+budget.LESSON = "zz-test/specs-never-burn-real-resources"
+budget.SHOWN = 10
+-- The CPU measurer every worker of a concurrent run is started under (`perl -e MEASURE <command> <args>`): it runs the
+-- command, waits for it, prints the CPU of the command and of every process it waited for (a detached one is not
+-- counted) as the last line of the worker's stdout, and exits with the command's status.
+budget.CPU_PREFIX = "zn-spec-cpu "
+budget.MEASURE = table.concat({
+	'my $pid = fork; die "measure: fork: $!\n" unless defined $pid;',
+	"if ($pid == 0) { exec { $ARGV[0] } @ARGV or exit 127 }",
+	"waitpid($pid, 0); my $st = $?; my ($cu, $cs) = (times)[2, 3];",
+	'printf "zn-spec-cpu %.3f\n", $cu + $cs;',
+	"exit($st & 127 ? 128 + ($st & 127) : $st >> 8);",
+}, " ")
+
+local function positive(s: string): number?
+	if string.match(s, "^%d+$") == nil and string.match(s, "^%d*%.%d+$") == nil then
+		return nil
+	end
+	local n = tonumber(s)
+	if n == nil or n <= 0 then
+		return nil
+	end
+	return n
+end
+
+-- The runner's `--budget` value: nil (no flag) is the default; "<wall>:<cpu>" (positive seconds, decimals allowed)
+-- replaces it; anything else, the empty string included, is refused with the message the runner prints before it
+-- exits 2.
+function budget.limits(value: string?): (Limits?, string?)
+	if value == nil then
+		return budget.DEFAULT, nil
+	end
+	local a, b = string.match(value, "^([^:]+):([^:]+)$")
+	local wall = if a then positive(a) else nil
+	local cpu = if b then positive(b) else nil
+	if wall == nil or cpu == nil then
+		return nil,
+			`tests/run: --budget must be <wall seconds>:<cpu seconds>, each a positive number (got "{value}")`
+	end
+	return { seconds = wall :: number, cpu = cpu :: number }, nil
+end
+
+-- The CPU seconds on the measurer's line, the last line of a worker's stdout, and the stdout without that line;
+-- (nil, stdout) when the last line is not the measurer's. Only a bounded tail is read: the line is at most a few dozen
+-- bytes, and a pattern over the whole output is quadratic in a long line.
+function budget.takeCpu(stdout: string): (number?, string)
+	local text = if string.sub(stdout, -1) == "\n" then string.sub(stdout, 1, -2) else stdout
+	local last = string.match(string.sub(text, -64), "([^\n]*)$") :: string
+	local start = #text - #last + 1
+	-- the line starts the text or follows a newline; a longer last line has no newline in the tail
+	if start > 1 and string.sub(text, start - 1, start - 1) ~= "\n" then
+		return nil, stdout
+	end
+	if string.sub(last, 1, #budget.CPU_PREFIX) ~= budget.CPU_PREFIX then
+		return nil, stdout
+	end
+	local n = string.match(string.sub(last, #budget.CPU_PREFIX + 1), "^(%d+%.%d+)$")
+	if n == nil then
+		return nil, stdout
+	end
+	return tonumber(n), string.sub(text, 1, start - 1)
+end
+
+-- The files over either limit (strictly), slowest first, ties by path. A file with no CPU measure is judged on wall only.
+function budget.over(costs: { Cost }, limits: Limits): { Cost }
+	local out: { Cost } = {}
+	for _, c in costs do
+		if c.seconds > limits.seconds or (c.cpu ~= nil and (c.cpu :: number) > limits.cpu) then
+			table.insert(out, c)
+		end
+	end
+	table.sort(out, function(x, y)
+		if x.seconds ~= y.seconds then
+			return x.seconds > y.seconds
+		end
+		return x.file < y.file
+	end)
+	return out
+end
+
+local function num(x: number): string
+	return string.format("%g", x)
+end
+
+-- The report, or nil when nothing is over: a header naming the limits and the lesson, one line per file (at most SHOWN),
+-- then how many more.
+function budget.render(over: { Cost }, limits: Limits): string?
+	if #over == 0 then
+		return nil
+	end
+	local lines = {
+		`over budget: {#over} spec files over {num(limits.seconds)} s wall or {num(limits.cpu)} s cpu (lesson {budget.LESSON})`,
+	}
+	for i = 1, math.min(#over, budget.SHOWN) do
+		local c = over[i]
+		local cpu = if c.cpu ~= nil then string.format("%.1f s cpu", c.cpu :: number) else "cpu not measured"
+		table.insert(lines, string.format("  %s %.1f s wall, %s", c.file, c.seconds, cpu))
+	end
+	if #over > budget.SHOWN then
+		table.insert(lines, `  and {#over - budget.SHOWN} more`)
+	end
+	return table.concat(lines, "\n")
+end
+
+return budget
