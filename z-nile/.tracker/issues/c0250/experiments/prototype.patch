+			if fs.isFile(prompt) then
+				fs.removeFile(prompt)
+			end
+			for _, claimPath in { claimFile(id), `{mainRoot()}/{claimFile(id)}` } do
+				if fs.isFile(claimPath) then
+					fs.removeFile(claimPath)
