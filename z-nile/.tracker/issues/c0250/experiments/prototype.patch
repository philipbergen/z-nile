+			if pulled.ok and before.ok then
+				local after = sh.run("git", { "-C", mainRoot(), "rev-parse", "HEAD" })
+				if after.ok then
+					sweepStale(mainRoot(), sh.trim(before.stdout), sh.trim(after.stdout))
+				end
+			end
+		end
