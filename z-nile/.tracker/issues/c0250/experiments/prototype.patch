+			local newDoc = withDesc(
+				render(`{TEMPLATES}/issue/doc.md`, vars),
+				{ ["--desc"] = { answer or words or "split out of " .. id } }
+			)
+			add(
+				`{itemRoot}/issues/{newId}/{newId}.md`,
+				withFront(withFront(newDoc, "idea", "unchallenged"), "status", stamp("new"))
