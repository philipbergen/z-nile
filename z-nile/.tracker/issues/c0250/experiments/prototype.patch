diff --git a/z-nile/tests/acceptance/d0416/narrow.py b/z-nile/tests/acceptance/d0416/narrow.py
new file mode 100644
index 000000000..3f659f41c
--- /dev/null
+++ b/z-nile/tests/acceptance/d0416/narrow.py
@@ -0,0 +1,116 @@
+# d0416 AC1: `z-nile/tests/acceptance/c0117/control-cli.spec.luau` equals its merge base (git merge-base HEAD <origin's
+# main, read with git ls-remote>) with exactly the three reviewed d0416 hunks applied, byte for byte (read as bytes), so
+# a deleted or added line anywhere (an assertion dropped from any case, the quiet half deleted, wrapped in `--[[ ]]`,
+# short-circuited by `do return end`, or its expectation changed to "failed") is red (lesson
+# zz-test/narrowing-pins-the-whole-file). The hunks are applied by anchored substitution, each anchor's count asserted
+# in the base first, so the pin depends on no line number and on no other case's text:
+#   (a) the one line giving c0095 its `.models.toml` is followed by c0098's two setup lines (issue and `.models.toml`);
+#   (b) the one comment line "a nested reviewer that goes quiet: ..." becomes the three-line comment saying why the
+#       quiet half reviews another issue;
+#   (c) the quiet half (from the bare `zn({ "dispatch", "z-design", "c0095" })` to its `"stalled"` assertion) becomes
+#       the same code on c0098, with `t.expect(n).toBe(1)` before the state is read (so a missing nested folder cannot
+#       read the author's own state); its expectation stays "stalled".
+# Three windows (lesson z-design/exact-checks-compare-against-the-merge-base): before the change lands, the base is the
+# stale form and the file must be the base plus the hunks; once the change is on origin's main (this branch landed, or
+# main moved on), the base already holds all three new forms and none of the old, and the file must equal that base
+# (nothing weakened since), which is not vacuous: the new forms must be there. A base holding some hunks only, or an
+# anchor whose count is wrong, is not the form this was reviewed against: red, stop for a re-prep. The base is
+# origin's published main read with git ls-remote (a moved local ref cannot turn the check green; zz-review/
+# sequestration-reference-not-a-ref); the check trusts this machine's git and the origin it resolves (check.sh prints
+# the URL). It checks this file only; that no engine file changes is AC4's.
+# Usage: python3 narrow.py <checkout> [<file to judge instead of the checkout's>]
+# (the second argument is for prep's mutation check only: check.sh never passes it).
+import pathlib, subprocess, sys
+
+R = pathlib.Path(sys.argv[1])
+F = "z-nile/tests/acceptance/c0117/control-cli.spec.luau"
+
+
+def git(*a):
+    return subprocess.run(["git", "-C", str(R), *a], capture_output=True, check=True).stdout
+
+
+def fail(msg):
+    print(msg)
+    sys.exit(1)
+
+
+try:
+    tip = git("ls-remote", "origin", "refs/heads/main").decode().split()[0]
+except (subprocess.CalledProcessError, IndexError):
+    fail("cannot read origin's main with git ls-remote (this check needs the network)")
+if subprocess.run(["git", "-C", str(R), "cat-file", "-e", tip + "^{commit}"], capture_output=True).returncode != 0:
+    fail(f"origin's main {tip[:8]} is not fetched: fetch origin main first")
+MB = git("merge-base", "HEAD", tip).decode().strip()
+try:
+    base = git("show", f"{MB}:{F}")
+except subprocess.CalledProcessError:
+    fail(f"{F} is not in the merge base {MB[:8]}")
+try:
+    now = (pathlib.Path(sys.argv[2]) if len(sys.argv) > 2 else R / F).read_bytes()
+except OSError:
+    fail(f"{F} is missing from the checkout")
+
+T = b"\t"
+A_OLD = (
+    T * 3 + b'["pickman/.tracker/issues/c0095/.models.toml"] = "[dispatch]\\ntool_seconds = 8\\nstall_seconds = 8\\n",\n'
+)
+A_NEW = (
+    A_OLD
+    + T * 3 + b'["pickman/.tracker/issues/c0098/c0098.md"] = issue("c0098", "quiet-review"),\n'
+    + T * 3 + b'["pickman/.tracker/issues/c0098/.models.toml"] = "[dispatch]\\ntool_seconds = 8\\nstall_seconds = 8\\n",\n'
+)
+B_OLD = (
+    T * 3 + b"-- a nested reviewer that goes quiet: it stalls at its own limits and its beats stop, so nothing hangs\n"
+)
+B_NEW = (
+    T * 3 + b"-- a nested reviewer that goes quiet: it stalls at its own limits and its beats stop, so nothing hangs. It reviews\n"
+    + T * 3 + b"-- another issue: c0095 holds design-review-001.md now, and a second design review is refused before any reviewer\n"
+    + T * 3 + b"-- starts (d0415, d0416)\n"
+)
+
+
+def quiet(item, extra):
+    return (
+        T * 3 + b'zn({ "dispatch", "z-design", "' + item + b'" })\n'
+        + T * 3 + b'local newest, n = "", 0\n'
+        + T * 3 + b'for _, name in fs.readDir(dirOf("' + item + b'")) do\n'
+        + T * 4 + b'local k = tonumber(string.match(name, "^zz%-review%-design%-' + item + b'%-(%d+)$") or "")\n'
+        + T * 4 + b"if k and k > n then\n"
+        + T * 5 + b"newest, n = name, k\n"
+        + T * 4 + b"end\n"
+        + T * 3 + b"end\n"
+        + extra
+        + T * 3 + b't.expect(fakecli.state(h, "' + item + b'", newest).outcome).toBe("stalled")\n'
+    )
+
+
+C_OLD = quiet(b"c0095", b"")
+C_NEW = quiet(
+    b"c0098", T * 3 + b"t.expect(n).toBe(1) -- c0098 is fresh: exactly one nested run, never the author's own state\n"
+)
+HUNKS = (("(a) c0098's two setup lines", A_OLD, A_NEW), ("(b) the quiet half's comment", B_OLD, B_NEW),
+         ("(c) the quiet half", C_OLD, C_NEW))
+
+old_counts = [base.count(o) for _, o, _ in HUNKS]
+landed = [base.count(n) for _, _, n in HUNKS]
+if old_counts == [1, 1, 1] and b"c0098" not in base:
+    expected, window = base, "stale base"
+    for _, o, n in HUNKS:
+        expected = expected.replace(o, n)
+elif landed == [1, 1, 1] and old_counts[1:] == [0, 0]:
+    # the change is on main: (a)'s old line stays inside its new text, so only (b) and (c) must be gone
+    expected, window = base, "landed base"
+else:
+    detail = "; ".join(f"{w}: {o} old and {n} new occurrences" for (w, _, _), o, n in zip(HUNKS, old_counts, landed))
+    fail(f"{F}: the base {MB[:8]} is neither the stale form d0416 was reviewed against nor the landed form ({detail}): "
+         "stop for a re-prep")
+
+if now != expected:
+    a, b = expected.split(b"\n"), now.split(b"\n")
+    i = next((k for k in range(min(len(a), len(b))) if a[k] != b[k]), min(len(a), len(b)))
+    want = a[i].decode(errors="replace") if i < len(a) else "<end of file>"
+    got = b[i].decode(errors="replace") if i < len(b) else "<end of file>"
+    fail(f"{F}: differs from its merge base {MB[:8]} with exactly the three d0416 hunks, first at line {i + 1}:\n"
+         f"  expected: {want}\n  found:    {got}\n(apply experiments/prototype.patch exactly; if the base moved, stop for a re-prep)")
+print(f"{F}: the {window} {MB[:8]}" + (" with exactly the three d0416 hunks" if window == "stale base" else " unchanged"))
diff --git a/z-nile/tests/acceptance/d0416/nested-second-review.spec.luau b/z-nile/tests/acceptance/d0416/nested-second-review.spec.luau
new file mode 100644
index 000000000..bb626a20d
--- /dev/null
+++ b/z-nile/tests/acceptance/d0416/nested-second-review.spec.luau
@@ -0,0 +1,183 @@
+--!strict
+-- d0416: a regression pin for what d0415 left untested. A second design review is refused before any reviewer starts,
+-- whether dispatched directly or by an author's step (a real `./zn dispatch z-design`, whose fake CLI starts the review
+-- as a headless author does); a first nested review starts its reviewer, so the refusal is about the second round, not
+-- about nesting. The expected refusal is built by dispatch.filing, its one writer. Fake CLIs (@tests/lib/fakecli),
+-- fixture under .cache/d0416-nested, about 15 s. It describes main as it is: it passes there.
+local dispatch = require("@znile/engine/dispatch")
+local dispatcher = require("@znile/engine/dispatcher")
+local fakecli = require("@tests/lib/fakecli")
+local fixture = require("@tests/lib/fixture")
+local fs = require("@lune/fs")
+local process = require("@lune/process")
+local t = require("@tests/lib/t")
+local trackerfix = require("@tests/lib/trackerfix")
+
+local MODELS = [[
+[dispatch]
+stall_seconds = 60
+tool_seconds = 120
+
+[roles.design]
+model = "claude-opus-5-5"
+cli = "claude"
+runtime = "claude-cli"
+rank = 3
+max_tokens = 5000
+effort = "high"
+fallbacks = []
+
+[roles.design-challenge]
+model = "claude-opus-5-5"
+cli = "claude"
+runtime = "claude-cli"
+rank = 4
+max_tokens = 5000
+effort = "xhigh"
+fallbacks = []
+]]
+
+local ISSUES = "pickman/.tracker/issues"
+local h: fakecli.Harness
+local wt: string
+
+-- what dispatch.filing says about an item whose folder holds design-review-001.md: the one writer of the refusal
+local function refusalFor(id: string): string
+	local f = dispatch.filing({
+		mode = "design",
+		dir = `{ISSUES}/{id}`,
+		prefix = "design-review-",
+		raftId = id,
+		reviews = { ["design-review-001.md"] = "# Review\n" },
+		grouped = nil,
+	})
+	return f.refusal or error("dispatch.filing no longer refuses a second review")
+end
+local function has(text: string, needle: string): boolean
+	return string.find(text, needle, 1, true) ~= nil
+end
+local function count(text: string, needle: string): number
+	local n, i = 0, 1
+	while true do
+		local a, b = string.find(text, needle, i, true)
+		if not a then
+			return n
+		end
+		n += 1
+		i = (b :: number) + 1
+	end
+end
+-- `./zn <args>` in the test worktree (a direct dispatch), with the fakes first on PATH
+local function znIn(args: { string }, extra: { [string]: string }?): fixture.Result
+	local argv = { "scripts/tracker.sh" }
+	for _, a in args do
+		table.insert(argv, a)
+	end
+	local env: { [string]: string } = {
+		FAKE_DIR = h.fakes,
+		PATH = `{h.bin}:{process.env.PATH}`,
+		ZN_AGENT_TOKEN_FILE = h.token,
+		GH_TOKEN = "the-users-token",
+	}
+	local more: { [string]: string } = extra or {}
+	for k, v in more do
+		env[k] = v
+	end
+	return fixture.exec(wt, "bash", argv, { env = env })
+end
+-- an author's step (the fake claude starts its review through the dispatcher, as the headless rule says), and a
+-- reviewer that writes its review
+local function authorAndReviewer()
+	fakecli.clear(h)
+	fakecli.mode(h, "claude.z-design", "waitreview")
+	fakecli.mode(h, "claude.zz-review", "reviewer")
+end
+-- the nested run folders of an author's state folder, by number
+local function nestedOf(id: string): { [number]: string }
+	local out: { [number]: string } = {}
+	local dir = `{dispatcher.homeAt(h.f.main)}/{id}`
+	for _, name in fs.readDir(dir) do
+		local k = tonumber(string.match(name, `^zz%-review%-design%-{id}%-(%d+)$`) or "")
+		if k then
+			out[k] = name
+		end
+	end
+	return out
+end
+
+return t.spec("d0416 a second design review is refused before any reviewer, nested or not", function(it)
+	it("sets up c0010, which holds design-review-001.md, and c0020, which holds no review", function()
+		h = fakecli.new("d0416-nested", {
+			[".models.toml"] = MODELS,
+			[`{ISSUES}/c0010/c0010.md`] = trackerfix.stub("c0010", "one", "new-quiet-copper-falcon"),
+			[`{ISSUES}/c0020/c0020.md`] = trackerfix.stub("c0020", "two", "new-quiet-copper-falcon"),
+		})
+		fakecli.advanceMain(h, {
+			[`{ISSUES}/c0010/design-review-001.md`] = "# Review\n\nVerdict: approve\n",
+		})
+		fixture.git(h.f.main, { "fetch", "-q", "origin", "main" })
+		wt = `{h.f.main}/.worktree/author`
+		fixture.git(h.f.main, { "worktree", "add", "-q", "-b", "author", wt, "origin/main" })
+		wt = fixture.physical(wt) :: string
+	end)
+
+	it("(i) a direct second design review is refused before any CLI starts", function()
+		authorAndReviewer()
+		local r = znIn({ "dispatch", "zz-review", "c0010", "--mode", "design" })
+		t.expect(r.ok).toBe(false)
+		t.expect(has(r.stdout .. r.stderr, refusalFor("c0010"))).toBe(true)
+		t.expect(fakecli.log(h)).toBe("")
+	end)
+
+	it(
+		"(ii) the review an author's step starts, twice on one item, is refused each time at zero tokens",
+		function()
+			authorAndReviewer()
+			for run = 1, 2 do
+				local r = fakecli.zn(h, { "dispatch", "z-design", "c0010" })
+				t.expect(fakecli.state(h, "c0010").outcome).toBe("ok") -- the author itself is fine
+				t.expect(r.code).toBe(0)
+				-- the nested run took a folder of its own each time: -1, then -2
+				local nested = nestedOf("c0010")
+				t.expect(nested[run] ~= nil).toBe(true)
+				local s = fakecli.state(h, "c0010", nested[run])
+				t.expect(s.outcome).toBe("failed")
+				t.expect(s.tokens).toBe(0)
+				t.expect(s.detail ~= nil and has(s.detail, refusalFor("c0010"))).toBe(true)
+			end
+			local nested = nestedOf("c0010")
+			t.expect(nested[1]).toBe("zz-review-design-c0010-1")
+			t.expect(nested[2]).toBe("zz-review-design-c0010-2")
+			local log = fakecli.log(h)
+			t.expect(count(log, "claude step=z-design")).toBe(2) -- both authors ran
+			t.expect(has(log, "claude step=zz-review")).toBe(false) -- no reviewer ever started
+			t.expect(has(log, "review=0")).toBe(false) -- each author's review command was refused
+			t.expect(count(log, "review=")).toBe(2)
+			t.expect(has(log, refusalFor("c0010"))).toBe(true) -- the author saw the refusal on its stderr
+		end
+	)
+
+	it("(iii) a nested first design review on an item with no review starts its reviewer", function()
+		authorAndReviewer()
+		-- ZN_DISPATCH_DIR set, as an author's step sets it for a review it starts
+		local parent = `{h.f.main}/.cache/dispatch/author-run`
+		fs.writeDir(parent)
+		local r = znIn({ "dispatch", "zz-review", "c0020", "--mode", "design" }, { ZN_DISPATCH_DIR = parent })
+		t.expect(has(fakecli.log(h), "claude step=zz-review")).toBe(true)
+		t.expect(has(r.stdout .. r.stderr, "there is no second round")).toBe(false)
+		t.expect(fakecli.state(h, "author-run", "zz-review-design-c0020-1").outcome).toBe("ok")
+	end)
+
+	it("(iv) the same through a real author step: its nested review starts and ends ok", function()
+		authorAndReviewer()
+		local r = fakecli.zn(h, { "dispatch", "z-design", "c0020" })
+		t.expect(r.code).toBe(0)
+		local log = fakecli.log(h)
+		t.expect(has(log, "claude step=zz-review")).toBe(true)
+		t.expect(has(log, "review=0")).toBe(true)
+		t.expect(has(log, "there is no second round")).toBe(false)
+		local nested = nestedOf("c0020")
+		t.expect(nested[1]).toBe("zz-review-design-c0020-1")
+		t.expect(fakecli.state(h, "c0020", nested[1]).outcome).toBe("ok")
+	end)
+end)
