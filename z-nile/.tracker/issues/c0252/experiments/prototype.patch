+-- c0252: what `./zn land-check` and `./zn done` read for landcheck.problems: the layers a landing binds (all the unlanded
+-- ones, up to `through`, or those below `below`), their completeness, the final review and trace, the approvals, the top
+-- layer's pull request and what main gained. `partial` leaves out what `done` checks itself further on (its own
+-- review, trace, approval and layer checks) so a manual `done` adds only the pull-request and main checks.
+-- Returns the input, the layer it lands through, or nil and why (a `below` with nothing under it gives neither).
+function H.landInput(
+	raft: store.Item,
+	through: string?,
+	below: string?,
+	partial: boolean?
+): (any?, string?, string?)
+	local landread = require("./landread")
+	local landcheck = require("./landcheck")
+	local issues = layergit.orderedMembers(raft)
+	local layers = layergit.layersOf(raft.id)
+	local orderedIds: { string } = {}
+	local landedMap: { [string]: boolean } = {}
+	local landedAt: { [number]: boolean } = {}
+	for i, issue in issues do
+		table.insert(orderedIds, issue.id)
+		landedMap[issue.id] = layergit.landed(issue.id)
+		landedAt[i] = landedMap[issue.id]
+	end
+	if below ~= nil then
+		local prev: string? = nil
+		for _, id in orderedIds do
+			if id == below then
+				break
+			end
+			if not landedMap[id] then
+				prev = id
+			end
+		end
+		if prev == nil then
+			return nil, nil, nil
+		end
+		through = prev
+	end
+	local bindIds, whyBind = stack.bindMembers(orderedIds, landedMap, through)
+	if not bindIds then
+		return nil, nil, whyBind
+	end
+	local marked = layergit.marked(raft)
+	local haveAt: { [number]: stack.Layer } = {}
+	for _, layer in layers do
+		haveAt[layer.position] = layer
+	end
+	local firstPos = 1
+	for i, issue in issues do
+		if issue.id == bindIds[1] then
+			firstPos = i
+		end
+	end
+	local checkLayers: { any } = {}
+	local topLayer: stack.Layer? = nil
+	for n, id in bindIds do
+		local i = firstPos + n - 1
+		local layer = haveAt[i]
+		local incomplete: string? = nil
+		if not layer then
+			incomplete = `{id} has no layer branch: ./zn start {raft.id}`
+		else
+			topLayer = layer
+			local onto = layergit.baseFor(haveAt, landedAt, i)
+			if i == firstPos then
+				onto = H.forkBase(layer, onto)
+			end
+			if not partial then
+				incomplete = if not onto
+					then `{layer.name} has no base`
+					elseif marked then layergit.completeReason(raft, layer, onto :: string)
+					elseif
+						not layergit.layerFinished(layer, onto :: string)
+					then `{id} is not finished: ./zn finish {id}`
+					else nil
+			end
+		end
+		table.insert(checkLayers, { issue = id, incomplete = incomplete })
+	end
+	-- layers not yet built are `layer-incomplete` (a worker's to build); the pull request read is the highest built one's
+	local tip = if topLayer then layergit.layerTip(topLayer :: stack.Layer) or "" else ""
+	local pr: landcheck.Pr?, prError: string? = nil, "no layer branch exists yet"
+	if topLayer then
+		pr, prError = landread.pr((topLayer :: stack.Layer).name)
+	end
+	local round = 0
+	if marked then
+		local onMainRounds, hereRounds = layergit.rounds(raft, "final-review")
+		round = stack.nextRound(onMainRounds, hereRounds)
+	end
+	local reviewWhy: string? = nil
+	local traceLines: { string } = {}
+	local drift: string? = nil
+	local openHigh: { string } = {}
+	local noVerdict = false
+	if not partial then
+		reviewWhy = reviewProblem(raft)
+		local traceName = if marked then string.format("trace-%03d.md", round) else "trace.md"
+		traceLines = traceProblems(raft, nil, through, traceName)
+		noVerdict = layergit.reviewVerdict(raft) == nil
+		if fs.isFile(raft.doc) then
+			openHigh = openlist.pending(fs.readFile(raft.doc))
+		end
+		for _, m in store.members(raft.id) do
+			if table.find(bindIds, m.id) then
+				local onMain =
+					sh.run("git", { "cat-file", "-e", `refs/remotes/origin/main:{approval.file(m)}` }).ok
+				drift = drift or approval.refusal(".", m, onMain)
+			end
+		end
+	end
+	local unreadable: { any } = {}
+	local baseRef = if layergit.shaOf("origin/main") then "origin/main" else "main"
+	local codePaths: { string } = {}
+	local gameRoots: { string } = {}
+	local okReg, reg = pcall(projects.load)
+	if not okReg then
+		table.insert(
+			unreadable,
+			{ code = "registry-unreadable", text = `the project registry could not be read: {reg}` }
+		)
+	else
+		for _, p in (reg :: projects.Registry).projects do
+			if p.home ~= "z-nile" and p.home ~= "." then
+				table.insert(gameRoots, p.home)
+			end
+		end
+		local fork = sh.run("git", { "merge-base", baseRef, tip })
+		local entries: any, why: any = nil, nil
+		if fork.ok then
+			entries, why = landread.rawEntries(sh.trim(fork.stdout), tip)
+		else
+			why = `git merge-base {baseRef} {tip} failed`
+		end
+		if entries then
+			codePaths = landread.codePaths(entries, projects.roots(reg :: projects.Registry))
+		else
+			table.insert(
+				unreadable,
+				{ code = "git-unreadable", text = `what the stack changes could not be read: {why}` }
+			)
+		end
+	end
+	-- c0251's frontier floor over the folders this landing covers: the raft's and each bound member's (the same call
+	-- `done` makes; land-check and the chain name the problem, c0251's refusal in `done` stays the person's)
+	local floorDirs: { string } = { raft.dir }
+	for _, m in store.members(raft.id) do
+		if table.find(bindIds, m.id) then
+			table.insert(floorDirs, m.dir)
+		end
+	end
+	local floor =
+		require("./reviewfiles").frontierVerdict(floorDirs, models.frontier(models.walk(".", raft.dir)))
+	-- where the cicd publish's configuration is (a guarded check run can name another file: G13)
+	local cicdFile = (if checking() then process.env.ZN_CICD_TOML else nil)
+		or `{process.env.HOME or ""}/.config/pickman/cicd.toml`
+	return {
+		raft = raft.id,
+		layers = checkLayers,
+		through = through,
+		topIssue = if topLayer then (topLayer :: stack.Layer).issue else bindIds[#bindIds],
+		topTip = tip,
+		pr = pr,
+		prError = prError,
+		reviewProblem = reviewWhy,
+		openHigh = openHigh,
+		traceProblems = traceLines,
+		approvalDrift = drift,
+		verdictMissing = noVerdict,
+		frontier = floor,
+		codePaths = codePaths,
+		unreadable = unreadable,
+		gameRoots = gameRoots,
+		cicd = fs.isFile(cicdFile),
+		topBranch = if topLayer then (topLayer :: stack.Layer).name else "",
+	},
+		through,
+		nil
+end
+
+-- c0252: the checks before a landing, read-only: `land-check <R-id> [--through <issue> | --below <issue>] [--json]`.
+-- Prints one line per problem (`code (kind): text`), or with --json the layer it would land through, the top layer's
+-- branch and tip and the problems; exit 0 when every check passes. The dispatcher runs it in the raft's worktree.
+cmd["land-check"] = function(pos: { string }, opts: { [string]: { string } })
+	local landcheck = require("./landcheck")
+	local serde = require("@lune/serde")
+	for k in opts do
+		if k ~= "--through" and k ~= "--below" and k ~= "--json" then
+			fail(
+				`usage: land-check <R-id> [--through <issue> | --below <issue>] [--json] (unknown option {k})`
+			)
+		end
+	end
+	if #pos ~= 1 or (opts["--through"] and opts["--below"]) then
+		fail("usage: land-check <R-id> [--through <issue> | --below <issue>] [--json]")
+	end
+	local raft = store.get(pos[1])
+	if raft.kind ~= "raft" or raft.state ~= "active" then
+		fail(`{raft.id} must be an active raft`)
+	end
+	if hasOrigin() then
+		sh.git({ "fetch", "--quiet", "origin" })
+	end
+	local asJson = opts["--json"] ~= nil
+	-- an old single-branch raft has no layer branch: it keeps its one pull request and a human's merge, and this
+	-- command says so (exit 2: not a pass, not a problem list) instead of printing a problem that is not one
+	if #layergit.layersOf(raft.id) == 0 then
+		if asJson then
+			print(serde.encode("json", { layered = false, through = "", problems = {} }))
+		else
+			print(
+				`{raft.id} has no layer branches: an old single-branch raft keeps its pull request and a human's merge (nothing here to land)`
+			)
+		end
+		process.exit(2)
+	end
+	local input, through, why = H.landInput(
+		raft,
+		if opts["--through"] then opts["--through"][1] else nil,
+		if opts["--below"] then opts["--below"][1] else nil
+	)
+	if not input then
+		if why then
+			fail(why)
+		end
+		if asJson then
+			print(serde.encode("json", { through = "", problems = {} }))
+		else
+			print("nothing below to land")
+		end
+		return
+	end
+	local problems = landcheck.problems(input)
+	if asJson then
+		local rows: { any } = {}
+		for _, p in problems do
+			table.insert(
+				rows,
+				{ code = p.code, kind = p.kind, text = p.text, reason = p.reason, layer = p.layer or "" }
+			)
+		end
+		print(
+			serde.encode(
+				"json",
+				{ through = through or "", top = input.topBranch, tip = input.topTip, problems = rows }
+			)
+		)
+	else
+		for _, line in landcheck.lines(problems) do
+			print(line)
+		end
+	end
+	if #problems > 0 then
+		process.exit(1)
+	end
+end
+
+-- c0252: `./zn lander [<R-id>]` lands the land requests that workers holding the agent's credential left
+-- (`.cache/land-requests/<R-id>`), with this session's own credential and the base's engine against the worker's worktree
+-- (`./zn -C`), exactly as the dispatcher's chain lands: the request's tip must still be the layer's published tip, every
+-- check passes, a game is gated by `land-gate`, then `done`. Refused in a session that holds the agent's credential.
+cmd.lander = function(pos: { string }, opts: { [string]: { string } })
+	local landcheck = require("./landcheck")
+	local serde = require("@lune/serde")
+	for k in opts do
+		fail(`usage: lander [<R-id>] (unknown option {k})`)
+	end
+	if (process.env.ZN_DISPATCH or "") ~= "" or (process.env.ZN_HEADLESS or "") ~= "" then
+		fail(
+			"lander is refused in a session that holds the agent's credential (ZN_DISPATCH or ZN_HEADLESS is set)"
+		)
+	end
+	local root = mainRoot()
+	local dir = `{root}/{landcheck.LAND_REQUESTS}`
+	local names: { string } = {}
+	if pos[1] then
+		table.insert(names, pos[1])
+	elseif fs.isDir(dir) then
+		names = fs.readDir(dir)
+		table.sort(names)
+	end
+	if #names == 0 then
+		print("no land request waits")
+		return
+	end
+	local zn = `{root}/zn`
+	local function run(
+		wt: string,
+		args: { string }
+	): { ok: boolean, code: number, stdout: string, stderr: string }
+		local argv: { string } = { "-C", wt }
+		for _, a in args do
+			table.insert(argv, a)
+		end
+		return process.exec(zn, argv, { cwd = root })
+	end
+	local failed = false
+	for _, name in names do
+		local path = `{dir}/{name}`
+		local req = if fs.isFile(path) then landcheck.parseLandRequest(fs.readFile(path)) else nil
+		if not req or req.item ~= name then
+			stdio.ewrite(`lander: {path} is not a land request: left as it is\n`)
+			failed = true
+			continue
+		end
+		if not fs.isDir(req.worktree) then
+			stdio.ewrite(`lander: {req.item}: the worktree {req.worktree} is gone: the request is void\n`)
+			pcall(fs.removeFile, path)
+			failed = true
+			continue
+		end
+		local args = { "land-check", req.item }
+		if req.through then
+			table.insert(args, "--through")
+			table.insert(args, req.through)
+		end
+		table.insert(args, "--json")
+		local checked = run(req.worktree, args)
+		local okj, j = pcall(function()
+			return serde.decode("json", checked.stdout)
+		end)
+		local current = if okj
+				and type(j) == "table"
+				and type((j :: any).tip) == "string"
+			then (j :: any).tip
+			else ""
+		if not landcheck.landRequestFresh(req, current) then
+			stdio.ewrite(
+				`lander: {req.item}: its top layer moved since the request ({req.tip} to {if current
+						== ""
+					then "unreadable"
+					else current}): the worker's checks were of the old tip; the request is void, and the worker asks again with ./zn done\n`
+			)
+			pcall(fs.removeFile, path)
+			failed = true
+			continue
+		end
+		local lines: { string } = {}
+		for _, p in (j :: any).problems do
+			if p.code ~= "self-gating" and p.code ~= "cicd-missing" then
+				table.insert(lines, `{p.code} ({p.kind}): {p.text}`)
+			end
+		end
+		if #lines > 0 then
+			stdio.ewrite(`lander: {req.item} is not ready to land:\n{table.concat(lines, "\n")}\n`)
+			failed = true
+			continue
+		end
+		local gate = run(
+			req.worktree,
+			if req.through
+				then { "land-gate", req.item, "--through", req.through }
+				else { "land-gate", req.item }
+		)
+		if not gate.ok then
+			stdio.ewrite(
+				`lander: {req.item}: the clean-clone gate {if gate.code == 4
+					then "could not run"
+					else "is red"}: {gate.stdout}{gate.stderr}\n`
+			)
+			failed = true
+			continue
+		end
+		local switched = sh.run("git", { "-C", req.worktree, "switch", "--quiet", "--detach", req.tip })
+		if not switched.ok then
+			stdio.ewrite(`lander: {req.item}: could not check out {req.tip}: {sh.trim(switched.stderr)}\n`)
+			failed = true
+			continue
+		end
+		local landed = run(
+			req.worktree,
+			if req.through then { "done", req.item, "--through", req.through } else { "done", req.item }
+		)
+		print(landed.stdout)
+		if not landed.ok then
+			stdio.ewrite(landed.stderr)
+			failed = true
+			continue
+		end
+		pcall(fs.removeFile, path)
+		print(`lander: {req.item} landed`)
+	end
+	if failed then
+		process.exit(1)
+	end
+end
+-- c0252: the gate the dispatcher runs before it lands a stack, read from zz-rules Merging 2 and 3: a stack that changes
+-- a game is gated in a clean clone outside this checkout, on the tree the bind would make (origin/main with the top
+-- layer merged): `z-nile/check.sh --full` there (with PICKMAN_FENCE_REAL_GIT as Merging 2 says), then
+-- `../zn run --time 1800 -- lune run scripts/cicd`. A tooling-only stack needs neither: `done`'s affected gate on the
+-- merged tree is its merge gate. Exit 0 passes, 4 waits (no cicd.toml, a lease held, the publish failed), 1 is red.
+-- The two commands can be replaced, only inside a guarded check run (`checking()`), by ZN_LANDGATE_FULL and
+-- ZN_LANDGATE_CICD: a spec's fakes.
+cmd["land-gate"] = function(pos: { string }, opts: { [string]: { string } })
