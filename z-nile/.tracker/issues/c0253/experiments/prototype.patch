@@ -0,0 +1,229 @@
+--!strict
+-- The exchange of a dispatched run (c0256): the messages between the user and the run's steps, kept in the run's
+-- state folder as `exchange/NNN-<kind>.md`, one file per message, so a re-run step reads the whole conversation with
+-- its dates instead of only the latest question. Pure over names and texts; the dispatcher reads and writes the files.
+--
+--   001-ask.md       the user's own request (`dispatch new "<words>"`), dated from the first message
+--   002-question.md  what a step stopped to ask, copied from its questions.md (a restatement is a question)
+--   003-answer.md    the user's reply (an approval or a correction) from `dispatch retry`
+--
+-- A file is `date: <UTC time>`, for a question a `step: <the step that asked>` line, one blank line, then the message
+-- exactly as it was written (no escaping, no newline added). The order is the number: an ask only first, a question
+-- after an ask or an answer, an answer after a question, no gap and no repeat; any other name in the folder is an
+-- error, never skipped. The dispatcher also keeps a seal of what it wrote (the sha256 of each file, in state.json),
+-- so a step that rewrote the record is noticed.
+local serde = require("@lune/serde")
+
+local exchange = {}
+
+export type Kind = "ask" | "question" | "answer"
+export type Entry = { n: number, kind: Kind, date: string, step: string?, body: string }
+
+exchange.DIR = "exchange"
+exchange.MAX = 999
+exchange.LIMIT = 65536 -- the most bytes of one answer
+exchange.NO_REPLY = "(no reply: the user ran retry without an answer)"
+exchange.WITHDRAWN = "(no reply: questions.md was removed without an answer)"
+exchange.UNKNOWN_REPLY =
+	"(the question was copied when the user retried, so any answer they wrote is inside it)"
+
+-- the kind a word names (a plain function, so the type checker sees a Kind and not a string)
+local function kindOf(word: string): Kind?
+	if word == "ask" then
+		return "ask"
+	elseif word == "question" then
+		return "question"
+	elseif word == "answer" then
+		return "answer"
+	end
+	return nil
+end
+
+type Named = { n: number, kind: Kind }
+
+-- Kind comparison through a function: the checker widens a refined union after an earlier branch of a chain
+local function same(a: Kind?, b: Kind): boolean
+	return a == b
+end
+
+local function named(name: string): Named?
+	local num, word = string.match(name, "^(%d%d%d)%-([a-z]+)%.md$")
+	if num == nil or word == nil then
+		return nil
+	end
+	local kind: Kind? = kindOf(word :: string)
+	if kind == nil then
+		return nil
+	end
+	return { n = tonumber(num :: string) :: number, kind = kind :: Kind }
+end
+
+function exchange.name(n: number, kind: Kind): string
+	return string.format("%03d-%s.md", n, kind)
+end
+
+-- The number and kind a file name says, or nil.
+function exchange.parseName(name: string): (number?, Kind?)
+	local got = named(name)
+	if got == nil then
+		return nil, nil
+	end
+	return got.n, got.kind
+end
+
+-- `step` is the step that asked, for a question only.
+function exchange.render(date: string, body: string, step: string?): string
+	return `date: {date}\n{if step then `step: {step}\n` else ""}\n{body}`
+end
+
+-- The entry a file holds, or nil and why.
+function exchange.parse(name: string, text: string): (Entry?, string?)
+	local got = named(name)
+	if got == nil then
+		return nil, `{name} is not an exchange file (NNN-ask|question|answer.md)`
+	end
+	local date, rest = string.match(text, "^date: (%d%d%d%d%-%d%d%-%d%dT%d%d:%d%d:%d%dZ)\n(.*)$")
+	if date == nil or rest == nil then
+		return nil, `{name} does not start with "date: <UTC time>"`
+	end
+	if same(got.kind, "question") then
+		local step, body = string.match(rest :: string, "^step: ([a-z][a-z0-9%-]*)\n\n(.*)$")
+		if step == nil or body == nil then
+			return nil,
+				`{name} is a question and must say "step: <the step that asked>" and then a blank line`
+		end
+		return {
+			n = got.n,
+			kind = got.kind,
+			date = date :: string,
+			step = step :: string,
+			body = body :: string,
+		},
+			nil
+	end
+	local body = string.match(rest :: string, "^\n(.*)$")
+	if body == nil then
+		return nil, `{name} must have a blank line after its date line (only a question has a step line)`
+	end
+	return { n = got.n, kind = got.kind, date = date :: string, step = nil, body = body :: string }, nil
+end
+
+-- The names in order, or nil and why: every name is an exchange file, numbered 1, 2, 3 without a gap or a repeat, and
+-- the kinds alternate as the header says. Names that start with a dot (a file being written) are not part of it.
+function exchange.order(names: { string }): ({ string }?, string?)
+	local byN: { [number]: string } = {}
+	local kinds: { [number]: Kind } = {}
+	local top = 0
+	for _, name in names do
+		if string.sub(name, 1, 1) ~= "." then
+			local got = named(name)
+			if got == nil then
+				return nil, `{name} is not an exchange file (NNN-ask|question|answer.md)`
+			end
+			if byN[got.n] ~= nil then
+				return nil, `{name} repeats number {got.n} ({byN[got.n]})`
+			end
+			byN[got.n], kinds[got.n] = name, got.kind
+			top = math.max(top, got.n)
+		end
+	end
+	local out: { string } = {}
+	local before: Kind? = nil
+	for n = 1, top do
+		local name = byN[n]
+		local kind: Kind = kinds[n] :: any
+		if name == nil then
+			return nil, `the exchange has no file number {n} (it has {top})`
+		end
+		if same(kind, "ask") and n ~= 1 then
+			return nil, `{name}: an ask can only be the first message`
+		elseif same(kind, "question") and same(before, "question") then
+			return nil, `{name}: a question cannot follow a question`
+		elseif same(kind, "answer") and not same(before, "question") then
+			return nil, `{name}: an answer must follow a question`
+		end
+		before = kind
+		table.insert(out, name)
+	end
+	return out, nil
+end
+
+-- The number of the next file for `kind`, or nil and why that kind may not follow.
+function exchange.next(names: { string }, kind: Kind): (number?, string?)
+	local ordered, why = exchange.order(names)
+	if ordered == nil then
+		return nil, why
+	end
+	local n = #ordered + 1
+	if n > exchange.MAX then
+		return nil, `the exchange is full ({exchange.MAX} messages)`
+	end
+	local lastNamed = named(ordered[#ordered] or "")
+	local last: Kind? = if lastNamed then lastNamed.kind else nil
+	if same(kind, "ask") and n ~= 1 then
+		return nil, "an ask can only be the first message"
+	elseif same(kind, "question") and same(last, "question") then
+		return nil, "a question cannot follow a question"
+	elseif same(kind, "answer") and not same(last, "question") then
+		return nil, "an answer must follow a question"
+	end
+	return n, nil
+end
+
+-- What the dispatcher wrote: the sha256 of each file's text, by name.
+function exchange.seal(texts: { [string]: string }): { [string]: string }
+	local out: { [string]: string } = {}
+	for name, text in texts do
+		out[name] = serde.hash("sha256", text)
+	end
+	return out
+end
+
+-- The first difference between the seal and the files as they are now ("added X", "changed X", "removed X"), or nil.
+-- No seal means nothing was written, so any file is an addition.
+function exchange.changed(sealed: { [string]: string }?, texts: { [string]: string }): string?
+	local seal: { [string]: string } = sealed or {}
+	local now = exchange.seal(texts)
+	local names: { string } = {}
+	for name in now do
+		table.insert(names, name)
+	end
+	for name in seal do
+		if now[name] == nil then
+			table.insert(names, name)
+		end
+	end
+	table.sort(names)
+	for _, name in names do
+		if seal[name] == nil then
+			return `added {name}`
+		elseif now[name] == nil then
+			return `removed {name}`
+		elseif now[name] ~= seal[name] then
+			return `changed {name}`
+		end
+	end
+	return nil
+end
+
+-- Why a message (`what`: "the answer", "the question") is refused (blank, too large, binary), or nil.
+function exchange.answerRefusal(text: string, what: string?): string?
+	local name = what or "the answer"
+	if string.find(text, "^%s*$") then
+		return `{name} is empty`
+	elseif #text > exchange.LIMIT then
+		return `{name} is {#text} bytes; the most is {exchange.LIMIT}`
+	elseif string.find(text, "\0", 1, true) then
+		return `{name} holds a NUL byte (a binary file?)`
+	end
+	return nil
+end
+
+-- A text compared as an editor leaves it: line ends and trailing whitespace do not count.
+function exchange.normal(text: string): string
+	local lf = string.gsub(text, "\r\n", "\n")
+	local lines = string.gsub(lf, "[ \t]+\n", "\n")
+	return (string.gsub(lines, "%s+$", ""))
+end
+
+return exchange
diff --git a/z-nile/engine/family.luau b/z-nile/engine/family.luau
new file mode 100644
index 000000000..6e12ccdd3
--- /dev/null
+++ b/z-nile/engine/family.luau
@@ -0,0 +1,38 @@
+--!strict
+-- c0251: which model line an id belongs to. A family is a model line (opus, fable, sonnet, kimi, grok, deepseek), kept as a
+-- prefix table in `.models.toml` (`[families]`) the user edits. Pure: ids and the table in, a family out. This is the one
+-- function that maps an id to a family; every other module (the picker, the dry-run, the board) asks it.
+
+local family = {}
+
+export type Families = { [string]: { string } } -- family -> id prefixes
+
+-- `models.bareModel` (one trailing context marker `[...]` removed), spelt here because models.luau requires this module.
+local function bare(id: string): string
+	return (string.gsub(id, "%[[^%[%]]*%]$", ""))
+end
+
+-- The family of the longest prefix that matches the bare model id, or nil when none matches. Two families holding the same
+-- prefix (two files can) are broken by name, so the answer never depends on table order.
+function family.of(id: string, f: Families): string?
+	local model = bare(id)
+	local best: string? = nil
+	local bestLen = 0
+	for name, prefixes in f do
+		for _, prefix in prefixes do
+			if prefix ~= "" and string.sub(model, 1, #prefix) == prefix then
+				if #prefix > bestLen or (#prefix == bestLen and best ~= nil and name < best) then
+					best, bestLen = name, #prefix
+				end
+			end
+		end
+	end
+	return best
+end
+
+-- True when both sides name a family and it is the same one: an unknown family is never the same as anything.
+function family.same(a: string?, b: string?): boolean
+	return a ~= nil and b ~= nil and a == b
+end
+
+return family
diff --git a/z-nile/engine/heartbeat.luau b/z-nile/engine/heartbeat.luau
new file mode 100644
index 000000000..cbd8667e9
--- /dev/null
+++ b/z-nile/engine/heartbeat.luau
@@ -0,0 +1,61 @@
+--!strict
+-- The part of c0265's work heartbeat (R0100/3/c0275 e417120b7, `engine/heartbeat.luau`) that the dispatcher's claimBeat
+-- needs (c0275): the interval, the spec-run setting, the due test, the stamp and the outcome of its beat child. The prototype
+-- copies only these six; c0265 owns the whole file (verdicts, takeover, the branch reads).
+local heartbeat = {}
+
+heartbeat.INTERVAL = 300
+heartbeat.SKEW = 300
+
+-- A tuning setting (ZN_BEAT_EVERY, ZN_NET_SECONDS): honoured only inside a spec run, and only a positive whole number.
+function heartbeat.setting(
+	env: { [string]: string? },
+	name: string,
+	default: number,
+	specRun: boolean
+): number
+	local raw = env[name]
+	local n = if raw ~= nil then tonumber(raw) else nil
+	if specRun and n ~= nil and n >= 1 and n == math.floor(n) then
+		return n
+	end
+	return default
+end
+
+-- Whether a beat is due: never made, a full `every` old, or dated past the skew allowance (a clock that went back).
+function heartbeat.due(last: number?, now: number, every: number): boolean
+	return last == nil or now - last >= every or last > now + heartbeat.SKEW
+end
+
+-- The dispatcher's stamp for a step's item: the claim its step worktree remembers (a step that made its own claim), else
+-- the stamp main showed when the step started.
+function heartbeat.dispatchStamp(started: string?, remembered: string?): string?
+	if remembered ~= nil and remembered ~= "" then
+		return remembered
+	end
+	return started
+end
+
+-- What the dispatcher does with the answer of its `zn beat <id> --adopt --stamp <S>` child: "beat" (landed), "lost" (the
+-- claim was taken over or ended mid-step: stop beating and say so once), "none" (no claim yet: the step has not made its
+-- own: ignored) or "failed" (written once per step to the run's stderr).
+function heartbeat.dispatchOutcome(ok: boolean, stderr: string): string
+	if ok then
+		return "beat"
+	elseif
+		string.find(stderr, "claim was taken over", 1, true) or string.find(stderr, "claim ended", 1, true)
+	then
+		return "lost"
+	elseif string.find(stderr, "no claim to beat", 1, true) then
+		return "none"
+	end
+	return "failed"
+end
+
+-- The claim stamp in a document's status field, nil for anything that is not a live claim (preparing-… or active-…).
+function heartbeat.stampIn(status: string?): string?
+	local kind = if status then string.match(status, "^(%a+)%-%a+%-%a+%-%a+$") else nil
+	return if kind == "preparing" or kind == "active" then status else nil
+end
+
+return heartbeat
diff --git a/z-nile/engine/landcheck.luau b/z-nile/engine/landcheck.luau
new file mode 100644
index 000000000..2feb04d47
--- /dev/null
+++ b/z-nile/engine/landcheck.luau
@@ -0,0 +1,495 @@
+--!strict
+-- c0252: the checks before a raft's stack (or its green prefix) lands, as one pure function over what the edge read
+-- (landread.luau, `./zn land-check`): each failed check is a named problem, and the chain acts on the strictest kind.
+-- `./zn done` and the dispatcher both call it, so a manual landing and the dispatcher's agree (one lander, Q5).
+-- Pure (zz-arch): texts and numbers in, problems and verdicts out; nothing is read, run or written here.
+local escalation = require("./escalation")
+
+local landcheck = {}
+
+-- wait: nothing for a worker to do (CI pending, no check registered yet, GitHub still computing, a read that failed, a
+--   stack that changes the gate that would judge it): the chain stops at the gate (exit 4) and a later run looks again.
+-- redo: a worker can fix it (a layer not complete, a review not answered, a stale trace, a red check, a head that is not
+--   the tip): the chain runs the worker again, and after `cap` repeats of the same failure the raft blocks.
+-- block: only a person can decide (an unruled high finding, approval drift, a closed pull request): escalate at once.
+-- Anything else is read as a wait: the unguarded action (land) follows only an explicit "no problem" (zz-arch rule 7).
+export type Kind = "wait" | "redo" | "block"
+export type Problem = {
+	code: string,
+	kind: Kind,
+	text: string,
+	reason: string, -- the escalation reason it files under when it blocks (escalation.REASONS)
+	layer: string?, -- the issue the problem is about, when one
+}
+export type Check = { name: string, state: string } -- state: gh's conclusion or state, upper case ("" while running)
+export type Pr = {
+	state: string, -- OPEN, MERGED or CLOSED
+	draft: boolean,
+	head: string, -- the head commit gh reports
+	mergeable: string, -- MERGEABLE, CONFLICTING or UNKNOWN
+	checks: { Check },
+}
+export type Layer = { issue: string, incomplete: string? } -- `incomplete`: layergit.completeReason's text
+export type Input = {
+	raft: string,
+	layers: { Layer }, -- the layers this landing binds, bottom first
+	through: string?, -- the layer a prefix landing stops at (nil: the whole stack)
+	topIssue: string, -- the last layer bound
+	topTip: string, -- the published tip of that layer: what the bind lands
+	pr: Pr?, -- the top layer's pull request; nil when gh could not read it
+	prError: string?, -- why `pr` is nil
+	reviewProblem: string?, -- main.luau's reviewProblem: the final review is not answered
+	openHigh: { string }, -- ids of high findings with no ruling under `## Open to the human`
+	traceProblems: { string }, -- `./zn trace --check`'s lines
+	approvalDrift: string?, -- approval.refusal's text
+	verdictMissing: boolean,
+	codePaths: { string }, -- paths the bind changes that are not tracker state (landread.codePaths: trackerstate's rule)
+	gameRoots: { string }, -- project homes whose game code needs the cicd publish (zz-rules Merging 3)
+	cicd: boolean, -- ~/.config/pickman/cicd.toml exists
+	unreadable: { Unreadable }, -- reads that failed (git, the registry): each is a wait, never a pass
+	gate: { red: string? }?, -- the clean-clone full gate and cicd run before the landing (`land-gate`)
+}
+export type Unreadable = { code: string, text: string }
+
+-- Paths whose change makes a stack its own judge: the gate's driver, the selector and the runner. The landing runs
+-- these from the stack's own tree (the merged tree is what is gated), so a stack that changes them is a person's to land.
+landcheck.SELF_GATING = {
+	"zn",
+	"z-nile/check.sh",
+	"z-nile/affected.luau",
+	"z-nile/specs.luau",
+	"z-nile/tests/run.luau",
+	"z-nile/lib/",
+}
+
+local function problem(code: string, kind: Kind, text: string, reason: string, layer: string?): Problem
+	return { code = code, kind = kind, text = text, reason = reason, layer = layer }
+end
+
+-- Whether any of the bind's code paths (landread.codePaths: not tracker state) is inside a game home.
+function landcheck.touchesGame(codePaths: { string }, gameRoots: { string }): boolean
+	for _, p in codePaths do
+		for _, root in gameRoots do
+			if string.sub(p, 1, #root + 1) == root .. "/" then
+				return true
+			end
+		end
+	end
+	return false
+end
+
+-- The first code path that is part of the gate's own driver, or nil.
+function landcheck.selfGating(codePaths: { string }): string?
+	for _, p in codePaths do
+		for _, g in landcheck.SELF_GATING do
+			if p == g or (string.sub(g, -1) == "/" and string.sub(p, 1, #g) == g) then
+				return p
+			end
+		end
+	end
+	return nil
+end
+
+local FAILED = {
+	FAILURE = true,
+	ERROR = true,
+	CANCELLED = true,
+	TIMED_OUT = true,
+	ACTION_REQUIRED = true,
+	STARTUP_FAILURE = true,
+}
+local PASSED = { SUCCESS = true, NEUTRAL = true, SKIPPED = true }
+
+-- "Green" on the top layer's head: no failed and no running check, SUCCESS, NEUTRAL and SKIPPED passing (a draft
+-- layer's `deploy` workflow is skipped). A state this list does not know is running, never passed. Returns the failed
+-- check names and the pending ones.
+function landcheck.checks(checks: { Check }): ({ string }, { string })
+	local failed: { string } = {}
+	local pending: { string } = {}
+	for _, c in checks do
+		if PASSED[c.state] then
+			continue
+		elseif FAILED[c.state] then
+			table.insert(failed, c.name)
+		else
+			table.insert(pending, c.name)
+		end
+	end
+	return failed, pending
+end
+
+-- The problem of the clean-clone full gate and the cicd run (`./zn land-gate`), which the dispatcher remembers per tip: a
+-- red run is a redo like any red check. A gate that could not run (no cicd.toml, a lease held, the publish failed) is not
+-- remembered: it stops the chain at the gate (exit 4) and runs again at the next pass.
+function landcheck.gateProblems(gate: { red: string? }?): { Problem }
+	local out: { Problem } = {}
+	if gate and gate.red then
+		table.insert(out, problem("full-gate-red", "redo", gate.red, "red-gate", nil))
+	end
+	return out
+end
+
+-- Every failed check of the landing, in the order a person reads them. Nothing here reads the world: an input that
+-- could not be read is a problem the edge already named (fail closed).
+function landcheck.problems(i: Input): { Problem }
+	local out: { Problem } = {}
+	local function add(p: Problem)
+		table.insert(out, p)
+	end
+	for _, u in i.unreadable do
+		add(problem(u.code, "wait", u.text, "red-gate", nil))
+	end
+	for _, l in i.layers do
+		if l.incomplete then
+			add(problem("layer-incomplete", "redo", `{l.issue}: {l.incomplete}`, "design-gap", l.issue))
+		end
+	end
+	if i.verdictMissing then
+		add(
+			problem(
+				"no-verdict",
+				"redo",
+				`{i.raft} has no Verdict line in its final review`,
+				"review-exhausted",
+				nil
+			)
+		)
+	end
+	if #i.openHigh > 0 then
+		add(
+			problem(
+				"open-high",
+				"block",
+				`unruled high finding(s) under ## Open to the human: {table.concat(i.openHigh, ", ")}`,
+				"review-exhausted",
+				nil
+			)
+		)
+	elseif i.reviewProblem then
+		add(problem("review-open", "redo", i.reviewProblem, "review-exhausted", nil))
+	end
+	for _, line in i.traceProblems do
+		add(problem("trace-stale", "redo", line, "review-exhausted", nil))
+	end
+	if i.approvalDrift then
+		add(problem("approval-drift", "block", i.approvalDrift, "needs-decision", nil))
+	end
+	local own = landcheck.selfGating(i.codePaths)
+	if own then
+		add(
+			problem(
+				"self-gating",
+				"wait",
+				`the stack changes {own}, part of the gate that would judge it: a person lands it (./zn done {i.raft})`,
+				"needs-decision",
+				nil
+			)
+		)
+	end
+	if landcheck.touchesGame(i.codePaths, i.gameRoots) and not i.cicd then
+		add(
+			problem(
+				"cicd-missing",
+				"wait",
+				"the stack changes a game and ~/.config/pickman/cicd.toml is missing: the cicd publish cannot run on this machine",
+				"needs-decision",
+				nil
+			)
+		)
+	end
+	for _, p in landcheck.gateProblems(i.gate) do
+		add(p)
+	end
+	local pr = i.pr
+	if not pr then
+		add(
+			problem(
+				"pr-unreadable",
+				"wait",
+				`the pull request of {i.topIssue} could not be read ({i.prError or "gh gave nothing"}): nothing is landed on a state that was not read`,
+				"red-gate",
+				i.topIssue
+			)
+		)
+	elseif pr.state == "CLOSED" or pr.state == "MERGED" then
+		add(
+			problem(
+				"pr-closed",
+				"block",
+				`the pull request of {i.topIssue} is {string.lower(pr.state)}, not open`,
+				"needs-decision",
+				i.topIssue
+			)
+		)
+	elseif pr.state ~= "OPEN" then
+		add(
+			problem(
+				"pr-state-unknown",
+				"wait",
+				`the pull request of {i.topIssue} reports the state "{pr.state}", which is not OPEN: nothing is landed on it`,
+				"red-gate",
+				i.topIssue
+			)
+		)
+	elseif pr.head ~= i.topTip then
+		add(
+			problem(
+				"pr-head-moved",
+				"redo",
+				`the pull request head {pr.head} is not the layer tip {i.topTip}: publish the layer ({i.topIssue}) and let CI look at it`,
+				"red-gate",
+				i.topIssue
+			)
+		)
+	else
+		if #pr.checks == 0 then
+			add(
+				problem(
+					"ci-none",
+					"wait",
+					`no check is registered on {i.topIssue}'s head yet: an empty rollup is not a green one`,
+					"red-gate",
+					i.topIssue
+				)
+			)
+		end
+		local failed, pending = landcheck.checks(pr.checks)
+		if #failed > 0 then
+			add(
+				problem(
+					"ci-failed",
+					"redo",
+					`CI failed on {i.topIssue}'s head {pr.head}: {table.concat(failed, ", ")}`,
+					"red-gate",
+					i.topIssue
+				)
+			)
+		end
+		if #pending > 0 then
+			add(
+				problem(
+					"ci-pending",
+					"wait",
+					`CI is still running on {i.topIssue}'s head: {table.concat(pending, ", ")}`,
+					"red-gate",
+					i.topIssue
+				)
+			)
+		end
+		-- a draft layer's mergeable is UNKNOWN for as long as it is a draft (done's merge onto main judges conflicts)
+		if not pr.draft then
+			if pr.mergeable == "CONFLICTING" then
+				add(
+					problem(
+						"pr-conflicting",
+						"redo",
+						`the pull request of {i.topIssue} conflicts with its base: ./zn restack {i.raft}`,
+						"red-gate",
+						i.topIssue
+					)
+				)
+			elseif pr.mergeable ~= "MERGEABLE" then
+				add(
+					problem(
+						"pr-mergeable-unknown",
+						"wait",
+						`GitHub has not said whether the pull request of {i.topIssue} merges ("{pr.mergeable}"): it is still computing it`,
+						"red-gate",
+						i.topIssue
+					)
+				)
+			end
+		end
+	end
+	return out
+end
+
+export type Verdict = {
+	action: "land" | "wait" | "redo" | "block",
+	problems: { Problem },
+	reason: string?, -- block: the escalation reason
+	layer: string?, -- block: the Layer
+}
+
+local KINDS = { wait = true, redo = true, block = true }
+
+-- What the chain does: land only when nothing failed; block at once on a block problem; run the worker again on a redo
+-- problem until `cap` repeats of the same failure are spent, then block; otherwise wait. A kind this module does not
+-- know is a wait. A redo outranks a wait (waiting on CI for a stack the worker must change is pointless), and a wait
+-- never blocks.
+function landcheck.classify(ps: { Problem }, tries: number, cap: number): Verdict
+	if #ps == 0 then
+		return { action = "land", problems = ps }
+	end
+	local firstBlock: Problem? = nil
+	local firstRedo: Problem? = nil
+	for _, p in ps do
+		if p.kind == "block" and not firstBlock then
+			firstBlock = p
+		elseif p.kind == "redo" and not firstRedo then
+			firstRedo = p
+		end
+	end
+	if firstBlock then
+		return { action = "block", problems = ps, reason = firstBlock.reason, layer = firstBlock.layer }
+	end
+	if firstRedo then
+		if tries >= cap then
+			return { action = "block", problems = ps, reason = firstRedo.reason, layer = firstRedo.layer }
+		end
+		return { action = "redo", problems = ps }
+	end
+	return { action = "wait", problems = ps }
+end
+
+-- Whether a problem row (from `./zn land-check`) names a kind this module knows; the dispatcher turns any other row
+-- into a wait.
+function landcheck.knownKind(kind: any): boolean
+	return type(kind) == "string" and KINDS[kind] == true
+end
+
+-- The failure a rerun is a repeat of: the codes and the top layer's tip. A worker that changes either has made progress
+-- (a layer built, a trace redone), so its next failure is a new one and the count starts again.
+function landcheck.signature(ps: { Problem }, topTip: string): string
+	local codes: { string } = {}
+	for _, p in ps do
+		table.insert(codes, p.code)
+	end
+	table.sort(codes)
+	return `{table.concat(codes, ",")}@{topTip}`
+end
+
+-- The repeats counted against `cap`: `spent` when the failure is the one the last rerun was for, else none.
+function landcheck.repeats(prevSignature: string?, spent: number, signature: string): number
+	return if prevSignature == signature then spent else 0
+end
+
+-- One line per problem, for a refusal or a stop.
+function landcheck.lines(ps: { Problem }): { string }
+	local out: { string } = {}
+	for _, p in ps do
+		table.insert(out, `{p.code} ({p.kind}): {p.text}`)
+	end
+	return out
+end
+
+-- The option a filed note recommends. Only a person's own ruling is `approve`; every other note recommends `retry`:
+-- `amend-design` takes the Layer out of the raft and back to draft, the most expensive answer, and the dispatcher never
+-- recommends it, and `abort` is the person's alone.
+landcheck.RECOMMEND = { ["open-high"] = "approve", ["approval-drift"] = "approve" } :: { [string]: string }
+function landcheck.recommended(ps: { Problem }): string
+	for _, p in ps do
+		local r = landcheck.RECOMMEND[p.code]
+		if r then
+			return r
+		end
+	end
+	return "retry"
+end
+
+-- The escalation.md body the dispatcher files when a landing is blocked: the four sections escalation.parse requires
+-- and exactly one recommended option.
+function landcheck.escalation(ps: { Problem }, raft: string, layer: string?, tries: number): string
+	local lines: { string } = {}
+	local capped = false
+	for _, p in ps do
+		table.insert(lines, `- {p.code}: {p.text}`)
+		if p.kind == "redo" then
+			capped = true
+		end
+	end
+	local recommend = landcheck.recommended(ps)
+	local function option(decision: string, text: string): string
+		return `- {decision}: {text}{if decision == recommend then " (recommended)" else ""}`
+	end
+	local body = {
+		"## Question",
+		`The dispatcher would not land {raft}{if layer then ` (layer {layer})` else ""}: {if capped
+			then `the same check failed after {tries} repeat(s) of the worker`
+			else "a check can only be decided by a person"}. What should it do?`,
+		"",
+		"## What was tried",
+		`The dispatcher ran landcheck over {raft}'s published layers, their pull request and the tracker state. {if capped
+			then `It ran the worker again {tries} time(s) for that failure and it stayed.`
+			else "It stopped at the first problem that is not a worker's to fix."}`,
+		"",
+		"## Open findings or error",
+		table.concat(lines, "\n"),
+		"",
+		"## Options",
+		option("retry", "run the worker again for another round of fixes"),
+		option("amend-design", "the design has to change to make the check pass"),
+		option("approve", "accept the finding as it stands (a person rules on it)"),
+		option("abort", "stop the raft"),
+		"",
+	}
+	return table.concat(body, "\n")
+end
+
+-- The bind in a first-parent walk of `main` from its tip down to the guard's mark: `chain` lists the commits newest
+-- first with their parents ({ sha, p1, p2? }). Exactly one commit whose second parent is `topTip` is the bind; nothing
+-- else counts. Returns its index in `chain` and nil, or nil and why.
+function landcheck.findBind(chain: { { string } }, topTip: string): (number?, string?)
+	local found: number? = nil
+	for idx, c in chain do
+		if c[3] ~= nil and c[3] == topTip and topTip ~= "" then
+			if found then
+				return nil, "two merges of the layer tip are on main since the mark"
+			end
+			found = idx
+		end
+	end
+	if not found then
+		return nil, `no merge of {topTip} is on main's first-parent line since the guard's mark`
+	end
+	return found, nil
+end
+
+-- The land request a worker that holds the agent's credential leaves instead of pushing `main` (F4, Q2 and Q5): `done`
+-- runs every check, then writes `<main checkout>/.cache/land-requests/<R-id>` and stops. A lander (the dispatcher's chain,
+-- or a person's `./zn lander`) lands it through the base's engine with its own credential. One `key: value` line each.
+landcheck.LAND_REQUESTS = ".cache/land-requests"
+export type LandRequest = { item: string, tip: string, through: string?, worktree: string }
+function landcheck.landRequestText(item: string, tip: string, through: string?, worktree: string): string
+	return `item: {item}\ntip: {tip}\nthrough: {through or ""}\nworktree: {worktree}\n`
+end
+function landcheck.parseLandRequest(text: string): LandRequest?
+	local item = string.match(text, "^item: (R%d%d%d%d)\n")
+	local tip = string.match(text, "\ntip: (%x+)\n")
+	local through = string.match(text, "\nthrough: ([^\n]*)\n")
+	local worktree = string.match(text, "\nworktree: ([^\n]+)\n")
+	if not item or not tip or #tip < 7 or not worktree or through == nil then
+		return nil
+	end
+	return { item = item, tip = tip, through = if through ~= "" then through else nil, worktree = worktree }
+end
+-- Whether the request is still about the layer tip as it is now: a layer that moved (a push, a restack) makes the
+-- worker's checks, which were of the old tip, void.
+function landcheck.landRequestFresh(req: LandRequest, currentTip: string): boolean
+	return currentTip ~= "" and currentTip == req.tip
+end
+
+-- The block request a dispatched `./zn block` leaves for the dispatcher (G1): one `key: value` line each. `tip` is the
+-- Layer's published tip, from which the dispatcher restores the note and the open findings when it files the block.
+function landcheck.requestText(id: string, reason: string, layer: string?, tip: string?): string
+	return `item: {id}\nreason: {reason}\nlayer: {layer or ""}\ntip: {tip or ""}\n`
+end
+
+export type Request = { item: string, reason: string, layer: string?, tip: string? }
+function landcheck.parseRequest(text: string): Request?
+	local item = string.match(text, "^item: ([^\n]+)\n")
+	local reason = string.match(text, "\nreason: ([^\n]+)\n")
+	local layer = string.match(text, "\nlayer: ([^\n]*)\n")
+	local tip = string.match(text, "\ntip: ([^\n]*)\n")
+	if not item or not reason or not table.find(escalation.REASONS, reason) then
+		return nil
+	end
+	return {
+		item = item,
+		reason = reason,
+		layer = if layer and layer ~= "" then layer else nil,
+		tip = if tip and tip ~= "" then tip else nil,
+	}
+end
+
+return landcheck
