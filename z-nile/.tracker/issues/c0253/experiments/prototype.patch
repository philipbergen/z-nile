+		return nil
+	end
+	local c = provenance.parse(common)
+	local o = provenance.parse(other)
+	if not c or not o then
+		return common
+	end
+	local keep: { Row } = {}
+	for i, r in c do
+		local m = o[i]
+		if not m or m.when ~= r.when or m.event ~= r.event or m.actor ~= r.actor or m.detail ~= r.detail then
+			break
+		end
+		table.insert(keep, r)
+	end
