+		t.expect(#created).toBe(3)
+		t.expect(created[2].event).toBe("unblocked")
+		t.expect(created[3].event).toBe("rafted")
+		-- a union never reverts or drops silently: a side that edited or removed an old row, or does not parse, refuses
+		local edited = (string.gsub(ours, "human:Ann", "human:Eve", 1))
+		local gone = provenance.render("c0010", { (provenance.parse(ours) :: { any })[2] })
+		for _, bad in { edited, gone, "garbage" } do
+			local text, reason = provenance.union(one :: string, bad, theirs)
+			t.expect(text).toBe(nil)
+			t.expect(reason ~= nil).toBe(true)
+			local text2, why2 = provenance.union(one :: string, ours, bad)
+			t.expect(text2).toBe(nil)
+			t.expect(why2 ~= nil).toBe(true)
+		end
+		-- a record is not a document: trail must not count it as the item's life
+		t.expect(trail.isDoc("provenance.md")).toBe(false)
+		t.expect(trail.isDoc("c0010.md")).toBe(true)
+	end)
+
+	it("settle decides what a merge does with one item's record", function()
+		local one = provenance.record(nil, "c0010", "ranked", "human:Ann", "", "2026-11-08 10:00") :: string
+		local ours = provenance.record(one, "c0010", "ranked", "human:Ours", "", "2026-11-08 11:00") :: string
+		local theirs =
+			provenance.record(one, "c0010", "ranked", "human:Main", "", "2026-11-08 12:00") :: string
+		-- neither side changed it; one side changed it (the other side's text, absence included)
+		t.expect((provenance.settle(one, one, one))).toBe("keep")
+		t.expect((provenance.settle(nil, nil, nil))).toBe("keep")
+		local action, text = provenance.settle(one, ours, one)
+		t.expect(action).toBe("write")
+		t.expect(text).toBe(ours)
+		action, text = provenance.settle(one, one, theirs)
+		t.expect(action).toBe("write")
+		t.expect(text).toBe(theirs)
+		t.expect((provenance.settle(nil, ours, nil))).toBe("write") -- a record only we added
+		t.expect((provenance.settle(one, nil, one))).toBe("remove") -- a record only we deleted
+		t.expect((provenance.settle(one, one, nil))).toBe("remove")
+		-- both changed: the union, main's rows first; the same change on both sides is one change
+		action, text = provenance.settle(one, ours, theirs)
+		t.expect(action).toBe("write")
+		t.expect(text).toBe((provenance.union(one, ours, theirs)))
+		local _, same = provenance.settle(one, ours, ours)
+		t.expect(same).toBe(ours)
+		t.expect((provenance.settle(one, nil, nil))).toBe("remove") -- both sides deleted it
+		-- changed on one side and absent on the other: stop, naming remap (an id changed)
+		local stops: { { common: string?, ours: string?, theirs: string? } } = {
+			{ common = one, ours = ours, theirs = nil },
+			{ common = one, ours = nil, theirs = theirs },
+		}
+		for _, args in stops do
+			local a, _, why = provenance.settle(args.common, args.ours, args.theirs)
+			t.expect(a).toBe(nil)
+			t.expect(string.find(why or "", "./zn remap", 1, true) ~= nil).toBe(true)
+		end
+		-- a side that did not only append, and a record that does not parse, stop too
+		local a2, _, why2 = provenance.settle(one, (string.gsub(ours, "human:Ann", "human:Eve", 1)), theirs)
+		t.expect(a2).toBe(nil)
+		t.expect(why2 ~= nil).toBe(true)
+		local a3, _, why3 = provenance.settle(one, "garbage\n", one)
+		t.expect(a3).toBe(nil)
+		t.expect(why3 ~= nil).toBe(true)
+	end)
+
+	it(
+		"a merge across a compaction is refused when the sides number items differently and a record changed",
+		function()
+			local stop = provenance.compactionProblem
+			-- theirs compacted (their map differs from the base's): a record changed on our side stops, none changed does not
+			t.expect(stop(nil, nil, "c0042 c0041\n", true, false) ~= nil).toBe(true) -- a stale branch's record
+			t.expect(stop(nil, nil, "c0042 c0041\n", true, true) ~= nil).toBe(true)
+			t.expect(stop(nil, nil, "c0042 c0041\n", false, true)).toBe(nil) -- ours changed none
+			t.expect(stop("a\n", nil, "b\n", false, false)).toBe(nil)
+			-- ours compacted: a record changed on their side stops, none changed does not
+			t.expect(stop(nil, "c0042 c0041\n", nil, false, true) ~= nil).toBe(true) -- the compaction's own branch
+			t.expect(stop(nil, "c0042 c0041\n", nil, true, false)).toBe(nil)
+			-- both compacted, possibly differently: any changed record stops
+			t.expect(stop("a\n", "b\n", "c\n", true, false) ~= nil).toBe(true)
+			t.expect(stop("a\n", "b\n", "c\n", false, true) ~= nil).toBe(true)
+			t.expect(stop("a\n", "b\n", "c\n", false, false)).toBe(nil)
+			-- one numbering on both sides: nothing to stop
+			t.expect(stop("same\n", "same\n", "same\n", true, true)).toBe(nil)
+			t.expect(stop(nil, nil, nil, true, true)).toBe(nil)
+			local why = stop(nil, nil, "x\n", true, true) :: string
+			t.expect(string.find(why, "./zn remap", 1, true) ~= nil).toBe(true)
+		end
+	)
+
+	it("locate finds an item's record by its id in a listing of one commit", function()
+		local listing = {
+			"pickman/.tracker/issues/c0019/c0019.md",
+			"pickman/.tracker/issues/c0019/provenance.md",
+			"pickman/.tracker/issues/c0190/provenance.md",
+			"pickman/.tracker/issues/active/c0020/provenance.md",
+		}
+		t.expect((provenance.locate(listing, "c0019"))).toBe("pickman/.tracker/issues/c0019/provenance.md")
+		t.expect((provenance.locate(listing, "c0020")))
+			.toBe("pickman/.tracker/issues/active/c0020/provenance.md")
+		t.expect((provenance.locate(listing, "c0021"))).toBe(nil)
+		t.expect((provenance.locate({ "c0019/provenance.md" }, "c0019"))).toBe("c0019/provenance.md")
+		-- the same id in two places is not decided here
+		local both = {
+			"pickman/.tracker/issues/c0019/provenance.md",
+			"pickman/.tracker/issues/active/c0019/provenance.md",
+		}
+		local path, why = provenance.locate(both, "c0019")
+		t.expect(path).toBe(nil)
+		t.expect(why ~= nil).toBe(true)
+	end)
+
+	it("audit", function()
+		local good = provenance.record(
+			nil,
+			"c0010",
+			"approved",
+			"human:Ann",
+			"design=aaaaaaaaaaaa",
+			"2026-11-08 10:00"
+		) :: string
+		t.expect(provenance.problems("z-nile/.tracker/issues/c0010/provenance.md", good)).toEqual({})
+		t.expect(#provenance.problems("z-nile/.tracker/issues/c0010/provenance.md", "garbage")).toBe(1)
+		-- an empty file is not a record (refused, not read as no rows)
+		t.expect((provenance.parse(""))).toBe(nil)
+		t.expect(#provenance.problems("z-nile/.tracker/issues/c0010/provenance.md", "")).toBe(1)
+		-- a raft may have one (c0250 blocks whole rafts); a header that names another id may not
+		local raft = provenance.record(
+			nil,
+			"R0010",
+			"unblocked",
+			"human:Ann",
+			"block=needs-decision",
+			"2026-11-08 10:00"
+		) :: string
+		t.expect(provenance.problems("z-nile/.tracker/rafts/R0010/provenance.md", raft)).toEqual({})
+		t.expect(#provenance.problems("z-nile/.tracker/issues/c0011/provenance.md", good)).toBe(1)
+	end)
+
+	it("docs", function()
+		local top = (string.gsub(process.exec("git", { "rev-parse", "--show-toplevel" }).stdout, "%s+$", ""))
+		local function has(path: string, ...: string)
+			local text = fs.readFile(`{top}/{path}`)
+			for _, needle in { ... } do
+				if not string.find(text, needle, 1, true) then
+					error(`{path} lacks {needle}`, 2)
+				end
+			end
+		end
+		has(
+			"z-nile/skills/zz-rules/SKILL.md",
+			"provenance.md",
+			"./zn provenance record",
+			"ZN_ACTOR",
+			"--actor",
+			"CLAUDECODE",
+			"AI_AGENT",
+			"ZN_DISPATCH",
+			"CURSOR_AGENT",
+			"GROK_SESSION_ID",
+			"merge by hand",
+			"`remap` settles the records the same way"
+		)
