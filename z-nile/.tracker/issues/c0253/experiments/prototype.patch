new file mode 100644
index 000000000..35d8cc0be
--- /dev/null
+++ b/z-nile/engine/reviewfiles.luau
@@ -0,0 +1,163 @@
+--!strict
+-- c0306: the edge of reviewmodel: reads the review files of an item folder and judges or stamps them.
+
+local fs = require("@lune/fs")
+local process = require("@lune/process")
+local reviewmodel = require("./reviewmodel")
+local sh = require("../lib/sh")
+local store = require("./store")
+
+local reviewfiles = {}
+
+-- The review files (design-review, review, final-review) of a folder, name -> text. A folder that is missing is empty.
+function reviewfiles.read(dir: string): { [string]: string }
+	local out: { [string]: string } = {}
+	if not fs.isDir(dir) then
+		return out
+	end
+	for _, name in fs.readDir(dir) do
+		if
+			(
+				string.match(name, "^design%-review%-%d+%.md$")
+				or string.match(name, "^review%-%d+%.md$")
+				or string.match(name, "^final%-review%-%d+%.md$")
+			) and fs.isFile(`{dir}/{name}`)
+		then
+			out[name] = fs.readFile(`{dir}/{name}`)
+		end
+	end
+	return out
+end
+
+-- The refusal for the first review of `kind` in `dir` off the review models, or nil.
+function reviewfiles.judge(dir: string, kind: string, owner: string): string?
+	return reviewmodel.problem(reviewfiles.read(dir), kind, owner)
+end
+
+-- What `./zn done` judges of a marked raft: its own folder, then each member's, for code and final reviews.
+function reviewfiles.judgeDone(dirs: { { id: string, dir: string } }): string?
+	for _, d in dirs do
+		local why = reviewfiles.judge(d.dir, "code", d.id)
+		if why then
+			return why
+		end
+	end
+	return nil
+end
+
+-- c0251: the models of the previous round across `folders` (each `{ kind, dir }`, kind design, coherence or code),
+-- up to the rank `upto`: the files are read with `read`, the ranking is reviewmodel.priorsOf.
+function reviewfiles.priors(folders: { { kind: string, dir: string } }, upto: number): { string }
+	local read: { { kind: string, files: { [string]: string } } } = {}
+	for _, f in folders do
+		-- stamped rounds count in any item, marked or not: c0306 stamps every review it files
+		table.insert(read, { kind = f.kind, files = reviewfiles.read(f.dir) })
+	end
+	return reviewmodel.priorsOf(read, upto)
+end
+
+-- Stamps the review file at `path` with the model and effort (and the fallback reason, c0251), or returns the refusal.
+function reviewfiles.stampFile(path: string, model: string, effort: string?, fallback: string?): string?
+	if not fs.isFile(path) then
+		return `{path} does not exist`
+	end
+	local stamped, why = reviewmodel.stamp(fs.readFile(path), model, effort, fallback)
+	if not stamped then
+		return `{path} {why}`
+	end
+	fs.writeFile(path, stamped)
+	return nil
+end
+
+-- Whether the item whose folder this is is marked `reviews: judged`: the folder's own document,
+-- `<folder>/<folder name>.md`. A folder with no document there is not marked.
+function reviewfiles.markedFolder(dir: string): boolean
+	local trimmed = string.gsub(dir, "/+$", "")
+	local name = string.match(trimmed, "([^/]+)$")
+	local doc = if name then `{trimmed}/{name}.md` else ""
+	if doc == "" or not fs.isFile(doc) then
+		return false
+	end
+	return reviewmodel.judged(store.readFront(doc))
+end
+
+-- What `./zn commit` does with the review files the commit carries (untracked, added or modified; not deleted) that
+-- have no `Model:` line. Returns a refusal, or nil after stamping them (with --phase code-review and --model).
+-- A review of a marked item is refused without --model under --phase code-review, and under any other phase at all;
+-- an unmarked item's is left as it is without --model, and stamped with it.
+function reviewfiles.commitReviews(
+	phase: string,
+	model: string?,
+	effort: string?,
+	typedEffort: string?,
+	fallbackFor: ((path: string) -> string?)?
+): string?
+	local status = sh.run("git", { "status", "--porcelain", "--untracked-files=all" })
+	if not status.ok then
+		return "cannot read git status"
+	end
+	local unstamped: { { path: string, marked: boolean } } = {}
+	for line in string.gmatch(status.stdout .. "\n", "([^\n]*)\n") do
+		local xy, rest = string.match(line, "^(..) (.+)$")
+		if xy and rest and not string.find(xy, "D", 1, true) then
+			local path = string.match(rest, " %-> (.+)$") or rest
+			local base = string.match(path, "([^/]+)$")
+			if
+				base
+				and (string.match(base, "^review%-%d+%.md$") or string.match(base, "^final%-review%-%d+%.md$") or string.match(
+					base,
+					"^design%-review%-%d+%.md$"
+				))
+				and fs.isFile(path)
+				and reviewmodel.read(fs.readFile(path)) == nil
+			then
+				table.insert(unstamped, {
+					path = path,
+					marked = #path > #base
+						and reviewfiles.markedFolder(string.sub(path, 1, #path - #base - 1)),
+				})
+			end
+		end
+	end
+	for _, u in unstamped do
+		if u.marked and phase ~= "code-review" then
+			return `{u.path} is a review: commit it with --phase code-review --model <the reviewer's model id>`
+		elseif u.marked and not model then
+			return `{u.path} is a review: --model <the reviewer's model id> records it`
+		elseif u.marked and model and string.sub(model, 1, 5) == "grok-" and not typedEffort then
+			return `{u.path} is a review: a grok- review is judged by its effort: --effort <level>`
+		end
+	end
+	if phase == "code-review" and model then
+		for _, u in unstamped do
+			local why =
+				reviewfiles.stampFile(u.path, model, effort, if fallbackFor then fallbackFor(u.path) else nil)
+			if why then
+				return why
+			end
+		end
+	end
+	return nil
+end
+
+-- `--effort <level>`, else CLAUDE_EFFORT when set and not empty, else nil.
+function reviewfiles.typedEffort(opts: { [string]: { string } }): string?
+	local typed = opts["--effort"] and opts["--effort"][1]
+	return if typed and typed ~= "" then typed else nil
+end
+
+-- The effort to record: `--effort`; else, for a `claude-` id only, CLAUDE_EFFORT (an interactive Claude Code subagent
+-- runs at its session's effort); for any other id it is never taken from the environment (review 001 F5).
+function reviewfiles.effortOption(opts: { [string]: { string } }, model: string?): string?
+	local typed = reviewfiles.typedEffort(opts)
+	if typed then
+		return typed
+	end
+	if model == nil or string.sub(model, 1, 7) ~= "claude-" then
+		return nil
+	end
+	local env = process.env.CLAUDE_EFFORT
+	return if env and env ~= "" then env else nil
+end
+
+return reviewfiles
diff --git a/z-nile/engine/reviewmodel.luau b/z-nile/engine/reviewmodel.luau
new file mode 100644
index 000000000..1ee46e946
--- /dev/null
+++ b/z-nile/engine/reviewmodel.luau
@@ -0,0 +1,350 @@
+--!strict
+-- c0306: which models count as review models, and the record of a review's model (two stamped lines in the review
+-- file). Pure: texts in, texts or a refusal out. The list is code (KINDS), never read from .models.toml, so a role
+-- or fallback change to another id of the same kind refuses nothing.
+
+local reviewmodel = {}
+
+-- A kind is an id prefix, plain (no pattern). `effort` is the one effort that kind needs, when it needs one.
+export type Kind = { prefix: string, effort: string? }
+
+reviewmodel.KINDS = {
+	{ prefix = "claude-opus-" },
+	{ prefix = "claude-fable-" },
+	{ prefix = "kimi-code-k3" },
+	{ prefix = "grok-", effort = "xhigh" },
+} :: { Kind }
+
+-- The front-matter line the tool writes at a claim and at a raft's creation: `reviews: judged`.
+reviewmodel.MARK = "judged"
+
+-- How far down a review file the record lines may sit (c0248's Commit: and Patch: share the rule).
+local HEAD_LINES = 12
+
+local function starts(s: string, prefix: string): boolean
+	return string.sub(s, 1, #prefix) == prefix
+end
+
+-- True when the id is of a review kind, at the effort that kind needs.
+function reviewmodel.ok(model: string, effort: string?): boolean
+	for _, kind in reviewmodel.KINDS do
+		if starts(model, kind.prefix) then
+			return kind.effort == nil or effort == kind.effort
+		end
+	end
+	return false
+end
+
+function reviewmodel.describe(): string
+	local parts: { string } = {}
+	for _, kind in reviewmodel.KINDS do
+		local part = `{kind.prefix}*`
+		if kind.effort then
+			part ..= ` at effort {kind.effort}`
+		end
+		table.insert(parts, part)
+	end
+	return table.concat(parts, ", ")
+end
+
+-- The recorded model and effort: the first `Model:` and `Effort:` lines within the first 12 lines. A `Model:` line
+-- with no id reads as "" (a record that fails), a missing line as nil.
+function reviewmodel.read(text: string): (string?, string?)
+	local model: string? = nil
+	local effort: string? = nil
+	local n = 0
+	for line in string.gmatch(text .. "\n", "([^\n]*)\n") do
+		n += 1
+		if n > HEAD_LINES then
+			break
+		end
+		local m = string.match(line, "^Model:%s*(.-)%s*$")
+		if m and model == nil then
+			model = m
+		end
+		local e = string.match(line, "^Effort:%s*(.-)%s*$")
+		if e and effort == nil then
+			effort = e
+		end
+	end
+	return model, effort
+end
+
+-- c0251: the longest reason a `Fallback:` line carries.
+reviewmodel.FALLBACK_MAX = 120
+
+-- The recorded fallback reason: the first `Fallback:` line within the first 12 lines (the same window as `read`), or nil
+-- when there is none or its reason is empty. The one reader of the line (the dispatcher's supersede rule and the board).
+function reviewmodel.fallbackOf(text: string): string?
+	local n = 0
+	for line in string.gmatch(text .. "\n", "([^\n]*)\n") do
+		n += 1
+		if n > HEAD_LINES then
+			break
+		end
+		local f = string.match(line, "^Fallback:%s*(.-)%s*$")
+		if f then
+			return if f == "" then nil else f
+		end
+	end
+	return nil
+end
+
+-- The text with `Model:` (and `Effort:`, then `Fallback:` when given) prepended, or nil and the refusal when it already
+-- records a model or the reason is not one short line.
+function reviewmodel.stamp(
+	text: string,
+	model: string,
+	effort: string?,
+	fallback: string?
+): (string?, string?)
+	local had = reviewmodel.read(text)
+	if had ~= nil then
+		return nil, `already records {had}: a review is recorded once; run a new round`
+	end
+	if
+		fallback ~= nil
+		and (string.find(fallback, "\n", 1, true) or #fallback > reviewmodel.FALLBACK_MAX or fallback == "")
+	then
+		return nil,
+			`has a fallback reason that is not one line of at most {reviewmodel.FALLBACK_MAX} characters`
+	end
+	local head = `Model: {model}\n`
+	if effort and effort ~= "" then
+		head ..= `Effort: {effort}\n`
+	end
+	if fallback then
+		head ..= `Fallback: {fallback}\n`
+	end
+	return head .. text, nil
+end
+
+-- True when the front matter carries the mark.
+function reviewmodel.judged(front: { [string]: string }): boolean
+	return front.reviews == reviewmodel.MARK
+end
+
+local function number(name: string, pattern: string): number?
+	local n = string.match(name, pattern)
+	return if n then tonumber(n) else nil
+end
+
+-- The names (of a folder) the kind judges, by round then name: design and coherence reviews are
+-- `design-review-NNN.md`, a code review `review-NNN.md` and `final-review-NNN.md`. Never a stream review, refute or harvest.
+function reviewmodel.files(names: { string }, kind: string): { string }
+	local out: { string } = {}
+	for _, name in names do
+		local hit = if kind == "code"
+			then number(name, "^review%-(%d+)%.md$") or number(name, "^final%-review%-(%d+)%.md$")
+			else number(name, "^design%-review%-(%d+)%.md$")
+		if hit then
+			table.insert(out, name)
+		end
+	end
+	table.sort(out, function(a: string, b: string): boolean
+		local na = number(a, "(%d+)%.md$") or 0
+		local nb = number(b, "(%d+)%.md$") or 0
+		if na ~= nb then
+			return na < nb
+		end
+		return a < b
+	end)
+	return out
+end
+
+-- The newest round of each kind the command judges, per folder (F2: a later round supersedes an earlier one):
+-- the newest `design-review-NNN.md`; for the code kind the newest `review-NNN.md` and the newest `final-review-NNN.md`,
+-- apart. `names` are the folder's files; the result is in file order (review before final).
+function reviewmodel.newest(names: { string }, kind: string): { string }
+	-- c0251: an idea challenge is `idea-review-NNN.md`; a stream review is `stream-review-<id>-NNN.md`, one line of rounds per layer
+	if kind == "idea" or kind == "stream" then
+		local best: { [string]: number } = {}
+		local bestName: { [string]: string } = {}
+		for _, name in names do
+			local id: string?, n: number?
+			if kind == "idea" then
+				id, n = "", number(name, "^idea%-review%-(%d+)%.md$")
+			else
+				local layer, round = string.match(name, "^stream%-review%-(.+)%-(%d+)%.md$")
+				id, n = layer, tonumber(round)
+			end
+			if id and n and n > (best[id] or -1) then
+				best[id], bestName[id] = n, name
+			end
+		end
+		local ids: { string } = {}
+		for id in bestName do
+			table.insert(ids, id)
+		end
+		table.sort(ids)
+		local out: { string } = {}
+		for _, id in ids do
+			table.insert(out, bestName[id])
+		end
+		return out
+	end
+	local groups: { { string } } = if kind == "code"
+		then { { "^review%-(%d+)%.md$" }, { "^final%-review%-(%d+)%.md$" } }
+		else { { "^design%-review%-(%d+)%.md$" } }
+	local out: { string } = {}
+	for _, g in groups do
+		local best, bestName = -1, nil
+		for _, name in names do
+			local n = number(name, g[1])
+			if n and n > best then
+				best, bestName = n, name
+			end
+		end
+		if bestName then
+			table.insert(out, bestName)
+		end
+	end
+	return out
+end
+
+-- True when a review's text is one the judge refuses: no `Model:` line, an empty one, or a model that is not a review model.
+function reviewmodel.refused(text: string): boolean
+	local model, effort = reviewmodel.read(text)
+	return model == nil or not reviewmodel.ok(model, effort)
+end
+
+-- The mode `./zn dispatch zz-review` takes for a review file: from its kind and its name.
+local function modeOf(kind: string, name: string): string
+	if kind == "code" then
+		return if string.sub(name, 1, 6) == "final-" then "final" else "code"
+	end
+	return if kind == "coherence" then "raft" else "design"
+end
+
+-- The refusal for the first file of `kind` in `files` (name -> text) that is not on a review model, or nil. The ways
+-- out are the ones that work from where the file is: always a new round on a review model; for a design or coherence
+-- review that records no `Model:` line also the spend that records it (an off-model record is recorded once, so it has
+-- only the new round); a coherence review or a member's design review (`onOrigin`) is on origin/main, so its way out is
+-- made in a worktree and lands by pull request; a code or final review is committed, so its new round is committed with
+-- `./zn commit --phase code-review`.
+function reviewmodel.problem(
+	files: { [string]: string },
+	kind: string,
+	owner: string,
+	onOrigin: boolean?
+): string?
+	local names: { string } = {}
+	for name in files do
+		table.insert(names, name)
+	end
+	for _, name in reviewmodel.newest(names, kind) do
+		local model, effort = reviewmodel.read(files[name])
+		local recorded = ""
+		if model == nil then
+			recorded = "no `Model:` line"
+		elseif reviewmodel.ok(model, effort) then
+			continue
+		else
+			recorded = `{model} at effort {effort or "none"}`
+			if model == "" then
+				recorded = "an empty `Model:` line"
+			end
+		end
+		local stem = (string.gsub(name, "%.md$", ""))
+		local again = `run the round again on a review model (./zn dispatch zz-review {owner} --mode {modeOf(
+			kind,
+			name
+		)}, or a fresh subagent on that role's model)`
+		local ways: string
+		if kind == "code" then
+			ways =
+				`{again} and commit it with ./zn commit -m "{owner}: review-NNN" --phase code-review --model <id> --effort <level>`
+		elseif onOrigin and kind ~= "coherence" then
+			-- a grouped member's design review is on origin/main, and a new round changes the member's design record, which
+			-- ready then refuses as changed since grouped: the member leaves its raft, is redone in its prep, and is folded back
+			ways =
+				`take {owner} out of its raft (./zn unfold <R-id> {owner}, in a rafting worktree), run the round again on a review model in its prep (z-design: ./zn dispatch zz-review {owner} --mode {modeOf(
+					kind,
+					name
+				)}, or a fresh subagent on that role's model) and record it with ./zn spend {owner} --phase design-review --note design-review-NNN --model <id> --effort <level>, land that, then fold it back with ./zn fold <R-id> {owner}, which makes a new record (a raft of several issues then needs a new coherence review)`
+		else
+			ways = again
+			if model == nil then
+				ways ..= `, or if it did run on one, record it: ./zn spend {owner} --phase design-review --note {stem} --model <id> --effort <level>, then commit the file`
+			end
+			if kind == "coherence" or onOrigin then
+				ways ..= " (this review is on origin/main: either way out is made in a worktree and lands by pull request)"
+			end
+		end
+		return `{owner}: {name} records {recorded}, which is not a review model (review models: {reviewmodel.describe()}). To go on, {ways}`
+	end
+	return nil
+end
+
+-- c0251: a kind's place in the lifecycle (idea, then design, coherence, code, final). A previous reviewer is one of the
+-- highest rank up to the kind being written.
+reviewmodel.RANK = { design = 1, coherence = 2, code = 3, final = 4 } :: { [string]: number }
+
+-- The rank and round of a review file in a folder of `kind` (design: an issue's; coherence: a raft's own; code: a member's
+-- or a raft's code and final reviews), or nil for any other name.
+local function rankOf(kind: string, name: string): (number?, number?)
+	if kind == "code" then
+		local c = number(name, "^review%-(%d+)%.md$")
+		if c then
+			return reviewmodel.RANK.code, c
+		end
+		local f = number(name, "^final%-review%-(%d+)%.md$")
+		if f then
+			return reviewmodel.RANK.final, f
+		end
+		return nil, nil
+	end
+	local d = number(name, "^design%-review%-(%d+)%.md$")
+	if d then
+		return reviewmodel.RANK[kind], d
+	end
+	return nil, nil
+end
+
+-- The models of the previous round. `folders` is each folder's kind and its review files (name -> text); `upto` the rank
+-- of the kind being written. Files that record no model are skipped; a refused or flagged round counts. The top rank is
+-- the highest rank up to `upto` that any folder holds. In each folder (an entry of `folders`) the newest round at that
+-- rank is a previous reviewer: round numbers are never compared between folders (c0248 numbers each layer's reviews from
+-- 001). Bare ids, each once, in folder order.
+function reviewmodel.priorsOf(
+	folders: { { kind: string, files: { [string]: string } } },
+	upto: number
+): { string }
+	type Hit = { folder: number, rank: number, round: number, model: string }
+	local hits: { Hit } = {}
+	local top = 0
+	for i, folder in folders do
+		for name, text in folder.files do
+			local rank, round = rankOf(folder.kind, name)
+			if rank ~= nil and round ~= nil and rank <= upto then
+				local model = reviewmodel.read(text)
+				if model ~= nil and model ~= "" then
+					table.insert(hits, {
+						folder = i,
+						rank = rank,
+						round = round,
+						model = (string.gsub(model, "%[[^%[%]]*%]$", "")),
+					})
+					top = math.max(top, rank)
+				end
+			end
+		end
+	end
+	local newest: { [number]: Hit } = {}
+	for _, hit in hits do
+		local had = newest[hit.folder]
+		if hit.rank == top and (had == nil or hit.round > had.round) then
+			newest[hit.folder] = hit
+		end
+	end
+	local out: { string } = {}
+	for i = 1, #folders do
+		local hit = newest[i]
+		if hit and not table.find(out, hit.model) then
+			table.insert(out, hit.model)
+		end
+	end
+	return out
+end
+
+return reviewmodel
diff --git a/z-nile/engine/reviewpool.luau b/z-nile/engine/reviewpool.luau
new file mode 100644
index 000000000..196014cef
--- /dev/null
+++ b/z-nile/engine/reviewpool.luau
@@ -0,0 +1,130 @@
+--!strict
+-- c0251: which model line reviews, away from the one that wrote the text. Pure: a role's tries, the family table, the
+-- text's writers and the previous round's reviewers in, the tries in the order to run them out. Whether a CLI is
+-- installed or out of quota stays the dispatcher's loop.
+--
+-- Three tiers over the tries (a stable partition, the role's order inside each):
+--   1  the model line differs from every writer and from the previous round's reviewers
+--   2  it differs from the writers only (the previous round's line, or a line the table does not name)
+--   3  it is the writers' line: the flagged fallback, the writer's exact model last
+-- A review never blocks: a tier 3 try is kept, last. An unknown family is never "different": it is tier 2 when a writer's
+-- line is known, tier 1 when no writer's line is (there is nothing to differ from, and no flag).
+local family = require("./family")
+local models = require("./models")
+
+local reviewpool = {}
+
+export type Tier = number -- 1, 2 or 3
+export type Pick = { spec: models.Spec, tier: Tier, exact: boolean, family: string? }
+export type Plan = {
+	picks: { Pick },
+	authors: { string }, -- bare model ids of the writers
+	authorFamilies: { string },
+	priors: { string }, -- bare model ids of the previous round's reviewers
+	priorFamilies: { string },
+	provenance: string, -- authorship.Provenance, or "none" when the role does not rotate
+	via: string, -- where the writers came from (authorship.Authorship.via)
+	families: family.Families,
+	rotate: boolean,
+	walk: string?, -- "main" (the pinned walk) or "checkout" (the working tree's .models.toml files)
+}
+
+local function bare(id: string): string
+	return (string.gsub(id, "%[[^%[%]]*%]$", ""))
+end
+
+local function familiesOf(ids: { string }, f: family.Families): { string }
+	local out: { string } = {}
+	for _, id in ids do
+		local fam = family.of(id, f)
+		if fam ~= nil and not table.find(out, fam) then
+			table.insert(out, fam)
+		end
+	end
+	return out
+end
+
+-- The tries in tier order, each with its tier. `authors` and `priors` are model ids (a context marker is ignored).
+function reviewpool.order(
+	tries: { models.Spec },
+	families: family.Families,
+	authors: { string },
+	priors: { string }
+): { Pick }
+	local authorIds: { string } = {}
+	for _, a in authors do
+		table.insert(authorIds, bare(a))
+	end
+	local authorFams = familiesOf(authors, families)
+	local priorFams = familiesOf(priors, families)
+	local groups: { { Pick } } = { {}, {}, {}, {} } -- tier 1, tier 2, tier 3 (not exact), tier 3 exact
+	for _, spec in tries do
+		local fam = family.of(spec.model, families)
+		local exact = table.find(authorIds, bare(spec.model)) ~= nil
+		local tier: Tier = 1
+		if exact or (fam ~= nil and table.find(authorFams, fam) ~= nil) then
+			tier = 3
+		elseif (#authorFams > 0 and fam == nil) or (fam ~= nil and table.find(priorFams, fam) ~= nil) then
+			tier = 2
+		else
+			tier = 1
+		end
+		local group = if tier == 3 and exact then 4 else tier
+		table.insert(groups[group], { spec = spec, tier = tier, exact = exact, family = fam })
+	end
+	local out: { Pick } = {}
+	for _, group in groups do
+		for _, pick in group do
+			table.insert(out, pick)
+		end
+	end
+	return out
+end
+
+local function cut(text: string): string
+	return if #text > 120 then string.sub(text, 1, 117) .. "..." else text
+end
+
+-- Why a tier 3 pick is a fallback, in one short line for the `Fallback:` stamp; nil for any other tier. `provenance` and
+-- `via` say how sure the tool is of the writer: when it only assumed or did not know, the reason says so.
+function reviewpool.fallbackReason(p: Pick, provenance: string, via: string): string?
+	if p.tier ~= 3 then
+		return nil
+	end
+	local model = bare(p.spec.model)
+	local what = if p.exact
+		then `the model that wrote the text ran the review ({model})`
+		else `the writer's model line ({p.family or "?"}) ran the review ({model})`
+	if provenance == "assumed" or provenance == "unknown" then
+		what ..= `; author {provenance} via {via}`
+	end
+	return cut(what)
+end
+
+-- Whether an interactive review on `ran` (the model id the lead typed) is a fallback: it is the writers' line, or the
+-- pool's first pick was not a Claude model and a different one ran (the lead stayed on a Claude subagent). nil when not.
+function reviewpool.interactiveReason(plan: Plan, ran: string): string?
+	local model = bare(ran)
+	local fam = family.of(model, plan.families)
+	local walked = if plan.walk == "checkout" then "; plan from the checkout's .models.toml" else ""
+	local exact = table.find(plan.authors, model) ~= nil
+	if exact or (fam ~= nil and table.find(plan.authorFamilies, fam) ~= nil) then
+		local what = if exact
+			then `the model that wrote the text ran the review ({model})`
+			else `the writer's model line ({fam or "?"}) ran the review ({model})`
+		if plan.provenance == "assumed" or plan.provenance == "unknown" then
+			what ..= `; author {plan.provenance} via {plan.via}`
+		end
+		return cut(what .. walked)
+	end
+	local first = plan.picks[1]
+	if first ~= nil then
+		local pick = bare(first.spec.model)
+		if string.sub(pick, 1, 7) ~= "claude-" and pick ~= model then
+			return cut(`the pool picked {pick}; {model} ran the review instead{walked}`)
+		end
+	end
+	return nil
+end
+
+return reviewpool
