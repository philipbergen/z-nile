+-- c0252: `./zn lander [<R-id>]` lands the land requests that workers holding the agent's credential left
+-- (`.cache/land-requests/<R-id>`), with this session's own credential and the base's engine against the worker's worktree
+-- (`./zn -C`), exactly as the dispatcher's chain lands: the request's tip must still be the layer's published tip, every
+-- check passes, a game is gated by `land-gate`, then `done`. Refused in a session that holds the agent's credential.
+cmd.lander = function(pos: { string }, opts: { [string]: { string } })
+	local landcheck = require("./landcheck")
+	local serde = require("@lune/serde")
+	for k in opts do
+		fail(`usage: lander [<R-id>] (unknown option {k})`)
+	end
+	if (process.env.ZN_DISPATCH or "") ~= "" or (process.env.ZN_HEADLESS or "") ~= "" then
+		fail(
+			"lander is refused in a session that holds the agent's credential (ZN_DISPATCH or ZN_HEADLESS is set)"
+		)
+	end
+	local root = mainRoot()
+	local dir = `{root}/{landcheck.LAND_REQUESTS}`
+	local names: { string } = {}
+	if pos[1] then
+		table.insert(names, pos[1])
+	elseif fs.isDir(dir) then
+		names = fs.readDir(dir)
+		table.sort(names)
+	end
+	if #names == 0 then
+		print("no land request waits")
+		return
+	end
+	local zn = `{root}/zn`
+	local function run(
+		wt: string,
+		args: { string }
+	): { ok: boolean, code: number, stdout: string, stderr: string }
+		local argv: { string } = { "-C", wt }
+		for _, a in args do
+			table.insert(argv, a)
+		end
+		return process.exec(zn, argv, { cwd = root })
+	end
+	local failed = false
+	for _, name in names do
+		local path = `{dir}/{name}`
+		local req = if fs.isFile(path) then landcheck.parseLandRequest(fs.readFile(path)) else nil
+		if not req or req.item ~= name then
+			stdio.ewrite(`lander: {path} is not a land request: left as it is\n`)
+			failed = true
+			continue
+		end
+		if not fs.isDir(req.worktree) then
+			stdio.ewrite(`lander: {req.item}: the worktree {req.worktree} is gone: the request is void\n`)
+			pcall(fs.removeFile, path)
+			failed = true
+			continue
+		end
+		local args = { "land-check", req.item }
+		if req.through then
+			table.insert(args, "--through")
+			table.insert(args, req.through)
+		end
+		table.insert(args, "--json")
+		local checked = run(req.worktree, args)
+		local okj, j = pcall(function()
+			return serde.decode("json", checked.stdout)
+		end)
+		local current = if okj
+				and type(j) == "table"
+				and type((j :: any).tip) == "string"
+			then (j :: any).tip
+			else ""
+		if not landcheck.landRequestFresh(req, current) then
+			stdio.ewrite(
+				`lander: {req.item}: its top layer moved since the request ({req.tip} to {if current
+						== ""
+					then "unreadable"
+					else current}): the worker's checks were of the old tip; the request is void, and the worker asks again with ./zn done\n`
+			)
+			pcall(fs.removeFile, path)
+			failed = true
+			continue
+		end
+		local lines: { string } = {}
+		for _, p in (j :: any).problems do
+			if p.code ~= "self-gating" and p.code ~= "cicd-missing" then
+				table.insert(lines, `{p.code} ({p.kind}): {p.text}`)
+			end
+		end
+		if #lines > 0 then
+			stdio.ewrite(`lander: {req.item} is not ready to land:\n{table.concat(lines, "\n")}\n`)
+			failed = true
+			continue
+		end
+		local gate = run(
+			req.worktree,
+			if req.through
+				then { "land-gate", req.item, "--through", req.through }
+				else { "land-gate", req.item }
+		)
+		if not gate.ok then
+			stdio.ewrite(
+				`lander: {req.item}: the clean-clone gate {if gate.code == 4
+					then "could not run"
+					else "is red"}: {gate.stdout}{gate.stderr}\n`
+			)
+			failed = true
+			continue
+		end
+		local switched = sh.run("git", { "-C", req.worktree, "switch", "--quiet", "--detach", req.tip })
+		if not switched.ok then
+			stdio.ewrite(`lander: {req.item}: could not check out {req.tip}: {sh.trim(switched.stderr)}\n`)
+			failed = true
+			continue
+		end
+		local landed = run(
+			req.worktree,
+			if req.through then { "done", req.item, "--through", req.through } else { "done", req.item }
+		)
+		print(landed.stdout)
+		if not landed.ok then
+			stdio.ewrite(landed.stderr)
+			failed = true
+			continue
+		end
+		pcall(fs.removeFile, path)
+		print(`lander: {req.item} landed`)
+	end
+	if failed then
+		process.exit(1)
+	end
+end
+-- c0252: the gate the dispatcher runs before it lands a stack, read from zz-rules Merging 2 and 3: a stack that changes
+-- a game is gated in a clean clone outside this checkout, on the tree the bind would make (origin/main with the top
+-- layer merged): `z-nile/check.sh --full` there (with PICKMAN_FENCE_REAL_GIT as Merging 2 says), then
+-- `../zn run --time 1800 -- lune run scripts/cicd`. A tooling-only stack needs neither: `done`'s affected gate on the
+-- merged tree is its merge gate. Exit 0 passes, 4 waits (no cicd.toml, a lease held, the publish failed), 1 is red.
+-- The two commands can be replaced, only inside a guarded check run (`checking()`), by ZN_LANDGATE_FULL and
+-- ZN_LANDGATE_CICD: a spec's fakes.
+cmd["land-gate"] = function(pos: { string }, opts: { [string]: { string } })
+	local landcheck = require("./landcheck")
+	for k in opts do
+		if k ~= "--through" then
+			fail(`usage: land-gate <R-id> [--through <issue>] (unknown option {k})`)
+		end
+	end
+	if #pos ~= 1 then
+		fail("usage: land-gate <R-id> [--through <issue>]")
+	end
+	local raft = store.get(pos[1])
+	if raft.kind ~= "raft" or raft.state ~= "active" then
+		fail(`{raft.id} must be an active raft`)
+	end
+	if hasOrigin() then
+		sh.git({ "fetch", "--quiet", "origin" })
+	end
+	local input, _, why =
+		H.landInput(raft, if opts["--through"] then opts["--through"][1] else nil, nil, true)
+	if not input then
+		fail(why or "nothing to land")
+	end
+	if not landcheck.touchesGame(input.codePaths, input.gameRoots) then
+		print(
+			"land-gate: a tooling stack: done's affected gate on the merged tree is its merge gate (zz-rules, Merging 2)"
+		)
+		return
+	end
+	local inCheck = checking()
+	local fullCmd = (if inCheck then process.env.ZN_LANDGATE_FULL else nil)
+		or "./zn run --time 3000 -- z-nile/check.sh --full"
+	local cicdCmd = (if inCheck then process.env.ZN_LANDGATE_CICD else nil)
+		or "./zn run --time 1800 -- lune run scripts/cicd"
+	if not input.cicd and not (inCheck and process.env.ZN_LANDGATE_CICD) then
+		print(
+			"land-gate: the stack changes a game and ~/.config/pickman/cicd.toml is missing: the cicd publish cannot run here"
+		)
+		process.exit(4)
+	end
+	local top = sh.trim(sh.git({ "rev-parse", "--show-toplevel" }))
+	local made = sh.run("mktemp", { "-d" })
+	local dir = sh.trim(made.stdout)
+	if not made.ok or dir == "" or string.sub(dir, 1, #top + 1) == top .. "/" then
+		fail(
+			"land-gate: no temporary directory outside this checkout (TMPDIR is inside it, or mktemp failed)"
+		)
+	end
+	local function done(code: number, text: string)
+		print(text)
+		pcall(fs.removeDir, dir)
+		process.exit(code)
+	end
+	local url = sh.trim(sh.git({ "remote", "get-url", "origin" }))
+	if not sh.run("git", { "clone", "--quiet", "--no-hardlinks", url, dir }).ok then
+		done(4, "land-gate: the clean clone failed")
+	end
+	local tip = input.topTip
+	local checkout = sh.run("git", { "-C", dir, "checkout", "--quiet", "--detach", "origin/main" })
+	local merged = sh.run("git", { "-C", dir, "merge", "--no-ff", "--no-commit", "--quiet", tip })
+	if not checkout.ok or not merged.ok then
+		done(1, `land-gate: {tip} does not merge onto origin/main in the clean clone`)
+	end
+	local common = sh.trim(sh.git({ "rev-parse", "--path-format=absolute", "--git-common-dir" }))
+	local inherited = process.env.PICKMAN_FENCE_REAL_GIT
+	local env: { [string]: string } = {
+		PICKMAN_FENCE_REAL_GIT = if inherited and inherited ~= "" then `{inherited}:{common}` else common,
+	}
+	for k, v in process.env do
+		if type(v) == "string" and env[k] == nil then
+			env[k] = v
+		end
+	end
+	local full = process.exec("bash", { "-c", fullCmd }, { cwd = dir, env = env, stdio = "default" })
+	if not full.ok then
+		done(
+			1,
+			`land-gate: the clean-clone full gate is red on {tip}: {string.sub(
+				full.stdout .. full.stderr,
+				-300
+			)}`
+		)
+	end
+	local cicd = process.exec("bash", { "-c", cicdCmd }, { cwd = dir, env = env, stdio = "default" })
+	if not cicd.ok then
+		local said = string.lower(cicd.stdout .. cicd.stderr)
+		if string.find(said, "lease", 1, true) or string.find(said, "publish", 1, true) then
+			done(4, `land-gate: scripts/cicd could not run on {tip} (a lease is held or the publish failed)`)
+		end
+		done(1, `land-gate: scripts/cicd is red on {tip}: {string.sub(cicd.stdout .. cicd.stderr, -300)}`)
+	end
+	done(0, `land-gate: the clean-clone full gate and scripts/cicd pass on {tip}`)
+end
+
+function cmd.done(pos: { string }, opts: { [string]: { string } })
+	refuseListMode()
+	for k in opts do
+		if k ~= "--through" then
+			fail(`usage: done <R-id> [--through <issue>] (unknown option {k})`)
+		end
+	end
+	local through = if opts["--through"] then opts["--through"][1] else nil
+	if through == "" then
+		fail("usage: done <R-id> [--through <issue>] (--through needs an issue id)")
+	end
+	-- c0252: a session that holds the agent's credential (ZN_DISPATCH is a dispatched step, ZN_HEADLESS a headless worker:
+	-- the markers the dispatcher and c0253's worker set; c0117's agent credential is only in those environments) never
+	-- pushes `main`. It runs every check below, then leaves a land request and stops (outcome 8).
