+		trOk(wm, { "provenance", "record", "c0012", "ranked", "--actor", "human:Main" })
+		write(`{wm}/{ISSUES}/f0020/provenance.md`, rec("f0020", "Base"))
+		git(wm, { "add", "-A" })
