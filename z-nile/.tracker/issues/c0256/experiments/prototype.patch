+local function freeName(dir: string, stem: string, ext: string, numbered: boolean): string
+	if not numbered and not taken(`{dir}/{stem}{ext}`) then
+		return `{dir}/{stem}{ext}`
+	end
+	local n = if numbered then 1 else 2
