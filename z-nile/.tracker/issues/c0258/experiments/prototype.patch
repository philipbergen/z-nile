+	attempt: number, -- 1-based: the push just tried
+	max: number, -- landrace.TRIES in the command
+	pushed: boolean, -- the push (or the broker) said it pushed
+	answered: boolean, -- false when the dispatcher's publish broker gave no answer in its wait (broker.NO_ANSWER)
+	moved: boolean, -- after a failed push: origin/main is no longer the commit's parent
+	contains: boolean, -- after a failed push: origin/main holds the commit land tried to push
+	trackerWhy: string?, -- why gated..now is not tracker state (trackerstate.checkEach), or nil when it is
+	touched: { string }, -- the capture's files that gated..now changes
+}
+
+-- The step after one push. A push that says it failed is landed anyway when origin/main holds its commit; a broker
+-- that gave no answer stops the land at once (ten more waits would take hours; a late push is found by the next
+-- run's start check); a main that did not move is a real push failure; the last try gives up; a main that moved by
+-- more than tracker state, or that changed a file of the capture, runs the gate again before the next push;
+-- otherwise the next push needs no gate. Returns the step and, for "regate", why.
+function landrace.next(f: Facts): (Step, string?)
+	if f.pushed or f.contains then
+		return "landed", nil
+	end
+	if not f.answered then
+		return "no-answer", nil
+	end
+	if not f.moved then
+		return "unmoved", nil
+	end
+	if f.attempt >= f.max then
+		return "give-up", nil
+	end
+	if f.trackerWhy then
+		return "regate", `main moved by more than tracker state: {f.trackerWhy}`
+	end
+	if #f.touched > 0 then
+		return "regate", `main changed this capture's {table.concat(f.touched, ", ")}`
+	end
+	return "again", nil
+end
+
+-- The paths in both lists, sorted, each once.
+function landrace.touched(own: { string }, changed: { string }): { string }
+	local mine: { [string]: boolean } = {}
+	for _, p in own do
+		mine[p] = true
+	end
+	local seen: { [string]: boolean } = {}
+	local out: { string } = {}
+	for _, p in changed do
+		if mine[p] and not seen[p] then
+			seen[p] = true
+			table.insert(out, p)
+		end
+	end
+	table.sort(out)
+	return out
+end
+
+export type Start = "land" | "already" | "nothing"
+
+-- Before the gate and after each race: `own` is the number of paths the branch's own non-merge commits that
+-- origin/main lacks change (read before any merge), `left` what the merged branch still changes against origin/main.
+-- A branch whose own commits changed files and main already holds the result has landed (an earlier land pushed it,
+-- even if the branch merged that push since); a branch with no commit of its own has nothing to land. A branch whose
+-- own commits cancel out (an edit and its revert) also reads as landed: main lacks nothing it has.
+function landrace.start(own: number, left: number): Start
+	if left > 0 then
+		return "land"
+	end
+	return if own > 0 then "already" else "nothing"
+end
+
+return landrace
