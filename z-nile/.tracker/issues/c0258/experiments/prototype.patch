+--!strict
+-- c0258: what `./zn` prints for -h/--help. Pure over the usage text and the parsed options: main.luau prints.
+local usage = {}
+
+-- Whether the arguments after the command ask for help: `-h` or `--help` as an option of its own. The flags
+-- reader of main.luau gives the answer (a value an option takes is never an option), so this reads its result.
+function usage.wantsHelp(opts: { [string]: { string } }): boolean
+	return opts["-h"] ~= nil or opts["--help"] ~= nil
+end
+
+-- The usage entries of `name` in `text` (main.luau's USAGE): every entry whose first word is the command, with
+-- its continuation lines, as the text has them. An entry starts with exactly two spaces; a continuation line with
+-- more. Nil when the text has none.
+function usage.of(text: string, name: string): string?
+	local out: { string } = {}
+	local inside = false
+	for line in string.gmatch(text .. "\n", "([^\n]*)\n") do
+		local word = string.match(line, "^  (%S+)")
+		if word then
+			inside = word == name
+		elseif not string.match(line, "^   ") then
+			inside = false
+		end
+		if inside then
+			table.insert(out, line)
+		end
+	end
+	if #out == 0 then
+		return nil
+	end
+	return `usage: ./zn {name} ...\n` .. table.concat(out, "\n")
+end
+
+return usage
