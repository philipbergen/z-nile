diff --git a/.models.toml b/.models.toml
index 1db7df1e..a496d538 100644
--- a/.models.toml
+++ b/.models.toml
@@ -136,3 +136,26 @@ max_calls = 200
 # and a wall-time ceiling, since a stream can hide its calls (fail closed)
 max_minutes = 240
 max_tokens = 2000000
+
+[z-ticket-review.claude]
+model = "claude-opus-5-5"
+rank = 4
+runtime = "claude-cli"
+max_tokens = 2000000
+
+[z-ticket-review.grok]
+model = "grok-4.7"
+effort = "xhigh"
+rank = 4
+runtime = "grok-cli"
+max_tokens = 2000000
+
+[z-ticket-review.agent]
+model = "claude-opus-5-5-high"
+rank = 4
+runtime = "cursor-cli"
+# agent reports no running token count: its step stops after max_calls model calls (calls are not tokens: tune it)
+max_calls = 200
+# and a wall-time ceiling, since a stream can hide its calls (fail closed)
+max_minutes = 240
+max_tokens = 2000000
