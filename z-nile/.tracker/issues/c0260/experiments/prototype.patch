diff --git a/z-nile/engine/capturecheck.luau b/z-nile/engine/capturecheck.luau
new file mode 100644
index 00000000..7f30b507
--- /dev/null
+++ b/z-nile/engine/capturecheck.luau
@@ -0,0 +1,290 @@
+--!strict
+-- c0260: the shape of an issue's `capture/` folder (z-ticket skill, The capture folder): the user's verbatim ask, the
+-- interview, the idea review's findings each answered, and the confirmation that names the last review round.
+-- Pure over texts; audit.luau reads the folder and calls `check`. It judges shape only: that the ask is verbatim and
+-- that the user really confirmed is for the reviewers (the audit cannot see either).
+local capturecheck = {}
+
+capturecheck.REVIEW = "^idea%-review%-(%d%d%d)%.md$"
+capturecheck.REFUTE = "^idea%-refute%-(%d%d%d)%.md$"
+
+local function blank(text: string): boolean
+	return string.match(text, "^%s*$") ~= nil
+end
+
+-- The fence a line opens or closes: its character and length (three or more backticks or tildes), or nil. A fenced
+-- block holds the user's words as written, headings and all (F3): nothing inside it is structure.
+local function fenceOf(line: string): (string?, number)
+	local ticks = string.match(line, "^(`+)%s*[%w]*%s*$")
+	if ticks and #ticks >= 3 then
+		return "`", #ticks
+	end
+	local tildes = string.match(line, "^(~+)%s*[%w]*%s*$")
+	if tildes and #tildes >= 3 then
+		return "~", #tildes
+	end
+	return nil, 0
+end
+
+-- Calls `visit(line, inFence)` for each line of `text`; returns false when a fence is never closed.
+local function eachLine(text: string, visit: (string, boolean) -> ()): boolean
+	local open: string? = nil
+	local width = 0
+	for line in string.gmatch(text .. "\n", "([^\n]*)\n") do
+		local ch, n = fenceOf(line)
+		if open == nil then
+			if ch then
+				open, width = ch, n
+				visit(line, true)
+			else
+				visit(line, false)
+			end
+		else
+			visit(line, true)
+			if ch == open and n >= width and string.match(line, "^[`~]+%s*$") then
+				open = nil
+			end
+		end
+	end
+	return open == nil
+end
+
+-- The `## ` sections of `text` in order: title, body (fenced lines included). The second result is false when a
+-- fence is never closed.
+local function sections(text: string): ({ { title: string, body: string } }, boolean)
+	local out: { { title: string, body: string } } = {}
+	local closed = eachLine(text, function(line: string, fenced: boolean)
+		local title = if fenced then nil else string.match(line, "^## (.-)%s*$")
+		if title then
+			table.insert(out, { title = title, body = "" })
+		elseif #out > 0 then
+			out[#out].body ..= line .. "\n"
+		end
+	end)
+	return out, closed
+end
+
+-- The interview's problems: `None: <why>` alone, or `### Qn` blocks numbered from 1 without gaps, each with its three
+-- lines filled in.
+local function interview(body: string, out: { string })
+	local none = string.match(body, "^%s*None:%s*(.-)%s*$")
+	if none ~= nil then
+		if blank(none) then
+			table.insert(out, "Interview: `None:` needs the reason")
+		elseif string.find(none, "\n", 1, true) then
+			table.insert(out, "Interview: `None: <why>` must be the only line (or write ### Q1 blocks)")
+		end
+		return
+	end
+	local want = 1
+	local cur: { [string]: string }? = nil
+	local lastKey: string? = nil
+	local function close()
+		if cur then
+			for _, key in { "Question", "Options", "Answer" } do
+				if blank(cur[key] or "") then
+					table.insert(out, `Interview: Q{want - 1} has no {key}: line`)
+				end
+			end
+		end
+	end
+	local closed = eachLine(body, function(line: string, fenced: boolean)
+		if fenced then
+			-- a fenced block after `Answer:` (or `Question:`) is that line's text: several lines, headings and all
+			if cur and lastKey and blank(cur[lastKey] or "") then
+				cur[lastKey] = "(fenced)"
+			end
+			return
+		end
+		local n = string.match(line, "^### Q(%d+)%s*$")
+		if n then
+			close()
+			if tonumber(n) ~= want then
+				table.insert(out, `Interview: found Q{n} where Q{want} belongs (number from 1, no gaps)`)
+			end
+			want += 1
+			cur, lastKey = {}, nil
+		elseif cur then
+			local k, v = string.match(line, "^(%a+):%s*(.*)$")
+			if k and (k == "Question" or k == "Options" or k == "Answer") and cur[k] == nil then
+				cur[k] = v :: string
+				lastKey = k
+			end
+		elseif not blank(line) then
+			table.insert(out, `Interview: text before the first ### Q1 block: {line}`)
+		end
+	end)
+	close()
+	if not closed then
+		table.insert(out, "Interview: a fenced block is never closed")
+	end
+	if want == 1 then
+		table.insert(out, "Interview: no ### Q1 block and no `None: <why>` line")
+	end
+end
+
+-- `ask`: capture/ask.md. `files`: the other files of the folder, name -> text. The problems, in reading order.
+function capturecheck.check(ask: string, files: { [string]: string }): { string }
+	local out: { string } = {}
+	local secs, closed = sections(ask)
+	if not closed then
+		table.insert(out, "ask.md has a fenced block that is never closed")
+		return out
+	end
+	local titles: { string } = {}
+	for _, sec in secs do
+		table.insert(titles, sec.title)
+	end
+	local joined = table.concat(titles, "|")
+	if
+		joined ~= "Verbatim ask|Interview|Confirmation"
+		and joined ~= "Verbatim ask|Part|Interview|Confirmation"
+	then
+		table.insert(
+			out,
+			`ask.md sections must be Verbatim ask, [Part,] Interview, Confirmation, in that order (found: {table.concat(
+				titles,
+				", "
+			)})`
+		)
+		return out
+	end
+	local partAt = if #secs == 4 then 2 else nil
+	if blank(secs[1].body) then
+		table.insert(out, "Verbatim ask is empty")
+	end
+	if partAt and blank(secs[2].body) then
+		table.insert(out, "Part is empty (it names the sibling issues and quotes this issue's part)")
+	end
+	local iv, cf = secs[#secs - 1], secs[#secs]
+	interview(iv.body, out)
+
+	-- the review rounds: idea-review-001.. without gaps, each with its refute file answering every finding
+	local anyAsk = false
+	local last = 0
+	local rounds: { [number]: boolean } = {}
+	for name in files do
+		local n = string.match(name, capturecheck.REVIEW)
+		if n then
+			rounds[tonumber(n) :: number] = true
+			last = math.max(last, tonumber(n) :: number)
+		end
+	end
+	if last == 0 then
+		table.insert(out, "no idea-review-001.md: the idea was never reviewed")
+	end
+	for n = 1, last do
+		local rev = string.format("idea-review-%03d.md", n)
+		local ref = string.format("idea-refute-%03d.md", n)
+		if not rounds[n] then
+			table.insert(out, `{rev} is missing (rounds number from 001 without gaps)`)
+		elseif files[ref] == nil then
+			table.insert(out, `{ref} is missing: answer every finding of {rev}`)
+		else
+			local answered: { [string]: boolean } = {}
+			for line in string.gmatch(files[ref], "[^\n]+") do
+				local f, kind, why = string.match(line, "^%- F(%d+): (%a+):%s*(.*)$")
+				if f then
+					if kind ~= "fixed" and kind ~= "refuted" and kind ~= "ask" then
+						table.insert(out, `{ref}: F{f} is answered "{kind}" (fixed, refuted or ask)`)
+					elseif blank(why :: string) then
+						table.insert(out, `{ref}: F{f} has an empty answer`)
+					end
+					if kind == "ask" then
+						anyAsk = true
+					end
+					answered[f :: string] = true
+				end
+			end
+			local seen: { [string]: boolean } = {}
+			for f in string.gmatch(files[rev], "\n### F(%d+)") do
+				seen[f] = true
+				if not answered[f] then
+					table.insert(
+						out,
+						`{ref}: finding F{f} of {rev} has no answer line (- F{f}: fixed|refuted|ask: …)`
+					)
+				end
+			end
+			for f in answered do
+				if not seen[f] then
+					table.insert(out, `{ref}: answers F{f}, which {rev} does not have`)
+				end
+			end
+		end
+	end
+
+	-- the confirmation: one line, last, naming the highest review round
+	local lines: { string } = {}
+	for line in string.gmatch(cf.body, "[^\n]+") do
+		if not blank(line) then
+			table.insert(lines, line)
+		end
+	end
+	if #lines ~= 1 then
+		table.insert(out, `Confirmation must be one line (found {#lines})`)
+	else
+		local who, date, round, words = string.match(
+			lines[1],
+			"^Confirmed %((%a+), (%d%d%d%d%-%d%d%-%d%d)%) after idea%-review%-(%d%d%d): (.+)$"
+		)
+		if not who or (who ~= "user" and who ~= "unattended") or not date or blank(words :: string) then
+			table.insert(
+				out,
+				"Confirmation must read `Confirmed (user|unattended, YYYY-MM-DD) after idea-review-NNN: <words>`"
+			)
+		elseif who == "unattended" and string.match(iv.body, "^%s*None:") == nil then
+			table.insert(
+				out,
+				"Confirmed (unattended …) needs the Interview to be `None: <why>`: nobody was asked"
+			)
+		elseif who == "user" and anyAsk then
+			table.insert(
+				out,
+				"a `- Fn: ask:` answer is open: once the user answered it, rewrite it `- Fn: fixed: asked as Qn` (an `ask:` is kept only with an unattended confirmation)"
+			)
+		elseif last > 0 and tonumber(round :: string) ~= last then
+			table.insert(
+				out,
+				`Confirmation follows idea-review-{round} but the last round is idea-review-{string.format(
+					"%03d",
+					last
+				)}`
+			)
+		end
+	end
+	return out
+end
+
+-- True when ask.md says `Confirmed (unattended …)`: the user has not confirmed the idea yet (z-design asks them).
+function capturecheck.unattended(ask: string): boolean
+	return string.find(ask, "\nConfirmed (unattended,", 1, true) ~= nil
+end
+
+-- The parts of ask.md a later change must keep: the Verbatim ask, the Part and each `### Qn` block already there.
+-- Returns the first thing `new` changed or dropped compared with `old`, or nil (appending a block, or changing the
+-- Confirmation, is allowed; so is turning the `None:` line into the questions put to the user later).
+function capturecheck.appendOnly(old: string, new: string): string?
+	local a = (sections(old))
+	local b = (sections(new))
+	local function by(secs: { { title: string, body: string } }, title: string): string?
+		for _, sec in secs do
+			if sec.title == title then
+				return sec.body
+			end
+		end
+		return nil
+	end
+	for _, title in { "Verbatim ask", "Part" } do
+		if by(a, title) ~= nil and by(a, title) ~= by(b, title) then
+			return `{title} changed`
+		end
+	end
+	local oldIv, newIv = by(a, "Interview") or "", by(b, "Interview") or ""
+	if string.match(oldIv, "^%s*None:") == nil and string.sub(newIv, 1, #oldIv) ~= oldIv then
+		return "an Interview block changed or was dropped (questions are only added)"
+	end
+	return nil
+end
+
+return capturecheck
