new file mode 100644
index 00000000..c33a14c9
--- /dev/null
+++ b/z-nile/engine/capturecut.luau
@@ -0,0 +1,53 @@
+--!strict
+-- c0260: which issues must carry a capture record (or the agent-filed marker). The cut-over is read from the landing
+-- in git's history, never from a calendar date or a commit time (a squash merge rewrites those): an issue is "after"
+-- when the commit that first added its document is a descendant of the commit that first added the marker file
+-- z-nile/.tracker/capture-since (the landing commit adds it).
+-- An issue made before that landing is "older" and is never judged; nothing is migrated. A history this cannot read
+-- (a shallow clone, a git error) is "unknown", and the claim gate fails closed on it.
+local capturecut = {}
+
+-- The marker is a tracker-state file, so a fixture that copies the tooling but no tracker state has none: the rule is
+-- not in force there, and every issue is "older". The landing commit adds it.
+capturecut.MARKER = "z-nile/.tracker/capture-since"
+
+export type Run = (args: { string }) -> (boolean, string)
+
+local function firstLine(text: string): string?
+	return string.match(text, "^%s*(%x+)")
+end
+
+-- "older" | "after" | "unknown", for the issue `id` whose document is at `docPath`, in the history of `ref`.
+function capturecut.of(run: Run, ref: string, id: string, docPath: string): string
+	local ok, shallow = run({ "rev-parse", "--is-shallow-repository" })
+	if not ok or string.match(shallow, "^%s*(%a+)") == "true" then
+		return "unknown"
+	end
+	local lok, landed =
+		run({ "log", "--diff-filter=A", "--format=%H", "--reverse", ref, "--", capturecut.MARKER })
+	if not lok then
+		return "unknown"
+	end
+	local landing = firstLine(landed)
+	if not landing then
+		return "older" -- the marker is not in this history yet: the rule is not in force
+	end
+	local aok, added =
+		run({ "log", "--diff-filter=A", "--format=%H", "--reverse", ref, "--", `:(glob)**/{id}/{id}.md` })
+	if not aok then
+		return "unknown"
+	end
+	local doc = firstLine(added)
+	if not doc then
+		return "unknown" -- no commit adds this document in the history: not ours to judge
+	end
+	-- exit 0: landing is an ancestor of (or equals) the commit that added the document
+	local anc = run({ "merge-base", "--is-ancestor", landing, doc })
+	if anc then
+		return "after"
+	end
+	local rok = run({ "merge-base", "--is-ancestor", doc, landing })
+	return if rok then "older" else "unknown"
+end
+
+return capturecut
