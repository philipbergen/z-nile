diff --git a/z-nile/engine/finalread.luau b/z-nile/engine/finalread.luau
new file mode 100644
index 000000000..947011027
--- /dev/null
+++ b/z-nile/engine/finalread.luau
@@ -0,0 +1,347 @@
+--!strict
+-- The edge of the ticket's final review (c0262): reads git and the tracker into finalview's inputs, writes
+-- the view folder. The rules are finalview.luau's.
+local audit = require("./audit")
+local escalation = require("./escalation")
+local finalview = require("./finalview")
+local fs = require("@lune/fs")
+local layergit = require("./layergit")
+local process = require("@lune/process")
+local sh = require("../lib/sh")
+local stack = require("./stack")
+local store = require("./store")
+local trail = require("./trail")
+
+local finalread = {}
+
+export type Where = { layer: stack.Layer, tip: string, base: string }
+
+local function trim(s: string): string
+	return (string.gsub(s, "%s+$", ""))
+end
+
+local function showAt(sha: string, path: string): string?
+	local r = sh.run("git", { "show", `{sha}:{path}` })
+	if r.ok then
+		return r.stdout
+	end
+	return nil
+end
+
+-- The layer's tip: the local branch when it is ahead of origin's (a worker's commits not pushed yet), else origin's.
+function finalread.tipOf(layer: stack.Layer): string?
+	local loc = layergit.shaOf(layer.name)
+	local rem = layergit.shaOf(`origin/{layer.name}`)
+	if loc and rem and loc ~= rem then
+		if sh.run("git", { "merge-base", "--is-ancestor", rem, loc }).ok then
+			return loc
+		end
+		return rem
+	end
+	return loc or rem
+end
+
+-- The layer of `issue`: the newest raft's layer branch for it, its tip, and the base it was built on (the tip
+-- of the layer below, or main). nil when the ticket has no layer.
+function finalread.where(issue: string): Where?
+	local listed =
+		sh.run("git", { "for-each-ref", "--format=%(refname:short)", "refs/heads", "refs/remotes/origin" })
+	if not listed.ok then
+		return nil
+	end
+	local best: stack.Layer? = nil
+	for line in string.gmatch(listed.stdout .. "\n", "([^\n]*)\n") do
+		local layer = if line == "" then nil else stack.parse(line)
+		if layer and layer.issue == issue and (not best or layer.raft > (best :: stack.Layer).raft) then
+			best = layer
+		end
+	end
+	if not best then
+		return nil
+	end
+	local layer = best :: stack.Layer
+	local tip = finalread.tipOf(layer)
+	if not tip then
+		return nil
+	end
+	-- c0248's base of the layer (layergit.baseOfLayer, through baseFor: whatever rule c0248's design gives the layer), so
+	-- the diff is exactly what the layer adds
+	local raftItem = store.find(layer.raft)
+	local found, fork = false, nil
+	if raftItem then
+		found, fork = pcall(layergit.baseOfLayer, raftItem, layer)
+	end
+	local base: string? = if found then fork else nil
+	if not base then
+		base = layergit.mainTip()
+		if layer.position > 1 then
+			for _, below in layergit.layersOf(layer.raft) do
+				if below.position == layer.position - 1 then
+					base = finalread.tipOf(below) or base
+				end
+			end
+		end
+	end
+	return { layer = layer, tip = tip, base = base :: string }
+end
+
+local function capturedText(item: store.Item): string
+	local commits, _ = trail.read("issues", item.id, trail.isDoc, "origin/main")
+	local found = if commits then (trail.capture(commits)) else nil
+	if found then
+		local shown = showAt(found.sha, found.path)
+		if shown then
+			return shown
+		end
+	end
+	return if fs.isFile(item.doc) then fs.readFile(item.doc) else ""
+end
+
+-- The text of `path` on origin/main, nil when it is not there.
+local function onMain(path: string): string?
+	return showAt("origin/main", path)
+end
+
+-- The ticket's folder as `ref` has it: a block or a stop moves it between the backlog and `active/` on main while its
+-- layer keeps the path it was built at, so each ref is asked for every place (backlog, `active/`, `done/`). nil when
+-- `ref` holds no document of the ticket.
+local function dirAt(ref: string, item: store.Item): string?
+	local root = string.match(item.dir, "^(.*)/issues/") or ""
+	for _, place in { "", "active/", "done/" } do
+		local dir = `{root}/issues/{place}{item.id}`
+		if sh.run("git", { "cat-file", "-e", `{ref}:{dir}/{item.id}.md` }).ok then
+			return dir
+		end
+	end
+	return nil
+end
+
+-- The view's files for `issue` at `at`. The judged texts (the document, the check, the acceptance specs) come from
+-- origin/main's copy of the ticket's folder: the approved prep, never the branch under review. What the layer
+-- changed in the design and the decision lines is shown apart, as claims (finalview.changes). A ticket that is not on
+-- origin/main (created on the branch) is read at the tip.
+function finalread.files(issue: string, at: Where): { [string]: string }
+	local item = store.get(issue)
+	local raft = at.layer.raft
+	local tipDir = dirAt(at.tip, item)
+	local mainDir = dirAt("origin/main", item)
+	local tipDoc = (if tipDir then showAt(at.tip, `{tipDir}/{issue}.md`) else nil)
+		or (if fs.isFile(item.doc) then fs.readFile(item.doc) else "")
+	local mainDoc = if mainDir then onMain(`{mainDir}/{issue}.md`) else nil
+	local from = if mainDoc then "origin/main" else at.tip
+	local fromDir = (if mainDoc then mainDir else tipDir) or item.dir
+	local baseDoc = mainDoc or tipDoc
+	local contract: { [string]: string } = {}
+	local check = showAt(from, `{fromDir}/check.sh`)
+	if check then
+		contract["check.sh"] = check
+	end
+	local listed = sh.run("git", { "ls-tree", "-r", "--name-only", from, `{fromDir}/acceptance/` })
+	if listed.ok then
+		local prefix = `{fromDir}/acceptance/`
+		for path in string.gmatch(listed.stdout .. "\n", "([^\n]+)\n") do
+			local text = showAt(from, path)
+			if text then
+				contract["acceptance/" .. string.sub(path, #prefix + 1)] = text
+			end
+		end
+	end
+	-- three dots: from the merge base of the layer below and this layer, so main moving on does not show as a change
+	local range = `{at.base}...{at.tip}`
+	local names = sh.run("git", { "diff", "--name-only", range })
+	local kept: { string } = { "diff", "--no-color", range, "--" }
+	local any = false
+	if names.ok then
+		for path in string.gmatch(names.stdout .. "\n", "([^\n]+)\n") do
+			if finalview.keepPath(path, issue, raft) then
+				table.insert(kept, path)
+				any = true
+			end
+		end
+	end
+	local diff = if any then sh.run("git", kept).stdout else ""
+	local patchId = ""
+	if diff ~= "" then
+		local pid = sh.run("git", { "patch-id", "--stable" }, diff)
+		patchId = string.match(pid.stdout, "^(%x+)") or ""
+	end
+	return finalview.assemble({
+		id = issue,
+		captured = capturedText(item),
+		base = baseDoc,
+		front = audit.front(baseDoc),
+		tip = tipDoc,
+		contract = contract,
+		diff = diff,
+		patchId = patchId,
+	})
+end
+
+-- The ticket's final reviews: the ones committed on its layer and the ones on origin/main in its folder (a ticket
+-- that went back to z-design leaves its off-course reviews on main with the re-prep, so a second off-course
+-- verdict still counts after a new raft and layer). By number; the layer's copy wins a repeated number.
+function finalread.reviews(issue: string, at: Where?): { finalview.Review }
+	local item = store.get(issue)
+	local byNumber: { [number]: finalview.Review } = {}
+	for _, ref in { "origin/main", if at then at.tip else "" } do
+		local dir = if ref ~= "" then dirAt(ref, item) else nil
+		if dir then
+			local listed = sh.run("git", { "ls-tree", "--name-only", ref, `{dir}/` })
+			if listed.ok then
+				for path in string.gmatch(listed.stdout .. "\n", "([^\n]+)\n") do
+					local n = string.match(path, "/final%-review%-(%d+)%.md$")
+					if n then
+						byNumber[tonumber(n) :: number] =
+							finalview.parse(tonumber(n) :: number, showAt(ref, path) or "")
+					end
+				end
+			end
+		end
+	end
+	local out: { finalview.Review } = {}
+	for _, r in byNumber do
+		table.insert(out, r)
+	end
+	table.sort(out, function(x, y)
+		return x.n < y.n
+	end)
+	return out
+end
+
+-- c0262: the human's rulings on the ticket's blocked final reviews, by review number (finalview.ruling): the resolved
+-- c0250 notes (`escalation.md`, `escalation-NNN.md`) on origin/main in its raft's folder (an approve or a retry keeps the
+-- raft) and in its own folder (an amend-design copies the note to the member it unfolds), in any lifecycle place.
+function finalread.rulings(issue: string, at: Where?): { [number]: string }
+	local item = store.get(issue)
+	local root = string.match(item.dir, "^(.*)/issues/") or ""
+	local dirs: { string } = {}
+	for _, place in { "", "active/", "done/" } do
+		table.insert(dirs, `{root}/issues/{place}{issue}/`)
+		if at then
+			table.insert(dirs, `{root}/rafts/{place}{at.layer.raft}/`)
+		end
+	end
+	local out: { [number]: string } = {}
+	local listed = sh.run("git", { "ls-tree", "--name-only", "origin/main", "--", table.unpack(dirs) })
+	if not listed.ok then
+		return out
+	end
+	for path in string.gmatch(listed.stdout .. "\n", "([^\n]+)\n") do
+		if string.match(path, "/escalation%.md$") or string.match(path, "/escalation%-%d+%.md$") then
+			local note = escalation.parse(showAt("origin/main", path) or "")
+			if note then
+				local n, decision = finalview.ruling(
+					issue,
+					note.layer,
+					note.findings,
+					if note.resolution then note.resolution.decision else nil
+				)
+				if n and decision then
+					out[n] = decision
+				end
+			end
+		end
+	end
+	return out
+end
+
+-- The highest review number the ticket has, on its layer or on origin/main.
+function finalread.lastNumber(issue: string): number
+	local last = 0
+	for _, r in finalread.reviews(issue, finalread.where(issue)) do
+		if r.n > last then
+			last = r.n
+		end
+	end
+	return last
+end
+
+function finalread.state(issue: string): finalview.State
+	local at = finalread.where(issue)
+	local reviews = finalread.reviews(issue, at)
+	if #reviews == 0 then
+		return {
+			state = "none",
+			why = if at then "no final review yet" else `{issue} has no layer`,
+			latest = "",
+		}
+	end
+	if not at then
+		return finalview.state(reviews, "", finalread.rulings(issue, nil))
+	end
+	local files = finalread.files(issue, at)
+	local view = string.match(files["README.md"] or "", "View: (%x+)") or ""
+	-- a review of this view quotes this view (finalview.unquoted); an older view's quotes were judged when it was filed.
+	-- The state reads it as a problem, which the human's ruling lifts (retry sets the review aside, approve counts it).
+	for _, r in reviews do
+		if r.view == view then
+			r.unquoted = finalview.unquoted(r, files)
+		end
+	end
+	return finalview.state(reviews, view, finalread.rulings(issue, at))
+end
+
+-- Why a review written for `issue`'s current view quotes nothing of it, or nil (the dispatcher asks before it files).
+function finalread.quoteProblem(issue: string, review: finalview.Review): string?
+	local at = finalread.where(issue)
+	if not at then
+		return nil
+	end
+	return finalview.unquoted(review, finalread.files(issue, at))
+end
+
+-- c0262: whether `issue` waits for its own final review: its document carries `final: ticket`, which `./zn status <id>
+-- prepared` writes when a ticket's design is finished with this rule in place (a ticket prepared before is not held).
+-- Read from origin/main's copy, the approved prep, as the judged texts are: a layer that drops the line is still held.
+-- A ticket not on origin/main is read in this tree.
+function finalread.marked(issue: string): boolean
+	local item = store.find(issue)
+	if item == nil or item.kind ~= "issue" then
+		return false
+	end
+	local dir = dirAt("origin/main", item)
+	local text = if dir
+		then showAt("origin/main", `{dir}/{issue}.md`)
+		elseif fs.isFile(item.doc) then fs.readFile(item.doc)
+		else nil
+	return text ~= nil and audit.front(text).final == "ticket"
+end
+
+-- Where a view for `issue` is written: under ZN_FINAL_VIEW_ROOT, else a folder of the OS temp area. Never inside
+-- a checkout, so no CLAUDE.md or AGENTS.md sits above the reviewer's working directory.
+function finalread.viewDir(issue: string): string
+	local root = process.env.ZN_FINAL_VIEW_ROOT
+	if not root or root == "" then
+		root = `{process.env.TMPDIR or "/tmp"}/zn-final`
+	end
+	root = string.gsub(root :: string, "/+$", "")
+	return `{root}/{issue}`
+end
+
+-- Writes the view folder `dir` (replacing what was there) and returns its file list.
+function finalread.write(issue: string, dir: string): { string }
+	local at = finalread.where(issue) or error(`{issue} has no layer branch (R<id>/<n>/{issue}) to review`, 0)
+	local files = finalread.files(issue, at)
+	if fs.isDir(dir) then
+		fs.removeDir(dir)
+	end
+	fs.writeDir(dir)
+	local names: { string } = {}
+	for path, text in files do
+		if not finalview.allowed(path) then
+			error(`the view holds only its fixed files: {path}`, 0)
+		end
+		local parent = string.match(path, "^(.*)/[^/]+$")
+		if parent then
+			fs.writeDir(`{dir}/{parent}`)
+		end
+		fs.writeFile(`{dir}/{path}`, text)
+		table.insert(names, path)
+	end
+	table.sort(names)
+	return names
+end
+
+finalread.trim = trim
+
+return finalread
diff --git a/z-nile/engine/finalview.luau b/z-nile/engine/finalview.luau
