diff --git a/z-nile/engine/readycheck.luau b/z-nile/engine/readycheck.luau
index c30f0a314..569e44dee 100644
--- a/z-nile/engine/readycheck.luau
+++ b/z-nile/engine/readycheck.luau
@@ -179,7 +179,7 @@ end
 -- The first reason `./zn ready` would refuse, or nil when it would accept. The second value is false
 -- when the documents already pass and the design files have not been loaded yet: the caller loads them
 -- and calls again. A refusal is complete either way.
-function readycheck.reason(r: Raft): (string?, boolean)
+local function refusal(r: Raft, approvals: boolean): (string?, boolean)
 	if not (r.where == "backlog" and r.status == "prepared") then
 		return `{r.id} is {r.status} in {r.dir} on origin/main: only a prepared raft is readied`, true
 	end
@@ -229,7 +229,9 @@ function readycheck.reason(r: Raft): (string?, boolean)
 		if not parts then
 			return `{m.id}: {err}`, true
 		end
-		local changed = approval.reasonOf(m.id, m.approvalFile, parts, m.approval, true)
+		local changed = if approvals
+			then approval.reasonOf(m.id, m.approvalFile, parts, m.approval, true)
+			else nil
 		if changed then
 			return changed, true
 		end
@@ -237,6 +239,51 @@ function readycheck.reason(r: Raft): (string?, boolean)
 	return nil, true
 end
 
+function readycheck.reason(r: Raft): (string?, boolean)
+	return refusal(r, true)
+end
+
+-- A member whose approval does not let ready take the raft: "none", "bad" or "changed" (approval.stateOf), and the
+-- contract parts that changed.
+export type Unapproved = { id: string, state: string, changed: { string } }
+
+-- The members whose approval on these texts is missing, unreadable or no longer matches their contract, in the
+-- order given (the raft's layer order; any member it leaves out after, by id), when approvals are all that ready
+-- would refuse `r` for. Nil when ready would refuse it for anything else first (the grouping record included), or
+-- when its design files are not loaded. An empty list: ready would accept it.
+function readycheck.waiting(r: Raft, order: { string }): { Unapproved }?
+	local other, complete = refusal(r, false)
+	if other or not complete then
+		return nil
+	end
+	if readycheck.record(r.id, r.grouped, r.members, r.files) then
+		return nil
+	end
+	local rank: { [string]: number } = {}
+	for i, id in order do
+		rank[id] = i
+	end
+	local members = table.clone(r.members)
+	table.sort(members, function(a: Member, b: Member): boolean
+		local ra, rb = rank[a.id] or math.huge, rank[b.id] or math.huge
+		if ra ~= rb then
+			return ra < rb
+		end
+		return a.id < b.id
+	end)
+	local out: { Unapproved } = {}
+	for _, m in members do
+		local parts = contract.build(m.doc, m.files["check.sh"] or "", m.specs)
+		if parts then
+			local state, changed = approval.stateOf(parts, m.approval)
+			if state ~= "holds" then
+				table.insert(out, { id = m.id, state = state, changed = changed })
+			end
+		end
+	end
+	return out
+end
+
 -- The specs the contract hashes: acceptance/ when it holds any spec, otherwise the promoted set the
 -- caller already read. Same choice as approval.collect.
 function readycheck.specs(files: { [string]: string }, promoted: { [string]: string }): { [string]: string }
