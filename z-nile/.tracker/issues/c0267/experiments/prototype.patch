+	unapproved: { Unapproved }?,
+	unreadable: string?, -- why those approvals could not be read from origin/main
 }
+export type Unapproved = { id: string, state: string, changed: { string } }
 export type Action = {
 	kind: "step" | "merge" | "stop",
 	step: string?, -- kind step: the step to run
@@ -204,6 +210,7 @@ export type Action = {
 	head: string?, -- a merge: the head commit it is pinned to
 	why: string?,
 	code: number?, -- kind stop: 0 done, 1 failure, 3 needs the user, 4 waiting at a merge gate
+	waiting: string?, -- a stop that waits for a person, not a failure: "approval"
 }
 
 -- the most actions one chain run takes before it stops
@@ -281,6 +288,30 @@ local function gate(f: Facts, name: string, pr: Pr): Action
 	return { kind = "stop", code = dispatch.EXIT.gate, gate = name, pr = pr.number, why = why }
 end
 
+-- The stop before a raft is readied while a person has not approved each of its issues (c0267): the design step
+-- drafted them, the chain merged the prep and rafted them, and no layer starts until the approvals are on origin/main.
+function dispatch.waitingWhy(raft: string, unapproved: { Unapproved }): string
+	local each: { string } = {}
+	for _, u in unapproved do
+		local what = if u.state == "none"
+			then "no approval"
+			elseif u.state == "bad" then "its approval.md does not parse"
+			else `its contract changed since approval ({table.concat(u.changed, ", ")})`
+		table.insert(each, `{u.id}: {what}.`)
+	end
+	local how: { string } = {}
+	for _, u in unapproved do
+		table.insert(
+			how,
+			`cd "$(./zn worktree approve-{u.id}-$(date +%s) --from origin/main)" && ./zn approve {u.id} && ./zn approve {u.id} --publish`
+		)
+	end
+	return `waiting for the person (not a failure): no layer of {raft} starts until a person approves the design of each of its issues on origin/main. {table.concat(
+		each,
+		" "
+	)} In a terminal of your own, from the main checkout, for each: {table.concat(how, "; ")}. Then run ./zn dispatch {raft} again.`
+end
+
 -- The next thing the chain does for the item. Stops first: questions.md, a failed step, a review step that left an
 -- unharvested finding. Then by state: capture, design, the prep gate, raft-plan, z-raft, the rafting gate, ready,
 -- run, the run's gate (always a human's), done.
@@ -379,6 +410,20 @@ function dispatch.next(f: Facts): Action
 	end
 	if f.where == "backlog" then
 		if f.status == "prepared" then
+			if f.unreadable then
+				return stop(
+					dispatch.EXIT.failure,
+					`the approvals of {f.id}'s issues could not be read from origin/main: {f.unreadable}`
+				)
+			end
+			if f.unapproved and #f.unapproved > 0 then
+				return {
+					kind = "stop",
+					code = dispatch.EXIT.user,
+					why = dispatch.waitingWhy(f.id, f.unapproved),
+					waiting = "approval",
+				}
+			end
 			return { kind = "step", step = "z-ready", target = f.id }
 		end
 		return stop(dispatch.EXIT.failure, `{f.id} is {f.status} in the backlog: z-raft prepares it first`)
