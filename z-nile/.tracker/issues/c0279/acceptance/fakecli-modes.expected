stop: 		[[stop) echo '{"type":"system"}'; sh -c 'echo $$ > "$FAKE_DIR/grandchild-stop.pid"; exec sleep 3600' & n=0; while [ ! -s "$FAKE_DIR/grandchild-stop.pid" ] && [ $n -lt 600 ]; do sleep 0.1; n=$((n+1)); done; sleep ${FAKE_DELAY:-0}; ./zn dispatch stop "$FAKE_STOP" >> "$FAKE_DIR/log" 2>&1; sleep 3600 ;;]], 
cap: 		[[cap) i=0; sh -c 'echo $$ > "$FAKE_DIR/grandchild-cap.pid"; exec sleep 3600' & n=0; while [ ! -s "$FAKE_DIR/grandchild-cap.pid" ] && [ $n -lt 600 ]; do sleep 0.1; n=$((n+1)); done; while [ $i -lt 20 ]; do ]] 			.. heavy 			.. "; i=$((i+1)); done; sleep 20 ;;", 
push: 		"push) echo note > notes.txt; git add notes.txt; " 			.. commit 			.. ' note; sleep ${FAKE_DELAY:-0}; git push -q origin HEAD:main 2>> "$FAKE_DIR/log"; echo "push=$?" >> "$FAKE_DIR/log"; sleep ${FAKE_DELAY:-0}; gh pr merge 7 --squash 2>> "$FAKE_DIR/log"; echo "merge=$?" >> "$FAKE_DIR/log"; ' 			.. ok 			.. " ;;", 
