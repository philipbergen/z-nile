orphan: 		[[orphan) sh -c 'echo $$ > "$FAKE_DIR/grandchild-orphan.pid"; exec sleep 3600' & n=0; while [ ! -s "$FAKE_DIR/grandchild-orphan.pid" ] && [ $n -lt 600 ]; do sleep 0.1; n=$((n+1)); done; echo '{"type":"system"}'; kill -9 "$ZN_DISPATCHER_PID"; sleep 3600 ;;]], 
late: 		[[late) git fetch -q origin main; git checkout -q -B late FETCH_HEAD; echo late > late.lua; git add late.lua; git -c user.name=c0117-fake -c user.email=c0117-fake@example.invalid commit -q -m late; perl -e 'setpgrp(0,0); exec @ARGV' sh -c 'n=0; while [ ! -f "$FAKE_DIR/late-go" ] && [ $n -lt 600 ]; do sleep 0.1; n=$((n+1)); done; [ -f "$FAKE_DIR/late-go" ] && "$ZN_REAL_GIT" push -q origin HEAD:main' > /dev/null 2>&1 < /dev/null & ]] 			.. OK.claude 			.. " ;;", 
waitreview: 		[[waitreview) echo '{"type":"assistant","message":{"id":"m9","content":[{"type":"tool_use","id":"t1","name":"Bash"}]}}'; ( n=0; while [ ! -f "$FAKE_DIR/started.zz-review" ] && [ $n -lt 1200 ]; do echo '{"type":"system"}'; sleep 0.5; n=$((n+1)); done ) & hb=$!; [ -z "${FAKE_START_DELAY:-}" ] || sleep "$FAKE_START_DELAY"; ./zn dispatch zz-review "$id" --mode design >> "$FAKE_DIR/log" 2>&1; echo "review=$?" >> "$FAKE_DIR/log"; kill $hb 2>/dev/null; echo '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t1"}]}}'; ]] 			.. ok 			.. " ;;", 
waitplain: 		[[waitplain) echo '{"type":"system"}'; ( n=0; while [ ! -f "$FAKE_DIR/started.zz-review" ] && [ $n -lt 1200 ]; do echo '{"type":"system"}'; sleep 0.5; n=$((n+1)); done ) & hb=$!; [ -z "${FAKE_START_DELAY:-}" ] || sleep "$FAKE_START_DELAY"; ./zn dispatch zz-review "$id" --mode design >> "$FAKE_DIR/log" 2>&1; echo "review=$?" >> "$FAKE_DIR/log"; kill $hb 2>/dev/null; ]] 			.. ok 			.. " ;;", 
