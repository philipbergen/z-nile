+-- The first spec file a tests-only ticket's finish commit (`<id>: <title>`) changed, kept or deleted, when that commit
+-- changed a spec file (`trace.isSpecFile`) and no source file; nil otherwise. Such a ticket's code cells cite it at line
+-- 1 (a deleted one at its line on main, c0301).
+local function testsOnlySpec(dir: string, issueId: string): string?
+	local log = fixture.git(dir, { "log", "--format=%H%x09%s", "HEAD" })
+	for line in string.gmatch(log .. "\n", "([^\n]*)\n") do
+		local sha, subject = string.match(line, "^(%x+)\t(.*)$")
+		if sha and subject and string.sub(subject, 1, #issueId + 2) == `{issueId}: ` then
+			local files = fixture.git(dir, { "diff-tree", "--no-commit-id", "--name-only", "-r", sha })
+			local spec: string? = nil
+			for path in string.gmatch(files .. "\n", "([^\n]*)\n") do
+				if watch.isSource(path) then
+					return nil
+				end
+				if spec == nil and trace.isSpecFile(path) then
+					spec = path
+				end
+			end
+			return spec
+		end
+	end
+	return nil
+end
