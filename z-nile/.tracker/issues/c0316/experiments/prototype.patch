+function lessons.reviewStage(stem: string): Stage
+	return if string.sub(stem, 1, 14) == "design-review-" then "design" else "implementation"
+end
+
+-- The valid `Stage:` line inside the block of `### <finding>` (its heading to the next `### ` or `## ` heading or
+-- the end); nil when the block has none, or only an unknown stage.
+function lessons.stageOf(review: string, finding: string): Stage?
+	local inBlock = false
+	for line in string.gmatch(review .. "\n", "([^\n]*)\n") do
+		local head = string.match(line, "^###%s+(F%d+)")
+		if head then
+			inBlock = head == finding
+		elseif string.match(line, "^##%s") then
+			inBlock = false
+		elseif inBlock then
+			local word = string.match(line, "^Stage:%s*(.-)%s*$")
+			if word then
+				return stageOfWord(word)
+			end
+		end
+	end
+	return nil
+end
+
+local function sortedFindings(review: string): { string }
+	local fs_ = lessons.findings(review)
+	table.sort(fs_, function(a, b)
+		return num(a) < num(b)
+	end)
+	return fs_
+end
+
+local RANK: { [string]: number } = { idea = 1, design = 2, implementation = 3 }
+
+-- Every escape of the item, covered or not. A finding is an escape when its stage is earlier than its review's own.
+function lessons.escapes(item: Item): { Escape }
+	local out: { Escape } = {}
+	local made: { [string]: Stage } = {}
+	for _, e in entriesOf(item) do
+		if e.escape then
+			made[e.finding] = e.escape.stage
+		end
+	end
+	for _, stem in stems(item) do
+		local own = lessons.reviewStage(stem)
+		local foundAt: "design" | "implementation" = if own == "design" then "design" else "implementation"
+		for _, f in sortedFindings(item.reviews[stem]) do
+			local stage = lessons.stageOf(item.reviews[stem], f)
+			if stage and RANK[stage] < RANK[own] then
+				table.insert(out, {
+					item = item.id,
+					kind = "finding",
+					ref = `{stem} {f}`,
+					made = stage :: Stage,
+					found = foundAt,
+				})
+			end
+		end
+	end
+	for n = 2, item.approvals or 0 do
+		local ref = `redesign {n}`
+		table.insert(
+			out,
+			{ item = item.id, kind = "redesign", ref = ref, made = made[ref], found = "implementation" }
+		)
+	end
+	for n = 1, item.stops or 0 do
+		local ref = `stop {n}`
+		table.insert(
+			out,
+			{ item = item.id, kind = "stop", ref = ref, made = made[ref], found = "implementation" }
+		)
+	end
+	if item.reworks ~= nil and item.reworks ~= "" then
+		table.insert(
+			out,
+			{ item = item.id, kind = "rework", ref = "rework 1", made = made["rework 1"], found = "merged" }
+		)
+	end
+	return out
+end
+
+-- `<id> <stem> <F>: no Stage line` for every finding of a review not in `exempt` (stems) with no valid Stage line.
+function lessons.unstaged(item: Item, exempt: { [string]: boolean }): { string }
+	local out = {}
+	for _, stem in stems(item) do
+		if exempt[stem] then
+			continue
+		end
+		for _, f in sortedFindings(item.reviews[stem]) do
+			if not lessons.stageOf(item.reviews[stem], f) then
+				table.insert(out, `{item.id} {stem} {f}: no Stage line`)
+			end
+		end
+	end
+	return out
+end
+
+-- The escapes by the stage that made them and the stage that found them, for the report: made in STAGES order and
+-- then "not harvested"; found design, implementation, merged. Only the rows that count something.
+function lessons.escapeCounts(items: { Item }): { { made: string, found: string, n: number } }
+	local counts: { [string]: number } = {}
+	for _, item in items do
+		for _, e in lessons.escapes(item) do
+			local key = `{e.made or "not harvested"}\t{e.found}`
+			counts[key] = (counts[key] or 0) + 1
+		end
+	end
+	local out: { { made: string, found: string, n: number } } = {}
+	for _, made in { "idea", "design", "implementation", "not harvested" } do
+		for _, found in { "design", "implementation", "merged" } do
+			local n = counts[`{made}\t{found}`]
+			if n then
+				table.insert(out, { made = made, found = found, n = n })
+			end
+		end
+	end
+	return out
+end
