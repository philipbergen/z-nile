+end
+
+-- the longest the format and lint stages may run at a gate (they take seconds; a hang fails closed)
+local LINT_SECONDS = 600
+
+-- c0359: a gate refuses a PR whose merge fails the gate's format and lint stages. Only when the PR changes a path
+-- they read (dispatch.lintable, from `base`, the merge base, or the empty tree): `git merge-tree` of today's main and
+-- the head, exported whole into a folder of this judgement alone (removed whole), and `z-nile/check.sh --lint` run
+-- there, bounded. The script is that tree's own, which is main's: the shape judgement before this refuses a PR that
+-- carries anything outside tracker state. Returns why not, or nil.
+function dispatcher.lintMerge(ctx: Ctx, number: number, main: string, ref: string, base: string?): string?
+	local root = ctx.mainRoot()
+	local okD, names =
+		git(root, { "diff", "--name-only", "--no-renames", base or trackerstate.EMPTY_TREE, ref })
+	if not okD then
+		return "its changed files could not be listed for the static stages"
+	end
+	local lintable = false
+	for path in string.gmatch(names, "[^\n]+") do
+		if dispatch.lintable(path) then
+			lintable = true
+			break
+		end
+	end
+	if not lintable then
+		return nil
+	end
+	local ok, out = git(root, { "merge-tree", "--write-tree", main, ref })
+	local tree = if ok then string.match(out, "^(%x+)") else nil
+	if not tree then
+		return "its merge with origin's main conflicts or could not be made"
+	end
+	local dir = `{root}/{HOME}/lint-{number}-{os.time()}-{math.random(1, 1000000000)}`
+	local function done(why: string?): string?
+		if fs.isDir(dir) then
+			pcall(fs.removeDir, dir)
+		end
+		return why
+	end
+	fs.writeDir(`{dir}/tree`)
+	local tar = `{dir}/tree.tar`
+	local okA = git(root, { "archive", "--format=tar", "-o", tar, tree :: string })
+	local x = if okA then process.exec("tar", { "-xf", tar, "-C", `{dir}/tree` }) else nil
+	if not okA or not x or not x.ok then
+		return done("its merge could not be exported for the static stages")
+	end
+	if not fs.isFile(`{dir}/tree/z-nile/check.sh`) then
+		return done("its merge has no z-nile/check.sh, so the static stages could not run")
+	end
+	local r = process.exec("perl", {
+		`{root}/z-nile/lib/bounded.pl`,
+		"--time",
+		tostring(LINT_SECONDS),
+		"--",
+		"env",
+		"ZN_MEASURED=1",
+		"bash",
+		"z-nile/check.sh",
+		"--lint",
+	}, { cwd = `{dir}/tree` })
+	if r.ok then
+		return done(nil)
+	end
+	local lines: { string } = {}
+	for line in string.gmatch(r.stdout .. "\n" .. r.stderr, "[^\n]+") do
+		if #lines < 40 then
+			table.insert(lines, line)
+		end
+	end
+	local said = table.concat(lines, "\n")
+	return done(`its merge fails the static stages (z-nile/check.sh --lint, exit {r.code}):\n{said}`)
 end
 
