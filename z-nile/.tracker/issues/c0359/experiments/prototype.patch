new file mode 100644
index 000000000..1dff8c46f
--- /dev/null
+++ b/.github/workflows/static.yml
@@ -0,0 +1,25 @@
+name: static
+# The gate's format and lint stages (`z-nile/check.sh --lint`) on every pull request, whatever it changes (c0359).
+# The `static` ruleset (.github/rulesets/static.json, posted by the user: SETUP.md) requires this check on main, so a
+# pull request whose merge fails either stage does not merge. It runs no spec, no item's check.sh and no runtime test:
+# verification stays the local gate (zz-rules skill, Merging).
+on:
+  pull_request:
+    types: [opened, synchronize, reopened, ready_for_review]
+
+permissions:
+  contents: read
+
+jobs:
+  static:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    concurrency:
+      group: static-${{ github.event.pull_request.number }}
+      cancel-in-progress: true
+    steps:
+      - uses: actions/checkout@v4
+      - run: z-nile/setup.sh --tools
+        env:
+          GH_TOKEN: ${{ github.token }}
+      - run: z-nile/check.sh --lint
