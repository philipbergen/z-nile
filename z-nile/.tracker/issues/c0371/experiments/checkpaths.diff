+-- The quoting of every byte of a check.sh, read once: `ctx[i]` is 0 at the top level and a fresh number inside each
+-- single-quoted string (a `bash -c '…'` script, read as a script of its own); `dq[i]` is true inside a double-quoted
+-- string of that context. A backslash escapes the next byte outside single quotes.
+type Quoting = { ctx: { number }, dq: { boolean } }
+local function quoting(text: string): Quoting
+	local ctx: { number }, dq: { boolean } = {}, {}
+	local cur, count, inDq, saved = 0, 0, false, false
+	local i, n = 1, #text
+	while i <= n do
+		local c = string.sub(text, i, i)
+		ctx[i], dq[i] = cur, inDq
+		if c == "\\" and i < n then
+			ctx[i + 1], dq[i + 1] = cur, inDq
+			i += 2
+			continue
+		elseif c == "'" and cur == 0 and not inDq then
+			count += 1
+			cur, saved, inDq = count, inDq, false
+		elseif c == "'" and cur ~= 0 then
+			cur, inDq = 0, saved
+		elseif c == '"' then
+			inDq = not inDq
+		end
+		i += 1
+	end
+	return { ctx = ctx, dq = dq }
+end
