diff --git a/z-nile/engine/easy.luau b/z-nile/engine/easy.luau
index 1f888756d..781e6f56f 100644
--- a/z-nile/engine/easy.luau
+++ b/z-nile/engine/easy.luau
@@ -178,6 +178,58 @@ function easy.raised(reviews: { string }): (string?, string?)
 	return best, nil
 end
 
+-- c0458: the levels a raft's reviews raised, per ticket. `levels` maps each ticket of the raft to its current `risk:`.
+-- `Level: <ticket> <level>` names a ticket; a bare `Level: <level>` is for a raft of one ticket and a problem in a raft
+-- of several. A raise counts above the ticket's current level, and at it when the ticket still has only a short note
+-- (`noted`: the author's level moved after the design, so the design never saw it); below it nothing is raised,
+-- and the highest of normal and risky wins per ticket. A line naming a ticket not in the raft, or a word that is no
+-- level, is a problem (callers refuse).
+function easy.raisedBy(
+	reviews: { string },
+	levels: { [string]: string },
+	noted: { [string]: boolean }
+): ({ [string]: string }, string?)
+	local ids: { string } = {}
+	for id in levels do
+		table.insert(ids, id)
+	end
+	local out: { [string]: string } = {}
+	for _, text in reviews do
+		local fenced = false
+		for line in string.gmatch(text .. "\n", "([^\n]*)\n") do
+			if string.match(line, "^%s*```") or string.match(line, "^%s*~~~") then
+				fenced = not fenced
+			elseif not fenced then
+				local rest = levelValue(line)
+				if rest then
+					local first, second = string.match(rest, "^([%w]+)%s*([%w]*)")
+					local ticket: string
+					local word: string
+					if first ~= nil and (first == "easy" or RANK[first] ~= nil) then
+						if #ids ~= 1 then
+							return {}, `a review has the line "{trim(line)}": name the ticket (Level: <ticket> <level>) in a raft of several`
+						end
+						ticket, word = ids[1], first
+					else
+						if first == nil or levels[first] == nil then
+							return {}, `a review has the line "{trim(line)}": no ticket {first or "?"} in the raft`
+						end
+						ticket, word = first, second or ""
+						if word ~= "easy" and RANK[word] == nil then
+							return {}, `a review has the line "{trim(line)}": a Level line holds easy, normal or risky`
+						end
+					end
+					local current = RANK[levels[ticket]] or 0
+					if word ~= "easy" and (RANK[word] > current or (RANK[word] == current and noted[ticket] == true)) and (out[ticket] == nil or RANK[word] > RANK[out[ticket]]) then
+						out[ticket] = word
+					end
+				end
+			end
+		end
+	end
+	return out, nil
+end
+
 local function isReview(name: string): boolean
 	return string.match(name, "^design%-review%-%d+%.md$") ~= nil
 		or string.match(name, "^final%-review%-%d+%.md$") ~= nil
