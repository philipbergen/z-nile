+-- d0298: the contract parts of an issue from a folder view (`files`: path relative to its folder -> text, as git
+-- tracks it), its acceptance specs from `acceptance/`, or else from `promoted` (path relative to the promoted folder).
+function approval.partsOf(
+	id: string,
+	files: { [string]: string },
+	promoted: { [string]: string }?
+): (contract.Parts?, string?)
+	local specs: { [string]: string } = {}
+	local found = false
+	for rel, text in files do
+		local name = string.match(rel, "^acceptance/(.+%.spec%.luau)$")
+		if name then
+			specs[name] = text
+			found = true
+		end
+	end
+	if not found and promoted then
+		for rel, text in promoted do
+			if string.match(rel, "%.spec%.luau$") then
+				specs[rel] = text
+			end
+		end
+	end
+	return contract.build(files[`{id}.md`] or "", files["check.sh"] or "", specs)
+end
+
+-- d0298: approval.md's text with its last row re-recorded for `parts` (same when and who, new hash and parts), or nil
+-- with why when it does not parse.
+function approval.reseal(text: string, parts: contract.Parts): (string?, string?)
+	local rows, err = contract.parse(text)
+	if not rows then
+		return nil, err
+	end
+	local last = rows[#rows]
+	rows[#rows] =
+		{ when = last.when, who = last.who, hash = contract.hash(parts), parts = contract.partHashes(parts) }
+	return contract.render(rows), nil
+end
+
+-- d0298: whether approval.md's last row matches `parts`.
+function approval.holds(text: string, parts: contract.Parts): boolean
+	local rows = contract.parse(text)
+	return rows ~= nil and #rows > 0 and rows[#rows].hash == contract.hash(parts)
+end
+
 function approval.summary(item: store.Item): string
