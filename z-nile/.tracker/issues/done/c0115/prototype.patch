+			write(`{root}/z-nile/skills/zz-test/lessons/pin.md`, lesson("Pinned?"))
+			write(`{root}/pickman/skills/pickman-play/SKILL.md`, doc("pickman-play"))
+			write(`{root}/pickman/skills/pickman-play/lessons/feel.md`, lesson("Fair?"))
