index 00000000..9e8d6f82
--- /dev/null
+++ b/z-nile/engine/explainer.luau
@@ -0,0 +1,276 @@
+--!strict
+-- The ticket explainer page (f0339): one self-contained HTML file per issue, `<issue-dir>/explainer.html`, that
+-- explains the idea and the design in plain words to the person who approves it. Pure: texts in, problems out.
+-- The caller reads the page, the issue's Touched modules and the contract hash (approval.collect).
+--
+-- The shape this checks (z-nile/templates/explainer.html is a page of that shape, still holding its placeholders):
+--   <meta name="zn-contract" content="<64 lowercase hex>">   the contract hash the page explains, exactly once
+--   <section id="idea">, "before", "changes", "after", "choices", each exactly once and in that order (the id may
+--   stand anywhere in the tag)
+--   "before" and "after" each hold an inline <svg>, and the two pictures differ
+--   "changes" names every path of the issue's Touched modules
+--   "choices" holds at least one class="choice" block, and each block a class="pros" and a class="cons"
+--   no element still has the template's placeholder class, zn-fill
+--   nothing is fetched or run: every src, href, srcset, poster, action, formaction, data, background and xlink:href
+--   value starts with "#" or "data:", every CSS url( and image-set( does too, there is no @import, no <script>, no
+--   on<event>= handler and no refresh; and no "://" stands anywhere but in an xmlns value
+-- Matching is on the lowercased page. The page is not part of the contract: approval.md's hash and `ready`'s check
+-- never read it.
+
+local explainer = {}
+
+explainer.FILE = "explainer.html"
+explainer.SECTIONS = { "idea", "before", "changes", "after", "choices" }
+explainer.DIAGRAMS = { "before", "after" }
+explainer.ATTRS =
+	{ "src", "href", "srcset", "poster", "action", "formaction", "data", "background", "xlink:href" }
+explainer.FILL = "zn-fill"
+
+local HEX = string.rep("%x", 64)
+local SELF = "the page is self-contained (inline styles and <svg>, data: URIs, no scripts)"
+
+-- A value fetches nothing when it is a fragment, an inline data: URI, or empty.
+local function isLocal(value: string): boolean
+	local v = string.gsub(value, "^%s+", "")
+	return v == "" or string.sub(v, 1, 1) == "#" or string.sub(v, 1, 5) == "data:"
+end
+
+local function escape(text: string): string
+	return (string.gsub(text, "[%^%$%(%)%%%.%[%]%*%+%-%?%:]", "%%%0"))
+end
+
+local function hasClass(classes: string, name: string): boolean
+	return string.match(" " .. classes .. " ", "%s" .. escape(name) .. "%s") ~= nil
+end
+
+-- What makes a lowercased page fetch or run something, each as a short description.
+local function external(low: string): { string }
+	local out: { string } = {}
+	for tag in string.gmatch(low, "<[^>]+>") do
+		for _, name in explainer.ATTRS do
+			-- the character before the name (space, slash or quote) keeps a longer name (data-src, onsrc) out
+			local pattern = "[%s/\"']" .. escape(name) .. "%s*=%s*([\"']?)"
+			local at = 1
+			while true do
+				local _, e, quote = string.find(tag, pattern, at)
+				if not e then
+					break
+				end
+				local rest = string.sub(tag, (e :: number) + 1)
+				local value = if quote ~= ""
+					then string.match(rest, "^([^" .. quote .. "]*)") or ""
+					else string.match(rest, "^([^%s>]*)") or ""
+				if not isLocal(value) then
+					table.insert(out, `fetches {name}="{value}"`)
+				end
+				at = (e :: number) + 1
+			end
+		end
+		local handler = string.match(tag, "[%s/\"'](on%a+)%s*=")
+		if handler then
+			table.insert(out, `runs an event handler ({handler}=)`)
+		end
+		if string.find(tag, "^<meta[%s/]") and string.find(tag, "http%-equiv%s*=%s*[\"']?refresh") then
+			table.insert(out, "refreshes to another page (http-equiv=refresh)")
+		end
+	end
+	for value in string.gmatch(low, "url%(%s*([^%)]*)%)") do
+		local v = string.gsub(value, "^[\"']", "")
+		if not isLocal(v) then
+			table.insert(out, `fetches url({value})`)
+		end
+	end
+	for body in string.gmatch(low, "image%-set%(([^%)]*)%)") do
+		for _, q in { '"', "'" } do
+			for value in string.gmatch(body, q .. "([^" .. q .. "]*)" .. q) do
+				if not isLocal(value) then
+					table.insert(out, `fetches image-set("{value}")`)
+				end
+			end
+		end
+	end
+	if string.find(low, "@import", 1, true) then
+		table.insert(out, "fetches @import")
+	end
+	if string.find(low, "<script", 1, true) then
+		table.insert(out, "runs a <script>")
+	end
+	if #out == 0 then
+		-- the backstop: a web address anywhere but in an xmlns value (inline svg's namespace)
+		local bare = string.gsub(low, "xmlns[%w:]*%s*=%s*[\"'][^\"']*[\"']", "")
+		local s = string.find(bare, "://", 1, true)
+		if s then
+			local word = string.match(
+				string.sub(bare, math.max(1, s - 12), s + 30),
+				"([%w%.%+%-]*://[^%s\"'<>]*)"
+			) or "://"
+			table.insert(out, `names a web address ({word})`)
+		end
+	end
+	return out
+end
+
+type Section = { body: string, at: number }
+
+-- Every `<section>` whose id is `name`, wherever the id stands in its tag: its body (to the first `</section>`
+-- after it) and where it opens.
+local function sections(low: string, name: string): { Section }
+	local out: { Section } = {}
+	for at, attrs, after in string.gmatch(low, "()<section([^>]*)>()") do
+		local id = string.match(attrs :: string, "[%s/\"']id%s*=%s*[\"']?([^\"'%s>]+)")
+		if id == name then
+			local close = string.find(low, "</section>", after :: number, true)
+			local body = string.sub(low, after :: number, if close then (close :: number) - 1 else #low)
+			table.insert(out, { body = body, at = at :: number })
+		end
+	end
+	return out
+end
+
+-- The contract hashes the page names in its zn-contract meta tags.
+local function metas(low: string): { string }
+	local out: { string } = {}
+	for tag in string.gmatch(low, "<meta[^>]*>") do
+		if string.find(tag, "name%s*=%s*[\"']?zn%-contract[\"'%s>/]") then
+			local value = string.match(tag, "content%s*=%s*[\"']?([^\"'%s>]*)") or ""
+			table.insert(out, value)
+		end
+	end
+	return out
+end
+
+-- The first inline <svg> of a section, whitespace between tags dropped and the rest collapsed, or nil.
+local function picture(body: string): string?
+	local svg = string.match(body, "<svg.-</svg>")
+	if not svg then
+		return nil
+	end
+	local tight = string.gsub(svg, ">%s+<", "><")
+	return (string.gsub(tight, "%s+", " "))
+end
+
+-- Every way the page breaks the shape above, naming `path` and the rule; empty when it holds. `hash` is the
+-- issue's current contract hash, `touched` the backticked paths of its Touched modules.
+function explainer.check(path: string, html: string, hash: string, touched: { string }): { string }
+	local problems: { string } = {}
+	local function add(text: string)
+		table.insert(problems, `{path}: {text}`)
+	end
+	local low = string.lower(html)
+
+	local named = metas(low)
+	if #named == 0 then
+		add(`has no <meta name="zn-contract" content="{hash}">: the page must name the contract it explains`)
+	elseif #named > 1 then
+		add(`has {#named} zn-contract meta tags: exactly one names the contract it explains`)
+	elseif not string.match(named[1], "^" .. HEX .. "$") then
+		add(`its zn-contract "{named[1]}" is not a sha256 (the contract is {hash})`)
+	elseif named[1] ~= string.lower(hash) then
+		add(
+			`explains contract {string.sub(named[1], 1, 12)}, but the contract is now {string.sub(hash, 1, 12)}: update the page for the design as it is, then set its zn-contract to {hash}`
+		)
+	end
+
+	local last = 0
+	local ordered = true
+	local bodies: { [string]: string } = {}
+	for _, name in explainer.SECTIONS do
+		local found = sections(low, name)
+		if #found == 0 then
+			add(`has no <section id="{name}">`)
+		elseif #found > 1 then
+			add(`has {#found} <section id="{name}">: each section is there once`)
+		else
+			bodies[name] = found[1].body
+			if found[1].at < last then
+				ordered = false
+			end
+			last = found[1].at
+		end
+	end
+	if not ordered then
+		add(`its sections are out of order: they are {table.concat(explainer.SECTIONS, ", ")}`)
+	end
+
+	local pictures: { [string]: string } = {}
+	for _, name in explainer.DIAGRAMS do
+		local body = bodies[name]
+		if body then
+			local svg = picture(body)
+			if svg then
+				pictures[name] = svg
+			else
+				add(`<section id="{name}"> has no inline <svg> diagram`)
+			end
+		end
+	end
+	if pictures.before and pictures.before == pictures.after then
+		add(
+			"the before and after diagrams are the same picture: draw the system as it is and as this leaves it"
+		)
+	end
+
+	local changes = bodies.changes
+	if changes then
+		for _, p in touched do
+			if not string.find(changes, string.lower(p), 1, true) then
+				add(`<section id="changes"> does not name {p} (a Touched module)`)
+			end
+		end
+	end
+
+	local choices = bodies.choices
+	if choices then
+		local marks: { number } = {}
+		for s, classes in string.gmatch(choices, "()class%s*=%s*[\"']([^\"']*)[\"']") do
+			if hasClass(classes :: string, "choice") then
+				table.insert(marks, s :: number)
+			end
+		end
+		if #marks == 0 then
+			add(
+				`<section id="choices"> has no class="choice" block: each choice is one, with its pros and cons`
+			)
+		end
+		for i, s in marks do
+			local block = string.sub(choices, s, if marks[i + 1] then marks[i + 1] - 1 else #choices)
+			for _, kind in { "pros", "cons" } do
+				local found = false
+				for classes in string.gmatch(block, "class%s*=%s*[\"']([^\"']*)[\"']") do
+					if hasClass(classes, kind) then
+						found = true
+					end
+				end
+				if not found then
+					add(`choice {i} in <section id="choices"> has no class="{kind}" list`)
+				end
+			end
+		end
+	end
+
+	for classes in string.gmatch(low, "class%s*=%s*[\"']([^\"']*)[\"']") do
+		if hasClass(classes, explainer.FILL) then
+			add(
+				`still holds the template's placeholder text (class="{explainer.FILL}"): fill it in and drop the class`
+			)
+			break
+		end
+	end
+
+	for _, ref in external(low) do
+		add(`{ref}: {SELF}`)
+	end
+	return problems
+end
+
+-- Only "y" or "yes" (any case, surrounding spaces ignored) approves. Anything else, an empty line and no answer
+-- at all (nil: the terminal closed) do not.
+function explainer.accepts(answer: string?): boolean
+	if answer == nil then
+		return false
+	end
+	local a = string.lower((string.gsub(string.gsub(answer, "^%s+", ""), "%s+$", "")))
+	return a == "y" or a == "yes"
+end
+
+return explainer
