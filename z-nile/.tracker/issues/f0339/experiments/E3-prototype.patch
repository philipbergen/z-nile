+-- Opens `path` in the system's default app for its type (`open` on macOS, `xdg-open` elsewhere): the browser for a page.
+-- Returns whether it opened, and the opener's name for a warning.
+local function openInDefaultApp(path: string): (boolean, string)
+	local opener = if process.os == "macos" then "open" else "xdg-open"
+	local ok, r = pcall(sh.run, opener, { path })
+	return ok and r.ok, opener
+end
+
+-- One line typed at the controlling terminal (the one stdinIsTerminal opens), or nil when there is none or it
