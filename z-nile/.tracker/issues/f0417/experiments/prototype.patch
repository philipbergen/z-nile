index 000000000..e79ff5c36
--- /dev/null
+++ b/z-nile/engine/lastgate.luau
@@ -0,0 +1,139 @@
+--!strict
+-- f0417: what a marked member needs to land, and where a refusal sends the work. Pure.
+
+local lastgate = {}
+
+export type Member = {
+	id: string,
+	marked: boolean,
+	state: string,
+	judged: string?,
+	current: string,
+	approved: string?,
+}
+export type Route = { decision: string, idea: boolean, line: string }
+export type Block = { reason: string, recommend: string }
+
+-- nil when the member may land; else what is missing and its kind: "review" (the last review is the work's own) or
+-- "approval" (only a person gives it). An unmarked member is judged by today's checks.
+function lastgate.problem(m: Member): (string?, string?)
+	if not m.marked then
+		return nil, nil
+	end
+	if m.state ~= "on-course" then
+		return `{m.id}: no on-course last review (state: {m.state})`, "review"
+	end
+	if m.judged ~= m.current then
+		return `{m.id}: the last review judged contract {m.judged or "none"}, the contract is now {m.current}: run it again`,
+			"review"
+	end
+	if m.approved == nil then
+		return `{m.id}: not approved: ./zn approve {m.id} (it covers the idea, the design, the guesses and the assumptions)`,
+			"approval"
+	end
+	if m.approved ~= m.current then
+		return `{m.id}: approved {m.approved}, not the contract the last review judged ({m.current})`,
+			"approval"
+	end
+	return nil, nil
+end
+
+local LOOPS: { [string]: { decision: string, idea: boolean, loop: string } } = {
+	idea = { decision = "amend-design", idea = true, loop = "idea" },
+	design = { decision = "amend-design", idea = false, loop = "design" },
+	build = { decision = "retry", idea = false, loop = "code" },
+}
+
+function lastgate.route(to: string, nextFile: string, today: string, who: string): (Route?, string?)
+	local r = LOOPS[to]
+	if not r then
+		return nil, `--to must be idea|design|build, not "{to}"`
+	end
+	return {
+		decision = r.decision,
+		idea = r.idea,
+		line = `- Loop ({who}, {today}): a new {r.loop} loop from {nextFile}`,
+	},
+		nil
+end
+
+function lastgate.offCourse(state: string, gaps: { string }): Block?
+	if state == "redo-design" then
+		return { reason = "design-gap", recommend = "amend-design" }
+	end
+	if state == "redo-layer" then
+		return { reason = "needs-decision", recommend = "retry" }
+	end
+	if state == "blocked" then
+		return {
+			reason = "needs-decision",
+			recommend = if table.find(gaps, "design") then "amend-design" else "retry",
+		}
+	end
+	return nil
+end
+
+function lastgate.reason(kind: string, marked: boolean): string
+	if kind == "dispute" and marked then
+		return "needs-decision"
+	end
+	return "review-exhausted"
+end
+
+export type Plan = {
+	block: { reason: string, layer: string? },
+	resolve: Route,
+	question: string,
+	ask: string?,
+}
+
+-- What `./zn refuse` does for an issue, from its state on origin/main, or why it refuses (pure).
+function lastgate.refusePlan(p: {
+	id: string,
+	where: string,
+	status: string,
+	raft: string,
+	to: string,
+	why: string,
+	today: string,
+	who: string,
+	next: { idea: string, design: string, code: string },
+}): (Plan?, string?)
+	local active = p.where == "active"
+	if not active then
+		if p.status == "new" then
+			return nil, `{p.id} is new: give its idea your words with ./zn idea {p.id} --record`
+		elseif p.status == "done" or p.where == "done" then
+			return nil, `{p.id} is done: ./zn new issue captures the rework as a new ticket`
+		elseif p.status == "closed" then
+			return nil, `{p.id} is closed: there is nothing to refuse`
+		elseif p.status == "blocked" then
+			return nil, `{p.id} is blocked: rule it with ./zn resolve {p.id}`
+		elseif p.status == "prepared" then
+			local unfold = if p.raft ~= "" then `./zn unfold {p.raft} {p.id}, then ` else ""
+			return nil,
+				`{p.id} is prepared, not built: claim it again ({unfold}./zn status {p.id} preparing) and refuse it there`
+		elseif p.status ~= "preparing" then
+			return nil, `{p.id} is {p.status}: nothing to refuse`
+		elseif p.to == "build" then
+			return nil, `{p.id} is being designed: nothing is built, so --to build has nothing to retry`
+		end
+	end
+	local nextFile = if p.to == "idea"
+		then p.next.idea
+		elseif p.to == "design" then p.next.design
+		else p.next.code
+	local route, why = lastgate.route(p.to, nextFile, p.today, p.who)
+	if not route then
+		return nil, why
+	end
+	return {
+		block = { reason = "needs-decision", layer = if active then p.id else nil },
+		resolve = route,
+		question = p.why,
+		ask = if p.to == "idea" then `### Message {p.today}\n{p.why}` else nil,
+	},
+		nil
+end
+
+return lastgate
