index 000000000..511fbb387
--- /dev/null
+++ b/z-nile/engine/assumptions.luau
@@ -0,0 +1,200 @@
+--!strict
+-- An issue's assumptions.md (f0417): every fact the work relies on and has not proven. Pure: texts in, texts out.
+-- `./zn assume` writes the file, the approval contract hashes it. The twin of guesses.luau.
+--   # assumptions
+--   - A1 (design, 2026-11-18): <what is taken as true> Because: <why it is believed> Unproven: <what would show it false>
+-- Oldest first, numbered from A1 with no gap. A field holds no line break and neither mark.
+
+local assumptions = {}
+
+export type Assumption = {
+	id: string,
+	step: string,
+	when: string,
+	what: string,
+	because: string,
+	unproven: string,
+}
+
+assumptions.FILE = "assumptions.md"
+assumptions.STEPS = { "idea", "design", "raft", "build" }
+
+local HEADER = "# assumptions"
+local BECAUSE = " Because: "
+local UNPROVEN = " Unproven: "
+local DAY = "^%d%d%d%d%-%d%d%-%d%d$"
+
+local function isStep(step: string): boolean
+	return table.find(assumptions.STEPS, step) ~= nil
+end
+
+local function fieldProblem(name: string, value: string): string?
+	if string.match(value, "^%s*$") then
+		return `{name} is empty`
+	end
+	if string.find(value, "[\r\n]") then
+		return `{name} has a line break`
+	end
+	if string.find(value, BECAUSE, 1, true) or string.find(value, UNPROVEN, 1, true) then
+		return `{name} holds a mark ("{BECAUSE}" or "{UNPROVEN}")`
+	end
+	return nil
+end
+
+function assumptions.parse(text: string): ({ Assumption }?, string?)
+	local norm = (string.gsub(text, "\r\n", "\n"))
+	local lines: { string } = {}
+	for line in string.gmatch(norm .. "\n", "(.-)\n") do
+		table.insert(lines, line)
+	end
+	for at = #lines, 1, -1 do
+		if lines[at] ~= "" then
+			break
+		end
+		lines[at] = nil
+	end
+	if lines[1] ~= HEADER then
+		return nil, `the first line must be "{HEADER}"`
+	end
+	local out: { Assumption } = {}
+	for i = 2, #lines do
+		local line = lines[i]
+		local n, step, when, rest = string.match(line, "^%- A(%d+) %((%a+), ([%d%-]+)%): (.*)$")
+		if not n then
+			return nil, `line {i} is not an assumption: "{line}"`
+		end
+		if tonumber(n) ~= #out + 1 or n ~= tostring(#out + 1) then
+			return nil, `line {i} is A{n}, expected A{#out + 1}`
+		end
+		if not isStep(step :: string) then
+			return nil, `A{n} has an unknown step "{step}"`
+		end
+		if not string.match(when :: string, DAY) then
+			return nil, `A{n}'s date is not YYYY-MM-DD`
+		end
+		local body = rest :: string
+		local b = string.find(body, BECAUSE, 1, true)
+		local u = b and string.find(body, UNPROVEN, b + #BECAUSE, true)
+		if not b or not u then
+			return nil, `A{n} needs "{BECAUSE}" and then "{UNPROVEN}"`
+		end
+		local what = string.sub(body, 1, b - 1)
+		local because = string.sub(body, b + #BECAUSE, u - 1)
+		local unproven = string.sub(body, u + #UNPROVEN)
+		for name, value in { what = what, because = because, unproven = unproven } :: { [string]: string } do
+			local problem = fieldProblem(name, value)
+			if problem then
+				return nil, `A{n}: {problem}`
+			end
+		end
+		table.insert(out, {
+			id = `A{n}`,
+			step = step :: string,
+			when = when :: string,
+			what = what,
+			because = because,
+			unproven = unproven,
+		})
+	end
+	return out, nil
+end
+
+function assumptions.render(list: { Assumption }): string
+	local lines = { HEADER }
+	for _, a in list do
+		table.insert(
+			lines,
+			`- {a.id} ({a.step}, {a.when}): {a.what}{BECAUSE}{a.because}{UNPROVEN}{a.unproven}`
+		)
+	end
+	return table.concat(lines, "\n") .. "\n"
+end
+
+function assumptions.append(
+	text: string?,
+	step: string,
+	when: string,
+	what: string,
+	because: string,
+	unproven: string
+): (string?, string?)
+	local list: { Assumption } = {}
+	if text and text ~= "" then
+		local parsed, err = assumptions.parse(text)
+		if not parsed then
+			return nil, `{assumptions.FILE} does not parse: {err}`
+		end
+		list = parsed
+	end
+	if not isStep(step) then
+		return nil, `unknown step "{step}" ({table.concat(assumptions.STEPS, "|")})`
+	end
+	if not string.match(when, DAY) then
+		return nil, "the date is not YYYY-MM-DD"
+	end
+	for _, pair in { { "--what", what }, { "--because", because }, { "--unproven", unproven } } do
+		local problem = fieldProblem(pair[1], pair[2])
+		if problem then
+			return nil, problem
+		end
+	end
+	table.insert(list, {
+		id = `A{#list + 1}`,
+		step = step,
+		when = when,
+		what = what,
+		because = because,
+		unproven = unproven,
+	})
+	return assumptions.render(list), nil
+end
+
+-- Is `new` the assumptions of `old` with nothing removed or changed, and any number added?
+function assumptions.extends(old: string?, new: string?): boolean
+	local was: { Assumption } = {}
+	if old and old ~= "" then
+		local parsed = assumptions.parse(old)
+		if not parsed then
+			return false
+		end
+		was = parsed
+	end
+	if not new or new == "" then
+		return #was == 0
+	end
+	local now = assumptions.parse(new)
+	if not now or #now < #was then
+		return false
+	end
+	for i, a in was do
+		local n = now[i]
+		if
+			n.step ~= a.step
+			or n.when ~= a.when
+			or n.what ~= a.what
+			or n.because ~= a.because
+			or n.unproven ~= a.unproven
+		then
+			return false
+		end
+	end
+	return true
+end
+
+function assumptions.has(text: string?, id: string): boolean
+	if not text or text == "" then
+		return false
+	end
+	local list = assumptions.parse(text)
+	if not list then
+		return false
+	end
+	for _, a in list do
+		if a.id == id then
+			return true
+		end
+	end
+	return false
+end
+
+return assumptions
