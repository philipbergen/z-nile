+-- f0417: the bullets of a loop, `- F<k>: (<prefix>NNN F<n>) ...`, each with its source round and whether a `Ruled (user, ...)`
+-- or a `Guessed (agent, ...)` line answers it. The one reader of that grammar; bullets without a source are not listed.
+function openlist.sourced(doc: string): { { source: string, id: string, ruled: boolean, guessed: boolean } }
+	local section = sectionOf(doc, "Open to the human")
+	local out: { { source: string, id: string, ruled: boolean, guessed: boolean } } = {}
+	if not section then
+		return out
+	end
+	local current: { source: string, id: string, ruled: boolean, guessed: boolean }? = nil
+	for line in string.gmatch(section .. "\n", "(.-)\n") do
+		local id = string.match(line, "^%- (F%d+):") or string.match(line, "^%- (JC%d+):")
+		if id then
+			local source = string.match(line, "^%- [%w]+:%s*%(([%w%-]+%d%d%d [%w]+)%)")
