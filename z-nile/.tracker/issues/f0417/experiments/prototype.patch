index 000000000..e7d6911dc
--- /dev/null
+++ b/z-nile/engine/ideafile.luau
@@ -0,0 +1,81 @@
+--!strict
+-- The one reader of an idea round's files, `idea-review-NNN.md` and `idea-refute-NNN.md` (f0417). Pure. `idea.luau`
+-- re-exports it and `rounds.luau` requires it, so neither needs the other.
+
+local ideafile = {}
+
+export type Finding = { id: string, text: string }
+
+function ideafile.trim(s: string): string
+	return (string.gsub(string.gsub(s, "^%s+", ""), "%s+$", ""))
+end
+
+function ideafile.sectionBody(md: string, heading: string): string?
+	local found = string.find(md, `\n## {heading}\n`, 1, true)
+	local startAt = 1
+	if string.sub(md, 1, #heading + 4) == `## {heading}\n` then
+		found = 1
+		startAt = #heading + 4
+	elseif found then
+		startAt = found + #heading + 4
+	else
+		return nil
+	end
+	local rest = string.sub(md, startAt)
+	local nextAt = string.find(rest, "\n## ", 1, true)
+	local body = if nextAt then string.sub(rest, 1, nextAt - 1) else rest
+	return body
+end
+
+function ideafile.parseReview(text: string): ({ Finding }, string?)
+	local body = text
+	if string.sub(body, 1, 1) ~= "\n" then
+		body = "\n" .. body
+	end
+	local found: { Finding } = {}
+	local raw = ideafile.sectionBody(body, "Findings")
+	if raw then
+		for line in string.gmatch(raw .. "\n", "(.-)\n") do
+			local item = ideafile.trim((string.gsub(ideafile.trim(line), "^[-*]%s+", "")))
+			if item ~= "" and item ~= "none" and item ~= "None" then
+				local id, rest = string.match(item, "^(F%d+):%s*(.+)$")
+				if id == nil or rest == nil or ideafile.trim(rest) == "" then
+					return {}, nil
+				end
+				table.insert(found, { id = id, text = ideafile.trim(rest) })
+			end
+		end
+	end
+	local verdictBody = ideafile.sectionBody(body, "Verdict")
+	local verdict = if verdictBody
+		then string.lower(ideafile.trim(string.match(verdictBody, "[^\n]+") or ""))
+		else nil
+	if verdict ~= "approve" and verdict ~= "revise" then
+		verdict = nil
+	end
+	return found, verdict
+end
+
+-- id -> "revised" | "disputed" | "other" from the `- F<n>: revised|disputed: <why>` lines of an idea-refute file.
+function ideafile.refuteLines(text: string): { [string]: string }
+	local map: { [string]: string } = {}
+	for id, rest in string.gmatch("\n" .. text, "\n%-%s+(F%d+):%s*([^\n]*)") do
+		local words = rest :: string
+		if string.find(words, "^revised") then
+			map[id :: string] = "revised"
+		elseif string.find(words, "^disputed") then
+			map[id :: string] = "disputed"
+		else
+			map[id :: string] = "other"
+		end
+	end
+	return map
+end
+
+-- The interview count of the review's `Round: ask <m>, interview <q>, idea <hash>` line (c0260), nil without one.
+function ideafile.interviewOf(text: string): number?
+	local q = string.match("\n" .. text, "\nRound:%s*ask%s+%d+,%s*interview%s+(%d+)")
+	return if q then tonumber(q) else nil
+end
+
+return ideafile
