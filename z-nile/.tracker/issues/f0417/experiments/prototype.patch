index 000000000..324260a3b
--- /dev/null
+++ b/z-nile/engine/rounds.luau
@@ -0,0 +1,424 @@
+--!strict
+-- f0417: the round rule. A review at a stage goes back and forth between the author and a new clean reviewer until a
+-- round approves with no open finding, or the stage's cap is reached; what is open then is the human's. Pure: texts
+-- in, texts out. One module says what a loop is, for the dispatcher, the claim gate, `work next` and the skills.
+
+local ideafile = require("./ideafile")
+local openlist = require("./openlist")
+
+local rounds = {}
+
+export type Stage = "idea" | "design" | "code"
+export type Finding = { id: string, severity: string, repeatOf: string?, ask: boolean }
+-- answers: finding id -> "fixed" | "refuted" | "deferred" | "revised" | "disputed" | "other"; nil with no refute file
+export type Round = {
+	n: number,
+	findings: { Finding },
+	verdict: string?,
+	answers: { [string]: string }?,
+	current: boolean?, -- false: a code round reviewed an older patch than the layer's (nil: current)
+	interview: number?, -- an idea round's `Round: ... interview <q> ...` count (c0260)
+}
+export type Window = { from: number, extra: number }
+export type State =
+	{ kind: string, count: number, cap: number, last: number, next: number?, human: { string } }
+
+rounds.CAP = { idea = 5, design = 9, code = 9 }
+rounds.PREFIX = {
+	idea = { "idea-review-", "idea-refute-" },
+	design = { "design-review-", "design-refute-" },
+	code = { "review-", "refute-" },
+}
+
+local function name(prefix: string, n: number): string
+	return `{prefix}{string.format("%03d", n)}`
+end
+
+local function repeatOf(claim: string): string?
+	return string.match(claim, "%(repeat of ([%w%-]+%d%d%d F%d+)%)")
+end
+
+-- The mark: the frontmatter line `rounds: on`, exactly. Body text is not the mark.
+function rounds.marked(doc: string): boolean
+	local text = (string.gsub(doc, "\r\n", "\n"))
+	if string.sub(text, 1, 4) ~= "---\n" then
+		return false
+	end
+	local close = string.find(text, "\n---", 4, true)
+	local front = if close then string.sub(text, 5, close) else string.sub(text, 5)
+	for line in string.gmatch(front, "(.-)\n") do
+		if line == "rounds: on" then
+			return true
+		end
+	end
+	return false
+end
+
+function rounds.read(stage: Stage, n: number, review: string, refute: string?): Round
+	local findings: { Finding } = {}
+	local verdict: string? = nil
+	local answers: { [string]: string }? = nil
+	local interview: number? = nil
+	if stage == "idea" then
+		local found, word = ideafile.parseReview(review)
+		for _, f in found do
+			if string.lower(f.text) ~= "none" then
+				table.insert(findings, {
+					id = f.id,
+					severity = "unrated",
+					repeatOf = repeatOf(f.text),
+					ask = string.find(string.lower(f.text), "^ask:") ~= nil,
+				})
+			end
+		end
+		verdict = word
+		interview = ideafile.interviewOf(review)
+		if refute ~= nil then
+			answers = ideafile.refuteLines(refute)
+		end
+	else
+		for _, f in openlist.findings(review) do
+			local claim = string.match("\n" .. review, `\n###%s+{f.id}([^\n]*)`) or ""
+			table.insert(
+				findings,
+				{ id = f.id, severity = f.severity, repeatOf = repeatOf(claim), ask = false }
+			)
+		end
+		local word = string.match("\n" .. review, "\nVerdict:%s*(%a+)")
+		verdict = if word then string.lower(word) else nil
+		if refute ~= nil then
+			local map: { [string]: string } = {}
+			for _, f in findings do
+				local kind = openlist.answerKind(refute, f.id)
+				if kind then
+					map[f.id] = kind
+				end
+			end
+			answers = map
+		end
+	end
+	return { n = n, findings = findings, verdict = verdict, answers = answers, interview = interview }
+end
+
+local function numberOf(token: string, prefix: string): number?
+	local d = string.match(token, "^" .. string.gsub(prefix, "%-", "%%-") .. "(%d+)$")
+	return if d then tonumber(d) else nil
+end
+
+-- The `## Loops` section's lines are the only place a loop starts or is extended.
+function rounds.window(doc: string, stage: Stage): Window
+	local prefix = rounds.PREFIX[stage][1]
+	local from = 1
+	local past: { number } = {}
+	local inside = false
+	for line in string.gmatch(doc .. "\n", "(.-)\n") do
+		if string.find(line, "^## ") then
+			inside = string.find(line, "^## Loops%s*$") ~= nil
+		elseif inside then
+			local newLoop = string.match(line, `^%- Loop %([^)]*%): a new {stage} loop from (%S+)`)
+			if newLoop then
+				local n = numberOf(newLoop, prefix)
+				if n and n > from then
+					from = n
+				end
+			end
+			local more = string.match(line, `^%- Loop %([^)]*%): one more {stage} round past (%S+)`)
+			if more then
+				local n = numberOf(more, prefix)
+				if n then
+					table.insert(past, n)
+				end
+			end
+		end
+	end
+	local extra = 0
+	for _, n in past do
+		if n >= from then
+			extra += 1
+		end
+	end
+	return { from = from, extra = extra }
+end
+
+local function isRepeatAgain(r: Round, f: Finding): boolean
+	if not f.repeatOf then
+		return false
+	end
+	local a = if r.answers then r.answers[f.id] else nil
+	return a == "refuted" or a == "disputed"
+end
+
+-- The number of `### Q` questions in the document's `## Interview` section.
+local function interviewQs(doc: string?): number
+	if not doc then
+		return 0
+	end
+	local count = 0
+	local inside = false
+	for line in string.gmatch(doc .. "\n", "(.-)\n") do
+		if string.find(line, "^## ") then
+			inside = string.find(line, "^## Interview") ~= nil
+		elseif inside and string.find(line, "^### Q%d+") then
+			count += 1
+		end
+	end
+	return count
+end
+
+function rounds.state(stage: Stage, list: { Round }, window: Window, doc: string?): State
+	local cap = rounds.CAP[stage] + window.extra
+	local inWindow: { Round } = {}
+	local highest = 0
+	for _, r in list do
+		if r.n > highest then
+			highest = r.n
+		end
+		if r.n >= window.from then
+			table.insert(inWindow, r)
+		end
+	end
+	table.sort(inWindow, function(a, b)
+		return a.n < b.n
+	end)
+	local prefix = rounds.PREFIX[stage][1]
+	local human: { string } = {}
+	local seen: { [string]: boolean } = {}
+	local function add(r: Round, f: Finding)
+		local entry = `{name(prefix, r.n)} {f.id}`
+		if not seen[entry] then
+			seen[entry] = true
+			table.insert(human, entry)
+		end
+	end
+	for _, r in inWindow do
+		for _, f in r.findings do
+			if isRepeatAgain(r, f) then
+				add(r, f)
+			end
+		end
+	end
+	local count = #inWindow
+	if count == 0 then
+		return {
+			kind = "none",
+			count = 0,
+			cap = cap,
+			last = 0,
+			next = math.max(highest + 1, window.from),
+			human = human,
+		}
+	end
+	local newest = inWindow[count]
+	local function state(kind: string, nextN: number?): State
+		return { kind = kind, count = count, cap = cap, last = newest.n, next = nextN, human = human }
+	end
+	local answers = newest.answers
+	local asks, others = 0, 0
+	for _, f in newest.findings do
+		if f.ask then
+			asks += 1
+		else
+			others += 1
+		end
+	end
+	-- every finding that is not an ask has an answer
+	local function answeredAll(): boolean
+		for _, f in newest.findings do
+			if not f.ask and (answers == nil or answers[f.id] == nil) then
+				return false
+			end
+		end
+		return true
+	end
+	local function noneFixed(): boolean
+		for _, f in newest.findings do
+			if answers and answers[f.id] == "fixed" then
+				return false
+			end
+		end
+		return true
+	end
+	if newest.verdict == "approve" and newest.current ~= false then
+		if stage == "idea" then
+			if #newest.findings == 0 then
+				return state("ended", nil)
+			end
+		elseif answeredAll() and noneFixed() then
+			return state("ended", nil)
+		end
+	end
+	local function capHuman()
+		for _, f in newest.findings do
+			local a = if answers then answers[f.id] else nil
+			if stage == "idea" or f.severity == "high" or a ~= "fixed" then
+				add(newest, f)
+			end
+		end
+	end
+	if stage == "idea" and count >= cap then
+		capHuman()
+		return state("cap", nil)
+	end
+	if not answeredAll() then
+		return state("answer", nil)
+	end
+	if stage == "idea" and others == 0 and asks > 0 and interviewQs(doc) <= (newest.interview or 0) then
+		return state("person", nil)
+	end
+	if count >= cap then
+		capHuman()
+		if newest.current == false then
+			add(newest, { id = "stale", severity = "", ask = false })
+		end
+		return state("cap", nil)
+	end
+	return state("next", newest.n + 1)
+end
+
+local function askIds(s: State, stage: Stage): string
+	local ids: { string } = {}
+	for _, entry in s.human do
+		if string.sub(entry, 1, #rounds.PREFIX[stage][1] + 3) == name(rounds.PREFIX[stage][1], s.last) then
+			table.insert(ids, string.match(entry, "(F%d+)$") or "")
+		end
+	end
+	return table.concat(ids, ", ")
+end
+
+function rounds.filing(
+	stage: Stage,
+	list: { Round },
+	window: Window,
+	doc: string?
+): { number: number?, refusal: string? }
+	local s = rounds.state(stage, list, window, doc)
+	local pair = rounds.PREFIX[stage]
+	if s.kind == "none" or s.kind == "next" then
+		return { number = s.next, refusal = nil }
+	end
+	if s.kind == "ended" then
+		return {
+			number = nil,
+			refusal = `{name(pair[1], s.last)} approved with no open finding: the loop ended`,
+		}
+	end
+	if s.kind == "answer" then
+		return {
+			number = nil,
+			refusal = `answer {name(pair[1], s.last)} first: every finding fixed or refuted in {name(
+				pair[2],
+				s.last
+			)}`,
+		}
+	end
+	if s.kind == "person" then
+		return {
+			number = nil,
+			refusal = `{name(pair[1], s.last)} asks the person: {askIds(s, stage)}; the next round waits for the answer`,
+		}
+	end
+	return {
+		number = nil,
+		refusal = `the {stage} cap of {s.cap} rounds is reached: what is open goes to the person (## Open to the human, ./zn block <id> review-exhausted); only the person's ./zn resolve <id> retry grants another round`,
+	}
+end
+
+function rounds.gate(stage: Stage, list: { Round }, window: Window, doc: string): string?
+	local s = rounds.state(stage, list, window, doc)
+	local pair = rounds.PREFIX[stage]
+	if s.kind == "none" or s.kind == "next" then
+		return `the next round is {name(pair[1], s.next or 1)}`
+	end
+	if s.kind == "answer" or s.kind == "person" then
+		return rounds.filing(stage, list, window, doc).refusal
+	end
+	if stage == "idea" then
+		-- c0260's open list: every bullet ruled; a Guessed line is never enough
+		local pending = openlist.pending(doc)
+		if #pending > 0 then
+			return `{table.concat(pending, ", ")} wait for the person under ## Open to the human`
+		end
+		return nil
+	end
+	local sourced = openlist.sourced(doc)
+	local missing: { string } = {}
+	for _, entry in s.human do
+		local ok = false
+		for _, b in sourced do
+			if b.source == entry and (b.ruled or b.guessed) then
+				ok = true
+			end
+		end
+		if not ok then
+			table.insert(missing, entry)
+		end
+	end
+	if #missing > 0 then
+		return `{table.concat(missing, ", ")} wait for the person under ## Open to the human`
+	end
+	return nil
+end
+
+-- Why `doc`'s `## Loops` section is not acceptable beside `base` (origin/main's copy, nil for a new item), or nil. A line
+-- of `base` that `doc` lacks is refused (sync first), and so is every line of `doc` that is not in `base`, except a new
+-- idea loop from the next idea round (`highest.idea + 1`) when the ask grew (`askGrew`: the person's new words).
+-- A new design loop is the claim's line, which the claim publishes with its status line (publish.claimMarks).
+function rounds.loopsProblem(
+	base: string?,
+	doc: string,
+	highest: { [string]: number },
+	askGrew: boolean
+): string?
+	local function loopLines(text: string): { string }
+		local out: { string } = {}
+		local inside = false
+		for line in string.gmatch(text .. "\n", "(.-)\n") do
+			if string.find(line, "^## ") then
+				inside = string.find(line, "^## Loops%s*$") ~= nil
+			elseif inside and string.find(line, "^%- Loop ") then
+				table.insert(out, line)
+			end
+		end
+		return out
+	end
+	local known: { [string]: boolean } = {}
+	if base then
+		for _, line in loopLines(base) do
+			known[line] = true
+		end
+	end
+	local held: { [string]: boolean } = {}
+	for _, line in loopLines(doc) do
+		held[line] = true
+	end
+	if base then
+		for _, line in loopLines(base) do
+			if not held[line] then
+				return `## Loops line '{line}' is on origin/main but missing here: ./zn sync`
+			end
+		end
+	end
+	for _, line in loopLines(doc) do
+		if not known[line] then
+			local idea = string.match(line, "^%- Loop %([^)]*%): a new idea loop from (%S+)$")
+			local okIdea = askGrew
+				and idea ~= nil
+				and idea == name(rounds.PREFIX.idea[1], (highest.idea or 0) + 1)
+			if not okIdea then
+				return `## Loops line '{line}' is not on origin/main and no command of the person wrote it`
+			end
+		end
+	end
+	return nil
+end
+
+-- Whether a design loop may be restarted by a claim: its gate passes (ended, or a cap whose leftovers are ruled or
+-- guessed); or the claim adopts an older reviewed issue (`adopting`) that has rounds.
+function rounds.restartable(list: { Round }, window: Window, doc: string, adopting: boolean): boolean
+	if #list == 0 then
+		return false
+	end
+	return adopting or rounds.gate("design", list, window, doc) == nil
+end
+
+return rounds
