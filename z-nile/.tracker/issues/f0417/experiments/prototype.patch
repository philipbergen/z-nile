+local IDEA_HEADINGS = { "Non-goals", "Ask (verbatim)", "Interview", "Confirmation" }
+
+local function sectionBody(doc: string, heading: string): string?
+	local hay = "\n" .. doc
+	local mark = "\n## " .. heading .. "\n"
+	local s = string.find(hay, mark, 1, true)
+	if not s then
+		return nil
+	end
+	local body = s + #mark
+	local nxt = string.find(hay, "\n## ", body - 1, true)
+	return if nxt then string.sub(hay, body, nxt - 1) else string.sub(hay, body)
+end
+
+-- f0417: what a person approves of the idea: its non-goals, the ask, the interview, the confirmation, then every
+-- idea review and refute in name order. Problem and Solution are in the design part already.
+function contract.ideaText(doc: string, files: { [string]: string }): string
+	local chunks: { string } = {}
+	for _, heading in IDEA_HEADINGS do
+		local body = sectionBody(doc, heading)
+		if body then
+			table.insert(chunks, `## {heading}\n{body}`)
+		end
+	end
+	local names: { string } = {}
+	for fname in files do
+		if
+			string.match(fname, "^idea%-review%-%d+%.md$") or string.match(fname, "^idea%-refute%-%d+%.md$")
+		then
+			table.insert(names, fname)
+		end
+	end
+	table.sort(names)
+	for _, fname in names do
+		table.insert(chunks, `## {fname}\n{files[fname]}`)
+	end
+	if #chunks == 0 then
+		return ""
+	end
+	return table.concat(chunks, "\n")
+end
+
+-- f0417: the parts beyond guesses, from the item's folder files (name -> text): the assumptions whenever the file
+-- exists, the idea's files only for an issue with `rounds: on`.
+function contract.more(doc: string, files: { [string]: string }): { idea: string?, assumptions: string? }
+	local marked = require("./rounds").marked(doc)
+	return {
+		idea = if marked then contract.ideaText(doc, files) else nil,
+		assumptions = files["assumptions.md"],
+	}
+end
