+			else
+				current = nil
+			end
+		end
+		if current then
+			if string.match(line, RULED) then
+				current.ruled = true
+			end
+			if string.match(line, GUESSED) then
+				current.guessed = true
+			end
+		end
+	end
+	return out
+end
