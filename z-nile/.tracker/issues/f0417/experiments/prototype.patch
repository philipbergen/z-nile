+--!strict
+-- f0417: reads a folder's rounds for rounds.luau, at the edge. One reader of the files `rounds.read` parses.
+
+local fs = require("@lune/fs")
+local rounds = require("./rounds")
+
+local roundread = {}
+
+-- The rounds of `stage` in `dir`, oldest first.
+function roundread.list(dir: string, stage: rounds.Stage): { rounds.Round }
+	local pair = rounds.PREFIX[stage]
+	local out: { rounds.Round } = {}
+	if not fs.isDir(dir) then
+		return out
+	end
+	local lead = string.gsub(pair[1], "%-", "%%-")
+	for _, name in fs.readDir(dir) do
+		local digits = string.match(name, "^" .. lead .. "(%d+)%.md$")
+		local n = if digits then tonumber(digits) else nil
+		if n then
+			local refutePath = `{dir}/{pair[2]}{string.format("%03d", n)}.md`
+			local refute = if fs.isFile(refutePath) then fs.readFile(refutePath) else nil
+			table.insert(out, rounds.read(stage, n, fs.readFile(`{dir}/{name}`), refute))
+		end
+	end
+	table.sort(out, function(a, b)
+		return a.n < b.n
+	end)
+	return out
+end
+
+-- The rounds of `stage` among a folder's files (name -> text), oldest first.
+function roundread.fromFiles(files: { [string]: string }, stage: rounds.Stage): { rounds.Round }
+	local pair = rounds.PREFIX[stage]
+	local lead = string.gsub(pair[1], "%-", "%%-")
+	local out: { rounds.Round } = {}
+	for name, text in files do
+		local digits = string.match(name, "^" .. lead .. "(%d+)%.md$")
+		local n = if digits then tonumber(digits) else nil
+		if n then
+			table.insert(out, rounds.read(stage, n, text, files[`{pair[2]}{string.format("%03d", n)}.md`]))
+		end
+	end
+	table.sort(out, function(a, b)
+		return a.n < b.n
+	end)
+	return out
+end
+
+-- rounds.gate over the design rounds in `dir`: nil when the design loop is done with, else the refusal.
+function roundread.design(dir: string, doc: string): string?
+	return rounds.gate("design", roundread.list(dir, "design"), rounds.window(doc, "design"), doc)
+end
+
+return roundread
diff --git a/z-nile/engine/rounds.luau b/z-nile/engine/rounds.luau
