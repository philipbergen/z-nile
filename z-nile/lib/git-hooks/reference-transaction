#!/bin/sh
# Ref guard for checks (zz-test skill, "Specs never touch the real repository"). z-nile/lib/fence.sh points
# every git a check runs at this directory (core.hooksPath), so this runs on every ref update. In a repository
# listed in PICKMAN_FENCE_REAL_GIT (the checkouts' own git directories) it refuses every update. A check.sh flow
# (not a spec run, PICKMAN_FENCE_SPECS) may still fetch: updates under refs/remotes/ that create or move a ref
# (not delete one, which is what removing a remote does), and the empty transaction of a fetch with nothing new.
# Fixtures update their own refs freely.
# Whatever it allows, it then runs the repository's own reference-transaction hook, if any, with the same
# arguments and input: core.hooksPath would otherwise skip a fixture's own hooks.
input=$(cat)
. "${0%/*}/.repo.sh"
chain() {
  own="$(repo_common)/hooks/reference-transaction"
  [ -x "$own" ] || exit 0
  if [ -n "$input" ]; then
    printf '%s\n' "$input" | "$own" "$@"
  else
    "$own" "$@" </dev/null
  fi
  exit $?
}
[ "$1" = prepared ] || chain "$@"
[ -n "$PICKMAN_FENCE_REAL_GIT" ] || chain "$@"
common=$(repo_common) || chain "$@"
protected=
old_ifs=$IFS
IFS=:
for real in $PICKMAN_FENCE_REAL_GIT; do
  [ "$common" = "$real" ] && protected=$real
done
IFS=$old_ifs
[ -n "$protected" ] || chain "$@"
zero=0000000000000000000000000000000000000000
lines=0
fetch_only=yes
while read -r old new ref; do
  [ -n "$ref" ] || continue
  lines=$((lines + 1))
  case $ref in
  refs/remotes/*) [ "$new" = "$zero" ] && fetch_only=no ;;
  *) fetch_only=no ;;
  esac
done <<INPUT
$input
INPUT
# allowed, outside spec runs only: a transaction with no refs (a fetch with nothing new changes nothing, c0131),
# or one whose every ref is created or moved under refs/remotes/ (a fetch)
[ "$lines" -eq 0 ] && [ -z "$PICKMAN_FENCE_SPECS" ] && chain "$@"
[ "$lines" -gt 0 ] && [ "$fetch_only" = yes ] && [ -z "$PICKMAN_FENCE_SPECS" ] && chain "$@"
echo "fence: a check tried to change refs in the real repository ($protected); refused" >&2
exit 1
