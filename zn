#!/usr/bin/env bash
# z-nile's command (c0114): ./zn <command> ... from anywhere in the checkout. See z-nile/skills/zz-rules/SKILL.md.
# The directory it is run from gives the project (a command's --project overrides it): ZN_CWD is that directory
# relative to the checkout, and ZN_TOP the checkout, so the engine trusts ZN_CWD only when it runs in ZN_TOP.
set -euo pipefail
# `./zn run` is the bounded runner (c0191): it starts before anything else, in the caller's folder, with no Lune of its
# own between the caller and the command it bounds.
if [[ ${1:-} == run ]]; then
  shift
  export PATH="$HOME/.rokit/bin:$PATH"
  export ZN_TOP="$(cd "$(dirname "$0")" && pwd -P)"
  # A run already inside a measurement (the gate, a spec run) records nothing of its own.
  if [[ -z "${ZN_MEASURED:-}" ]]; then
    export ZN_MEASURE_BUFFER=1
    export ZN_MEASURE_KIND=run
    export ZN_MEASURE_PHASE=other
    export ZN_MEASURE_SUBJECT=run
    ZN_MEASURE_BRANCH="$(git -C "$ZN_TOP" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    ZN_MEASURE_HEAD="$(git -C "$ZN_TOP" rev-parse HEAD 2>/dev/null || true)"
    if [[ "$ZN_MEASURE_BRANCH" == "HEAD" ]]; then ZN_MEASURE_BRANCH=""; fi
    export ZN_MEASURE_BRANCH ZN_MEASURE_HEAD
  else
    unset ZN_MEASURE_BUFFER
  fi
  exec perl "$ZN_TOP/z-nile/lib/bounded.pl" "$@"
fi
# `./zn live <op>` is the live layer's (f0424): the daemon's one binary, `znlive`, built from the main checkout's z-nile/go
# into <main>/.cache/bin. `build` builds it; every other op finds it (ZN_LIVE_BIN, else the main checkout's), builds it
# first when it is missing or a Go source is newer than its build id, and execs it: no Lune starts. With no binary and
# no Go it exits 3. ZN_LIVE_ROOT names another checkout to build from and into (specs: a fixture).
# `./zn app [--open] [flags]` (f0437) is `live app`: the daemon is started when none runs, made to serve the app on 127.0.0.1,
# and the URL is printed (--open also opens it in the browser).
live_open=0
if [[ ${1:-} == app ]]; then
  shift
  live_args=()
  for live_a in "$@"; do
    if [[ $live_a == --open ]]; then live_open=1; else live_args+=("$live_a"); fi
  done
  set -- live app ${live_args[@]+"${live_args[@]}"}
fi
if [[ ${1:-} == live ]]; then
  live_top="$(cd "$(dirname "$0")" && pwd -P)"
  live_root="${ZN_LIVE_ROOT:-}"
  if [[ -z $live_root ]]; then
    # the main checkout, with no git process: a .git folder is the main one; a worktree's .git file leads there
    live_root="$live_top"
    if [[ -f $live_top/.git ]]; then
      live_gd="$(sed -n 's/^gitdir: *//p' "$live_top/.git")"
      [[ $live_gd == /* ]] || live_gd="$live_top/$live_gd" # git writes a relative gitdir with worktree.useRelativePaths
      live_cd="$(cat "$live_gd/commondir" 2>/dev/null || true)"
      if [[ -n $live_cd ]]; then
        [[ $live_cd == /* ]] || live_cd="$live_gd/$live_cd"
        live_root="$(dirname "$(cd "$live_cd" && pwd -P)")"
      fi
    fi
  fi
  live_build() { bash "$live_top/z-nile/lib/gobuild.sh" "$live_root" "$live_root/.cache/bin/znlive" "$@"; }
  case "${2:-}" in
  build)
    live_build
    exit $?
    ;;
  "")
    echo "usage: ./zn live <op> [flags]; ops: build register beat claim release gone stop workers claims wait events poke emit app status shutdown serve" >&2
    exit 2
    ;;
  *)
    # this checkout's own main checkout is the live layer's root, wherever the caller's folder is (it may be another
    # repository); the default state directory is <root>/.cache/live, which the daemon recognises by its real path
    export ZN_LIVE_ROOT="$live_root"
    [[ -n ${ZN_LIVE_DIR:-} ]] || export ZN_LIVE_DIR="$live_root/.cache/live"
    live_bin="${ZN_LIVE_BIN:-}"
    if [[ -z $live_bin ]]; then
      live_bin="$live_root/.cache/bin/znlive"
      if [[ ! -x $live_bin ]] || [[ ! -f $live_bin.id ]] || [[ -n $(find "$live_root/z-nile/go" \( -name '*.go' -o -name go.mod \) ! -name '*_test.go' -newer "$live_bin.id" -print -quit 2>/dev/null) ]]; then
        # a failed rebuild keeps an existing binary and says so in one line; with none, gobuild.sh has said why (no Go)
        live_rc=0
        live_build --auto >/dev/null || live_rc=$?
        case $live_rc in
        0 | 3) [[ -x $live_bin ]] || exit 3 ;;
        *)
          if [[ -x $live_bin ]]; then
            echo "rebuild of znlive failed; using the existing build; ./zn live build shows why" >&2
          else
            echo "live layer unavailable: the build of znlive failed (./zn live build shows why)" >&2
            exit 3
          fi
          ;;
        esac
      fi
    elif [[ ! -x $live_bin ]]; then
      echo "live layer unavailable: ZN_LIVE_BIN $live_bin is not an executable (./zn live build makes it)" >&2
      exit 3
    fi
    shift
    if [[ ${1:-} == app ]]; then
      # the page comes from the checkout the command ran in (a worktree's own, before it lands), else the main checkout's
      if [[ " $* " != *" --page "* && -f $live_top/z-nile/app/index.html ]]; then set -- "$@" --page "$live_top/z-nile/app/index.html"; fi
      live_rc=0
      live_url="$("$live_bin" "$@")" || live_rc=$?
      [[ -z $live_url ]] || printf '%s\n' "$live_url"
      if [[ $live_rc == 0 && $live_open == 1 ]]; then
        if command -v open >/dev/null 2>&1; then open "$live_url"; else xdg-open "$live_url" >/dev/null 2>&1 || echo "cannot open a browser; open $live_url" >&2; fi
      fi
      exit $live_rc
    fi
    exec "$live_bin" "$@"
    ;;
  esac
fi
top="$(cd "$(dirname "$0")" && pwd -P)"
here="$(pwd -P)"
# `work` started in another worktree of this repo reads that worktree. Every other command stays here.
if [[ ${1:-} == work ]]; then
  if git -C "$here" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    caller="$(cd "$(git -C "$here" rev-parse --show-toplevel)" && pwd -P)"
    common_here="$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)"
    common_top="$(git -C "$top" rev-parse --path-format=absolute --git-common-dir)"
    if [[ "$common_here" == "$common_top" && "$caller" != "$top" ]]; then
      rel_here="${here#"$caller"}"
      export ZN_TOP="$caller" ZN_CWD="${rel_here#/}"
      cd "$caller"
      export PATH="$HOME/.rokit/bin:$PATH"
      lim=${ZN_ENGINE_CPU:-1800}
      [[ $lim =~ ^[0-9]+$ ]] || lim=1800
      source "$top/z-nile/lib/cpu.sh"
      zn_lower_cpu "$lim" 2>/dev/null || true
      exec lune run "$top/z-nile/engine/main" -- "$@"
    fi
  fi
fi
case "$here/" in
"$top/"*) rel="${here#"$top"}" ;;
*) rel="" ;; # outside the checkout: like its root
esac
export ZN_TOP="$top" ZN_CWD="${rel#/}"
cd "$top"
export PATH="$HOME/.rokit/bin:$PATH"
# approve records, and starts a walkthrough, only for the human, in a terminal. --check, --queue and --ruling only
# read or write the run's rulings, so a pipe or an agent session may run them (f0423). The engine repeats the
# dispatch and session checks; this one is the stdin test, which a child process cannot see.
if [[ ${1:-} == approve ]]; then
  reading=0
  for arg in "$@"; do
    case $arg in --check | --queue | --ruling | --help) reading=1 ;; esac
  done
  if [[ $reading == 0 ]]; then
    lead="${2:-}"
    hint="./zn approve ${*:2}"
    hint="${hint% }"
    if [[ -z $lead ]]; then
      lead=""
    elif [[ $lead == --* ]]; then
      lead=""
    else
      lead="$lead: "
    fi
    if [[ -n ${ZN_DISPATCH:-} ]]; then
      echo "${lead}approve is refused while ZN_DISPATCH is set. Run $hint yourself, in a terminal." >&2
      exit 1
    fi
    if [[ -n ${ZN_APPROVE_SESSION:-} ]]; then
      echo "${lead}approve is refused inside a walkthrough session (ZN_APPROVE_SESSION is set): an agent never records an approval. Write rulings with ./zn approve --ruling, then ask the person to run ./zn approve --apply ${ZN_APPROVE_SESSION} in a terminal." >&2
      exit 1
    fi
    if [[ ! -t 0 ]]; then
      echo "${lead}approve is refused without a terminal on stdin. Run $hint yourself, in a terminal." >&2
      exit 1
    fi
  fi
fi
# the engine's own CPU limit (c0191), ZN_ENGINE_CPU seconds (default 1800): what an engine command spends is its own
# CPU, not its children's (the gate, git), and a loop in it ends in half an hour instead of never. It only lowers the
# limit the caller has, so the spec runner's 1200 s stays what it asks for
lim=${ZN_ENGINE_CPU:-1800}
[[ $lim =~ ^[0-9]+$ ]] || lim=1800
source "$top/z-nile/lib/cpu.sh"
zn_lower_cpu "$lim" 2>/dev/null || true
exec lune run z-nile/engine/main -- "$@"
