#!/usr/bin/env bash
# z-nile's command (c0114): ./zn <command> ... from anywhere in the checkout. See z-nile/skills/zz-rules/SKILL.md.
# The directory it is run from gives the project (a command's --project overrides it): ZN_CWD is that directory
# relative to the checkout, and ZN_TOP the checkout, so the engine trusts ZN_CWD only when it runs in ZN_TOP.
set -euo pipefail
# `./zn run` is the bounded runner (c0191): it starts before anything else, in the caller's folder, with no Lune of its
# own between the caller and the command it bounds.
if [[ ${1:-} == run ]]; then
  shift
  export PATH="$HOME/.rokit/bin:$PATH"
  export ZN_TOP="$(cd "$(dirname "$0")" && pwd -P)"
  # A run already inside a measurement (the gate, a spec run) records nothing of its own.
  if [[ -z "${ZN_MEASURED:-}" ]]; then
    export ZN_MEASURE_BUFFER=1
    export ZN_MEASURE_KIND=run
    export ZN_MEASURE_PHASE=other
    export ZN_MEASURE_SUBJECT=run
    ZN_MEASURE_BRANCH="$(git -C "$ZN_TOP" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    ZN_MEASURE_HEAD="$(git -C "$ZN_TOP" rev-parse HEAD 2>/dev/null || true)"
    if [[ "$ZN_MEASURE_BRANCH" == "HEAD" ]]; then ZN_MEASURE_BRANCH=""; fi
    export ZN_MEASURE_BRANCH ZN_MEASURE_HEAD
  else
    unset ZN_MEASURE_BUFFER
  fi
  exec perl "$ZN_TOP/z-nile/lib/bounded.pl" "$@"
fi
# `./zn live <op>` is the live layer's (f0424): the daemon's one binary, built from the main checkout's z-nile/go. Only
# `build` exists so far; every other op is step 2's. ZN_LIVE_ROOT names another checkout (specs: a fixture).
if [[ ${1:-} == live ]]; then
  case "${2:-}" in
  build)
    root="${ZN_LIVE_ROOT:-}"
    if [[ -z $root ]]; then
      common="$(git -C "$(dirname "$0")" rev-parse --path-format=absolute --git-common-dir)"
      root="$(dirname "$common")"
    fi
    exec bash "$(cd "$(dirname "$0")" && pwd -P)/z-nile/lib/gobuild.sh" "$root" "$root/.cache/bin/znlive"
    ;;
  *)
    echo "./zn live ${2:-}: not built yet: step 2" >&2
    exit 3
    ;;
  esac
fi
top="$(cd "$(dirname "$0")" && pwd -P)"
here="$(pwd -P)"
# `work` started in another worktree of this repo reads that worktree. Every other command stays here.
if [[ ${1:-} == work ]]; then
  if git -C "$here" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    caller="$(cd "$(git -C "$here" rev-parse --show-toplevel)" && pwd -P)"
    common_here="$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)"
    common_top="$(git -C "$top" rev-parse --path-format=absolute --git-common-dir)"
    if [[ "$common_here" == "$common_top" && "$caller" != "$top" ]]; then
      rel_here="${here#"$caller"}"
      export ZN_TOP="$caller" ZN_CWD="${rel_here#/}"
      cd "$caller"
      export PATH="$HOME/.rokit/bin:$PATH"
      lim=${ZN_ENGINE_CPU:-1800}
      [[ $lim =~ ^[0-9]+$ ]] || lim=1800
      source "$top/z-nile/lib/cpu.sh"
      zn_lower_cpu "$lim" 2>/dev/null || true
      exec lune run "$top/z-nile/engine/main" -- "$@"
    fi
  fi
fi
case "$here/" in
"$top/"*) rel="${here#"$top"}" ;;
*) rel="" ;; # outside the checkout: like its root
esac
export ZN_TOP="$top" ZN_CWD="${rel#/}"
cd "$top"
export PATH="$HOME/.rokit/bin:$PATH"
# approve is the human's, in a terminal. --check only reads, so a pipe may run it. The engine repeats the
# dispatch check; this one is the stdin test, which a child process cannot see.
if [[ ${1:-} == approve ]]; then
  checking=0
  for arg in "$@"; do
    [[ $arg == --check ]] && checking=1
  done
  if [[ $checking == 0 ]]; then
    id="${2:-<issue-id>}"
    [[ $id == --* ]] && id="<issue-id>"
    if [[ -n ${ZN_DISPATCH:-} ]]; then
      echo "$id: approve is refused while ZN_DISPATCH is set. Run ./zn approve $id yourself, in a terminal." >&2
      exit 1
    fi
    if [[ ! -t 0 ]]; then
      echo "$id: approve is refused without a terminal on stdin. Run ./zn approve $id yourself, in a terminal." >&2
      exit 1
    fi
  fi
fi
# the engine's own CPU limit (c0191), ZN_ENGINE_CPU seconds (default 1800): what an engine command spends is its own
# CPU, not its children's (the gate, git), and a loop in it ends in half an hour instead of never. It only lowers the
# limit the caller has, so the spec runner's 1200 s stays what it asks for
lim=${ZN_ENGINE_CPU:-1800}
[[ $lim =~ ^[0-9]+$ ]] || lim=1800
source "$top/z-nile/lib/cpu.sh"
zn_lower_cpu "$lim" 2>/dev/null || true
exec lune run z-nile/engine/main -- "$@"
